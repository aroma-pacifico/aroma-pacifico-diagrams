<mxfile host="Electron">
  <diagram id="platform-pipeline" name="Platform CI/CD Pipeline and Release Model">
    <mxGraphModel dx="2600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Platform CI/CD Pipeline and Release Model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Repository triggers, OIDC pipeline identities, three-stage promotion flow (dev -&gt; qa -&gt; pdn), plan-only verification gates, and CodeDeploy canary shifts." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="72" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_pipeline" value="CONTINUOUS INTEGRATION &amp; THREE-STAGE PROMOTION PIPELINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="2580" height="500" as="geometry" />
        </mxCell>
        <mxCell id="card_repos" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="170" width="410" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_repos" value="Source Repositories [D01]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_repos" value="&lt;b&gt;aroma-pacifico-terraform-modules&lt;/b&gt; (Public)&lt;br/&gt;• Reusable Terraform reference modules&lt;br/&gt;• Published via semver tags (vX.Y.Z)&lt;br/&gt;• Zero account IDs, ARNs, credentials or state&lt;br/&gt;• Verified by tflint, validate, and checkov&lt;br/&gt;&lt;br/&gt;&lt;b&gt;aroma-pacifico-infrastructure&lt;/b&gt; (Private)&lt;br/&gt;• Root stack definitions per environment (dev, qa, pdn)&lt;br/&gt;• Consumes modules by tag; remote state per account&lt;br/&gt;• Plan-only automation; zero live resource creation&lt;br/&gt;&lt;br/&gt;&lt;b&gt;aroma-pacifico-platform&lt;/b&gt; (Private, ASM-170)&lt;br/&gt;• Application services, Lambda functions, prompts&lt;br/&gt;• Code mapped to platform, ingestion, flight pipelines" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="230" width="370" height="345" as="geometry" />
        </mxCell>
        <mxCell id="card_rc" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="170" width="410" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_rc" value="Release Candidate (RC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="615" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_rc" value="&lt;b&gt;Deterministic Artifact Pinning (ASM-171)&lt;/b&gt;&lt;br/&gt;• Built once per release tag by artifact publisher role&lt;br/&gt;• Lambda zip packages and container images&lt;br/&gt;• Staged to regional S3 artifact bucket per environment&lt;br/&gt;• Digest pinned in &lt;i&gt;stacks/workload/releases.tfvars&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Single Release Candidate Promotion&lt;/b&gt;&lt;br/&gt;• Exactly one RC promoted sequentially across tiers&lt;br/&gt;• Zero environment-specific artifact builds&lt;br/&gt;• Same byte-identical packages tested in dev, qa, pdn&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Audit &amp;amp; Traceability&lt;/b&gt;&lt;br/&gt;• Traceable to commit hash, roadmap issue, PR approval" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="230" width="370" height="345" as="geometry" />
        </mxCell>
        <mxCell id="card_dev" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="170" width="410" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_dev" value="Stage 1: Development (dev) [D12]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="1145" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_dev" value="&lt;b&gt;Environment &amp;amp; Target&lt;/b&gt;&lt;br/&gt;• Dedicated sandbox account and isolated VPC&lt;br/&gt;• Continuous integration on PR merge to main&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Plan-Only Verification Gates&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform plan&lt;/i&gt; execution in CI&lt;br/&gt;• Security &amp;amp; lint checks (validate, tflint, checkov)&lt;br/&gt;• Zero high/critical security findings allowed&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Execution &amp;amp; Testing&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform apply&lt;/i&gt; via GitHub OIDC&lt;br/&gt;• Function deployment via CodeDeploy AllAtOnce&lt;br/&gt;• Automated smoke tests, API health checks&lt;br/&gt;• Succeeded run generates promotion evidence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1145" y="230" width="370" height="345" as="geometry" />
        </mxCell>
        <mxCell id="card_qa" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="170" width="410" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_qa" value="Stage 2: QA Pattern (qa) [D12]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#3730a3;" vertex="1" parent="1">
          <mxGeometry x="1675" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_qa" value="&lt;b&gt;Environment &amp;amp; Target&lt;/b&gt;&lt;br/&gt;• Pattern environment topology (D04, D05, D08)&lt;br/&gt;• Synthetic telemetry &amp;amp; test flight objects&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Promotion &amp;amp; Verification Gates&lt;/b&gt;&lt;br/&gt;• Promotion PR against qa branch&lt;br/&gt;• Gate 1: dev verification log and test evidence&lt;br/&gt;• Gate 2: 1 peer review (SR1, SR2, JR1, JR2 not author, ASM-172)&lt;br/&gt;• Gate 3: &lt;i&gt;terraform plan&lt;/i&gt; diff inspection&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Execution &amp;amp; Testing&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform apply&lt;/i&gt; on PR merge&lt;br/&gt;• Integration tests and pattern validation&lt;br/&gt;• CodeDeploy canary simulation (10% 5 min, D11)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="230" width="370" height="345" as="geometry" />
        </mxCell>
        <mxCell id="card_pdn" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2185" y="170" width="410" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_pdn" value="Stage 3: Production (pdn) [D12]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="2205" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_pdn" value="&lt;b&gt;Environment &amp;amp; Target&lt;/b&gt;&lt;br/&gt;• Primary production workload (AWS us-east-1)&lt;br/&gt;• Live coffee data (Cauca, Huila, Tolima)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Four Mandatory Production Gates&lt;/b&gt;&lt;br/&gt;1. Approver: One of SR1 or SR2 (not author/trigger, ASM-172)&lt;br/&gt;2. Federation Notice: 2 business days lead time (ASM-173, Q-15)&lt;br/&gt;3. Harvest Window: Outside harvest blackout (ASM-183)&lt;br/&gt;4. Plan Review: QA acceptance recorded, zero drift&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Deployment &amp;amp; Safeguards&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform apply&lt;/i&gt; via GitHub OIDC&lt;br/&gt;• CodeDeploy canary traffic shift (10% 5 min, D11)&lt;br/&gt;• CloudWatch rollback alarms armed (D13)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2205" y="230" width="370" height="345" as="geometry" />
        </mxCell>
        <mxCell id="e_repo_rc" value="Merge commit&lt;br/&gt;on main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_repos" target="card_rc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rc_dev" value="Automated&lt;br/&gt;trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_rc" target="card_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dev_qa" value="dev green +&lt;br/&gt;1 approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_dev" target="card_qa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_qa_pdn" value="qa passed +&lt;br/&gt;4 pdn gates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366f1;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#4338ca;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_qa" target="card_pdn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_safeguards" value="RELEASE MODEL, PIPELINE IDENTITY &amp; PRODUCTION SAFEGUARDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="2580" height="500" as="geometry" />
        </mxCell>
        <mxCell id="card_b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="700" width="600" height="420" as="geometry" />
        </mxCell>
        <mxCell id="icon_iam" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.role;" vertex="1" parent="1">
          <mxGeometry x="85" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="135" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_sm" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="185" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_b1" value="Pipeline Identity &amp; State [D01, D02, D03, D06]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="235" y="717" width="410" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_b1" value="&lt;b&gt;GitHub Actions OIDC Authentication (ADR-003)&lt;/b&gt;&lt;br/&gt;• Short-lived STS credentials via aws-actions/configure-aws-credentials&lt;br/&gt;• Zero static AWS access keys or long-lived secrets in GitHub&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Scoped Pipeline Roles (ASM-171, ADR-003)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;plan&lt;/i&gt; role: Scoped read-only plan permissions for PR checks&lt;br/&gt;• &lt;i&gt;apply&lt;/i&gt; role: Scoped write permissions for deployment on merge&lt;br/&gt;• BreakGlass permission set operates via AWS IAM, never deployment path&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Remote State Isolation [D02]&lt;/b&gt;&lt;br/&gt;• Dedicated S3 state bucket per environment (dev, qa, pdn isolated)&lt;br/&gt;• Native state locking (DynamoDB lock table / S3 locking) prevents collision&lt;br/&gt;• Server-side encryption with KMS CMK (&lt;i&gt;state&lt;/i&gt; key class, ASM-097)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Configuration &amp;amp; Secrets [D03]&lt;/b&gt;&lt;br/&gt;• AWS Secrets Manager &amp;amp; SSM Parameter Store for runtime credentials&lt;br/&gt;• Dynamic runtime resolution; zero credentials in git or state (ADR-003)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="765" width="560" height="335" as="geometry" />
        </mxCell>
        <mxCell id="card_b2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="695" y="700" width="600" height="420" as="geometry" />
        </mxCell>
        <mxCell id="icon_codedeploy" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codedeploy;" vertex="1" parent="1">
          <mxGeometry x="715" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_b2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="765" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_b2" value="Function Deployment Pattern [D11]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="815" y="717" width="460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_b2" value="&lt;b&gt;Deployment Engine &amp;amp; Strategy (ASM-174)&lt;/b&gt;&lt;br/&gt;• AWS CodeDeploy application and deployment groups&lt;br/&gt;• dev: &lt;i&gt;CodeDeployDefault.LambdaAllAtOnce&lt;/i&gt; for sandbox speed&lt;br/&gt;• qa &amp;amp; pdn: &lt;i&gt;CodeDeployDefault.LambdaCanary10Percent5Minutes&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Traffic Shifting &amp;amp; Validation&lt;/b&gt;&lt;br/&gt;• Routes 10% live traffic to new Lambda alias version for 5 minutes&lt;br/&gt;• Automated rollback triggered if any rollback alarm enters ALARM state&lt;br/&gt;• Shifts remaining 90% traffic to new version upon green bake window&lt;br/&gt;• Minimum 5 published Lambda versions kept alive (ASM-174)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Target Function Workloads (ASM-160, ASM-161, ASM-170)&lt;/b&gt;&lt;br/&gt;• Telemetry threshold function [D10] (evaluates reading vs DynamoDB)&lt;br/&gt;• Drone reception &amp;amp; screening function [D06]&lt;br/&gt;• Bedrock inference functions [D10] (confirmation, verification, estimation)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="715" y="765" width="560" height="335" as="geometry" />
        </mxCell>
        <mxCell id="card_b3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1325" y="700" width="600" height="420" as="geometry" />
        </mxCell>
        <mxCell id="icon_cw_b3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1345" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_b3" value="Observability &amp; Rollback Hooks [D13]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1395" y="717" width="510" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_b3" value="&lt;b&gt;CloudWatch Rollback Alarm Hooks (ASM-174, A18 sec 12)&lt;/b&gt;&lt;br/&gt;• Lambda alias error rate alarms: &lt;i&gt;&amp;lt;prefix&amp;gt;-pdn-alarm-&amp;lt;fn&amp;gt;-errors&lt;/i&gt;&lt;br/&gt;• Lambda throttles alarms: &lt;i&gt;&amp;lt;prefix&amp;gt;-pdn-alarm-&amp;lt;fn&amp;gt;-throttles&lt;/i&gt;&lt;br/&gt;• Function DLQ message alarms: &lt;i&gt;infthresholddlq&lt;/i&gt;, &lt;i&gt;infconfirmdlq&lt;/i&gt;&lt;br/&gt;• API Gateway 5XX alarms: &lt;i&gt;&amp;lt;prefix&amp;gt;-pdn-alarm-api-5xx&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Rollback Design Targets (ASM-174, PD-176)&lt;/b&gt;&lt;br/&gt;• Automatic CodeDeploy rollback: Traffic back to prior version &amp;lt; 10 min&lt;br/&gt;• Rollback deployment: Move alias to prior version &amp;lt; 30 min of decision&lt;br/&gt;• Revert commit through promotion: Plan review &amp;amp; apply &amp;lt; 2 hours&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Failure Recovery &amp;amp; Redrive (A18 sec 10)&lt;/b&gt;&lt;br/&gt;• Dead-letter queue redrive executed by platform operator after rollback&lt;br/&gt;• Deployment events published to SNS release topic and GitHub status" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1345" y="765" width="560" height="335" as="geometry" />
        </mxCell>
        <mxCell id="card_b4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1955" y="700" width="640" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_b4" value="Harvest Blackout &amp; Incident Exception Policy" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1975" y="717" width="600" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_b4" value="&lt;b&gt;Coffee Harvest Deployment Blackout (ASM-183)&lt;/b&gt;&lt;br/&gt;• Standard production deployments blocked during harvest weeks&lt;br/&gt;• Protects critical harvest intake operations across Cauca, Huila, Tolima&lt;br/&gt;• Advance Notice: Default 2 business days lead time to Federation (ASM-173)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Emergency Incident Exception (ASM-183)&lt;/b&gt;&lt;br/&gt;• Urgent change inside window or shortened notice requires incident declaration&lt;br/&gt;• Declared by one of SR1 or SR2 with formal incident reference&lt;br/&gt;• Incident reference recorded in approval and release note&lt;br/&gt;• Shortened notice sent at decision; completed note within 1 business day&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Forward Correction &amp;amp; Schema Compatibility (ASM-175, ASM-185)&lt;/b&gt;&lt;br/&gt;• Fixes roll forward through standard Git promotion (dev -&gt; qa -&gt; pdn)&lt;br/&gt;• Additive schema changes: readers ignore unrecognized attributes&lt;br/&gt;• Safe rollbacks: attributes added by new versions ignored by prior version" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1975" y="765" width="600" height="335" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
