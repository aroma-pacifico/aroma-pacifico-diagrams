<mxfile host="Electron">
  <diagram id="platform-pipeline" name="Platform CI/CD Pipeline and Release Model">
    <mxGraphModel dx="2600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Platform CI/CD Pipeline and Release Model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Repository triggers, OIDC pipeline identities, three-stage promotion flow (dev -&gt; qa -&gt; pdn), plan-only verification gates, and CodeDeploy canary shifts." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="72" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_pipeline" value="CONTINUOUS INTEGRATION &amp; THREE-STAGE PROMOTION PIPELINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="2580" height="630" as="geometry" />
        </mxCell>
        <mxCell id="card_repos" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="180" width="430" height="540" as="geometry" />
        </mxCell>
        <mxCell id="t_repos" value="Source Repositories [D01]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="195" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_repos" value="&lt;b&gt;aroma-pacifico-terraform-modules&lt;/b&gt;&lt;br/&gt;• Reusable core Terraform modules&lt;br/&gt;• Enforces tflint, tfsec, checkov validation&lt;br/&gt;• Published via semver tags (vX.Y.Z)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;aroma-pacifico-infrastructure&lt;/b&gt;&lt;br/&gt;• Environment root definitions (dev, qa, pdn)&lt;br/&gt;• Remote backend configuration per environment&lt;br/&gt;• Isolated network and state topologies&lt;br/&gt;&lt;br/&gt;&lt;b&gt;aroma-pacifico-platform&lt;/b&gt;&lt;br/&gt;• Application services, Lambda functions, containers&lt;br/&gt;• Pinned artifact references in &lt;i&gt;releases.tfvars&lt;/i&gt;&lt;br/&gt;• Automated lint and unit test suites on all PRs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="245" width="390" height="450" as="geometry" />
        </mxCell>
        <mxCell id="e_repo_rc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_repos" target="card_rc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_repo_rc" value="Merge commit&lt;br/&gt;on main" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="495" y="380" width="95" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_rc" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="430" height="540" as="geometry" />
        </mxCell>
        <mxCell id="t_rc" value="Release Candidate (RC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="610" y="195" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_rc" value="&lt;b&gt;Deterministic Release Pinning (ASM-174)&lt;/b&gt;&lt;br/&gt;• Pinned Git SHA-256 digest in &lt;i&gt;releases.tfvars&lt;/i&gt;&lt;br/&gt;• Cryptographic image digests for containers&lt;br/&gt;• SHA-256 package hash for Lambda function zips&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Single Release Candidate Policy&lt;/b&gt;&lt;br/&gt;• Exactly one RC promoted sequentially across tiers&lt;br/&gt;• Zero environment-specific artifact builds&lt;br/&gt;• Immutable deployment packages across dev, qa, pdn&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Audit &amp;amp; Traceability&lt;/b&gt;&lt;br/&gt;• Every release maps to exact commit hash&lt;br/&gt;• Traceable to roadmap issue and PR approval" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="610" y="245" width="390" height="450" as="geometry" />
        </mxCell>
        <mxCell id="e_rc_dev" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_rc" target="card_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_rc_dev" value="Automated&lt;br/&gt;trigger" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="380" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_dev" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1110" y="180" width="450" height="540" as="geometry" />
        </mxCell>
        <mxCell id="t_dev" value="Stage 1: Development (dev) [D12]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="1130" y="195" width="410" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_dev" value="&lt;b&gt;Environment &amp;amp; Target&lt;/b&gt;&lt;br/&gt;• Dedicated development sandbox account / VPC&lt;br/&gt;• Low-cost instance types and test databases&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Plan-Only Verification Gates&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform plan&lt;/i&gt; execution in CI&lt;br/&gt;• Security policy inspection (tflint, checkov)&lt;br/&gt;• Zero high or critical security findings allowed&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Execution &amp;amp; Testing&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform apply&lt;/i&gt; via GitHub Actions OIDC&lt;br/&gt;• Automated smoke tests and API health checks&lt;br/&gt;• Generates promotion verification report" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1130" y="245" width="410" height="450" as="geometry" />
        </mxCell>
        <mxCell id="e_dev_qa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_dev" target="card_qa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_dev_qa" value="dev green +&lt;br/&gt;1 approval" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="1560" y="380" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_qa" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1660" y="180" width="450" height="540" as="geometry" />
        </mxCell>
        <mxCell id="t_qa" value="Stage 2: Quality Assurance (qa) [D12]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#3730a3;" vertex="1" parent="1">
          <mxGeometry x="1680" y="195" width="410" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_qa" value="&lt;b&gt;Environment &amp;amp; Target&lt;/b&gt;&lt;br/&gt;• Production-mirror environment topology&lt;br/&gt;• Synthetic IoT traffic and test telemetry feeds&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Promotion &amp;amp; Verification Gates&lt;/b&gt;&lt;br/&gt;• Triggered via promotion PR against qa branch&lt;br/&gt;• Gate 1: dev verification log and test evidence&lt;br/&gt;• Gate 2: Mandatory 1 peer review sign-off&lt;br/&gt;• Gate 3: &lt;i&gt;terraform plan&lt;/i&gt; diff inspection&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Execution &amp;amp; Testing&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform apply&lt;/i&gt; on PR merge&lt;br/&gt;• Automated integration test suite and load tests&lt;br/&gt;• Validates CodeDeploy canary shift simulation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1680" y="245" width="410" height="450" as="geometry" />
        </mxCell>
        <mxCell id="e_qa_pdn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366f1;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_qa" target="card_pdn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_qa_pdn" value="qa passed +&lt;br/&gt;4 pdn gates" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#4338ca;" vertex="1" parent="1">
          <mxGeometry x="2110" y="380" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_pdn" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2210" y="180" width="390" height="540" as="geometry" />
        </mxCell>
        <mxCell id="t_pdn" value="Stage 3: Production (pdn) [D12]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="2230" y="195" width="350" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_pdn" value="&lt;b&gt;Environment &amp;amp; Workload&lt;/b&gt;&lt;br/&gt;• Primary production cloud workload (AWS)&lt;br/&gt;• Live coffee producer data (Cauca, Huila, Tolima)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Four Mandatory Production Gates&lt;/b&gt;&lt;br/&gt;1. CAB Approval: SR1 Human Lead sign-off&lt;br/&gt;2. Federation Notice: 24h advance notification&lt;br/&gt;3. Harvest Blackout: Blocked 05:00-18:00 COT&lt;br/&gt;4. Plan Review: Zero unexpected resource changes&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Deployment &amp;amp; Safeguards&lt;/b&gt;&lt;br/&gt;• Automated &lt;i&gt;terraform apply&lt;/i&gt; on PR merge&lt;br/&gt;• CodeDeploy canary shift (D11)&lt;br/&gt;• CloudWatch rollback alarms armed (D13)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2230" y="245" width="350" height="450" as="geometry" />
        </mxCell>
        <mxCell id="c_safeguards" value="RELEASE MODEL, PIPELINE IDENTITY &amp; PRODUCTION SAFEGUARDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="2580" height="660" as="geometry" />
        </mxCell>
        <mxCell id="card_b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="840" width="600" height="560" as="geometry" />
        </mxCell>
        <mxCell id="icon_iam" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.role;" vertex="1" parent="1">
          <mxGeometry x="85" y="860" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="145" y="860" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="icon_sm" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="205" y="860" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="t_b1" value="Pipeline Identity &amp; Remote State [D01, D02, D03]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="265" y="865" width="380" height="38" as="geometry" />
        </mxCell>
        <mxCell id="b_b1" value="&lt;b&gt;GitHub Actions OIDC Authentication&lt;/b&gt;&lt;br/&gt;• Short-lived credentials via &lt;i&gt;aws-actions/configure-aws-credentials&lt;/i&gt;&lt;br/&gt;• Zero static access keys or long-lived secrets in GitHub&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IAM Roles &amp;amp; Boundaries (ASM-171)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;github-actions-plan-role&lt;/i&gt;: Scoped read-only plan permissions&lt;br/&gt;• &lt;i&gt;github-actions-apply-role&lt;/i&gt;: Scoped write permissions for deployment&lt;br/&gt;• &lt;i&gt;github-actions-breakglass-role&lt;/i&gt;: High-privilege role requiring SR1 approval&lt;br/&gt;• Bound by &lt;i&gt;pipeline-boundary-policy&lt;/i&gt; to prevent privilege escalation&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Remote State Isolation [D02]&lt;/b&gt;&lt;br/&gt;• Dedicated S3 bucket per environment (dev, qa, pdn isolated)&lt;br/&gt;• DynamoDB state lock table prevents concurrent execution&lt;br/&gt;• State encrypted at rest with AWS KMS Customer Managed Keys (CMK)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Secrets Management [D03]&lt;/b&gt;&lt;br/&gt;• Secrets stored in AWS Secrets Manager and SSM Parameter Store&lt;br/&gt;• Runtime dynamic resolution; zero credentials stored in Git" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="925" width="560" height="450" as="geometry" />
        </mxCell>
        <mxCell id="card_b2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="840" width="600" height="560" as="geometry" />
        </mxCell>
        <mxCell id="icon_codedeploy" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codedeploy;" vertex="1" parent="1">
          <mxGeometry x="710" y="860" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_b2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="770" y="860" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="t_b2" value="Function Deployment Pattern [D11]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="830" y="865" width="440" height="38" as="geometry" />
        </mxCell>
        <mxCell id="b_b2" value="&lt;b&gt;Deployment Engine &amp;amp; Strategy (ASM-181)&lt;/b&gt;&lt;br/&gt;• AWS CodeDeploy application and deployment groups&lt;br/&gt;• Production strategy: &lt;i&gt;LambdaCanary10Percent5Minutes&lt;/i&gt;&lt;br/&gt;• QA strategy: &lt;i&gt;LambdaCanary10Percent5Minutes&lt;/i&gt; (full simulation)&lt;br/&gt;• Dev strategy: &lt;i&gt;AllAtOnce&lt;/i&gt; for rapid sandbox development iteration&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Traffic Routing &amp;amp; Validation&lt;/b&gt;&lt;br/&gt;• Shifts 10% of production traffic to the new Lambda version&lt;br/&gt;• Evaluates live traffic during the 5-minute canary window&lt;br/&gt;• Automatically shifts remaining 90% of traffic upon green alarms&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Target Workloads [D06]&lt;/b&gt;&lt;br/&gt;• Telemetry Ingestion Processor Lambda&lt;br/&gt;• Drone Reception &amp;amp; Screening Lambda&lt;br/&gt;• Agronomic Alert Dispatcher Lambda" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="710" y="925" width="560" height="450" as="geometry" />
        </mxCell>
        <mxCell id="card_b3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1315" y="840" width="600" height="560" as="geometry" />
        </mxCell>
        <mxCell id="icon_cw_b3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1335" y="860" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="t_b3" value="Observability &amp; Rollback Alarms [D13]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1395" y="865" width="500" height="38" as="geometry" />
        </mxCell>
        <mxCell id="b_b3" value="&lt;b&gt;CloudWatch Rollback Alarms&lt;/b&gt;&lt;br/&gt;• Lambda Error Rate &amp;gt; 1% during deployment window&lt;br/&gt;• P95 Latency &amp;gt; 5000 ms threshold violation&lt;br/&gt;• Ingestion Dead-Letter Queue (DLQ) message surge&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Automated CodeDeploy Rollback&lt;/b&gt;&lt;br/&gt;• Automatic trip: CodeDeploy immediately reverses traffic to prior version&lt;br/&gt;• Zero manual intervention required to prevent customer impact&lt;br/&gt;• Retains prior stable version alive with zero downtime&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Alert Notification &amp;amp; Logging&lt;/b&gt;&lt;br/&gt;• Publishes deployment failure event to SNS alert topic&lt;br/&gt;• Emits structured CloudWatch logs with deployment ID and error trace&lt;br/&gt;• Dispatches high-priority alert to engineering team" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1335" y="925" width="560" height="450" as="geometry" />
        </mxCell>
        <mxCell id="card_b4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1940" y="840" width="660" height="560" as="geometry" />
        </mxCell>
        <mxCell id="t_b4" value="Harvest Blackout &amp; Forward Correction Policy" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1960" y="865" width="620" height="38" as="geometry" />
        </mxCell>
        <mxCell id="b_b4" value="&lt;b&gt;Coffee Harvest Deployment Blackout (ASM-183)&lt;/b&gt;&lt;br/&gt;• Blackout Window: 05:00 to 18:00 Colombia Time (COT)&lt;br/&gt;• Harvest Days: Active harvesting periods in Cauca, Huila, Tolima&lt;br/&gt;• Completion Rule: All production changes must conclude before 05:00 COT&lt;br/&gt;• Advance Notice: 24h prior notification sent to Federation&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Emergency Incident Exception&lt;/b&gt;&lt;br/&gt;• Standard blackout can only be bypassed during active Sev-1 incidents&lt;br/&gt;• Requires formal tracking ID: &lt;i&gt;INC-YYYYMMDD-NN&lt;/i&gt;&lt;br/&gt;• Requires explicit authorization from SR1 Human Lead&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Forward Correction Policy&lt;/b&gt;&lt;br/&gt;• All fixes roll forward through standard Git workflow and CI pipeline&lt;br/&gt;• No manual resource modifications in AWS console or live CLI&lt;br/&gt;• No &lt;i&gt;git revert&lt;/i&gt; in production without full promotion sequence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1960" y="925" width="620" height="450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>