<mxfile host="Electron" modified="2026-11-11T00:00:00.000Z" agent="Mozilla/5.0 AromaPacifico" version="32.4.1" type="device"><diagram id="iac-provisioning-sequence" name="IaC CD Promotion and Production Provisioning Sequence"><mxGraphModel dx="3400" dy="2700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3400" pageHeight="2700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=none;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="3320" height="100" as="geometry" /></mxCell><mxCell id="hdr_title" value="AROMA PACÍFICO — IAC CD PROMOTION &amp; PRODUCTION PROVISIONING SEQUENCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="28" width="2800" height="32" as="geometry" /></mxCell><mxCell id="hdr_subtitle" value="Multi-Environment Promotion (dev -&gt; qa -&gt; pdn), Two-Step Production Approval, Harvest Blackout Verification &amp; Stack Dependency Order" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#bcccdc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="60" width="2800" height="22" as="geometry" /></mxCell><mxCell id="hdr_meta" value="Refs aroma-pacifico/aroma-pacifico-roadmap#38 | Track B Delivery | Normative: docs/cd-pipeline.md (B12), ADR-003, ASM-172, ASM-178, ASM-320 | Boxes: D01, D02, D04, D06, D12, D13" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#9fb3c8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="86" width="2800" height="20" as="geometry" /></mxCell><mxCell id="hdr_badge" value="PLAN-ONLY CD BOUNDARY&#10;Two-Step Workflow Approval&#10;Harvest Freeze: 05:00-18:00&#10;Stack Order: State -&gt; Net -&gt; Sec -&gt; Work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2900" y="28" width="440" height="84" as="geometry" /></mxCell><mxCell id="z1" value="TRUNK MERGE &amp; ORCHESTRATION&#10;cd-promotion.yml Workflow Trigger &amp; Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="480" height="80" as="geometry" /></mxCell><mxCell id="z2" value="DEV &amp; QA PROMOTION [Box D12]&#10;Sequential Dependency-Ordered Planning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="620" height="80" as="geometry" /></mxCell><mxCell id="z3" value="PRODUCTION GATES &amp; APPROVAL [Box D12 / D13]&#10;Change Window Check, Digest Binding &amp; Four-Eyes Record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1220" y="130" width="960" height="80" as="geometry" /></mxCell><mxCell id="z4" value="PROVISIONING STACKS IN DEPENDENCY ORDER [Box D02, D04, D06, D10]&#10;1. state-backend -&gt; 2. network -&gt; 3. security -&gt; 4. workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2210" y="130" width="1130" height="80" as="geometry" /></mxCell><mxCell id="icon_ll_trig" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="246" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_trig" value="Main Trunk &amp; Trigger&#10;Push / Workflow Dispatch" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="160" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_orch" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="546" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_orch" value="CD Orchestrator&#10;(guard &amp; cd-promotion.yml)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="460" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_devqa" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="936" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_devqa" value="Dev &amp; QA Stages [D12]&#10;plan-dev &amp; plan-qa Stacks" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="850" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_win" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="1446" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_win" value="Change Window &amp; Review&#10;(review-pdn, window-check)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1360" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_roles" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1866" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_roles" value="Requester &amp; Approver&#10;Four-Eyes Gate (ASM-172)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1780" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_appr" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2266" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_appr" value="Approval Verifier [D13]&#10;pdn-approval (cd-verify)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2180" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_stacks" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2816" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_stacks" value="Infrastructure Stacks&#10;State -&gt; Net -&gt; Sec -&gt; Work" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2720" y="240" width="240" height="2400" as="geometry" /></mxCell><mxCell id="p1" value="PHASE 1: TRUNK MERGE, PLAN-ONLY GUARD &amp; PROMOTION SCOPE (cd-promotion.yml, ASM-320)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e40af;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m1" value="1.1: Push to main touching stacks/**, environments/**, .terraform-version, scripts/cd-*, or dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="385" as="sourcePoint" /><mxPoint x="570" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m2" value="1.2: guard job executes: scans workflows &amp; scripts for forbidden apply/destroy regex; fails run if found (ASM-320)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="435" as="sourcePoint" /><mxPoint x="570" y="461" as="targetPoint" /><Array as="points"><mxPoint x="635" y="435" /><mxPoint x="635" y="461" /></Array></mxGeometry></mxCell><mxCell id="m3" value="1.3: Resolves promotion scope: push to main defaults to promote_to=qa; dispatch sets promote_to=pdn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="485" as="sourcePoint" /><mxPoint x="570" y="511" as="targetPoint" /><Array as="points"><mxPoint x="635" y="485" /><mxPoint x="635" y="511" /></Array></mxGeometry></mxCell><mxCell id="m4" value="1.4: Sets concurrency: cd-promotion-&lt;ref&gt; (cancels stale promotions); approval runs use non-cancelling group" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="535" as="sourcePoint" /><mxPoint x="570" y="561" as="targetPoint" /><Array as="points"><mxPoint x="635" y="535" /><mxPoint x="635" y="561" /></Array></mxGeometry></mxCell><mxCell id="c1" value="PLAN-ONLY CD BOUNDARY (ASM-320, docs/cd-pipeline.md §1):&#10;• Zero apply or destroy executed in automated pipelines; guard job strictly enforces regex check on every run&#10;• Concurrency group cd-promotion-&lt;ref&gt; ensures a later push to main supersedes a running review&#10;• Production approval approves a reviewed plan digest; nothing is deployed by this pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="850" height="80" as="geometry" /></mxCell><mxCell id="p2" value="PHASE 2: DEV &amp; QA ENVIRONMENT PROMOTION (DEPENDENCY-ORDERED PLANNING, D12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m5" value="2.1: plan-dev job invokes reusable cd-plan.yml: plans dev environment stacks in strict dependency order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="740" as="sourcePoint" /><mxPoint x="960" y="740" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m6" value="2.2: Stacks dependency evaluation: 1. state-backend -&gt; 2. network -&gt; 3. security -&gt; 4. workload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="790" as="sourcePoint" /><mxPoint x="2840" y="790" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="2.3: plan-dev passes -&gt; triggers plan-qa (pattern environment, D04, D05, D08) with qa.tfvars.example" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="840" as="sourcePoint" /><mxPoint x="960" y="840" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="2.4: plan-qa executes all 4 stacks against Floci emulator in identical dependency order; stores plan-qa artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="890" as="sourcePoint" /><mxPoint x="2840" y="890" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="2.5: Parallel cost job runs Infracost CLI v2: prices qa stacks before and after; uploads cost-qa artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="940" as="sourcePoint" /><mxPoint x="960" y="940" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="2.6: QA promotion complete: outputs plan table &amp; cost delta to Step Summary (auto-promotion ends on push)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="990" as="sourcePoint" /><mxPoint x="570" y="990" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2" value="STACK DEPENDENCY ORDER (PC-IAC-022, docs/cd-pipeline.md):&#10;1. state-backend: S3 remote state bucket, native S3 lockfile, KMS 'state' CMK (Box D02)&#10;2. network: VPC, subnets, route tables, Transit Gateway attachments, CC association (Box D04/D05)&#10;3. security: OIDC pipeline IAM roles, Cognito User Pools (staff/field), KMS CMKs, WAF (Box D06)&#10;4. workload: DynamoDB tables, IoT topic rules, EventBridge pipes, SQS queues, Lambdas (D10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1035" width="920" height="85" as="geometry" /></mxCell><mxCell id="p3" value="PHASE 3: PRODUCTION RUN 1 — CD PLAN, COST DELTA &amp; CHANGE WINDOW VERIFICATION (review-pdn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#78350f;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m11" value="3.1: Requester (JR1/JR2/SR1) dispatches Run 1: gh workflow run &quot;CD promotion&quot; -f promote_to=pdn -f release_note_url=..." style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1890" y="1200" as="sourcePoint" /><mxPoint x="570" y="1200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="3.2: Validates release_note_url is HTTPS link under release-notes/ (ASM-180) or incident_reference override" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1250" as="sourcePoint" /><mxPoint x="570" y="1276" as="targetPoint" /><Array as="points"><mxPoint x="635" y="1250" /><mxPoint x="635" y="1276" /></Array></mxGeometry></mxCell><mxCell id="m13" value="3.3: plan-pdn executes plans for pdn environment across 4 stacks in dependency order: state -&gt; net -&gt; sec -&gt; work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1300" as="sourcePoint" /><mxPoint x="2840" y="1300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="3.4: cost job computes pdn Infracost monthly cost before, after, and delta per stack and in total" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1350" as="sourcePoint" /><mxPoint x="1470" y="1350" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="3.5: review-pdn downloads plan-pdn &amp; cost-pdn artifacts; runs scripts/cd-window-check.sh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="1400" as="sourcePoint" /><mxPoint x="1470" y="1426" as="targetPoint" /><Array as="points"><mxPoint x="1535" y="1400" /><mxPoint x="1535" y="1426" /></Array></mxGeometry></mxCell><mxCell id="m16" value="3.6: Window check: verifies Colombia time (UTC-5) against harvest blackout (05:00-18:00 on HARVEST_WEEK_DATES, ASM-007)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="1450" as="sourcePoint" /><mxPoint x="1470" y="1476" as="targetPoint" /><Array as="points"><mxPoint x="1535" y="1450" /><mxPoint x="1535" y="1476" /></Array></mxGeometry></mxCell><mxCell id="m17" value="3.7: Checks destroys and replacements across all stacks; states totals first in prose (AGENTS.md §7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="1500" as="sourcePoint" /><mxPoint x="1470" y="1526" as="targetPoint" /><Array as="points"><mxPoint x="1535" y="1500" /><mxPoint x="1535" y="1526" /></Array></mxGeometry></mxCell><mxCell id="m18" value="3.8: Computes SHA-256 digest of plan manifest (sha256sum review/plan-pdn/SHA256SUMS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="1550" as="sourcePoint" /><mxPoint x="1470" y="1576" as="targetPoint" /><Array as="points"><mxPoint x="1535" y="1550" /><mxPoint x="1535" y="1576" /></Array></mxGeometry></mxCell><mxCell id="m19" value="3.9: Generates 'How to approve' table with approve_run_id and approve_digest; uploads review-context-pdn (7d)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="1600" as="sourcePoint" /><mxPoint x="1890" y="1600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3" value="HARVEST FREEZE &amp; FEDERATION NOTICE CONTRACT:&#10;• Blackout: 05:00 to 18:00 Colombia time on harvest-week dates (ASM-007, ASM-178); window check covers full execution&#10;• Advance notice to Federation: default 2 business days lead time before standard change (ASM-173, Q-15)&#10;• Incident change: requires incident_reference (INC-YYYYMMDD-NN, ASM-183) to override harvest blackout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="1645" width="920" height="80" as="geometry" /></mxCell><mxCell id="p4" value="PHASE 4: PRODUCTION RUN 2 — MANDATORY FOUR-EYES APPROVAL GATE &amp; EVIDENCE RECORD (ASM-172, PD-020)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#881337;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1755" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m20" value="4.1: Approver (SR1 or SR2 in PDN_APPROVERS, strictly different from Requester) reviews Run 1 summary &amp; cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1890" y="1805" as="sourcePoint" /><mxPoint x="1890" y="1831" as="targetPoint" /><Array as="points"><mxPoint x="1955" y="1805" /><mxPoint x="1955" y="1831" /></Array></mxGeometry></mxCell><mxCell id="m21" value="4.2: Approver dispatches Run 2: gh workflow run &quot;CD promotion&quot; -f approve_run_id=&lt;run-1&gt; -f approve_digest=&lt;digest&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1890" y="1855" as="sourcePoint" /><mxPoint x="570" y="1855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m22" value="4.3: guard job detects approve_run_id set -&gt; enters approval mode: skips plan/cost jobs, runs ONLY pdn-approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1905" as="sourcePoint" /><mxPoint x="2290" y="1905" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m23" value="4.4: pdn-approval executes scripts/cd-verify-approval.sh Step A: verifies approver login is listed in PDN_APPROVERS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="1955" as="sourcePoint" /><mxPoint x="2290" y="1981" as="targetPoint" /><Array as="points"><mxPoint x="2355" y="1955" /><mxPoint x="2355" y="1981" /></Array></mxGeometry></mxCell><mxCell id="m24" value="4.5: Step B - Four-Eyes check: verifies approver != requester, approver != Run 1 actor, approver != Run 1 trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2005" as="sourcePoint" /><mxPoint x="2290" y="2031" as="targetPoint" /><Array as="points"><mxPoint x="2355" y="2005" /><mxPoint x="2355" y="2031" /></Array></mxGeometry></mxCell><mxCell id="m25" value="4.6: Step C - Run validation: verifies Run 1 was 'CD promotion', workflow_dispatch, success, main branch, same commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2055" as="sourcePoint" /><mxPoint x="2290" y="2081" as="targetPoint" /><Array as="points"><mxPoint x="2355" y="2055" /><mxPoint x="2355" y="2081" /></Array></mxGeometry></mxCell><mxCell id="m26" value="4.7: Step D - Plan binding: downloads plan-pdn artifacts, verifies sha256sum matches, compares digest to approve_digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2105" as="sourcePoint" /><mxPoint x="2290" y="2131" as="targetPoint" /><Array as="points"><mxPoint x="2355" y="2105" /><mxPoint x="2355" y="2131" /></Array></mxGeometry></mxCell><mxCell id="m27" value="4.8: Step E - Window re-check: re-executes change window check at approval time (or validates incident reference)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2155" as="sourcePoint" /><mxPoint x="2290" y="2181" as="targetPoint" /><Array as="points"><mxPoint x="2355" y="2155" /><mxPoint x="2355" y="2181" /></Array></mxGeometry></mxCell><mxCell id="m28" value="4.9: Writes immutable approval-record-pdn.json (result, requester, approver, runs, commit, digest, timestamp)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2205" as="sourcePoint" /><mxPoint x="2290" y="2231" as="targetPoint" /><Array as="points"><mxPoint x="2355" y="2205" /><mxPoint x="2355" y="2231" /></Array></mxGeometry></mxCell><mxCell id="m29" value="4.10: Uploads approval-record-pdn artifact (90-day retention) and outputs formal approval record to Job Summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2255" as="sourcePoint" /><mxPoint x="1890" y="2255" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c4" value="TWO-STEP APPROVAL GATE ON GITHUB FREE (PD-020, docs/cd-pipeline.md §1):&#10;• GitHub Free private repo lacks required environment reviewers; two-step workflow approval binds two named humans&#10;• Approver must be listed in repository variable PDN_APPROVERS (SR1/SR2) and differ from Requester (ASM-172)&#10;• Verifies byte-identical plan digest (SHA-256 of SHA256SUMS) and stores approval-record-pdn for 90 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#881337;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="2300" width="940" height="80" as="geometry" /></mxCell><mxCell id="p5" value="PHASE 5: PRODUCTION PROVISIONING EXECUTION (PROPOSED APPLY OF EXACT REVIEWED PLAN, D12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="2410" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m30" value="5.1: Proposed apply step consumes byte-identical approved plan: terraform apply pdn.tfplan (bound by SHA-256 digest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2290" y="2460" as="sourcePoint" /><mxPoint x="2840" y="2460" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m31" value="5.2: Apply Stack 1 - state-backend: provisions S3 remote state bucket, native locking, and KMS 'state' CMK (Box D02)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2840" y="2510" as="sourcePoint" /><mxPoint x="2840" y="2536" as="targetPoint" /><Array as="points"><mxPoint x="2905" y="2510" /><mxPoint x="2905" y="2536" /></Array></mxGeometry></mxCell><mxCell id="m32" value="5.3: Apply Stack 2 - network: provisions VPC, subnets, route tables, Transit Gateway attachments, CC association (Box D04)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2840" y="2560" as="sourcePoint" /><mxPoint x="2840" y="2586" as="targetPoint" /><Array as="points"><mxPoint x="2905" y="2560" /><mxPoint x="2905" y="2586" /></Array></mxGeometry></mxCell><mxCell id="m33" value="5.4: Apply Stack 3 - security: provisions OIDC pipeline IAM roles, Cognito User Pools (staff/field), KMS CMKs, WAF (Box D06)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2840" y="2610" as="sourcePoint" /><mxPoint x="2840" y="2636" as="targetPoint" /><Array as="points"><mxPoint x="2905" y="2610" /><mxPoint x="2905" y="2636" /></Array></mxGeometry></mxCell><mxCell id="m34" value="5.5: Apply Stack 4 - workload: provisions DynamoDB tables, IoT topic rules, EventBridge pipes, Lambdas, Bedrock access (D10)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2840" y="2660" as="sourcePoint" /><mxPoint x="2840" y="2686" as="targetPoint" /><Array as="points"><mxPoint x="2905" y="2660" /><mxPoint x="2905" y="2686" /></Array></mxGeometry></mxCell><mxCell id="m35" value="5.6: Emits deployment event to release topic and CloudWatch: commit, digests, approver, window status, execution time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2840" y="2710" as="sourcePoint" /><mxPoint x="1470" y="2710" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m36" value="5.7: Change owner copies run links and approval record into release-notes/&lt;release_id&gt;.md within 1 business day (ASM-180)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1890" y="2760" as="sourcePoint" /><mxPoint x="270" y="2760" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="PROPOSED PROVISIONING PROCEDURE (docs/cd-pipeline.md §1, ASM-320):&#10;• Academic delivery stops at terraform plan; repository does not execute live cloud apply&#10;• Apply shown above models the production deployment sequence if boundary is lifted by faculty advisor&#10;• Preserves exact stack dependency order: state-backend -&gt; network -&gt; security -&gt; workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#581c87;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="2805" width="960" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>