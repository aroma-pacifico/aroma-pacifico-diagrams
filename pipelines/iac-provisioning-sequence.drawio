<mxfile host="Electron" modified="2026-11-11T00:00:00.000Z" agent="Mozilla/5.0 AromaPacifico" version="32.4.1" type="device"><diagram id="iac-provisioning-sequence" name="IaC CD Provisioning Sequence"><mxGraphModel dx="2400" dy="2925" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="2925" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=none;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="100" as="geometry" /></mxCell><mxCell id="hdr_title" value="AROMA PACÍFICO — IAC CD PROVISIONING SEQUENCE (BRINGING INFRASTRUCTURE UP)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="28" width="1850" height="30" as="geometry" /></mxCell><mxCell id="hdr_subtitle" value="Multi-Environment Promotion, Change-Window &amp; Blackout Verification, Two-Step Human Approval Gate &amp; Ordered Apply" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#bcccdc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="58" width="1850" height="22" as="geometry" /></mxCell><mxCell id="hdr_meta" value="Refs aroma-pacifico/aroma-pacifico-roadmap#38 | Track B Delivery | Normative: docs/cd-pipeline.md, ADR-003, ASM-172, PD-020, ASM-320 | Boxes: D01, D02, D04, D06, D10, D12, D13" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#9fb3c8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="82" width="1850" height="20" as="geometry" /></mxCell><mxCell id="hdr_badge" value="PLAN-ONLY PROMOTION&#10;Proposed Apply Procedure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1910" y="28" width="430" height="84" as="geometry" /></mxCell><mxCell id="icon_ll_trig" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="146" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_trig" value="Main Trunk &amp; Trigger&#10;Push / Workflow Dispatch" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="icon_ll_orch" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="491" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_orch" value="CD Orchestrator&#10;(guard &amp; cd-promotion.yml)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="415" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="icon_ll_devqa" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="836" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_devqa" value="Dev &amp; QA Stages [D12]&#10;plan-dev &amp; plan-qa Stacks" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="icon_ll_win" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="1181" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_win" value="Change Window &amp; Review&#10;(review-pdn, window-check)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1105" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="icon_ll_roles" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_roles" value="Requester &amp; Approver&#10;Four-Eyes Gate (ASM-172)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1450" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="icon_ll_appr" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1871" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_appr" value="Approval Verifier [D13]&#10;pdn-approval (cd-verify)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1795" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="icon_ll_stacks" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2216" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_stacks" value="Infrastructure Stacks&#10;State -&gt; Net -&gt; Sec -&gt; Work" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2140" y="190" width="200" height="2680" as="geometry" /></mxCell><mxCell id="p1" value="PHASE 1: TRIGGER &amp; PROMOTION GUARD EVALUATION (cd-promotion.yml, ASM-320)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e40af;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m1" value="1.1: Merge to main triggers cd-promotion.yml&lt;br&gt;(or manual dispatch with promote_to=dev/qa/pdn)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="378" as="sourcePoint" /><mxPoint x="515" y="378" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m2" value="1.2: guard job runs regex check on commit message &amp; PR title:&lt;br&gt;enforces plan-only pattern (rejects direct deploy, ASM-320)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="430" as="sourcePoint" /><mxPoint x="515" y="456" as="targetPoint" /><Array as="points"><mxPoint x="570" y="430" /><mxPoint x="570" y="456" /></Array></mxGeometry></mxCell><mxCell id="m3" value="1.3: Guard passes: verifies OIDC credentials&lt;br&gt;and outputs environment promotion target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="482" as="sourcePoint" /><mxPoint x="515" y="508" as="targetPoint" /><Array as="points"><mxPoint x="570" y="482" /><mxPoint x="570" y="508" /></Array></mxGeometry></mxCell><mxCell id="c1" value="PLAN-ONLY GUARD CONTRACT (ASM-320, docs/cd-pipeline.md §1):&#10;• Academic DevOps challenge: deployment stops at speculative plan; no live cloud apply or destroy&#10;• Guard job validates commit headers and PR context against plan-only safety regex&#10;• Unattended automatic execution limited to plan-dev and plan-qa; production requires four-eyes human review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="527" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p2" value="PHASE 2: DEV &amp; QA PROMOTION WITH DEPENDENCY-ORDERED SPECULATIVE PLANS (Box D12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="619" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m4" value="2.1: plan-dev executes plans for dev across 4 stacks in dependency order:&lt;br&gt;1. state-backend -&gt; 2. network -&gt; 3. security -&gt; 4. workload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="667" as="sourcePoint" /><mxPoint x="860" y="667" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="2.2: plan-dev plans stacks against Floci emulator&lt;br&gt;in strict dependency order: state -&gt; net -&gt; sec -&gt; work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="719" as="sourcePoint" /><mxPoint x="2240" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m6" value="2.3: Parallel cost job runs Infracost on dev stacks;&lt;br&gt;computes monthly cost impact before and after" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="771" as="sourcePoint" /><mxPoint x="860" y="771" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="2.4: plan-dev passes cleanly -&gt; triggers plan-qa stage&lt;br&gt;with qa.tfvars.example variables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="823" as="sourcePoint" /><mxPoint x="860" y="823" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="2.5: plan-qa executes all 4 stacks against Floci emulator&lt;br&gt;in identical dependency order; stores plan-qa artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="875" as="sourcePoint" /><mxPoint x="2240" y="875" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="2.6: Parallel cost job prices qa stacks before and after;&lt;br&gt;uploads cost-qa artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="927" as="sourcePoint" /><mxPoint x="860" y="927" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="2.7: QA promotion complete: outputs plan table &amp; cost delta&lt;br&gt;to Step Summary (auto-promotion ends on push)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="979" as="sourcePoint" /><mxPoint x="515" y="979" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2" value="STACK DEPENDENCY ORDER (PC-IAC-022, docs/cd-pipeline.md):&#10;1. state-backend: S3 remote state bucket, native S3 lockfile, KMS 'state' CMK (Box D02)&#10;2. network: VPC, subnets, route tables, Transit Gateway attachments, CC association (Box D04/D05)&#10;3. security: OIDC pipeline IAM roles, Cognito User Pools (staff/field), KMS CMKs, WAF (Box D06)&#10;4. workload: DynamoDB tables, IoT topic rules, EventBridge pipes, SQS queues, Lambdas (D10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1024" width="2200" height="80" as="geometry" /></mxCell><mxCell id="p3" value="PHASE 3: PRODUCTION RUN 1 — CD PLAN, COST DELTA &amp; CHANGE WINDOW VERIFICATION (review-pdn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#78350f;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1122" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m11" value="3.1: Requester (JR1/JR2/SR1) dispatches Run 1:&lt;br&gt;gh workflow run &quot;CD promotion&quot; -f promote_to=pdn -f release_note_url=..." style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1170" as="sourcePoint" /><mxPoint x="515" y="1170" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="3.2: Validates release_note_url is HTTPS link under release-notes/&lt;br&gt;(ASM-180) or incident_reference override" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1222" as="sourcePoint" /><mxPoint x="515" y="1248" as="targetPoint" /><Array as="points"><mxPoint x="570" y="1222" /><mxPoint x="570" y="1248" /></Array></mxGeometry></mxCell><mxCell id="m13" value="3.3: plan-pdn executes plans for pdn environment across 4 stacks&lt;br&gt;in dependency order: state -&gt; net -&gt; sec -&gt; work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1274" as="sourcePoint" /><mxPoint x="2240" y="1274" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="3.4: cost job computes pdn Infracost monthly cost&lt;br&gt;before, after, and delta per stack and in total" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1326" as="sourcePoint" /><mxPoint x="1205" y="1326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="3.5: review-pdn downloads plan-pdn &amp; cost-pdn artifacts;&lt;br&gt;runs bash scripts/cd-window-check.sh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1378" as="sourcePoint" /><mxPoint x="1205" y="1404" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1378" /><mxPoint x="1260" y="1404" /></Array></mxGeometry></mxCell><mxCell id="m16" value="3.6: Window check: verifies Colombia time (UTC-5) against&lt;br&gt;harvest blackout (05:00-18:00 on harvest dates, ASM-007)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1430" as="sourcePoint" /><mxPoint x="1205" y="1456" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1430" /><mxPoint x="1260" y="1456" /></Array></mxGeometry></mxCell><mxCell id="m17" value="3.7: Checks destroys and replacements across all stacks;&lt;br&gt;states totals first in prose (AGENTS.md §7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1482" as="sourcePoint" /><mxPoint x="1205" y="1508" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1482" /><mxPoint x="1260" y="1508" /></Array></mxGeometry></mxCell><mxCell id="m18" value="3.8: Computes SHA-256 digest of plan manifest&lt;br&gt;(sha256sum review/plan-pdn/SHA256SUMS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#92400e;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1534" as="sourcePoint" /><mxPoint x="1205" y="1560" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1534" /><mxPoint x="1260" y="1560" /></Array></mxGeometry></mxCell><mxCell id="m19" value="3.9: Generates 'How to approve' table with approve_run_id&lt;br&gt;and approve_digest; uploads review-context-pdn (7d)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1586" as="sourcePoint" /><mxPoint x="1550" y="1586" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3" value="HARVEST FREEZE &amp; FEDERATION NOTICE CONTRACT:&#10;• Blackout: 05:00 to 18:00 Colombia time on harvest-week dates (ASM-007, ASM-178); window check covers full execution&#10;• Advance notice to Federation: default 2 business days lead time before standard change (ASM-173, Q-15)&#10;• Incident change: requires incident_reference (INC-YYYYMMDD-NN, ASM-183) to override harvest blackout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1631" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p4" value="PHASE 4: PRODUCTION RUN 2 — MANDATORY FOUR-EYES APPROVAL GATE &amp; EVIDENCE RECORD (ASM-172, PD-020)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#881337;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1723" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m20" value="4.1: Approver (SR1 or SR2 in PDN_APPROVERS, strictly different&lt;br&gt;from Requester) reviews Run 1 summary &amp; cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1771" as="sourcePoint" /><mxPoint x="1550" y="1797" as="targetPoint" /><Array as="points"><mxPoint x="1605" y="1771" /><mxPoint x="1605" y="1797" /></Array></mxGeometry></mxCell><mxCell id="m21" value="4.2: Approver dispatches Run 2: gh workflow run &quot;CD promotion&quot;&lt;br&gt;-f approve_run_id=RUN_1_ID -f approve_digest=SHA256_DIGEST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1823" as="sourcePoint" /><mxPoint x="515" y="1823" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m22" value="4.3: guard job detects approve_run_id set -&gt; enters approval mode:&lt;br&gt;skips plan/cost jobs, runs ONLY pdn-approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1875" as="sourcePoint" /><mxPoint x="1895" y="1875" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m23" value="4.4: pdn-approval executes scripts/cd-verify-approval.sh Step A:&lt;br&gt;verifies approver login is listed in PDN_APPROVERS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1927" as="sourcePoint" /><mxPoint x="1895" y="1953" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="1927" /><mxPoint x="1840" y="1953" /></Array></mxGeometry></mxCell><mxCell id="m24" value="4.5: Step B - Four-Eyes check: verifies approver != requester,&lt;br&gt;approver != Run 1 actor, approver != Run 1 trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1979" as="sourcePoint" /><mxPoint x="1895" y="2005" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="1979" /><mxPoint x="1840" y="2005" /></Array></mxGeometry></mxCell><mxCell id="m25" value="4.6: Step C - Run validation: verifies Run 1 was 'CD promotion',&lt;br&gt;workflow_dispatch, success, main branch, same commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2031" as="sourcePoint" /><mxPoint x="1895" y="2057" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2031" /><mxPoint x="1840" y="2057" /></Array></mxGeometry></mxCell><mxCell id="m26" value="4.7: Step D - Plan binding: downloads plan-pdn artifacts, verifies&lt;br&gt;sha256sum matches, compares digest to approve_digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2083" as="sourcePoint" /><mxPoint x="1895" y="2109" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2083" /><mxPoint x="1840" y="2109" /></Array></mxGeometry></mxCell><mxCell id="m27" value="4.8: Step E - Window re-check: re-executes change window check&lt;br&gt;at approval time (or validates incident reference)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2135" as="sourcePoint" /><mxPoint x="1895" y="2161" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2135" /><mxPoint x="1840" y="2161" /></Array></mxGeometry></mxCell><mxCell id="m28" value="4.9: Writes immutable approval-record-pdn.json&lt;br&gt;(result, requester, approver, runs, commit, digest, timestamp)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2187" as="sourcePoint" /><mxPoint x="1895" y="2213" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2187" /><mxPoint x="1840" y="2213" /></Array></mxGeometry></mxCell><mxCell id="m29" value="4.10: Uploads approval-record-pdn artifact (90-day retention)&lt;br&gt;and outputs formal approval record to Job Summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2239" as="sourcePoint" /><mxPoint x="1550" y="2239" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c4" value="TWO-STEP APPROVAL GATE ON GITHUB FREE (PD-020, docs/cd-pipeline.md §1):&#10;• GitHub Free private repo lacks required environment reviewers; two-step workflow approval binds two named humans&#10;• Approver must be listed in repository variable PDN_APPROVERS (SR1/SR2) and differ from Requester (ASM-172)&#10;• Verifies byte-identical plan digest (SHA-256 of SHA256SUMS) and stores approval-record-pdn for 90 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#881337;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="2284" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p5" value="PHASE 5: PRODUCTION PROVISIONING EXECUTION (PROPOSED APPLY OF EXACT REVIEWED PLAN, D12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="2376" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m30" value="5.1: Proposed apply step consumes byte-identical approved plan:&lt;br&gt;terraform apply pdn.tfplan (bound by SHA-256 digest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2424" as="sourcePoint" /><mxPoint x="2240" y="2424" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m31" value="5.2: Apply Stack 1 - state-backend: provisions S3 remote state&lt;br&gt;bucket, native locking, and KMS 'state' CMK (Box D02)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2476" as="sourcePoint" /><mxPoint x="2240" y="2502" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2476" /><mxPoint x="2185" y="2502" /></Array></mxGeometry></mxCell><mxCell id="m32" value="5.3: Apply Stack 2 - network: provisions VPC, subnets, route tables,&lt;br&gt;Transit Gateway attachments, CC association (Box D04)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2528" as="sourcePoint" /><mxPoint x="2240" y="2554" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2528" /><mxPoint x="2185" y="2554" /></Array></mxGeometry></mxCell><mxCell id="m33" value="5.4: Apply Stack 3 - security: provisions OIDC pipeline IAM roles,&lt;br&gt;Cognito User Pools (staff/field), KMS CMKs, WAF (Box D06)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2580" as="sourcePoint" /><mxPoint x="2240" y="2606" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2580" /><mxPoint x="2185" y="2606" /></Array></mxGeometry></mxCell><mxCell id="m34" value="5.5: Apply Stack 4 - workload: provisions DynamoDB tables, IoT topic&lt;br&gt;rules, EventBridge pipes, Lambdas, Bedrock access (D10)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2632" as="sourcePoint" /><mxPoint x="2240" y="2658" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2632" /><mxPoint x="2185" y="2658" /></Array></mxGeometry></mxCell><mxCell id="m35" value="5.6: Emits deployment event to release topic and CloudWatch:&lt;br&gt;commit, digests, approver, window status, execution time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2684" as="sourcePoint" /><mxPoint x="1205" y="2684" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m36" value="5.7: Change owner copies run links and approval record into&lt;br&gt;release-notes/RELEASE_ID.md within 1 business day (ASM-180)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2736" as="sourcePoint" /><mxPoint x="170" y="2736" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="PROPOSED PROVISIONING PROCEDURE (docs/cd-pipeline.md §1, ASM-320):&#10;• Academic delivery stops at terraform plan; repository does not execute live cloud apply&#10;• Apply shown above models the production deployment sequence if boundary is lifted by faculty advisor&#10;• Preserves exact stack dependency order: state-backend -&gt; network -&gt; security -&gt; workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#581c87;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="2781" width="2200" height="74" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>