          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t3_t4" value="Strong Read&lt;br/&gt;&amp;amp; Thresholds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t3" target="card_t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t4_t5" value="Alert Raised&lt;br/&gt;Notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t4" target="card_t5">
