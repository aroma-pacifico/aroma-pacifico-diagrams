        <mxCell id="t_ff" value="Flight-Object Failure Handling, Quarantine &amp; Dead-Letter Queues" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="750" y="1250" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_ff" value="&lt;b&gt;S3 Integrity Failure:&lt;/b&gt; SHA-256 mismatch or truncated upload causes immediate HTTP 400 rejection; mobile app notifies pilot to re-upload.&lt;br/&gt;&lt;b&gt;Quarantine Storage:&lt;/b&gt; Corrupt GeoTIFF rasters or out-of-boundary flight coordinates moved to S3 &lt;i&gt;quarantine/&lt;/i&gt; prefix for forensic analysis.&lt;br/&gt;&lt;b&gt;Dead-Letter Queue:&lt;/b&gt; Unhandled screening or Bedrock invocation timeouts routed to SQS DLQ &lt;i&gt;aroma-drone-reception-dlq&lt;/i&gt; with CloudWatch Alarm.&lt;br/&gt;&lt;b&gt;Agronomist Re-Scan Notice:&lt;/b&gt; Pilot dashboard updated with failure reason (e.g., lens occlusion, excessive cloud shadow, corrupted band)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#7f1d1d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="610" y="1295" width="1970" height="105" as="geometry" />
