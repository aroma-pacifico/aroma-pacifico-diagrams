        <mxCell id="card_t1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="180" width="430" height="360" as="geometry" />
        </mxCell>
        <mxCell id="t_t1" value="Field IoT Sensor Nodes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="195" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t1" value="&lt;b&gt;Origin &amp;amp; Coverage&lt;/b&gt;&lt;br/&gt;• Coffee producer plots in Cauca, Huila, Tolima&lt;br/&gt;• LoRaWAN gateways &amp;amp; cellular telemetry stations&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Telemetry Payload&lt;/b&gt;&lt;br/&gt;• Soil moisture (depth 10cm, 30cm), temperature&lt;br/&gt;• Ambient relative humidity, leaf wetness sensor&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Security &amp;amp; Transport&lt;/b&gt;&lt;br/&gt;• MQTT over TLS 1.3 with X.509 device certificates&lt;br/&gt;• 15-minute periodic heartbeat &amp;amp; batch telemetry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="240" width="390" height="280" as="geometry" />
        </mxCell>
        <mxCell id="e_t1_t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_t1" target="card_t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_t1_t2" value="mTLS MQTT&lt;br/&gt;Publish" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="495" y="300" width="95" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_t2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="430" height="360" as="geometry" />
        </mxCell>
        <mxCell id="icon_iot" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="610" y="195" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t2" value="AWS IoT Core [D09]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="660" y="195" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_t2" value="&lt;b&gt;Message Broker &amp;amp; Ingress&lt;/b&gt;&lt;br/&gt;• Mutual TLS authentication via AWS IoT Core&lt;br/&gt;• Topic: &lt;i&gt;aroma/{farm_id}/telemetry&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IoT Topic Rule [D09]&lt;/b&gt;&lt;br/&gt;• SQL query: &lt;i&gt;SELECT * FROM &apos;aroma/+/telemetry&apos;&lt;/i&gt;&lt;br/&gt;• Direct PutItem action into Amazon DynamoDB&lt;br/&gt;• Zero compute overhead: eliminates Lambda hop&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Failure Path&lt;/b&gt;&lt;br/&gt;• Error action dispatches corrupt payload to SQS DLQ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="610" y="245" width="390" height="280" as="geometry" />
        </mxCell>
        <mxCell id="e_t2_t3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_t2" target="card_t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_t2_t3" value="Direct PutItem&lt;br/&gt;Rule Action" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_t3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1110" y="180" width="450" height="360" as="geometry" />
        </mxCell>
        <mxCell id="icon_ddb" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1130" y="195" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_t3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1175" y="195" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t3" value="DynamoDB Telemetry [D09]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1225" y="195" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_t3" value="&lt;b&gt;Storage Architecture&lt;/b&gt;&lt;br/&gt;• Table: &lt;i&gt;aroma-telemetry-{env}&lt;/i&gt;&lt;br/&gt;• Partition Key: &lt;i&gt;farm_id#sensor_id&lt;/i&gt; (String)&lt;br/&gt;• Sort Key: &lt;i&gt;timestamp&lt;/i&gt; (ISO-8601 String)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Security &amp;amp; Change Stream&lt;/b&gt;&lt;br/&gt;• KMS CMK encryption at rest with annual rotation&lt;br/&gt;• DynamoDB Streams enabled: &lt;i&gt;NEW_IMAGE&lt;/i&gt; capture&lt;br/&gt;• Sub-millisecond write latency for high volume feeds" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1130" y="245" width="410" height="280" as="geometry" />
        </mxCell>
        <mxCell id="e_t3_t4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_t3" target="card_t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_t3_t4" value="DynamoDB&lt;br/&gt;Streams Event" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="1560" y="300" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_t4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1660" y="180" width="450" height="360" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_t4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1680" y="195" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t4" value="Ingestion Processor [D06]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1730" y="195" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_t4" value="&lt;b&gt;Stream Processor Logic&lt;/b&gt;&lt;br/&gt;• EventSourceMapping consumes DynamoDB Stream&lt;br/&gt;• Batch size: 100 records with 5s batch window&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Agronomic Rules Engine&lt;/b&gt;&lt;br/&gt;• Frost hazard detection (&amp;lt;4°C threshold)&lt;br/&gt;• Severe soil moisture deficit &amp;amp; flood warning&lt;br/&gt;• Windowed deduplication suppresses duplicate alerts&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Canary Rollout Policy [D11]&lt;/b&gt;&lt;br/&gt;• Deployed via CodeDeploy canary traffic shift" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1680" y="245" width="410" height="280" as="geometry" />
        </mxCell>
        <mxCell id="e_t4_t5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_t4" target="card_t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_t4_t5" value="Publish Alert&lt;br/&gt;Event" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
