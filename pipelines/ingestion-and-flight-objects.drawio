<mxfile host="Electron">
  <diagram id="ingestion-and-flight-objects" name="Telemetry Ingestion and Flight-Object Reception Pipelines">
    <mxGraphModel dx="2600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Telemetry Ingestion and Flight-Object Reception Pipelines" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Left-to-right processing flows: field sensor telemetry ingestion (D08, D09, D10) and drone flight-object reception (D10) with validation, storage, and failure paths." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="72" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_telemetry" value="TELEMETRY INGESTION PIPELINE (IoT Core to DynamoDB &amp; Agronomic Alerting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="2580" height="570" as="geometry" />
        </mxCell>
        <mxCell id="card_t1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="t_t1" value="Field IoT Sensor Nodes [D08]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t1" value="&lt;b&gt;Coverage &amp;amp; Nodes (connectivity.md, ASM-070)&lt;/b&gt;&lt;br/&gt;• 200 farms in Cauca, Huila, Tolima; 2 nodes per farm&lt;br/&gt;• Moisture (10/30cm), temp, RH, and NPK readings&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Transport &amp;amp; Buffer&lt;/b&gt;&lt;br/&gt;• Cellular LPWA (LTE-M/NB-IoT), MQTT over TLS 1.2+ (port 8883)&lt;br/&gt;• Mutual X.509 cert authentication; 24h offline buffer&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Alert Budget&lt;/b&gt;&lt;br/&gt;• &amp;lt; 5 min delivery budget for live readings (ASM-075)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_iot" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="615" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t2" value="AWS IoT Core [D09]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="665" y="185" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t2" value="&lt;b&gt;Ingress &amp;amp; Broker&lt;/b&gt;&lt;br/&gt;• AWS IoT Core in us-east-1 with mutual X.509 mTLS&lt;br/&gt;• Scoped topic: &lt;i&gt;aroma/{farm_id}/telemetry&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Topic Rule Actions (ADR-003, ASM-161)&lt;/b&gt;&lt;br/&gt;• SQL: &lt;i&gt;SELECT * FROM &apos;aroma/+/telemetry&apos;&lt;/i&gt;&lt;br/&gt;• Action 1: Direct PutItem to DynamoDB &lt;i&gt;telemetry&lt;/i&gt; table&lt;br/&gt;• Action 2: SQS message action to &lt;i&gt;infthresholdqueue&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Error Handling&lt;/b&gt;&lt;br/&gt;• Rule error action routes to SQS DLQ after 5 attempts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_ddb" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1145" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_t3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1190" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t3" value="DynamoDB Stores [D09]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1240" y="185" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t3" value="&lt;b&gt;Telemetry Table (ADR-003, farm-monitoring.md)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;telemetry&lt;/i&gt; table (PK: node_id, SK: timestamp)&lt;br/&gt;• KMS CMK encrypted (&lt;i&gt;telemetry&lt;/i&gt; key class); 5-year TTL&lt;br/&gt;• Strongly consistent reads for evaluation (ASM-161)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Thresholds Table (sec 4)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;thresholds&lt;/i&gt; table with versioned Federation ranges&lt;br/&gt;• Farm-specific scope evaluated first, then pilot scope" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1145" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_t4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1675" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t4" value="Threshold Lambda [D10]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1725" y="185" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t4" value="&lt;b&gt;SQS Trigger &amp;amp; Config (ASM-161, ASM-162)&lt;/b&gt;&lt;br/&gt;• Queue &lt;i&gt;infthresholdqueue&lt;/i&gt;, batch size 10 (ASM-162)&lt;br/&gt;• 60s timeout, 256MB memory, reserved concurrency 10&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Evaluation Logic (farm-monitoring.md sec 5)&lt;/b&gt;&lt;br/&gt;• Strongly consistent read from DynamoDB &lt;i&gt;telemetry&lt;/i&gt;&lt;br/&gt;• Evaluates reading against active Federation thresholds&lt;br/&gt;• Thresholds are Federation data, never hardcoded in SQL&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Alerting &amp;amp; Canary (ASM-174)&lt;/b&gt;&lt;br/&gt;• Out of range: writes &lt;i&gt;crop_alert_raised&lt;/i&gt; and emits to SNS&lt;br/&gt;• Deployed via CodeDeploy canary: 10% 5 min (ASM-174)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2185" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_sns" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="2205" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="2250" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t5" value="Alert Dispatch &amp; SNS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="2300" y="185" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t5" value="&lt;b&gt;Farmer Notification (ASM-075, farm-monitoring.md)&lt;/b&gt;&lt;br/&gt;• SNS alert topic (&lt;i&gt;alerts&lt;/i&gt; key class, ASM-097)&lt;br/&gt;• Dual dispatch: Push &amp;amp; SMS delivered &amp;lt; 5 min&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Case Management (sec 5.1)&lt;/b&gt;&lt;br/&gt;• Links alert to plot pest case; switches to precision mode&lt;br/&gt;• Pilot-wide observation metrics emitted to CloudWatch" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2205" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="e_t1_t2" value="mTLS MQTT&lt;br/&gt;Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t1" target="card_t2">
          <mxGeometry relative="1" as="geometry" />
