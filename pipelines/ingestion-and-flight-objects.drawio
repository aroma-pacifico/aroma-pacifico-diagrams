<mxfile host="Electron">
  <diagram id="ingestion-and-flight-objects" name="Telemetry Ingestion and Flight-Object Reception Pipelines">
    <mxGraphModel dx="2600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Telemetry Ingestion and Flight-Object Reception Pipelines" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Left-to-right processing flows: field sensor telemetry ingestion (D08, D09, D10) and drone flight-object reception (D04, D06, D10) with validation, storage, and failure paths." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="72" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_telemetry" value="TELEMETRY INGESTION PIPELINE (IoT Core to DynamoDB &amp; Agronomic Alerting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="2580" height="570" as="geometry" />
        </mxCell>
        <mxCell id="card_t1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="t_t1" value="Field IoT Sensor Nodes [D08]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="185" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t1" value="&lt;b&gt;Origin &amp;amp; Coverage (connectivity.md)&lt;/b&gt;&lt;br/&gt;• 200 coffee farms in Cauca, Huila, Tolima (2 nodes/farm, ASM-070)&lt;br/&gt;• Cellular LPWA radio (LTE-M/NB-IoT, satellite dual-mode)&lt;br/&gt;• No gateway, mast, repeater or wired link installed (A10 sec 4.1)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Telemetry Payload &amp;amp; Cadence&lt;/b&gt;&lt;br/&gt;• Soil moisture (10cm, 30cm), soil temp, air temp/humidity, NPK&lt;br/&gt;• Node publishes every reading as taken; no persistent session&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Transport &amp;amp; Buffer (connectivity.md)&lt;/b&gt;&lt;br/&gt;• MQTT over TLS 1.2 or later with mutual X.509 cert auth&lt;br/&gt;• QoS 1, port 8883 (port 443 with ALPN fallback)&lt;br/&gt;• Up to 24h encrypted non-volatile store-and-forward buffer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_iot" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="615" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t2" value="AWS IoT Core [D09]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="665" y="185" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t2" value="&lt;b&gt;Ingress &amp;amp; Authentication&lt;/b&gt;&lt;br/&gt;• Regional endpoint in us-east-1, mutual TLS with X.509&lt;br/&gt;• Node policy restricts publish to &lt;i&gt;aroma/{farm_id}/telemetry&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IoT Topic Rule Actions (ADR-003, ASM-161)&lt;/b&gt;&lt;br/&gt;• SQL rule: &lt;i&gt;SELECT * FROM &apos;aroma/+/telemetry&apos;&lt;/i&gt;&lt;br/&gt;• Action 1: PutItem directly into DynamoDB telemetry table&lt;br/&gt;• Action 2: SQS message action to threshold evaluation queue&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Rule Error Action (ASM-161, ASM-162)&lt;/b&gt;&lt;br/&gt;• Error action routes failed payloads to IoT Rule SQS DLQ&lt;br/&gt;• Retries up to 5 attempts before DLQ routing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C925D1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_ddb" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1145" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_t3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1190" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t3" value="DynamoDB Stores [D09]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1240" y="185" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t3" value="&lt;b&gt;Telemetry Table (ADR-003, farm-monitoring.md)&lt;/b&gt;&lt;br/&gt;• Table: &lt;i&gt;telemetry&lt;/i&gt; keyed by node_id and reading_timestamp&lt;br/&gt;• Encrypted with KMS CMK (&lt;i&gt;telemetry&lt;/i&gt; key class, ASM-097)&lt;br/&gt;• 5-year retention by TTL; strongly consistent reads (ASM-161)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Thresholds Table (farm-monitoring.md sec 4)&lt;/b&gt;&lt;br/&gt;• Table: &lt;i&gt;thresholds&lt;/i&gt; in workload account, KMS CMK encrypted&lt;br/&gt;• Federation data: Partition key &lt;i&gt;rule_key&lt;/i&gt;, sort key &lt;i&gt;effective_from&lt;/i&gt;&lt;br/&gt;• Versioned &amp;amp; audited: reason, Federation reference, operator ID&lt;br/&gt;• Farm scope override evaluated first, fallback to pilot scope" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1145" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_t4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1675" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t4" value="Threshold Lambda [D10]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1725" y="185" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t4" value="&lt;b&gt;SQS Queue Trigger (ASM-161, ASM-162)&lt;/b&gt;&lt;br/&gt;• Triggered by threshold SQS queue, batch size 10 (ASM-162)&lt;br/&gt;• Function: 60s timeout, 256MB, reserved concurrency 10&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Evaluation Logic (farm-monitoring.md sec 5)&lt;/b&gt;&lt;br/&gt;• Strongly consistent read of reading from DynamoDB telemetry&lt;br/&gt;• Evaluates reading against active Federation thresholds&lt;br/&gt;• Thresholds are Federation data, never hardcoded in rule SQL&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Alert Generation &amp;amp; Deployment [D11]&lt;/b&gt;&lt;br/&gt;• If out of range: persists &lt;i&gt;crop_alert_raised&lt;/i&gt; and emits to SNS&lt;br/&gt;• Deployed via CodeDeploy canary (10% 5 min, D11)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_t5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2185" y="170" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_sns" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="2205" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="2250" y="182" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t5" value="Alert Dispatch &amp; SNS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="2300" y="185" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_t5" value="&lt;b&gt;Farmer Notification (ASM-075, farm-monitoring.md)&lt;/b&gt;&lt;br/&gt;• SNS alert topic (&lt;i&gt;alerts&lt;/i&gt; key class, ASM-097)&lt;br/&gt;• Push notification &amp;amp; SMS sent to farmer phone&lt;br/&gt;• Design target: Alert delivery under 5 minutes (ASM-075)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Case Management &amp;amp; Observation&lt;/b&gt;&lt;br/&gt;• Opens or updates agronomic case in DynamoDB (section 5.1)&lt;br/&gt;• Agronomist portal reads cases and alerts by department&lt;br/&gt;• Pilot-wide observation metrics emitted to CloudWatch" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2205" y="225" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="e_t1_t2" value="mTLS MQTT&lt;br/&gt;Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t1" target="card_t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t2_t3" value="Direct PutItem&lt;br/&gt;Rule Action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t2" target="card_t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t3_t4" value="Strong Read&lt;br/&gt;&amp;amp; Thresholds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t3" target="card_t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t4_t5" value="Alert Raised&lt;br/&gt;Notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_t4" target="card_t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="card_tf1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="550" width="480" height="125" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_tf1" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="615" y="562" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t_tf1" value="IoT Topic Rule SQS DLQ (ASM-161)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="655" y="562" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b_tf1" value="• Error action for malformed MQTT payload or DynamoDB PutItem failure&lt;br/&gt;• Retries up to 5 attempts before routing to DLQ (ASM-162)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#7f1d1d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="598" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_t2_tf1" value="Rule error (5 attempts)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#dc2626;labelBackgroundColor=#fef2f2;spacing=4;" edge="1" parent="1" source="card_t2" target="card_tf1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="card_tf2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="550" width="480" height="125" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_tf2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="1675" y="562" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="icon_cw_tf2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1712" y="562" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t_tf2" value="Threshold Function DLQ (ASM-162)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="1750" y="562" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b_tf2" value="• 14-day retention SQS DLQ (&lt;i&gt;infthresholddlq&lt;/i&gt;) on 5 retries exhausted&lt;br/&gt;• CloudWatch alarm &lt;i&gt;&amp;lt;prefix&amp;gt;-pdn-alarm-infthresholddlq&lt;/i&gt; armed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#7f1d1d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="598" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_t4_tf2" value="5 retries exhausted (DLQ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#dc2626;labelBackgroundColor=#fef2f2;spacing=4;" edge="1" parent="1" source="card_t4" target="card_tf2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_flight" value="FLIGHT-OBJECT RECEPTION PIPELINE (Drone Imagery to Bedrock AI Analysis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="2580" height="570" as="geometry" />
        </mxCell>
        <mxCell id="card_f1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="t_f1" value="Drone / Ground Station" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="785" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f1" value="&lt;b&gt;Flight Missions (ADR-002, drone-service.md)&lt;/b&gt;&lt;br/&gt;• Combined mode: Area delimitation/estimation &amp;amp; precision confirmation/verification&lt;br/&gt;• Certified operator pilot; photos, track, maps, polygons, flight record&lt;br/&gt;&lt;br/&gt;&lt;b&gt;On-Device Person Screen (ASM-164)&lt;/b&gt;&lt;br/&gt;• Ground station runs on-device person detector prior to upload&lt;br/&gt;• Manifest records &lt;i&gt;person_screen&lt;/i&gt;: &lt;i&gt;clear&lt;/i&gt; or &lt;i&gt;person_present&lt;/i&gt;&lt;br/&gt;• Zero cloud person detectors used; protects privacy cryptographically&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Authentication &amp;amp; Buffer (drone-service.md sec 7)&lt;/b&gt;&lt;br/&gt;• Pilot authenticates via Cognito &lt;i&gt;staff&lt;/i&gt; pool with MFA&lt;br/&gt;• Local buffer retained until signed receipt received from platform" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3_f2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="615" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_f2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="660" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f2" value="S3 Drone Ingress [D04]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="710" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f2" value="&lt;b&gt;Object Storage Target (drone-service.md sec 7)&lt;/b&gt;&lt;br/&gt;• Workload S3 bucket with mission-prefixed keys&lt;br/&gt;• Direct upload via time-limited Pre-signed URL from upload grant&lt;br/&gt;• S3 verifies SHA-256 header checksum on upload (HTTP 400 on error)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Encryption &amp;amp; 5-Year Lifecycle (ASM-097, drone-service.md line 197)&lt;/b&gt;&lt;br/&gt;• Server-Side Encryption with KMS CMK (&lt;i&gt;drone&lt;/i&gt; key class)&lt;br/&gt;• 5-year retention enforced by S3 lifecycle rules&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Person Screening &amp;amp; Quarantine Prefix (ASM-165)&lt;/b&gt;&lt;br/&gt;• Objects with &lt;i&gt;person_present&lt;/i&gt; moved to &lt;i&gt;restricted/person/&lt;/i&gt;&lt;br/&gt;• Encrypted under 8th KMS key class &lt;i&gt;restricted&lt;/i&gt; (no function access)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_f3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1145" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_ddb_f3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1190" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f3" value="Reception &amp; Pipe [D06]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1240" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f3" value="&lt;b&gt;Manifest Validation &amp;amp; Receipt (drone-service.md sec 7)&lt;/b&gt;&lt;br/&gt;• Reception Lambda validates manifest, checksums, and flight record&lt;br/&gt;• Writes mission item to DynamoDB &lt;i&gt;missions&lt;/i&gt; table (status: &lt;i&gt;record_persisted&lt;/i&gt;)&lt;br/&gt;• Returns receipt to ground station to release local mission buffer&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Event Routing to Inference (ASM-161)&lt;/b&gt;&lt;br/&gt;• DynamoDB Stream captures changes into &lt;i&gt;record_persisted&lt;/i&gt;&lt;br/&gt;• EventBridge Pipe filters for &lt;i&gt;record_persisted&lt;/i&gt; to drone event bus&lt;br/&gt;• EventBridge rules dispatch to dedicated SQS queue per mission type&lt;br/&gt;• Lambda event source mapping reads with batch size 1 (ASM-161)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1145" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_bedrock_f4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1675" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_eb_f4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="1720" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f4" value="Bedrock Inference [D10]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1770" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f4" value="&lt;b&gt;Managed Foundation Model (ASM-160, architecture.md Part E)&lt;/b&gt;&lt;br/&gt;• Amazon Bedrock invoked on-demand in us-east-1&lt;br/&gt;• Vision-capable model, initially Amazon Nova Pro (foundation-model ID)&lt;br/&gt;• Zero-shot prompts &amp;amp; JSON schemas kept as versioned configuration&lt;br/&gt;• Zero training, fine-tuning, or persistent compute (ASM-160)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Confidence &amp;amp; Result Persistence (ASM-160, ASM-163)&lt;/b&gt;&lt;br/&gt;• Returns uncalibrated confidence score; threshold &amp;gt;= 0.70 (ASM-163)&lt;br/&gt;• Output stored in DynamoDB with timestamp, confidence, object key&lt;br/&gt;• Never authorizes fumigation or closure directly (ADR-002)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E7157B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2185" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_sns_f5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="2205" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_ddb_f5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="2250" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f5" value="Agronomist Sign-Off" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="2300" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f5" value="&lt;b&gt;Human-in-the-Loop Authorization (ADR-002)&lt;/b&gt;&lt;br/&gt;• Federation agronomist reviews AI confidence score and source photos&lt;br/&gt;• Agronomist authorizes fumigation prescription as human with MFA&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Order &amp;amp; Case Progression&lt;/b&gt;&lt;br/&gt;• Updates case to &lt;i&gt;focus_confirmed&lt;/i&gt; and emits fumigation order&lt;br/&gt;• Verification flight closes case and mission order upon agronomist sign-off&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Traceability &amp;amp; Origin Audit&lt;/b&gt;&lt;br/&gt;• Audit record tied to coffee parcel origin for port delivery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2205" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="e_f1_f2" value="Pre-signed PUT&lt;br/&gt;SHA-256 Check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#0369a1;labelBackgroundColor=#ffffff;spacing=6;" edge="1" parent="1" source="card_f1" target="card_f2">
