        <mxCell id="icon_sqs" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="2275" y="195" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_t5" value="Alert Dispatch &amp; SQS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="2325" y="195" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_t5" value="&lt;b&gt;Notification Channels&lt;/b&gt;&lt;br/&gt;• SNS topic: &lt;i&gt;aroma-agronomic-alerts&lt;/i&gt;&lt;br/&gt;• Agronomist mobile push notifications &amp;amp; SMS&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Analytics Queue&lt;/b&gt;&lt;br/&gt;• SQS queue for analytical rollups and historical audit&lt;br/&gt;• CloudWatch metric publishing for farm-level telemetry&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Federation Reporting&lt;/b&gt;&lt;br/&gt;• Anonymized regional climate trends published" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2230" y="245" width="350" height="280" as="geometry" />
        </mxCell>
        <mxCell id="card_tf" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="565" width="2010" height="165" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_tf" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="610" y="580" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_cw_tf" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="655" y="580" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_tf" value="Telemetry Failure Paths, Dead-Letter Queues &amp; Recovery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="705" y="580" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_tf" value="&lt;b&gt;IoT Core Error Action:&lt;/b&gt; Invalid MQTT payload or unparseable JSON routed to SQS DLQ &lt;i&gt;aroma-iot-dlq&lt;/i&gt; (zero silent message drops).&lt;br/&gt;&lt;b&gt;Lambda Stream Failure:&lt;/b&gt; On-failure destination routes poison pills to SQS DLQ after 3 retries with &lt;i&gt;BisectBatchOnFunctionError&lt;/i&gt; enabled.&lt;br/&gt;&lt;b&gt;CloudWatch Alarms:&lt;/b&gt; &lt;i&gt;TelemetryDLQMessagesVisible &amp;gt; 0&lt;/i&gt; alerts DevOps on-call; &lt;i&gt;SensorSilent &amp;gt; 60m&lt;/i&gt; flags hardware disconnection." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#7f1d1d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="610" y="625" width="1970" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e_t2_tf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="card_t2" target="card_tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t4_tf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="card_t4" target="card_tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_flight" value="FLIGHT-OBJECT RECEPTION PIPELINE (Drone Multispectral Imagery to Bedrock AI Analysis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="2580" height="660" as="geometry" />
        </mxCell>
        <mxCell id="card_f1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="840" width="430" height="370" as="geometry" />
        </mxCell>
        <mxCell id="t_f1" value="Drone / Ground Station" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="855" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f1" value="&lt;b&gt;Mission Capture &amp;amp; Packaging&lt;/b&gt;&lt;br/&gt;• Agronomist drone flight over coffee parcels&lt;br/&gt;• Multispectral imagery (RGB, RedEdge, NIR bands)&lt;br/&gt;• Mission bundle: raw TIFF rasters + flight log&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Authentication &amp;amp; Pre-flight Check&lt;/b&gt;&lt;br/&gt;• Pilot authenticates via Amazon Cognito token&lt;br/&gt;• Local client computes SHA-256 package checksum&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Offline Resilience&lt;/b&gt;&lt;br/&gt;• Missions buffered locally on ground station if plot lacks connectivity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="900" width="390" height="295" as="geometry" />
        </mxCell>
        <mxCell id="e_f1_f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_f1" target="card_f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_f1_f2" value="Pre-signed PUT&lt;br/&gt;SHA-256 Check" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="495" y="965" width="95" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_f2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="840" width="430" height="370" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3_f2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="610" y="855" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_f2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="655" y="855" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f2" value="S3 Drone Bucket [D04]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="705" y="855" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_f2" value="&lt;b&gt;Object Storage Target [D04]&lt;/b&gt;&lt;br/&gt;• Bucket: &lt;i&gt;aroma-drone-objects-{env}&lt;/i&gt;&lt;br/&gt;• Direct upload via time-limited Pre-signed URL&lt;br/&gt;• Tier: &lt;i&gt;object_storage&lt;/i&gt; / &lt;i&gt;application&lt;/i&gt; endpoint&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Integrity &amp;amp; Encryption&lt;/b&gt;&lt;br/&gt;• S3 PutObject verifies SHA-256 header digest&lt;br/&gt;• Server-Side Encryption with AWS KMS CMK (D03)&lt;br/&gt;• Lifecycle: Transitions raw TIFFs to Glacier after 90d&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Event Generation&lt;/b&gt;&lt;br/&gt;• Emits &lt;i&gt;s3:ObjectCreated:*&lt;/i&gt; on successful upload" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="610" y="905" width="390" height="295" as="geometry" />
        </mxCell>
        <mxCell id="e_f2_f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="card_f2" target="card_f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_f2_f3" value="S3 Event&lt;br/&gt;Notification" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=13;fontStyle=1;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="965" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_f3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1110" y="840" width="450" height="370" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_f3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
