<mxfile host="Electron">
  <diagram id="ingestion-and-flight-objects" name="Telemetry Ingestion and Flight-Object Reception Pipelines">
    <mxGraphModel dx="2600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1500" math="0" shadow="0">
