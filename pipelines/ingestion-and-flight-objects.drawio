        <mxCell id="t_tf1" value="IoT Topic Rule SQS DLQ (ASM-161)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="655" y="562" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b_tf1" value="• Error action for malformed MQTT payload or PutItem failure&lt;br/&gt;• Retries up to 5 attempts before routing to DLQ (ASM-162)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#7f1d1d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="598" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_t2_tf1" value="Rule error (5 attempts)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#dc2626;labelBackgroundColor=#fef2f2;spacing=4;" edge="1" parent="1" source="card_t2" target="card_tf1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="card_tf2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="550" width="480" height="125" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_tf2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="1675" y="562" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="icon_cw_tf2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1712" y="562" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t_tf2" value="Threshold Function DLQ (ASM-162)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="1750" y="562" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b_tf2" value="• 14-day retention SQS DLQ (&lt;i&gt;infthresholddlq&lt;/i&gt;) on 5 retries exhausted&lt;br/&gt;• CloudWatch DLQ depth alarm triggers rollback (ASM-229)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#7f1d1d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="598" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_t4_tf2" value="5 retries exhausted (DLQ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#dc2626;labelBackgroundColor=#fef2f2;spacing=4;" edge="1" parent="1" source="card_t4" target="card_tf2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_flight" value="FLIGHT-OBJECT RECEPTION PIPELINE (Drone Imagery to Bedrock AI Analysis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=16;spacingLeft=24;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="2580" height="570" as="geometry" />
        </mxCell>
        <mxCell id="card_f1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="t_f1" value="Drone / Ground Station" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="785" width="370" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f1" value="&lt;b&gt;Flight Missions (ADR-002, drone-service.md)&lt;/b&gt;&lt;br/&gt;• Combined flight mode; certified commercial UAV pilot&lt;br/&gt;• Photos, track, maps, polygons, and flight record&lt;br/&gt;&lt;br/&gt;&lt;b&gt;On-Device Person Screen (ASM-164)&lt;/b&gt;&lt;br/&gt;• On-device screen sets &lt;i&gt;person_screen&lt;/i&gt; manifest flag&lt;br/&gt;• Zero cloud detectors used; cryptographic privacy&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Authentication &amp;amp; Buffer (sec 7)&lt;/b&gt;&lt;br/&gt;• Cognito &lt;i&gt;staff&lt;/i&gt; pool with MFA for pilot staff&lt;br/&gt;• 24h buffer retained until signed receipt received" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="85" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="595" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3_f2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="615" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_f2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="660" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f2" value="S3 Drone Object Ingress" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="710" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f2" value="&lt;b&gt;Object Storage Target (drone-service.md sec 7)&lt;/b&gt;&lt;br/&gt;• Workload S3 bucket with mission-prefixed keys&lt;br/&gt;• Direct upload via pre-signed URL from upload grant&lt;br/&gt;• S3 verifies SHA-256 header checksum (HTTP 400 on error)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Encryption &amp;amp; Retention (ASM-097)&lt;/b&gt;&lt;br/&gt;• KMS CMK encryption under &lt;i&gt;drone&lt;/i&gt; key class&lt;br/&gt;• 5-year retention enforced by S3 lifecycle rules&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Person Screening &amp;amp; Quarantine (ASM-165)&lt;/b&gt;&lt;br/&gt;• Files with person present moved to &lt;i&gt;restricted/person/&lt;/i&gt;&lt;br/&gt;• Encrypted under 8th KMS key class &lt;i&gt;restricted&lt;/i&gt; (deny functions)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="615" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_lambda_f3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1145" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_ddb_f3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1190" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f3" value="Reception &amp; Event Pipe" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1240" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f3" value="&lt;b&gt;Manifest Validation &amp;amp; Receipt (sec 7)&lt;/b&gt;&lt;br/&gt;• Reception Lambda validates manifest and SHA-256 checksums&lt;br/&gt;• Writes mission item to DynamoDB &lt;i&gt;missions&lt;/i&gt; (&lt;i&gt;record_persisted&lt;/i&gt;)&lt;br/&gt;• Returns receipt to ground station to release local buffer&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Event Routing to Inference (ASM-161)&lt;/b&gt;&lt;br/&gt;• DynamoDB Stream captures &lt;i&gt;record_persisted&lt;/i&gt; events&lt;br/&gt;• EventBridge Pipe routes filtered events to custom drone bus&lt;br/&gt;• EventBridge rules dispatch to dedicated SQS queue per mission&lt;br/&gt;• Inference Lambda event source mapping reads with batch size 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1145" y="825" width="370" height="265" as="geometry" />
        </mxCell>
        <mxCell id="card_f4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1655" y="770" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="icon_bedrock_f4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1675" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_eb_f4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="1720" y="782" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_f4" value="Bedrock Inference [D10]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1770" y="785" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_f4" value="&lt;b&gt;Managed Foundation Model (ASM-160)&lt;/b&gt;&lt;br/&gt;• Amazon Bedrock on-demand in us-east-1 (Amazon Nova Pro)&lt;br/&gt;• Zero-shot prompts &amp;amp; versioned JSON output schemas&lt;br/&gt;• Zero training, fine-tuning, or persistent compute&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Confidence &amp;amp; Boundaries (ASM-160, ASM-163)&lt;/b&gt;&lt;br/&gt;• Generates confidence score; threshold &amp;ge; 0.70 to confirm&lt;br/&gt;• Persists timestamp, confidence, and source object key&lt;br/&gt;• NEVER authorizes fumigation or flight dispatch directly" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1675" y="825" width="370" height="265" as="geometry" />
        </mxCell>
