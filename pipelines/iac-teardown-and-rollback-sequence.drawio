<mxfile host="Electron" modified="2026-11-11T00:00:00.000Z" agent="Mozilla/5.0 AromaPacifico" version="32.4.1" type="device"><diagram id="iac-teardown-and-rollback-sequence" name="IaC Teardown and Rollback Sequence"><mxGraphModel dx="2400" dy="2253" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="2253" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=none;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="100" as="geometry" /></mxCell><mxCell id="hdr_title" value="AROMA PACÍFICO — IAC TEARDOWN &amp; ROLLBACK SEQUENCE (BRINGING INFRASTRUCTURE DOWN)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="28" width="1850" height="30" as="geometry" /></mxCell><mxCell id="hdr_subtitle" value="Emergency Rollback via Revert PR, 5-Year Data Retention Guards &amp; Proposed Reverse-Order Environment Teardown" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#bcccdc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="58" width="1850" height="22" as="geometry" /></mxCell><mxCell id="hdr_meta" value="Refs aroma-pacifico/aroma-pacifico-roadmap#38 | Track B Delivery | Normative: docs/cd-pipeline.md §7, ADR-003, ASM-174, ASM-097, ASM-098 | Boxes: D01, D02, D04, D06, D09, D10, D12" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#9fb3c8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="82" width="1850" height="20" as="geometry" /></mxCell><mxCell id="hdr_badge" value="PROPOSED TEARDOWN&#10;Plan-Only Academic Safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e11d48;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1910" y="28" width="430" height="84" as="geometry" /></mxCell><mxCell id="icon_ll_lead" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="146" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_lead" value="Approver &amp; Incident Lead&#10;(SR1 / SR2, ASM-172)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="icon_ll_revert" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="491" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_revert" value="Git Trunk &amp; Revert PR&#10;[Box D01] Branch Workflow" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="415" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="icon_ll_cd" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="836" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_cd" value="CD Promotion Pipeline&#10;[Box D12] Re-promotion" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="icon_ll_telguard" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1181" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_telguard" value="5-Year Telemetry Guard&#10;[Box D09] DynamoDB / S3 WORM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1105" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="icon_ll_audguard" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_audguard" value="5-Year Audit Archive Guard&#10;[Box D02] S3 Compliance WORM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1450" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="icon_ll_ctrl" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="1871" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_ctrl" value="Reverse Teardown Controller&#10;Proposed Procedure Engine" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1795" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="icon_ll_stacks" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2216" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_stacks" value="Infrastructure Stacks&#10;Work -&gt; Sec -&gt; Net -&gt; State" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2140" y="190" width="200" height="2008" as="geometry" /></mxCell><mxCell id="p1" value="PART 1: INFRASTRUCTURE ROLLBACK BY REVERTING AND RE-PROMOTING (docs/cd-pipeline.md §7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e40af;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m1" value="1.1: Production defect, regression, or incident observed in pdn&lt;br&gt;(CloudWatch alarm or operational failure)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="378" as="sourcePoint" /><mxPoint x="170" y="404" as="targetPoint" /><Array as="points"><mxPoint x="225" y="378" /><mxPoint x="225" y="404" /></Array></mxGeometry></mxCell><mxCell id="m2" value="1.2: Incident Lead (SR1/SR2) declares incident reference:&lt;br&gt;INC-YYYYMMDD-01 (bypasses change blackout, ASM-183)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="430" as="sourcePoint" /><mxPoint x="170" y="456" as="targetPoint" /><Array as="points"><mxPoint x="225" y="430" /><mxPoint x="225" y="456" /></Array></mxGeometry></mxCell><mxCell id="m3" value="1.3: Lead checks out revert branch from origin/main:&lt;br&gt;git checkout -b revert-38-incident origin/main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="482" as="sourcePoint" /><mxPoint x="515" y="482" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="1.4: Reverts faulty commit: git revert FAULTY_SHA&lt;br&gt;(creates clean inverse diff with zero manual code edits)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="534" as="sourcePoint" /><mxPoint x="515" y="560" as="targetPoint" /><Array as="points"><mxPoint x="570" y="534" /><mxPoint x="570" y="560" /></Array></mxGeometry></mxCell><mxCell id="m5" value="1.5: Commits revert: revert(iac): revert faulty deployment&lt;br&gt;Refs aroma-pacifico/aroma-pacifico-roadmap#38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="586" as="sourcePoint" /><mxPoint x="515" y="612" as="targetPoint" /><Array as="points"><mxPoint x="570" y="586" /><mxPoint x="570" y="612" /></Array></mxGeometry></mxCell><mxCell id="m6" value="1.6: Pushes revert branch and opens emergency PR targeting main&lt;br&gt;(labeled with incident reference and priority: urgent)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="638" as="sourcePoint" /><mxPoint x="515" y="638" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="1.7: Cross-provider peer review conducts expedited review:&lt;br&gt;verifies inverted plan diff (destroys/adds flipped)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="690" as="sourcePoint" /><mxPoint x="515" y="716" as="targetPoint" /><Array as="points"><mxPoint x="570" y="690" /><mxPoint x="570" y="716" /></Array></mxGeometry></mxCell><mxCell id="m8" value="1.8: Reviewer approves and squash-merges revert PR to main;&lt;br&gt;target MTTR &lt; 2 hours (ASM-174)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="742" as="sourcePoint" /><mxPoint x="170" y="742" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="1.9: Emergency rollback promoted through normal CD pipeline:&lt;br&gt;dev -&gt; qa -&gt; pdn with two-step approval and plan binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="794" as="sourcePoint" /><mxPoint x="860" y="794" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1" value="ROLLBACK CONTRACT (docs/cd-pipeline.md §7, ASM-174):&#10;• Target MTTR &lt; 2 hours for production rollbacks; root cause investigation deferred to post-incident review&#10;• Rollback executed by git revert creating an inverse commit; direct terraform state surgery strictly forbidden&#10;• Re-promotion follows standard pipeline (dev -&gt; qa -&gt; pdn) ensuring full audit trail and approval evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="839" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p2" value="PART 2: MANDATORY DATA RETENTION VERIFICATION &amp; PRE-TEARDOWN COMPLIANCE GATES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="931" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m10" value="2.1: Change owner initiates retirement request for environment&lt;br&gt;(e.g. dev, qa, or full project retirement)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="979" as="sourcePoint" /><mxPoint x="1895" y="979" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="2.2: Mandatory manual teardown approval gate by SR1 and SR2&lt;br&gt;with documented audit justification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1031" as="sourcePoint" /><mxPoint x="1895" y="1031" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="2.3: Verifies Telemetry Data Retention Guard: DynamoDB deletion&lt;br&gt;protection and S3 Object Lock Compliance Mode (5 years)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1083" as="sourcePoint" /><mxPoint x="1205" y="1083" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m13" value="2.4: Telemetry guard confirms: agroclimatic records and drone&lt;br&gt;manifests protected from deletion (ADR-003, ASM-070)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1135" as="sourcePoint" /><mxPoint x="1895" y="1135" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="2.5: Verifies Audit Trail Retention Guard: S3 central audit bucket&lt;br&gt;(WORM, 5-year retention, CloudTrail, approvals)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1187" as="sourcePoint" /><mxPoint x="1550" y="1187" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="2.6: Audit guard confirms: audit archive cannot be deleted&lt;br&gt;or modified by any principal (SCP enforced, ASM-098)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1239" as="sourcePoint" /><mxPoint x="1895" y="1239" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m16" value="2.7: Verifies State Backend Safeguard: S3 remote state bucket&lt;br&gt;is protected; STATE IS NEVER DESTROYED FIRST!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1291" as="sourcePoint" /><mxPoint x="2240" y="1291" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m17" value="2.8: Pre-teardown compliance check passed: data retention guards&lt;br&gt;active and state backend persistence confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1343" as="sourcePoint" /><mxPoint x="170" y="1343" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2" value="MANDATORY DATA RETENTION GUARDS (Case Statement, ADR-003, ASM-098):&#10;• 5-Year Telemetry Retention: DynamoDB Point-in-Time Recovery &amp; S3 Object Lock in Compliance Mode (cannot be deleted)&#10;• 5-Year Central Audit Archive: CloudTrail WORM archive in Security Account under 'audit' CMK (SCP protected)&#10;• State Backend Safeguard: Remote S3 state bucket MUST remain intact during teardown; state is never destroyed first!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1388" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p3" value="PART 3: CONTROLLED ENVIRONMENT TEARDOWN IN REVERSE STACK ORDER (PROPOSED PROCEDURE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m18" value="3.1: Teardown Stage 1 — stacks/workload: initiates destruction&lt;br&gt;of application compute, pipes, and queues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1528" as="sourcePoint" /><mxPoint x="2240" y="1528" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m19" value="3.2: Destroys Threshold/Reception Lambdas, EventBridge pipes&lt;br&gt;&amp; rules, SQS threshold &amp; dlq queues, IoT topic rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="1580" as="sourcePoint" /><mxPoint x="2240" y="1606" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="1580" /><mxPoint x="2185" y="1606" /></Array></mxGeometry></mxCell><mxCell id="m20" value="3.3: Preserves protected tables: DynamoDB telemetry table and&lt;br&gt;S3 object archives retained under retention policies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="1632" as="sourcePoint" /><mxPoint x="1205" y="1632" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m21" value="3.4: Teardown Stage 2 — stacks/security: initiates destruction&lt;br&gt;of application security layer (Box D06)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1684" as="sourcePoint" /><mxPoint x="2240" y="1684" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m22" value="3.5: Destroys workload IAM roles, Cognito User Pool app clients,&lt;br&gt;and AWS WAF Web ACL associations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="1736" as="sourcePoint" /><mxPoint x="2240" y="1762" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="1736" /><mxPoint x="2185" y="1762" /></Array></mxGeometry></mxCell><mxCell id="m23" value="3.6: Preserves central audit identities; KMS CMK deletion scheduled&lt;br&gt;with mandatory 30-day waiting period (ASM-097)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="1788" as="sourcePoint" /><mxPoint x="1550" y="1788" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m24" value="3.7: Teardown Stage 3 — stacks/network: initiates destruction&lt;br&gt;of networking and routing domain (Box D04/D05)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1840" as="sourcePoint" /><mxPoint x="2240" y="1840" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m25" value="3.8: Detaches collection center VPN tunnels, deletes Transit Gateway&lt;br&gt;VPC attachments, subnets, route tables, and VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="1892" as="sourcePoint" /><mxPoint x="2240" y="1918" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="1892" /><mxPoint x="2185" y="1918" /></Array></mxGeometry></mxCell><mxCell id="m26" value="3.9: Teardown Stage 4 — stacks/state-backend: ONLY AFTER all&lt;br&gt;dependent stacks are destroyed and state reflects 0 resources" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1944" as="sourcePoint" /><mxPoint x="2240" y="1944" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m27" value="3.10: Final state snapshot archived to central audit archive;&lt;br&gt;S3 state bucket locked or archived (NEVER destroyed first!)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="1996" as="sourcePoint" /><mxPoint x="1550" y="1996" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m28" value="3.11: Teardown completion audit record emitted to central audit&lt;br&gt;archive; signed off by SR1 / SR2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2048" as="sourcePoint" /><mxPoint x="170" y="2048" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3" value="REVERSE DEPENDENCY ORDER RATIONALE (PC-IAC-022, docs/cd-pipeline.md §7):&#10;1. Workload destroyed first: terminates event processors, compute, and ingress before shared resources&#10;2. Security destroyed second: removes workload IAM roles, policies, and WAF rules while preserving audit keys&#10;3. Network destroyed third: dismantles subnets, Transit Gateway attachments, and VPC after traffic has stopped&#10;4. State backend preserved to the very end: tracks and proves destruction; state is never destroyed first!&#10;NOTE: Proposed procedure for environment retirement; repository delivery is plan-only (AGENTS.md §4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#581c87;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="2093" width="2200" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>