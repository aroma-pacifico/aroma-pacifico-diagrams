<mxfile host="Electron" modified="2026-11-11T00:00:00.000Z" agent="Mozilla/5.0 AromaPacifico" version="32.4.1" type="device"><diagram id="iac-teardown-and-rollback-sequence" name="IaC Teardown and Rollback Sequence"><mxGraphModel dx="3400" dy="2700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3400" pageHeight="2700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=none;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="3320" height="100" as="geometry" /></mxCell><mxCell id="hdr_title" value="AROMA PACÍFICO — IAC TEARDOWN &amp; ROLLBACK SEQUENCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="28" width="2800" height="32" as="geometry" /></mxCell><mxCell id="hdr_subtitle" value="Revert Re-Promotion Rollback, Controlled Reverse-Stack Teardown &amp; 5-Year Data Retention Compliance Safeguards" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#bcccdc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="60" width="2800" height="22" as="geometry" /></mxCell><mxCell id="hdr_meta" value="Refs aroma-pacifico/aroma-pacifico-roadmap#38 | Track B Delivery | Normative: docs/cd-pipeline.md §7, ASM-157, ASM-174, ASM-184, ASM-185, ASM-320 | Boxes: D01, D02, D04, D06, D12, D13" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#9fb3c8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="86" width="2800" height="20" as="geometry" /></mxCell><mxCell id="hdr_badge" value="PROPOSED TEARDOWN PROCEDURE&#10;State Backend Never Destroyed First&#10;5-Year Retention: Telemetry &amp; Audit&#10;Reverse Order: Work -&gt; Sec -&gt; Net -&gt; State" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b91c1c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2900" y="28" width="440" height="84" as="geometry" /></mxCell><mxCell id="z1" value="GOVERNANCE &amp; INCIDENT COMMAND&#10;Rollback Decision &amp; Teardown Approval Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="480" height="80" as="geometry" /></mxCell><mxCell id="z2" value="ROLLBACK &amp; RE-PROMOTION PIPELINE [Box D01, D12]&#10;Git Revert Branch, PR Gates &amp; Inverted Plan Promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="700" height="80" as="geometry" /></mxCell><mxCell id="z3" value="DATA RETENTION GUARDS &amp; SAFEGUARDS [Box D02, D06, D09]&#10;5-Year Telemetry &amp; Audit Compliance Locks (WORM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="840" height="80" as="geometry" /></mxCell><mxCell id="z4" value="CONTROLLED REVERSE TEARDOWN EXECUTION [Box D02, D04, D06, D10]&#10;Reverse Dependency: 1. Workload -&gt; 2. Security -&gt; 3. Network -&gt; 4. State Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2170" y="130" width="1170" height="80" as="geometry" /></mxCell><mxCell id="icon_ll_lead" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="246" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_lead" value="Approver &amp; Incident Lead&#10;(SR1 / SR2, ASM-172)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="160" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_revert" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="626" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_revert" value="Git Trunk &amp; Revert PR&#10;[Box D01] Branch Workflow" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_cd" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_cd" value="CD Promotion Pipeline&#10;[Box D12] Re-promotion" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_telguard" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_telguard" value="5-Year Telemetry Guard&#10;[Box D09] DynamoDB / S3 WORM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1440" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_audguard" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1946" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_audguard" value="5-Year Audit Archive Guard&#10;[Box D02] S3 Compliance WORM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1860" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_ctrl" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2386" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_ctrl" value="Reverse Teardown Controller&#10;Proposed Procedure Engine" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2300" y="240" width="220" height="2400" as="geometry" /></mxCell><mxCell id="icon_ll_stacks" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2896" y="186" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_stacks" value="Infrastructure Stacks&#10;Work -&gt; Sec -&gt; Net -&gt; State" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#102a43;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2800" y="240" width="240" height="2400" as="geometry" /></mxCell><mxCell id="p1" value="PART 1: INFRASTRUCTURE ROLLBACK BY REVERTING AND RE-PROMOTING (docs/cd-pipeline.md §7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e40af;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m1" value="1.1: Production defect, regression, or incident observed in pdn (CloudWatch alarm or operational failure)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="385" as="sourcePoint" /><mxPoint x="270" y="411" as="targetPoint" /><Array as="points"><mxPoint x="335" y="385" /><mxPoint x="335" y="411" /></Array></mxGeometry></mxCell><mxCell id="m2" value="1.2: Deciding approver (SR1 or SR2) decides to roll back; logs incident reference (INC-YYYYMMDD-NN, ASM-183)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="435" as="sourcePoint" /><mxPoint x="650" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m3" value="1.3: Operator checks out revert branch: git checkout -b fix/&lt;issue&gt;-revert-&lt;slug&gt; from origin/main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="485" as="sourcePoint" /><mxPoint x="650" y="511" as="targetPoint" /><Array as="points"><mxPoint x="715" y="485" /><mxPoint x="715" y="511" /></Array></mxGeometry></mxCell><mxCell id="m4" value="1.4: Revert squash commit: git revert &lt;commit-sha&gt; (never direct push to main, AGENTS.md §6)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="535" as="sourcePoint" /><mxPoint x="650" y="561" as="targetPoint" /><Array as="points"><mxPoint x="715" y="535" /><mxPoint x="715" y="561" /></Array></mxGeometry></mxCell><mxCell id="m5" value="1.5: Opens PR against main with Conventional Commit header and Refs aroma-pacifico/aroma-pacifico-roadmap#&lt;n&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="585" as="sourcePoint" /><mxPoint x="650" y="611" as="targetPoint" /><Array as="points"><mxPoint x="715" y="585" /><mxPoint x="715" y="611" /></Array></mxGeometry></mxCell><mxCell id="m6" value="1.6: PR conventions and CI gates run: secret scan, format, validate, tflint, trivy, and Floci speculative plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="635" as="sourcePoint" /><mxPoint x="1070" y="635" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="1.7: Reviewer reviews revert PR; approves and squash-merges revert commit into main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="685" as="sourcePoint" /><mxPoint x="650" y="685" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="1.8: CD promotion triggered: re-runs promotion mode through dev, qa, and pdn (Run 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="735" as="sourcePoint" /><mxPoint x="1070" y="735" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="1.9: Speculative plan of the revert shows the exact INVERSE of original change (destroys and replacements first)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="785" as="sourcePoint" /><mxPoint x="2920" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="1.10: Approver (SR1/SR2) dispatches Run 2 (approval mode); pdn-approval verifies digest and records approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="835" as="sourcePoint" /><mxPoint x="1070" y="835" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="1.11: Proposed apply executes revert plan: restores previous clean infrastructure configuration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="885" as="sourcePoint" /><mxPoint x="2920" y="885" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="1.12: Updates release note status to rolled_back and transmits outcome notice to Federation (target: &lt; 2 hours)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="935" as="sourcePoint" /><mxPoint x="270" y="935" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1" value="ROLLBACK DESIGN TARGETS (ASM-174, ASM-184, docs/cd-pipeline.md §7):&#10;• Automatic Lambda rollback: &lt; 10 min from alarm breach; rollback deployment: &lt; 30 min from human decision&#10;• Revert commit through promotion: &lt; 2 hours including approval (inside 4h lookup RTO budget, ASM-157)&#10;• Center firewall restore: &lt; 2 hours from pre-change configuration backup (device config, ASM-184)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="980" width="880" height="80" as="geometry" /></mxCell><mxCell id="p2" value="PART 2: DATA RETENTION COMPLIANCE &amp; SAFETY GUARDS (PRE-TEARDOWN VERIFICATION)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1095" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m13" value="2.1: Formal environment decommissioning / teardown requested (e.g. pilot decommission or test teardown)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1145" as="sourcePoint" /><mxPoint x="2410" y="1145" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="2.2: Mandatory manual teardown approval gate by SR1 and SR2 with documented audit justification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1195" as="sourcePoint" /><mxPoint x="2410" y="1195" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="2.3: Verifies Telemetry Data Retention Guard: DynamoDB deletion protection and S3 Object Lock Compliance Mode (5 years)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="1245" as="sourcePoint" /><mxPoint x="1550" y="1245" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m16" value="2.4: Telemetry guard confirms: agroclimatic records and drone manifests protected from deletion (ADR-003, ASM-070)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1295" as="sourcePoint" /><mxPoint x="2410" y="1295" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m17" value="2.5: Verifies Audit Trail Retention Guard: S3 central audit bucket (WORM, 5-year retention, CloudTrail, approvals)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="1345" as="sourcePoint" /><mxPoint x="1970" y="1345" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m18" value="2.6: Audit guard confirms: audit archive cannot be deleted or modified by any principal (SCP enforced, ASM-098)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="1395" as="sourcePoint" /><mxPoint x="2410" y="1395" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m19" value="2.7: Verifies State Backend Safeguard: S3 remote state bucket is protected; STATE IS NEVER DESTROYED FIRST!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="1445" as="sourcePoint" /><mxPoint x="2920" y="1445" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m20" value="2.8: Pre-teardown compliance check passed: data retention guards active and state backend persistence confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="1495" as="sourcePoint" /><mxPoint x="270" y="1495" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2" value="MANDATORY DATA RETENTION GUARDS (Case Statement, ADR-003, ASM-098):&#10;• 5-Year Telemetry Retention: DynamoDB Point-in-Time Recovery &amp; S3 Object Lock in Compliance Mode (cannot be deleted)&#10;• 5-Year Central Audit Archive: CloudTrail WORM archive in Security Account under 'audit' CMK (SCP protected)&#10;• State Backend Safeguard: Remote S3 state bucket MUST remain intact during teardown; state is never destroyed first!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="1540" width="960" height="80" as="geometry" /></mxCell><mxCell id="p3" value="PART 3: CONTROLLED ENVIRONMENT TEARDOWN IN REVERSE STACK ORDER (PROPOSED PROCEDURE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=12.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1655" width="3280" height="32" as="geometry" /></mxCell><mxCell id="m21" value="3.1: Teardown Stage 1 — stacks/workload: initiates destruction of application compute, pipes, and queues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="1705" as="sourcePoint" /><mxPoint x="2920" y="1705" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m22" value="3.2: Destroys Threshold/Reception Lambdas, EventBridge pipes &amp; rules, SQS threshold &amp; dlq queues, IoT topic rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2920" y="1755" as="sourcePoint" /><mxPoint x="2920" y="1781" as="targetPoint" /><Array as="points"><mxPoint x="2985" y="1755" /><mxPoint x="2985" y="1781" /></Array></mxGeometry></mxCell><mxCell id="m23" value="3.3: Preserves protected tables: DynamoDB telemetry table and S3 object archives retained under retention policies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2920" y="1805" as="sourcePoint" /><mxPoint x="1550" y="1805" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m24" value="3.4: Teardown Stage 2 — stacks/security: initiates destruction of application security layer (Box D06)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="1855" as="sourcePoint" /><mxPoint x="2920" y="1855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m25" value="3.5: Destroys workload IAM roles, Cognito User Pool app clients, and AWS WAF Web ACL associations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2920" y="1905" as="sourcePoint" /><mxPoint x="2920" y="1931" as="targetPoint" /><Array as="points"><mxPoint x="2985" y="1905" /><mxPoint x="2985" y="1931" /></Array></mxGeometry></mxCell><mxCell id="m26" value="3.6: Preserves central audit identities; KMS CMK deletion scheduled with mandatory 30-day waiting period (ASM-097)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2920" y="1955" as="sourcePoint" /><mxPoint x="1970" y="1955" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m27" value="3.7: Teardown Stage 3 — stacks/network: initiates destruction of networking and routing domain (Box D04/D05)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="2005" as="sourcePoint" /><mxPoint x="2920" y="2005" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m28" value="3.8: Detaches collection center VPN tunnels, deletes Transit Gateway VPC attachments, subnets, route tables, and VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=15;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2920" y="2055" as="sourcePoint" /><mxPoint x="2920" y="2081" as="targetPoint" /><Array as="points"><mxPoint x="2985" y="2055" /><mxPoint x="2985" y="2081" /></Array></mxGeometry></mxCell><mxCell id="m29" value="3.9: Teardown Stage 4 — stacks/state-backend: ONLY AFTER all dependent stacks are destroyed and state reflects 0 resources" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=11.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="2105" as="sourcePoint" /><mxPoint x="2920" y="2105" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m30" value="3.10: Final state snapshot archived to central audit archive; S3 state bucket locked or archived (NEVER destroyed first!)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2920" y="2155" as="sourcePoint" /><mxPoint x="1970" y="2155" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m31" value="3.11: Teardown completion audit record emitted to central audit archive; signed off by SR1 / SR2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.8;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=11.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2410" y="2205" as="sourcePoint" /><mxPoint x="270" y="2205" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3" value="REVERSE DEPENDENCY ORDER RATIONALE (PC-IAC-022, docs/cd-pipeline.md §7):&#10;1. Workload destroyed first: terminates event processors, compute, and ingress before shared resources&#10;2. Security destroyed second: removes workload IAM roles, policies, and WAF rules while preserving audit keys&#10;3. Network destroyed third: dismantles subnets, Transit Gateway attachments, and VPC after traffic has stopped&#10;4. State backend preserved to the very end: tracks and proves destruction; state is never destroyed first!&#10;NOTE: Proposed procedure for environment retirement; repository delivery is plan-only (AGENTS.md §4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#581c87;fontSize=11.5;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2150" y="2250" width="1000" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>