xCell id="ll_cd" value="CD Promotion Pipeline&#10;[Box D12] Re-promotion" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="200" height="2669" as="geometry" /></mxCell><mxCell id="icon_ll_telguard" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1181" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_telguard" value="5-Year Telemetry Guard&#10;[Box D09] DynamoDB / S3 WORM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1105" y="190" width="200" height="2669" as="geometry" /></mxCell><mxCell id="icon_ll_audguard" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_audguard" value="5-Year Audit Archive Guard&#10;[Box D02] S3 Compliance WORM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1450" y="190" width="200" height="2669" as="geometry" /></mxCell><mxCell id="icon_ll_ctrl" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="1871" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_ctrl" value="Reverse Teardown Controller&#10;Teardown Procedure Engine" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1795" y="190" width="200" height="2669" as="geometry" /></mxCell><mxCell id="icon_ll_stacks" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2216" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_stacks" value="Infrastructure Stacks&#10;Work -&gt; Sec -&gt; Net -&gt; State" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2140" y="190" width="200" height="2669" as="geometry" /></mxCell><mxCell id="p1" value="PART 1: INFRASTRUCTURE ROLLBACK BY REVERTING AND RE-PROMOTING (docs/cd-pipeline.md §7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e40af;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m1" value="1.1: Production defect, regression, or incident&lt;br&gt;observed in pdn (CloudWatch alarm or&lt;br&gt;operational failure)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="412" as="sourcePoint" /><mxPoint x="170" y="438" as="targetPoint" /><Array as="points"><mxPoint x="225" y="412" /><mxPoint x="225" y="438" /></Array></mxGeometry></mxCell><mxCell id="m2" value="1.2: Incident Lead (SR1/SR2) declares incident&lt;br&gt;reference: INC-YYYYMMDD-01 (bypasses&lt;br&gt;change blackout, ASM-183)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="475" as="sourcePoint" /><mxPoint x="170" y="501" as="targetPoint" /><Array as="points"><mxPoint x="225" y="475" /><mxPoint x="225" y="501" /></Array></mxGeometry></mxCell><mxCell id="m3" value="1.3: Lead checks out revert branch from&lt;br&gt;origin/main: git checkout -b revert-38-incident&lt;br&gt;origin/main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="580" as="sourcePoint" /><mxPoint x="515" y="580" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="1.4: Reverts faulty commit: git revert&lt;br&gt;FAULTY_SHA (creates clean inverse diff with&lt;br&gt;zero manual code edits)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="640" as="sourcePoint" /><mxPoint x="515" y="666" as="targetPoint" /><Array as="points"><mxPoint x="570" y="640" /><mxPoint x="570" y="666" /></Array></mxGeometry></mxCell><mxCell id="m5" value="1.5: Commits revert: revert(iac): revert faulty&lt;br&gt;deployment Refs&lt;br&gt;aroma-pacifico/aroma-pacifico-roadmap#38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="703" as="sourcePoint" /><mxPoint x="515" y="729" as="targetPoint" /><Array as="points"><mxPoint x="570" y="703" /><mxPoint x="570" y="729" /></Array></mxGeometry></mxCell><mxCell id="m6" value="1.6: Pushes revert branch and opens&lt;br&gt;emergency PR targeting main (labeled with&lt;br&gt;incident reference and priority: urgent)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="808" as="sourcePoint" /><mxPoint x="515" y="808" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="1.7: Cross-provider peer review conducts&lt;br&gt;expedited review: verifies inverted plan diff&lt;br&gt;(destroys/adds flipped)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="868" as="sourcePoint" /><mxPoint x="515" y="894" as="targetPoint" /><Array as="points"><mxPoint x="570" y="868" /><mxPoint x="570" y="894" /></Array></mxGeometry></mxCell><mxCell id="m8" value="1.8: Reviewer approves and squash-merges&lt;br&gt;revert PR to main; target MTTR &lt; 2 hours&lt;br&gt;(ASM-174)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="974" as="sourcePoint" /><mxPoint x="170" y="974" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="1.9: Emergency rollback promoted through&lt;br&gt;normal CD pipeline: dev -&gt; qa -&gt; pdn with&lt;br&gt;two-step approval and plan binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1045" as="sourcePoint" /><mxPoint x="860" y="1045" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c1" value="ROLLBACK CONTRACT (docs/cd-pipeline.md §7, ASM-174):&#10;• Target MTTR &lt; 2 hours for production rollbacks; root cause investigation deferred to post-incident review&#10;• Rollback executed by git revert creating an inverse commit; direct terraform state surgery strictly forbidden&#10;• Re-promotion follows standard pipeline (dev -&gt; qa -&gt; pdn) ensuring full audit trail and approval evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1067" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p2" value="PART 2: MANDATORY DATA RETENTION VERIFICATION &amp; PRE-TEARDOWN COMPLIANCE GATES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1159" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m10" value="2.1: Change owner initiates retirement request for&lt;br&gt;environment (e.g. dev, qa, or full project retirement)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1269" as="sourcePoint" /><mxPoint x="1895" y="1269" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="2.2: Mandatory manual teardown approval gate by&lt;br&gt;SR1 and SR2 with documented audit justification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1329" as="sourcePoint" /><mxPoint x="1895" y="1329" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="2.3: Verifies Telemetry Data Retention Guard: DynamoDB deletion&lt;br&gt;protection and S3 Object Lock Compliance Mode (5 years)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1389" as="sourcePoint" /><mxPoint x="1205" y="1389" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m13" value="2.4: Telemetry guard confirms: agroclimatic records and drone&lt;br&gt;manifests protected from deletion (ADR-003, ASM-070)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1449" as="sourcePoint" /><mxPoint x="1895" y="1449" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="2.5: Verifies Audit Trail Retention Guard: S3&lt;br&gt;central audit bucket (WORM, 5-year retention,&lt;br&gt;CloudTrail, approvals)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1520" as="sourcePoint" /><mxPoint x="1550" y="1520" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="2.6: Audit guard confirms: audit archive cannot&lt;br&gt;be deleted or modified by any principal (SCP&lt;br&gt;enforced, ASM-098)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1591" as="sourcePoint" /><mxPoint x="1895" y="1591" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m16" value="2.7: Verifies State Backend Safeguard: S3&lt;br&gt;remote state bucket is protected; STATE IS&lt;br&gt;NEVER DESTROYED FIRST!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1662" as="sourcePoint" /><mxPoint x="2240" y="1662" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m17" value="2.8: Pre-teardown compliance check passed: data&lt;br&gt;retention guards active and state backend&lt;br&gt;persistence confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1733" as="sourcePoint" /><mxPoint x="170" y="1733" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2" value="MANDATORY DATA RETENTION GUARDS (Case Statement, ADR-003, ASM-098):&#10;• 5-Year Telemetry Retention: DynamoDB Point-in-Time Recovery &amp; S3 Object Lock in Compliance Mode (cannot be deleted)&#10;• 5-Year Central Audit Archive: CloudTrail WORM archive in Security Account under 'audit' CMK (SCP protected)&#10;• State Backend Safeguard: Remote S3 state bucket MUST remain intact during teardown; state is never destroyed first!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1755" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p3" value="PART 3: CONTROLLED ENVIRONMENT TEARDOWN IN REVERSE STACK ORDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1847" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m18" value="3.1: Teardown Stage 1 — stacks/workload:&lt;br&gt;initiates destruction of application compute,&lt;br&gt;pipes, and queues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="1972" as="sourcePoint" /><mxPoint x="2240" y="1972" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m19" value="3.2: Destroys Threshold/Reception Lambdas,&lt;br&gt;EventBridge pipes &amp; rules, SQS threshold &amp;&lt;br&gt;dlq queues, IoT topic rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2032" as="sourcePoint" /><mxPoint x="2240" y="2058" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2032" /><mxPoint x="2185" y="2058" /></Array></mxGeometry></mxCell><mxCell id="m20" value="3.3: Preserves protected tables: DynamoDB&lt;br&gt;telemetry table and S3 object archives retained&lt;br&gt;under retention policies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2138" as="sourcePoint" /><mxPoint x="1205" y="2138" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m21" value="3.4: Teardown Stage 2 — stacks/security:&lt;br&gt;initiates destruction of application security layer&lt;br&gt;(Box D06)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2209" as="sourcePoint" /><mxPoint x="2240" y="2209" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m22" value="3.5: Destroys workload IAM roles, Cognito&lt;br&gt;User Pool app clients, and AWS WAF Web&lt;br&gt;ACL associations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2269" as="sourcePoint" /><mxPoint x="2240" y="2295" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2269" /><mxPoint x="2185" y="2295" /></Array></mxGeometry></mxCell><mxCell id="m23" value="3.6: Preserves central audit identities; KMS CMK deletion scheduled&lt;br&gt;with mandatory 30-day waiting period (ASM-097)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2360" as="sourcePoint" /><mxPoint x="1550" y="2360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m24" value="3.7: Teardown Stage 3 — stacks/network:&lt;br&gt;initiates destruction of networking and routing&lt;br&gt;domain (Box D04/D05)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2431" as="sourcePoint" /><mxPoint x="2240" y="2431" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m25" value="3.8: Detaches collection center VPN tunnels,&lt;br&gt;deletes Transit Gateway VPC attachments,&lt;br&gt;subnets, route tables, and VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2491" as="sourcePoint" /><mxPoint x="2240" y="2517" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="2491" /><mxPoint x="2185" y="2517" /></Array></mxGeometry></mxCell><mxCell id="m26" value="3.9: Teardown Stage 4 —&lt;br&gt;stacks/state-backend: ONLY AFTER all&lt;br&gt;dependent stacks are destroyed and state&lt;br&gt;reflects 0 resources" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2612" as="sourcePoint" /><mxPoint x="2240" y="2612" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m27" value="3.10: Final state snapshot archived to central audit archive;&lt;br&gt;S3 state bucket locked or archived (NEVER destroyed first!)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="2672" as="sourcePoint" /><mxPoint x="1550" y="2672" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m28" value="3.11: Teardown completion audit record emitted to&lt;br&gt;central audit archive; signed off by SR1 / SR2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2732" as="sourcePoint" /><mxPoint x="170" y="2732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3" value="IaC teardown and rollback (bring down) (PC-IAC-022, docs/cd-pipeline.md §7):&#10;1. Workload destroyed first: terminates event processors, compute, and ingress before shared resources&#10;2. Security destroyed second: removes workload IAM roles, policies, and WAF rules while preserving audit keys&#10;3. Network destroyed third: dismantles subnets, Transit Gateway attachments, and VPC after traffic has stopped&#10;4. State backend preserved to the very end: tracks and proves destruction; state is never destroyed first!&#10;NOTE: Environment retirement procedure; repository delivery is plan-only (AGENTS.md §4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#581c87;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="2754" width="2200" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>