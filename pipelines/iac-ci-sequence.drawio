<mxfile host="Electron" modified="2026-11-11T00:00:00.000Z" agent="Mozilla/5.0 AromaPacifico" version="32.4.1" type="device"><diagram id="iac-ci-sequence" name="IaC CI and Module Release Sequence"><mxGraphModel dx="2400" dy="4008" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="4008" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=none;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="100" as="geometry" /></mxCell><mxCell id="hdr_title" value="AROMA PACÍFICO — IAC CI &amp; REUSABLE MODULE RELEASE SEQUENCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="28" width="1850" height="30" as="geometry" /></mxCell><mxCell id="hdr_subtitle" value="Pull Request Verification Gates, Emulated Floci Speculative Plan, Infracost Delta &amp; Module Release Tagging" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#bcccdc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="58" width="1850" height="22" as="geometry" /></mxCell><mxCell id="hdr_meta" value="Refs aroma-pacifico/aroma-pacifico-roadmap#38 | Track B Delivery | Normative: standards/iac-rules/ (pc-iac-015, pc-iac-027, pc-iac-028) &amp; ADR-003 | Boxes: D01, D11, D13" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#9fb3c8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="82" width="1850" height="20" as="geometry" /></mxCell><mxCell id="hdr_badge" value="PLAN-ONLY CI GATES&#10;No Cloud Apply / Spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1910" y="28" width="430" height="84" as="geometry" /></mxCell><mxCell id="icon_ll_dev" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="146" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_dev" value="Developer (JR1/JR2/SR1/SR2)&#10;Feature Branch &amp; Commits" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="icon_ll_gh" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="491" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_gh" value="GitHub PR Workflow&#10;[Box D01] Orchestration" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="415" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="icon_ll_sec" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="836" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_sec" value="Secret Scanner (env-secrets)&#10;Variable &amp; Backend Files" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="icon_ll_gates" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1181" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_gates" value="Validation Gates (4 Stacks)&#10;fmt, validate, tflint, trivy, test" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1105" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="icon_ll_floci" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_floci" value="Floci AWS Emulator [D11]&#10;Speculative Plan (pc-iac-028)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1450" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="icon_ll_cost" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1871" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_cost" value="Infracost Estimator [D13]&#10;Monthly Delta (pc-iac-027)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1795" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="icon_ll_rev" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2216" y="136" width="48" height="48" as="geometry" /></mxCell><mxCell id="ll_rev" value="Peer Reviewer &amp; Release [D01]&#10;Cross-Provider Reviewer (SR1/SR2)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=72;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#102a43;fontSize=13;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2140" y="190" width="200" height="3763" as="geometry" /></mxCell><mxCell id="p1" value="PHASE 1: FEATURE BRANCHING, COMMIT HYGIENE &amp; PULL REQUEST CREATION (AGENTS.md §6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e40af;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m1" value="1.1: Developer checks out branch&lt;br&gt;TYPE/ISSUE-SLUG from origin/main&lt;br&gt;(Trunk-Based Development)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="412" as="sourcePoint" /><mxPoint x="170" y="438" as="targetPoint" /><Array as="points"><mxPoint x="225" y="412" /><mxPoint x="225" y="438" /></Array></mxGeometry></mxCell><mxCell id="m2" value="1.2: Commits atomically: TYPE(SCOPE):&lt;br&gt;subject with mandatory Refs roadmap#38&lt;br&gt;footer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="475" as="sourcePoint" /><mxPoint x="170" y="501" as="targetPoint" /><Array as="points"><mxPoint x="225" y="475" /><mxPoint x="225" y="501" /></Array></mxGeometry></mxCell><mxCell id="m3" value="1.3: Push branch: git push -u origin&lt;br&gt;TYPE/ISSUE-SLUG (push only own branch;&lt;br&gt;direct push to main forbidden)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="580" as="sourcePoint" /><mxPoint x="515" y="580" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="1.4: Opens PR targeting main using PR&lt;br&gt;template (Conventional Commit title, criteria,&lt;br&gt;verification)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#1e3a8a;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="651" as="sourcePoint" /><mxPoint x="515" y="651" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="1.5: PR triggers automated GitHub Actions&lt;br&gt;workflows with concurrency group&lt;br&gt;cancel-in-progress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#334155;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="711" as="sourcePoint" /><mxPoint x="515" y="737" as="targetPoint" /><Array as="points"><mxPoint x="570" y="711" /><mxPoint x="570" y="737" /></Array></mxGeometry></mxCell><mxCell id="c1" value="TRUNK-BASED DEVELOPMENT RULES (AGENTS.md §6):&#10;• Direct commits to main strictly forbidden; short-lived branch lifespan &lt; 48 hours; target PR diff &lt; 400 lines&#10;• Strict Conventional Commits (TYPE(SCOPE): lowercase subject) without emojis and with mandatory Refs footer&#10;• Push only assigned feature branch; peer reviewer or lead approves and squash-merges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="767" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p2" value="PHASE 2: PR CONVENTIONS &amp; SECRET SCANNING (Cheapest Gate First, ADR-003, PC-IAC-016)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#991b1b;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="859" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m6" value="2.1: pr-conventions workflow: validates&lt;br&gt;Conventional Commit title, branch naming,&lt;br&gt;English-only, and zero emojis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="942" as="sourcePoint" /><mxPoint x="515" y="968" as="targetPoint" /><Array as="points"><mxPoint x="570" y="942" /><mxPoint x="570" y="968" /></Array></mxGeometry></mxCell><mxCell id="m7" value="2.2: env-secrets job: runs bash&lt;br&gt;scripts/check-env-secrets.sh . across all&lt;br&gt;*.tfvars, *.tfbackend, *.example files" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1048" as="sourcePoint" /><mxPoint x="860" y="1048" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="2.3: Scans for AWS account IDs, access keys,&lt;br&gt;private keys, ARNs, and sensitive tokens&lt;br&gt;(PC-IAC-016)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#991b1b;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1108" as="sourcePoint" /><mxPoint x="860" y="1134" as="targetPoint" /><Array as="points"><mxPoint x="915" y="1108" /><mxPoint x="915" y="1134" /></Array></mxGeometry></mxCell><mxCell id="m9" value="2.4: Secret scan clean: exits 0, no credentials&lt;br&gt;leaked -&gt; publishes SUCCESS check to PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1198" as="sourcePoint" /><mxPoint x="515" y="1198" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c2" value="SECRET POSTURE &amp; HYGIENE (PC-IAC-016, ADR-003):&#10;• Zero static keys anywhere in repository or state; sensitive inputs declared with sensitive = true&#10;• Public aroma-pacifico-terraform-modules contains zero account IDs, ARNs, hostnames or credentials&#10;• GitHub Actions CI reaches AWS strictly through OIDC federation assuming dedicated least-privilege roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1220" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p3" value="PHASE 3: STATIC ANALYSIS, LINTING, SECURITY &amp; PLAN-MODE TESTS (Matrix: state-backend, network, security, workload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m10" value="3.1: Matrix runner checks out PR head and reads&lt;br&gt;pinned Terraform version (.terraform-version: 1.15.8)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1422" as="sourcePoint" /><mxPoint x="1205" y="1422" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="3.2: Format check: terraform&lt;br&gt;-chdir=stacks/STACK fmt -check -recursive -diff&lt;br&gt;(clean syntax enforced)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1482" as="sourcePoint" /><mxPoint x="1205" y="1508" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1482" /><mxPoint x="1260" y="1508" /></Array></mxGeometry></mxCell><mxCell id="m12" value="3.3: Initialize without backend: terraform init&lt;br&gt;-backend=false -input=false (no credentials&lt;br&gt;used)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1545" as="sourcePoint" /><mxPoint x="1205" y="1571" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1545" /><mxPoint x="1260" y="1571" /></Array></mxGeometry></mxCell><mxCell id="m13" value="3.4: Schema validation: terraform validate&lt;br&gt;-no-color (validates arguments, types, provider&lt;br&gt;syntax)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1608" as="sourcePoint" /><mxPoint x="1205" y="1634" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1608" /><mxPoint x="1260" y="1634" /></Array></mxGeometry></mxCell><mxCell id="m14" value="3.5: Linter: tflint --init --config=.tflint.hcl&lt;br&gt;&amp; tflint --chdir=stacks/STACK --format compact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1668" as="sourcePoint" /><mxPoint x="1205" y="1694" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1668" /><mxPoint x="1260" y="1694" /></Array></mxGeometry></mxCell><mxCell id="m15" value="3.6: Security scan: aquasecurity/trivy-action&lt;br&gt;config scan (fails on HIGH or CRITICAL&lt;br&gt;misconfigurations)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1728" as="sourcePoint" /><mxPoint x="1205" y="1754" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1728" /><mxPoint x="1260" y="1754" /></Array></mxGeometry></mxCell><mxCell id="m16" value="3.7: Unit tests: terraform test executing native&lt;br&gt;.tftest.hcl plan-mode suites (skips cleanly if no&lt;br&gt;tests)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#15803d;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1791" as="sourcePoint" /><mxPoint x="1205" y="1817" as="targetPoint" /><Array as="points"><mxPoint x="1260" y="1791" /><mxPoint x="1260" y="1817" /></Array></mxGeometry></mxCell><mxCell id="m17" value="3.8: All 4 stack matrices pass all gates cleanly&lt;br&gt;-&gt; publishes green check statuses to PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="1882" as="sourcePoint" /><mxPoint x="515" y="1882" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c3" value="MATRIX VERIFICATION CONTRACT (AGENTS.md §8, PC-IAC-018):&#10;• 4 Stacks evaluated in parallel: state-backend, network, security, workload&#10;• Pure child modules (pc-iac-005): child modules contain zero provider or backend blocks&#10;• Automated verification must show actual terminal output (pc-iac-010); plan-mode tests (.tftest.hcl) verify contracts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="1904" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p4" value="PHASE 4: SPECULATIVE PLAN AGAINST FLOCI AWS EMULATOR (Zero Cloud Credentials / Spend, PC-IAC-028)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1996" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m18" value="4.1: floci-plan workflow launches Floci service&lt;br&gt;container (floci/floci@sha256:5ee85db6..., port&lt;br&gt;4566)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2121" as="sourcePoint" /><mxPoint x="1550" y="2121" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m19" value="4.2: Injects emulator test environment: test&lt;br&gt;keys,&lt;br&gt;AWS_ENDPOINT_URL=http://localhost:4566,&lt;br&gt;us-east-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2181" as="sourcePoint" /><mxPoint x="1550" y="2207" as="targetPoint" /><Array as="points"><mxPoint x="1605" y="2181" /><mxPoint x="1605" y="2207" /></Array></mxGeometry></mxCell><mxCell id="m20" value="4.3: Creates ephemeral state bucket in Floci:&lt;br&gt;aws s3 mb s3://floci-state-ENV-STACK&lt;br&gt;(ADR-003)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2252" as="sourcePoint" /><mxPoint x="1550" y="2278" as="targetPoint" /><Array as="points"><mxPoint x="1605" y="2252" /><mxPoint x="1605" y="2278" /></Array></mxGeometry></mxCell><mxCell id="m21" value="4.4: Dynamic init: terraform init&lt;br&gt;-backend-config=&quot;use_path_style=true&quot;&lt;br&gt;-backend-config=&quot;use_lockfile=true&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2315" as="sourcePoint" /><mxPoint x="1550" y="2341" as="targetPoint" /><Array as="points"><mxPoint x="1605" y="2315" /><mxPoint x="1605" y="2341" /></Array></mxGeometry></mxCell><mxCell id="m22" value="4.5: Speculative plan: terraform plan&lt;br&gt;-input=false -detailed-exitcode (PLAN-ONLY:&lt;br&gt;apply and destroy strictly forbidden!)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2378" as="sourcePoint" /><mxPoint x="1550" y="2404" as="targetPoint" /><Array as="points"><mxPoint x="1605" y="2378" /><mxPoint x="1605" y="2404" /></Array></mxGeometry></mxCell><mxCell id="m23" value="4.6: Extracts plan summary: captures resource&lt;br&gt;counts (add/change/destroy) and replacements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#5b21b6;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2438" as="sourcePoint" /><mxPoint x="1550" y="2464" as="targetPoint" /><Array as="points"><mxPoint x="1605" y="2438" /><mxPoint x="1605" y="2464" /></Array></mxGeometry></mxCell><mxCell id="m24" value="4.7: Uploads short-lived speculative plan artifact&lt;br&gt;and publishes plan markdown table to Step Summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2521" as="sourcePoint" /><mxPoint x="515" y="2521" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c4" value="PC-IAC-028 FLOCI EMULATOR RULES:&#10;• Accepted by faculty advisor in lieu of AWS account; zero Terraform code modifications required (native provider v6)&#10;• Strictly plan-only: apply and destroy forbidden everywhere; proves root stacks plan cleanly with valid schemas&#10;• S3 remote state evidence initialized via aws s3 mb against Floci with native lockfile enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#581c87;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="2543" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p5" value="PHASE 5: AUTOMATED INFRACOST MONTHLY COST ESTIMATION &amp; SUMMARY (PC-IAC-027)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#881337;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="2635" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m25" value="5.1: Verifies INFRACOST_CLI_TOKEN, INFRACOST_ORG=aroma-pacifico,&lt;br&gt;and INFRACOST_METADATA_EGRESS_APPROVED=true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2745" as="sourcePoint" /><mxPoint x="1895" y="2745" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m26" value="5.2: Downloads checksum-pinned Infracost CLI&lt;br&gt;v2 (SHA-256:&lt;br&gt;0950674d6e19eee5c492e59b415f3078c7c6b7&lt;br&gt;2421f940543c6cfa884692874e)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2805" as="sourcePoint" /><mxPoint x="1895" y="2831" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2805" /><mxPoint x="1840" y="2831" /></Array></mxGeometry></mxCell><mxCell id="m27" value="5.3: Infracost scans base commit (HEAD~1)&lt;br&gt;with example variables per stack&lt;br&gt;(environments/qa/*.tfvars.example)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2876" as="sourcePoint" /><mxPoint x="1895" y="2902" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2876" /><mxPoint x="1840" y="2902" /></Array></mxGeometry></mxCell><mxCell id="m28" value="5.4: Infracost scans head commit (PR head&lt;br&gt;SHA) with matching example variables (no&lt;br&gt;cloud credentials needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="2939" as="sourcePoint" /><mxPoint x="1895" y="2965" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="2939" /><mxPoint x="1840" y="2965" /></Array></mxGeometry></mxCell><mxCell id="m29" value="5.5: Computes monthly cost breakdown:&lt;br&gt;previous cost, new cost, monthly dollar delta&lt;br&gt;and percentage change per stack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="3002" as="sourcePoint" /><mxPoint x="1895" y="3028" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="3002" /><mxPoint x="1840" y="3028" /></Array></mxGeometry></mxCell><mxCell id="m30" value="5.6: If token missing or not approved -&gt; writes&lt;br&gt;'estimate unavailable' (never claims zero cost&lt;br&gt;delta, PC-IAC-027 §1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9f1239;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="3065" as="sourcePoint" /><mxPoint x="1895" y="3091" as="targetPoint" /><Array as="points"><mxPoint x="1840" y="3065" /><mxPoint x="1840" y="3091" /></Array></mxGeometry></mxCell><mxCell id="m31" value="5.7: Publishes formatted markdown cost impact table&lt;br&gt;to PR step summary and keeps artifact cost-qa.md" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1895" y="3156" as="sourcePoint" /><mxPoint x="515" y="3156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="PC-IAC-027 COST GOVERNANCE:&#10;• Infracost CLI v2 token (legacy ico- keys rejected); variables INFRACOST_ORG and egress approved required&#10;• Publishes before, after, and delta breakdowns for each root in job summary; missing token outputs 'estimate unavailable'&#10;• Pinning: checksum-pinned CLI download and SHA-pinned GitHub actions; Slack notifications not required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#881337;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="3178" width="2200" height="74" as="geometry" /></mxCell><mxCell id="p6" value="PHASE 6: CODE REVIEW, SQUASH MERGE &amp; IMMUTABLE MODULE RELEASE TAGGING (PC-IAC-015)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1.5;fontColor=#7c2d12;fontSize=13.5;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="3270" width="2320" height="32" as="geometry" /></mxCell><mxCell id="m32" value="6.1: Cross-provider peer reviewer (SR1/SR2) reviews&lt;br&gt;PR diff, test outputs, and verification evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9a3412;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="3380" as="sourcePoint" /><mxPoint x="2240" y="3380" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m33" value="6.2: Verifies all CI checks green: conventions,&lt;br&gt;secret scan, matrix gates, Floci plan, and Infracost&lt;br&gt;delta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9a3412;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="3451" as="sourcePoint" /><mxPoint x="515" y="3451" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m34" value="6.3: Inspects destroys and replacements first in&lt;br&gt;prose (AGENTS.md §7); confirms no&lt;br&gt;unexpected drift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9a3412;labelBackgroundColor=#ffffff;align=right;spacingRight=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="3511" as="sourcePoint" /><mxPoint x="2240" y="3537" as="targetPoint" /><Array as="points"><mxPoint x="2185" y="3511" /><mxPoint x="2185" y="3537" /></Array></mxGeometry></mxCell><mxCell id="m35" value="6.4: Approves pull request on GitHub&lt;br&gt;(review status: APPROVED)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="3602" as="sourcePoint" /><mxPoint x="515" y="3602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m36" value="6.5: Reviewer squash-merges PR to main: PR title&lt;br&gt;becomes commit subject on main (clean trunk history)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9a3412;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2240" y="3662" as="sourcePoint" /><mxPoint x="515" y="3662" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m37" value="6.6: In aroma-pacifico-terraform-modules: cuts&lt;br&gt;immutable SemVer release tag vX.Y.Z (e.g.&lt;br&gt;v1.2.0, PC-IAC-015)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;strokeDashed=0;endArrow=block;endFill=1;fontSize=12.5;fontColor=#9a3412;labelBackgroundColor=#ffffff;align=left;spacingLeft=14;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="3722" as="sourcePoint" /><mxPoint x="515" y="3748" as="targetPoint" /><Array as="points"><mxPoint x="570" y="3722" /><mxPoint x="570" y="3748" /></Array></mxGeometry></mxCell><mxCell id="m38" value="6.7: Root stacks in infrastructure consume&lt;br&gt;modules by pinned git tag:&lt;br&gt;git::https://github.com/.../modules/NAME?ref=v&lt;br&gt;X.Y.Z" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;fontSize=12.5;fontColor=#065f46;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="3842" as="sourcePoint" /><mxPoint x="170" y="3842" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c6" value="PC-IAC-015 MODULE RELEASE CONTRACT:&#10;• Semantic Versioning: vMAJOR.MINOR.PATCH (e.g. v1.2.0); git tags are immutable (never overwritten or moved)&#10;• Public repository allows credential-free terraform init without leaking accounts, ARNs, or client data&#10;• Infrastructure stacks consume modules strictly by pinned git tag (never branch or floating ref)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;fontColor=#7c2d12;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="3864" width="2200" height="74" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>