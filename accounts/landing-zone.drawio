<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="landing-zone" name="AWS Landing Zone, Controls, Identity, Budgets and Auditing">
    <mxGraphModel dx="3900" dy="2650" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3900" pageHeight="2650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="AWS Landing Zone, Controls, Identity, Budgets and Auditing" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="3800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Aroma Pacífico AWS Organization Baseline (us-east-1, all features enabled | ASM-060, ASM-061): multi-account tree, root controls &amp; SCPs, identity entry points, budgets &amp; cost alerts, audit pipeline for the four mandatory events, and tagging scheme." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="3800" height="32" as="geometry" />
        </mxCell>
        <mxCell id="org_boundary" value="AWS Organization: aroma-pacifico (Region: us-east-1 | All Features Enabled | Single Organization | ASM-060, ASM-061)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="3800" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="root_controls" value="ORGANIZATION ROOT CONTROLS &amp; POLICIES (Applied from Root | Section 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;strokeWidth=2;fontColor=#0f172a;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="715" height="765" as="geometry" />
        </mxCell>
        <mxCell id="box_tag_policy" value="TAG POLICY (Attached to Root | Section 3.2 &amp; Section 5)&#10;• Enforces PascalCase keys across all pilot cloud resources&#10;• Standard Mandatory Keys:&#10;   Client, Project, Environment, Owner, CostCenter, FarmId, CollectionCenter, Name&#10;• Enforced Allowed Values:&#10;   - Environment: dev, qa, pdn, shared (ASM-006, ASM-063)&#10;   - CostCenter: farms, drones, collection-centers, trips, shared (ASM-064)&#10;   - CollectionCenter: cauca, huila, tolima (case statement octets 41, 42, 43)&#10;• Key capitalization enforced for Client and Project (values set after PD-070)&#10;• Tag policy validates compliance upon update/tag; creation presence enforced via SCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="200" width="675" height="230" as="geometry" />
        </mxCell>
        <mxCell id="box_scps" value="SERVICE CONTROL POLICIES (SCPs | Attached to Root &amp; OUs | Section 3.1)&#10;1. Deny leaving organization (Attached: Root)&#10;   Denies organizations:LeaveOrganization (prevents accounts escaping trail/budgets/tags)&#10;2. Deny Regions other than us-east-1 (Attached: Root)&#10;   Denies any action outside us-east-1 (exempts global: IAM, Organizations, Budgets | ADR-001)&#10;3. Protect audit trail and storage (Attached: Root)&#10;   Denies cloudtrail:StopLogging, DeleteTrail, UpdateTrail, PutEventSelectors;&#10;   Protects audit archive bucket policy, Object Lock compliance, and KMS key deletion/disabling&#10;4. Deny long-term IAM credentials (Attached: Root)&#10;   Denies iam:CreateUser, iam:CreateAccessKey, iam:CreateLoginProfile (ADR-003)&#10;5. Deny root user of member accounts (Attached: Root)&#10;   Denies all actions by member account root principals (centralized root access mgmt)&#10;6. Require cost tags on creation (Attached: Workloads OU)&#10;   Denies resource creation if Environment or CostCenter tag is missing (aws:RequestTag)&#10;7. Production changes only via pipeline (Attached: Production OU)&#10;   Denies write actions by human IAM Identity Center sessions in pdn (reads allowed);&#10;   Break-glass and narrow ops exempt under incident reference (ADR-003, ASM-007)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="445" width="675" height="465" as="geometry" />
        </mxCell>
        <mxCell id="box_azure" value="Azure (Prepared, not deployed | 10.88.0.0/13 | ADR-001)&#10;• Multi-cloud posture: Azure prepared as an export target and disaster-recovery option.&#10;• No Azure subscription, management group, or deployed resources in the pilot (ADR-001).&#10;• Retains address reservation 10.88.0.0/13 in the addressing plan (A07) without duplicate spend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;strokeDasharray=4 4;fontColor=#334155;fontSize=12.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="65" y="940" width="715" height="175" as="geometry" />
        </mxCell>
        <mxCell id="org_root_junction" value="AWS Organization Root (All Features Enabled | Master Account: Management Account | ASM-060)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=13.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="130" width="2400" height="36" as="geometry" />
        </mxCell>
