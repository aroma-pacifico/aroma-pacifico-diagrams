        <mxCell id="mgmt_acct" value="Management Account (Root Level, outside OUs | Environment: shared | ASM-060)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
