r=#166534;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="530" y="1465" width="115" height="90" as="geometry" /></mxCell><mxCell id="e_k4_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#ef4444;strokeWidth=1;" edge="1" parent="1" source="box_k4_cogstaff" target="box_k4_target"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="1478" /><mxPoint x="515" y="1478" /></Array></mxGeometry></mxCell><mxCell id="e_k4_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#0284c7;strokeWidth=1;" edge="1" parent="1" source="box_k4_cogfield" target="box_k4_target"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="1510" /><mxPoint x="515" y="1510" /></Array></mxGeometry></mxCell><mxCell id="e_k4_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#64748b;strokeWidth=1;" edge="1" parent="1" source="box_k4_cogpub" target="box_k4_target"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="1542" /><mxPoint x="515" y="1542" /></Array></mxGeometry></mxCell><mxCell id="k4_desc" value="Pool separation in pdn; staff enforces MFA; field optimizes rural adoption; zero cedula exposed" style="text;html=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="55" y="1568" width="580" height="20" as="geometry" /></mxCell><mxCell id="panel_budgets" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="860" width="680" height="780" as="geometry" /></mxCell><mxCell id="panel_budgets_hdr" value="BUDGETS &amp; COST ALERTING PATH (11 Budgets | Section 6)" style="rounded=1;arcSize=8;html=0;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1;fontColor=#166534;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="690" y="860" width="680" height="32" as="geometry" /></mxCell><mxCell id="b_engine_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="705" y="902" width="650" height="168" as="geometry" /></mxCell><mxCell id="icon_b_budgets" value="AWS Budgets&#10;Engine" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="740" y="910" width="40" height="40" as="geometry" /></mxCell><mxCell id="icon_b_anomaly" value="Cost Anomaly&#10;Detection" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="740" y="988" width="40" height="40" as="geometry" /></mxCell><mxCell id="b_engine_text" value="• Centralized in Management Account across all 6 accounts (ASM-060)&#10;• 11 Monthly Budgets:&#10;  - 5 Cost Lines: farms, drones, collection-centers, trips, testing&#10;  - 6 Account Budgets: Management, Security, Network, pdn, qa, dev&#10;• Threshold Triggers: 80% Actual, 100% Actual, 100% Forecasted (ASM-066)&#10;• 2 Anomaly Monitors: Workloads Service &amp; Cross-Account Spikes" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="855" y="910" width="490" height="150" as="geometry" /></mxCell><mxCell id="b_sns_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="705" y="1150" width="315" height="180" as="geometry" /></mxCell><mxCell id="icon_b_sns" value="SNS Topic" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="730" y="1180" width="38" height="38" as="geometry" /></mxCell><mxCell id="icon_b_kms" value="KMS Key" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kms;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="815" y="1180" width="38" height="38" as="geometry" /></mxCell><mxCell id="b_sns_text" value="Amazon SNS Topic (Management)&#10;• Encrypted with KMS [D06]&#10;• Receives threshold breaches&#10;  &amp; cost anomaly notifications&#10;• Broadcasts to operators" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="715" y="1225" width="295" height="95" as="geometry" /></mxCell><mxCell id="e_b_to_sns" value="Threshold Trigger" style="edgeStyle=straightEdge;html=0;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#166534;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="b_engine_box" target="b_sns_box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="1070" /><mxPoint x="862" y="1150" /></Array></mxGeometry></mxCell><mxCell id="b_recip_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="705" y="1420" width="315" height="185" as="geometry" /></mxCell><mxCell id="icon_b_user1" value="Platform Ops" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;fillColor=#232F3D;strokeColor=#ffffff;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="730" y="1450" width="38" height="38" as="geometry" /></mxCell><mxCell id="icon_b_user2" value="Cost Owner" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;fillColor=#232F3D;strokeColor=#ffffff;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="815" y="1450" width="38" height="38" as="geometry" /></mxCell><mxCell id="b_recip_text" value="Alert Recipients (SNS subscribers)&#10;• Platform operator&#10;• Cost owner (chosen by the lead&#10;  at deployment)&#10;• Notified at 80%, 100% actual, and&#10;  100% forecasted run rate (ASM-066)" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="715" y="1495" width="295" height="105" as="geometry" /></mxCell><mxCell id="e_sns_to_recip" value="Encrypted Alerts" style="edgeStyle=straightEdge;html=0;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#166534;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="b_sns_box" target="b_recip_box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="1330" /><mxPoint x="862" y="1420" /></Array></mxGeometry></mxCell><mxCell id="b_action_box" value="" style="rounded=1;html=0;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="1110" width="315" height="510" as="geometry" /></mxCell><mxCell id="icon_b_action" value="Budget Action" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=middle;verticalAlign=middle;align=left;html=0;fontSize=12;fontColor=#0f172a;labelPosition=right;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1055" y="1140" width="38" height="38" as="geometry" /></mxCell><mxCell id="b_action_text" value="AUTOMATED TESTING GUARDRAIL:&#10;• Triggered at 100% actual spend on&#10;  testing cost line (ASM-066)&#10;• Action: Applies SCP to NonProduction&#10;  OU denying new resource creation&#10;• Human Approval: Requires manual&#10;  operator confirmation to execute&#10;&#10;PRODUCTION EXEMPTION RULE:&#10;• Production OU NEVER receives an&#10;  automated stop action (protects&#10;  4-hour RTO for alerts &amp; lookup)" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="1050" y="1195" width="295" height="235" as="geometry" /></mxCell><mxCell id="badge_action_target" value="Target: NonProduction OU" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#ef4444;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1050" y="1575" width="295" height="28" as="geometry" /></mxCell><mxCell id="e_b_to_action" value="100% Test Spend Breach" style="edgeStyle=straightEdge;html=0;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontColor=#991b1b;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="b_engine_box" target="b_action_box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1197" y="1070" /><mxPoint x="1197" y="1110" /></Array></mxGeometry></mxCell><mxCell id="e_action_to_nonprod" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#ef4444;strokeWidth=2;exitX=1;exitY=0.2706;entryX=0.5;entryY=1;" edge="1" parent="1" source="b_action_box" target="badge_qa_target"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1392" y="1248" /><mxPoint x="1392" y="840" /><mxPoint x="1730" y="840" /></Array></mxGeometry></mxCell><mxCell id="badge_scp_halt_action" value="Applies SCP: Halts QA/Dev Creation" style="rounded=1;html=0;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="828" width="240" height="24" as="geometry" /></mxCell><mxCell id="panel_audit" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1405" y="860" width="950" height="780" as="geometry" /></mxCell><mxCell id="panel_audit_hdr" value="AUDIT PIPELINE FOR FOUR MANDATORY EVENTS (5-Year S3 Object Lock | Section 7)" style="rounded=1;arcSize=8;html=0;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=1;fontColor=#5b21b6;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1405" y="860" width="950" height="32" as="geometry" /></mxCell><mxCell id="audit_pdn_boundary" value="" style="rounded=1;arcSize=3;html=0;fillColor=none;strokeWidth=1.5;dashed=0;strokeColor=#dc2626;" vertex="1" parent="1"><mxGeometry x="1415" y="900" width="405" height="555" as="geometry" /></mxCell><mxCell id="audit_pdn_hdr" value="Production Account (pdn) | writes the records" style="rounded=1;arcSize=8;html=0;strokeWidth=1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="1415" y="900" width="405" height="26" as="geometry" /></mxCell><mxCell id="audit_sec_boundary" value="" style="rounded=1;arcSize=3;html=0;fillColor=none;strokeWidth=1.5;dashed=0;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1835" y="900" width="510" height="555" as="geometry" /></mxCell><mxCell id="audit_sec_hdr" value="Security Account | ingestion and 5-year archive" style="rounded=1;arcSize=8;html=0;strokeWidth=1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="1"><mxGeometry x="1835" y="900" width="510" height="26" as="geometry" /></mxCell><mxCell id="ev1_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1425" y="935" width="385" height="92" as="geometry" /></mxCell><mxCell id="ev1_title" value="Event 1: Sack Read (Public Lookup and Apps)" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="1435" y="939" width="365" height="18" as="geometry" /></mxCell><mxCell id="ev1_cw" value="CW Logs" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1432" y="961" width="36" height="36" as="geometry" /></mxCell><mxCell id="ev1_text" value="• Stream: /aws/application/audit (pdn)&#10;• Records: sack ID, timestamp, caller (ASM-069)&#10;• Written by the lookup service" style="text;html=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1480" y="960" width="325" height="62" as="geometry" /></mxCell><mxCell id="ev2_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1425" y="1035" width="385" height="92" as="geometry" /></mxCell><mxCell id="ev2_title" value="Event 2: Threshold Change (Operator, MFA)" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="1435" y="1039" width="365" height="18" as="geometry" /></mxCell><mxCell id="ev2_cw" value="CW Logs" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1432" y="1061" width="36" height="36" as="geometry" /></mxCell><mxCell id="ev2_text" value="• Stream: /aws/application/audit (pdn)&#10;• Records: operator ID, old and new value&#10;• Secondary: CloudTrail data event on DynamoDB" style="text;html=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1480" y="1060" width="325" height="62" as="geometry" /></mxCell><mxCell id="ev3_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1425" y="1235" width="385" height="92" as="geometry" /></mxCell><mxCell id="ev3_title" value="Event 3: Telemetry Publication (Farm IoT Nodes)" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="1435" y="1239" width="365" height="18" as="geometry" /></mxCell><mxCell id="ev3_iot" value="IoT Core" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;fillColor=#3F8624;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1432" y="1261" width="36" height="36" as="geometry" /></mxCell><mxCell id="ev3_text" value="• Topic rule stores reading + cert principal&#10;• Records: node ID, client ID, source IP&#10;• Rejections logged to AWSIotLogsV2 (pdn)" style="text;html=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1480" y="1260" width="325" height="62" as="geometry" /></mxCell><mxCell id="ev4_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1425" y="1135" width="385" height="92" as="geometry" /></mxCell><mxCell id="ev4_title" value="Event 4: Flight Object Delivery (Drone Upload)" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="1435" y="1139" width="365" height="18" as="geometry" /></mxCell><mxCell id="ev4_s3" value="S3 Drone" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1432" y="1161" width="36" height="36" as="geometry" /></mxCell><mxCell id="ev4_text" value="• S3 Drone Bucket [D06] PutObject in pdn&#10;• CloudTrail S3 data events (trail prefix)&#10;• Object linked to its flight record (ADR-002)" style="text;html=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1480" y="1160" width="325" height="62" as="geometry" /></mxCell><mxCell id="ingest_fh_box" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1960" y="935" width="120" height="192" as="geometry" /></mxCell><mxCell id="icon_ingest_fh" value="" style="shape