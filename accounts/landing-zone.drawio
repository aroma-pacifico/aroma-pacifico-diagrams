        <mxCell id="badge_d06_qoidc" value="D06" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
