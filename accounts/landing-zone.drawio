 nodes" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="1957" width="380" height="40" as="geometry" /></mxCell><mxCell id="tr_5_4" value="Key capitalization enforced" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="1957" width="230" height="40" as="geometry" /></mxCell><mxCell id="tr_5_5" value="Yes (Active)" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="1430" y="1957" width="180" height="40" as="geometry" /></mxCell><mxCell id="tr_6_0" value="CollectionCenter" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="50" y="2000" width="170" height="40" as="geometry" /></mxCell><mxCell id="tr_6_1" value="A08" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="220" y="2000" width="120" height="40" as="geometry" /></mxCell><mxCell id="tr_6_2" value="cauca, huila, tolima (case statement octets 41, 42, 43)" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="2000" width="480" height="40" as="geometry" /></mxCell><mxCell id="tr_6_3" value="Collection-center association (B05)" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="2000" width="380" height="40" as="geometry" /></mxCell><mxCell id="tr_6_4" value="Enforced allowed values" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="2000" width="230" height="40" as="geometry" /></mxCell><mxCell id="tr_6_5" value="Yes (Active)" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="1430" y="2000" width="180" height="40" as="geometry" /></mxCell><mxCell id="tr_7_0" value="Name" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="50" y="2043" width="170" height="40" as="geometry" /></mxCell><mxCell id="tr_7_1" value="PC-IAC-004" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="220" y="2043" width="120" height="40" as="geometry" /></mxCell><mxCell id="tr_7_2" value="Physical name adhering to PC-IAC-003 conventions" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="2043" width="480" height="40" as="geometry" /></mxCell><mxCell id="tr_7_3" value="Each reference module explicitly" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="2043" width="380" height="40" as="geometry" /></mxCell><mxCell id="tr_7_4" value="Not enforced by policy" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="2043" width="230" height="40" as="geometry" /></mxCell><mxCell id="tr_7_5" value="No" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=12;align=center" vertex="1" parent="1"><mxGeometry x="1430" y="2043" width="180" height="40" as="geometry" /></mxCell><mxCell id="box_formula" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1630" y="1705" width="720" height="205" as="geometry" /></mxCell><mxCell id="box_formula_hdr" value="Shared Resource Usage-Based Cost Allocation Formula (ASM-065)" style="rounded=1;arcSize=8;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1;fontColor=#0369a1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1630" y="1705" width="720" height="28" as="geometry" /></mxCell><mxCell id="box_formula_text" value="• Formula: AllocatedCost = TotalSharedCost * (ComponentOperations / TotalOperations)&#10;• Scope: Shared managed services without native sub-resource tagging:&#10;  - AWS IoT Core message broker and topic rule evaluations&#10;  - Amazon Data Firehose cross-account audit ingestion stream&#10;  - Amazon CloudWatch centralized audit log groups&#10;• Metric: Stored operation counts per CostCenter reported to monthly billing audit&#10;• Implementation: AWS Cost Categories map CostCenter tags to line items&#10;• Verification: Prorating verified against consolidated billing invoices (ASM-065)" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1645" y="1740" width="690" height="165" as="geometry" /></mxCell><mxCell id="box_badges" value="" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1630" y="1925" width="720" height="245" as="geometry" /></mxCell><mxCell id="box_badges_hdr" value="Architecture Catalog Traceability (docs/architecture.md Section 14)" style="rounded=1;arcSize=8;html=0;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1;fontColor=#92400e;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1630" y="1925" width="720" height="28" as="geometry" /></mxCell><mxCell id="box_badges_text" value="• [D02] S3 State Buckets: One per environment with S3 native locking&#10;  (State bucket (pdn), State bucket (qa), State bucket (dev); ADR-003)&#10;• [D03] Transversal Configuration: common_tags and secrets management&#10;• [D04] Network &amp; VPC: Boundaries, subnets, TGW hub and VPC endpoints (pdn, qa, dev)&#10;• [D06] Identity &amp; KMS: Identity Center, Cognito pools, GitHub OIDC, KMS keys&#10;• [D09] Telemetry Ingestion: IoT Core certificates, topic rules, DynamoDB store&#10;&#10;Traceability Contract: All diagram components correspond exactly to IaC modules&#10;in B01-B13 and architectural decisions recorded in docs/decision-log.md." style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1645" y="1960" width="690" height="205" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>