        <mxCell id="badge_d06_mgmt" value="D06" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1070" y="210" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="icon_mgmt_sns" value="SNS Alert Topic" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1135" y="220" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mgmt_text" value="Roles and Capabilities:&#10;• AWS Organizations Root: master account for SCPs, Tag Policy, and Member Accounts.&#10;• Consolidated Billing: aggregated invoicing across all 6 linked accounts in us-east-1.&#10;• Cost Allocation Tags &amp; Cost Categories: activates Environment, CostCenter, CollectionCenter,&#10;  FarmId, Project; maps CostCenter lines to farms, drones, collection-centers, trips, testing, shared.&#10;• AWS Budgets &amp; Anomaly Detection: 5 cost line budgets, 6 account budgets, 2 anomaly monitors.&#10;• IAM Identity Center Organization Instance [D06]: directory root; administered from Security acct.&#10;• Amazon SNS Topic (KMS-encrypted): broadcasts budget &amp; anomaly alerts to Operator and Cost Owner.&#10;• Automated Budget Guardrail: Testing budget action at 100% applies SCP to NonProduction OU (manual).&#10;• Boundary Rule: Holds NO workload, NO Terraform remote state bucket, NO app identities (ASM-060)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=1.5;fontColor=#0f172a;fontSize=12.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="290" width="650" height="355" as="geometry" />
        </mxCell>
        <mxCell id="sec_ou" value="Security OU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#064e3b;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="180" width="780" height="480" as="geometry" />
        </mxCell>
        <mxCell id="sec_acct" value="Security Account (Environment: shared | Delegated Administrator | ASM-061)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;fontColor=#064e3b;fontSize=13.5;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1525" y="215" width="750" height="430" as="geometry" />
        </mxCell>
        <mxCell id="icon_sec_trail" value="CloudTrail Admin" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1545" y="255" width="48" height="48" as="geometry" />
        </mxCell>
