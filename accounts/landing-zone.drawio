        <mxCell id="badge_d09_piot" value="D09" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="845" width="26" height="26" as="geometry" />
