          <mxGeometry x="1725" y="255" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="badge_d06_sec" value="D06" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1760" y="245" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="icon_sec_firehose" value="Data Firehose" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1815" y="255" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="icon_sec_athena" value="Athena Workspace" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1905" y="255" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="sec_text" value="Roles and Capabilities:&#10;• Delegated Administrator: CloudTrail organization trail and IAM Identity Center.&#10;• Central Audit Archive Bucket (s3://aroma-audit-archive-shared) [D06]:&#10;  - S3 Object Lock in COMPLIANCE MODE: 5-year immutable retention (ASM-067).&#10;  - Customer-Managed KMS Key (audit key) with restrictive key policy.&#10;  - S3 Block Public Access, Versioning, bucket policy denying non-TLS requests.&#10;  - Key Prefixes: AWSLogs/&lt;org-id&gt;/ (CloudTrail) and application/ (Firehose).&#10;• Amazon Data Firehose: receives application audit records from pdn CloudWatch Logs cross-account.&#10;• Amazon Athena: audit query workspace for Auditor role (read-only queries).&#10;• Multi-Region Organization Trail: logs all management events + S3 drone bucket data events.&#10;• Boundary Rule: Runs no application workloads; single security account matches ADR-001 (ASM-061)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#a7f3d0;strokeWidth=1.5;fontColor=#0f172a;fontSize=12.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1540" y="325" width="720" height="305" as="geometry" />
        </mxCell>
        <mxCell id="net_ou" value="Infrastructure OU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#4c1d95;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2315" y="180" width="680" height="480" as="geometry" />
        </mxCell>
        <mxCell id="net_acct" value="Network Account (Environment: shared | Hub &amp; WAN | ASM-033)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.5;fontColor=#4c1d95;fontSize=13.5;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2330" y="215" width="650" height="430" as="geometry" />
        </mxCell>
        <mxCell id="icon_net_tgw" value="Transit Gateway" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="2350" y="255" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="net_text" value="Roles and Capabilities:&#10;• Collection-Center Hub (ASM-033): AWS Transit Gateway (TGW) terminating WAN links.&#10;• Reserved Address Space: 10.83.0.0/16 held for Network &amp; Security infrastructure (ASM-034).&#10;• Three Collection Center Site Attachments:&#10;  - Cauca Collection Center WAN (10.41.0.0/16, octet 41 | IPsec VPN)&#10;  - Huila Collection Center WAN (10.42.0.0/16, octet 42 | IPsec VPN)&#10;  - Tolima Collection Center WAN (10.43.0.0/16, octet 43 | IPsec VPN)&#10;• Environment VPC Attachments:&#10;  - Production VPC attachment (10.82.0.0/16)&#10;  - Test VPC attachment (10.81.0.0/16)&#10;  - Development VPC attachment (10.80.0.0/16)&#10;• Cross-Account TGW Route Tables &amp; Security Segmentation (firewall-policy.md).&#10;• Boundary Rule: Houses only connectivity and hub routing; holds no workload data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#ddd6fe;strokeWidth=1.5;fontColor=#0f172a;fontSize=12.5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2345" y="325" width="620" height="305" as="geometry" />
        </mxCell>
