        <mxCell id="card_prod_cw" value="CloudWatch Logs&#10;/aws/application/audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;strokeWidth=1.5;fontColor=#713f12;fontSize=11.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
