        </mxCell>
        <mxCell id="icon_mgmt_budgets" value="Budgets Engine" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11.5;" vertex="1" parent="1">
