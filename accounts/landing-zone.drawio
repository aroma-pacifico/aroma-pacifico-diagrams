ity&#10;• Auditor: IAM Identity Center permission set, read-only, in the Security Account (7.3)&#10;• Platform operators read pdn log groups and AWSIotLogsV2 only, never the archive" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1665" y="1480" width="670" height="95" as="geometry" /></mxCell><mxCell id="badge_athena_role" value="Auditor Role: Read-Only Athena Access via Identity Center MFA (ASM-067, Section 7.3)" style="rounded=1;html=0;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1435" y="1585" width="900" height="28" as="geometry" /></mxCell><mxCell id="e_s3_athena" value="Queries Both Streams" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontColor=#5b21b6;align=center;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.9113;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="audit_s3_box" target="athena_box"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="panel_tags" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1660" width="2340" height="530" as="geometry" /></mxCell><mxCell id="panel_tags_hdr" value="TAGGING SCHEME LEGEND, COST ALLOCATION, PRORATING FORMULA &amp; D01-D13 BADGES (Section 5 &amp; 6)" style="rounded=1;arcSize=8;html=0;fillColor=#e2e8f0;strokeColor=#64748b;strokeWidth=1;fontColor=#0f172a;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="1660" width="2340" height="32" as="geometry" /></mxCell><mxCell id="th_0" value="Tag Key" style="rounded=1;html=0;fillColor=#cbd5e1;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="1705" width="170" height="32" as="geometry" /></mxCell><mxCell id="th_1" value="Origin" st