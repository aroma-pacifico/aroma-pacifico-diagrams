<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net" version="32.4.1" type="device"><diagram id="landing-zone" name="AWS Landing Zone, Controls, Identity, Budgets and Auditing"><mxGraphModel dx="2400" dy="2220" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="2220" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AWS Landing Zone: Organization, Controls, Identity, Budgets and Auditing" style="text;html=0;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="2340" height="35" as="geometry" /></mxCell><mxCell id="subtitle" value="AWS Multi-Account Architecture (us-east-1 | ASM-060, ASM-061): Governance Hierarchy, Identity Federation, Cost Alerting &amp; 5-Year Compliance Audit Pipeline" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="2340" height="25" as="geometry" /></mxCell><mxCell id="org_boundary" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="2340" height="755" as="geometry" /></mxCell><mxCell id="org_boundary_hdr" value="AWS Organization: aroma-pacifico (Region: us-east-1 | All Features Enabled | ASM-060, ASM-061)" style="rounded=1;arcSize=8;html=0;fillColor=#e2e8f0;strokeColor=#64748b;strokeWidth=1;fontColor=#0f172a;fontSize=15;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="2340" height="32" as="geometry" /></mxCell><mxCell id="root_controls_box" value="" style="rounded=1;html=0;fillColor=#f1f5f9;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="460" height="525" as="geometry" /></mxCell><mxCell id="root_controls_hdr" value="ORGANIZATION ROOT CONTROLS &amp; POLICIES" style="rounded=1;arcSize=8;html=0;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1;fontColor=#1e3a8a;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="460" height="28" as="geometry" /></mxCell><mxCell id="box_tag_policy" value="TAG POLICY (Attached to Root | Section 3.2 &amp; 5)&#10;• Enforces PascalCase keys across all pilot cloud resources&#10;• Mandatory keys: Client, Project, Environment, Owner, CostCenter,&#10;  FarmId, CollectionCenter, Name&#10;• Allowed values enforced by policy:&#10;  - Environment: dev, qa, pdn, shared (ASM-006, ASM-063)&#10;  - CostCenter: farms, drones, collection-centers, trips, shared (ASM-064)&#10;  - CollectionCenter: cauca, huila, tolima&#10;• Capitalization enforced for Client, Project, Owner, FarmId, Name" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="65" y="168" width="430" height="152" as="geometry" /></mxCell><mxCell id="box_scps" value="SERVICE CONTROL POLICIES (SCPs | Attached to Root &amp; OUs)&#10;1. Deny leaving organization (Root: organizations:LeaveOrganization)&#10;2. Deny non-us-east-1 Regions (Root: aws:RequestedRegion != us-east-1)&#10;3. Protect audit trail &amp; S3 archive (Root: deny trail/lock/kms tampering)&#10;4. Deny long-term IAM credentials (Root: deny iam:CreateUser/Key) [ADR-003]&#10;5. Deny member root users (Root: centralized root credential denial)&#10;6. Require cost tags on creation (Workloads OU: aws:RequestTag)&#10;7. Pipeline-only production changes (Production OU: deny human write in pdn)" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="65" y="328.0" width="430" height="135" as="geometry" /></mxCell><mxCell id="badge_scp_root" value="Root SCPs: 1-5 Active" style="rounded=1;html=0;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="472.0" width="210" height="28" as="geometry" /></mxCell><mxCell id="badge_scp_workloads" value="Workloads SCP: 6 Active" style="rounded=1;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="285" y="472.0" width="210" height="28" as="geometry" /></mxCell><mxCell id="badge_scp_prod" value="Production SCP: 7 Active (Pipeline-Only Changes | Break-Glass Exempt)" style="rounded=1;html=0;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="508.0" width="430" height="28" as="geometry" /></mxCell><mxCell id="scp_note" value="• SCPs attach to Root, Workloads OU &amp; Production OU; evaluate before IAM&#10;• Member account root users denied; break-glass audited via CloudTrail" style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="65" y="542.0" width="430" height="36" as="geometry" /></mxCell><mxCell id="box_azure" value="" style="rounded=1;html=0;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="665" width="460" height="160" as="geometry" /></mxCell><mxCell id="box_azure_hdr" value="AZURE MULTI-CLOUD (Prepared, not deployed | ADR-001)" style="rounded=1;arcSize=8;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1;fontColor=#0369a1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="665" width="460" height="28" as="geometry" /></mxCell><mxCell id="box_azure_text" value="• Multi-Cloud Posture: Prepared as disaster-recovery reserve &amp; export target&#10;• Reserved CIDR Block: 10.88.0.0/13 (docs/addressing-plan.md)&#10;• Zero Duplicate Spend: No active workloads or VMs deployed during pilot&#10;• Verification: Azure Terraform modules validated in plan-only mode (ADR-001)" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="65" y="700" width="430" height="75" as="geometry" /></mxCell><mxCell id="badge_azure_status" value="Status: Prepared, Not Deployed (10.88.0.0/13 | ADR-001)" style="rounded=1;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="785" width="430" height="28" as="geometry" /></mxCell><mxCell id="org_root_bar" value="AWS Organization Root | Policy Attachment Point for SCPs and Tag Policy" style="rounded=1;html=0;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="1680" height="36" as="geometry" /></mxCell><mxCell id="edge_controls_to_root" value="Applies Root SCPs&#10;&amp; Tag Policy" style="edgeStyle=straightEdge;html=0;strokeColor=#1e3a8a;strokeWidth=2;fontSize=12;fontColor=#1e3a8a;align=center;verticalAlign=top;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.389;" edge="1" parent="1" source="root_controls_hdr" target="org_root_bar"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="6" as="offset" /></mxGeometry></mxCell><mxCell id="mgmt_acct_box" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="550" y="205" width="370" height="230" as="geometry" /></mxCell><mxCell id="mgmt_acct_hdr" value="Management Account (Root Level, outside OUs)" style="rounded=1;arcSize=8;html=0;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1;fontColor=#0369a1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="550" y="205" width="370" height="28" as="geometry" /></mxCell><mxCell id="icon_mgmt_org" value="Organizations" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="icon_mgmt_budgets" value="Budgets" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="645" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="icon_mgmt_sso" value="Identity Center" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="725" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="badge_d06_mgmt" value="D06" style="ellipse;html=0;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="755" y="232" width="24" height="24" as="geometry" /></mxCell><mxCell id="icon_mgmt_sns" value="SNS Alerts" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="820" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="mgmt_text_box" value="• Consolidated billing across all 6 accounts (ASM-060)&#10;• Cost Allocation Tags &amp; Cost Categories master&#10;• 11 monthly budgets &amp; 2 anomaly monitors (ASM-066)&#10;• IAM Identity Center Org Instance [D06]&#10;• Holds NO workloads and NO TF state buckets" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="565" y="305" width="345" height="120" as="geometry" /></mxCell><mxCell id="tree_drop_mgmt" value="Master / Billing" style="edgeStyle=straightEdge;html=0;strokeColor=#0284c7;strokeWidth=2;fontSize=12;fontColor=#0369a1;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="org_root_bar" target="mgmt_acct_hdr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="166" /><mxPoint x="735" y="205" /></Array></mxGeometry></mxCell><mxCell id="sec_acct_box" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="205" width="450" height="230" as="geometry" /></mxCell><mxCell id="sec_acct_hdr" value="Security OU | Security Account (shared | ASM-061)" style="rounded=1;arcSize=8;html=0;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1;fontColor=#065f46;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="940" y="205" width="450" height="28" as="geometry" /></mxCell><mxCell id="icon_sec_trail" value="CloudTrail" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;fillColor=#E7157B;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="icon_sec_s3" value="Audit S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1035" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="icon_sec_kms" value="KMS Audit" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kms;fillColor=#DD344C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1110" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="badge_d06_sec" value="D06" style="ellipse;html=0;fillColor=#059669;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1140" y="232" width="24" height="24" as="geometry" /></mxCell><mxCell id="icon_sec_firehose" value="Firehose" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1190" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="icon_sec_athena" value="Athena" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1270" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="sec_text_box" value="• Delegated Admin for CloudTrail &amp; IAM Identity Center&#10;• Central S3 Audit Archive (Object Lock Compliance 5-yr, ASM-067)&#10;• Customer Managed KMS Audit Key [D06]&#10;• Amazon Data Firehose cross-account log ingestion&#10;• Amazon Athena audit query workspace for Auditor role" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="955" y="305" width="425" height="120" as="geometry" /></mxCell><mxCell id="tree_drop_sec" value="Security Branch" style="edgeStyle=straightEdge;html=0;strokeColor=#059669;strokeWidth=2;fontSize=12;fontColor=#065f46;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="org_root_bar" target="sec_acct_hdr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="166" /><mxPoint x="1165" y="205" /></Array></mxGeometry></mxCell><mxCell id="net_acct_box" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#9333ea;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1410" y="205" width="440" height="230" as="geometry" /></mxCell><mxCell id="net_acct_hdr" value="Infrastructure OU | Network Account (shared | ASM-033)" style="rounded=1;arcSize=8;html=0;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1;fontColor=#6b21a8;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1410" y="205" width="440" height="28" as="geometry" /></mxCell><mxCell id="icon_net_tgw" value="Transit Gateway Hub" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1460" y="240" width="42" height="42" as="geometry" /></mxCell><mxCell id="badge_d04_net" value="D04" style="ellipse;html=0;fillColor=#9333ea;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1508" y="249" width="24" height="24" as="geometry" /></mxCell><mxCell id="net_text_box" value="• Collection-Center Hub / AWS Transit Gateway (TGW) [D04]&#10;• Terminating WAN links: Cauca (10.41), Huila (10.42), Tolima (10.43)&#10;• Environment VPC attachments (pdn, qa, dev)&#10;• Network Reserve Block: 10.83.0.0/16 (ASM-034)&#10;• Zero workloads hosted in network account" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1425" y="305" width="415" height="120" as="geometry" /></mxCell><mxCell id="tree_drop_net" value="Infrastructure Branch" style="edgeStyle=straightEdge;html=0;strokeColor=#9333ea;strokeWidth=2;fontSize=12;fontColor=#6b21a8;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="org_root_bar" target="net_acct_hdr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="166" /><mxPoint x="1630" y="205" /></Array></mxGeometry></mxCell><mxCell id="tree_drop_workloads_root" value="Workloads OU Branch" style="edgeStyle=straightEdge;html=0;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontColor=#92400e;align=center;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="org_root_bar" target="workloads_gov_box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2105" y="166" /><mxPoint x="2105" y="205" /></Array></mxGeometry></mxCell><mxCell id="workloads_gov_box" value="" style="rounded=1;html=0;fillColor=#f8fafc;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1870" y="205" width="470" height="230" as="geometry" /></mxCell><mxCell id="workloads_gov_hdr" value="Workloads OU Governance (SCP 6 Enforced | ASM-006)" style="rounded=1;arcSize=8;html=0;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1;fontColor=#92400e;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1870" y="205" width="470" height="28" as="geometry" /></mxCell><mxCell id="workloads_gov_text" value="• SCP 6 Enforced: Requires Environment &amp; CostCenter tags on creation&#10;• Complete Account Isolation: dev (10.80), qa (10.81), pdn (10.82)&#10;• One state bucket per environment, S3 native locking [D02]&#10;• Pipeline Deploy Roles: GitHub Actions OIDC federation [D06]&#10;• Production Protection: SCP 7 denies human write actions in pdn" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1885" y="245" width="445" height="100" as="geometry" /></mxCell><mxCell id="badge_d02_gov" value="D02" style="ellipse;html=0;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1885" y="360" width="28" height="28" as="geometry" /></mxCell><mxCell id="badge_d03_gov" value="D03" style="ellipse;html=0;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" pa