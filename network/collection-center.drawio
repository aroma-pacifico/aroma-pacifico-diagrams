          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="547" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_bak_wan" value="Cellular Backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;fontColor=#0369a1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="535" width="115" height="24" as="geometry" />
        </mxCell>

        <mxCell id="note_cloudlink" value="Edge rule: 10.4x.20.0/24 never bridged into switch trunk.&#10;Provider public IPs are external; WAN failover activates backup tunnel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="595" width="520" height="45" as="geometry" />
        </mxCell>

        <!-- Perimeter Firewall Appliance [D07] -->
        <mxCell id="node_firewall" value="PERIMETER FIREWALL APPLIANCE [D07]&#10;Edge: 10.4x.20.1 | Mgmt: 10.4x.10.1 | Gateways: 10.4x.Z.1&#10;- Stateful Zone Inspection: Rules CC-01 to CC-DEF (firewall-policy.md sec 4)&#10;- Dual IPsec VPN Tunnels: UDP 500 / 4500 NAT-T, IP 50 ESP to AWS Hub&#10;- Subinterfaces: .1 default gateway for VLANs 101-105 and 110&#10;- Gateway Services: DHCP server &amp; DNS conditional forwarder (.1)&#10;- Local RADIUS Server: 802.1X EAP-TLS with cached CRL for offline auth&#10;- QoS Traffic Shaper: Priority 1 to 5 bandwidth guarantees and caps&#10;- Dual Contexts: Internal LAN context vs Internet-only routing context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=3;fontColor=#991b1b;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacingLeft=25;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="660" y="360" width="670" height="290" as="geometry" />
        </mxCell>
        <mxCell id="badge_d07" value="[D07] Pattern Firewall Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=#991b1b;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="370" width="230" height="28" as="geometry" />
        </mxCell>

        <!-- Managed Switch & APs -->
        <mxCell id="node_switch_box" value="MANAGED PoE ACCESS SWITCH (VLAN 110)&#10;Management: 10.4x.10.2 to .9 | Static assignment&#10;- 802.1Q Trunk from firewall on dedicated access trunk port&#10;- Access ports with 802.1X EAP-TLS port admission for staff&#10;- MAC-based port security for Code-Sheet Printers (ASM-124)&#10;- Layer 2 only: does not route; switches only carry VLAN tags (ASM-080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacingLeft=25;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="360" width="630" height="135" as="geometry" />
        </mxCell>
        <mxCell id="flow_fw_switch" value="" style="strokeColor=#2563eb;strokeWidth=3;fontColor=#1e40af;fontSize=12;endArrow=block;" edge="1" source="node_firewall" target="node_switch_box" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1345" y="427" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_fw_switch" value="802.1Q VLAN Trunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e40af;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1285" y="325" width="150" height="24" as="geometry" />
        </mxCell>

        <mxCell id="node_aps_box" value="MANAGED Wi-Fi ACCESS POINTS (VLAN 110)&#10;Management: 10.4x.10.20 to .49 | DHCP reservation by MAC&#10;- 5 SSIDs broadcast per radio (cc-management, cc-support, cc-logistics, cc-transport, cc-guest)&#10;- WPA3-Enterprise (802.1X EAP-TLS) for staff zones; WPA3-Personal (SAE) for guests&#10;- Client Isolation enforced on cc-transport &amp; cc-guest SSIDs (ASM-081)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacingLeft=25;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="515" width="630" height="135" as="geometry" />
        </mxCell>
        <mxCell id="flow_switch_aps" value="" style="strokeColor=#2563eb;strokeWidth=3;fontColor=#1e40af;fontSize=12;endArrow=block;" edge="1" source="node_switch_box" target="node_aps_box" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1675" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_switch_aps" value="PoE + Trunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e40af;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1695" y="498" width="100" height="22" as="geometry" />
        </mxCell>

        <!-- Corridor 2 Flow: Firewall to Cloud Admin (y=680) -->
        <mxCell id="flow_fw_admin" value="" style="strokeColor=#15803d;strokeWidth=3;fillColor=#15803d;fontColor=#14532d;fontSize=12;endArrow=block;" edge="1" source="node_firewall" target="tier_admin" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="650" />
              <mxPoint x="1300" y="680" />
              <mxPoint x="2270" y="680" />
              <mxPoint x="2270" y="990" />
              <mxPoint x="2675" y="990" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ROW 2: Staff & Infrastructure Zones (y=720 to 1180) -->
        <!-- Gerencia (101) -->
        <mxCell id="zone_gerencia" value="GERENCIA (Management) | VLAN 101 | CIDR: 10.4x.1.0/24&#10;- SSID: cc-management (WPA3-Enterprise 802.1X EAP-TLS)&#10;- Gateway: 10.4x.1.1 (Firewall subinterface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="720" width="560" height="460" as="geometry" />
        </mxCell>
        <mxCell id="node_gerencia_detail" value="Gerencia Operational Context&#10;- Planned Clients: 2 wired desktops, 5 Wi-Fi smartphones (7 clients)&#10;- DHCP Pool: 10.4x.1.50 to .69 (20 hosts, lease 12 h)&#10;- Traffic Class: Staff Class (Priority 4, 28/7 Mbps guaranteed)&#10;- Allowed Flows:&#10;  * AWS Application tier: Center web app &amp; reports [CC-STF-01] (TCP 443)&#10;  * Local Code-Sheet Printers: Administrative printing [CC-STF-02] (TCP 631)&#10;  * External Internet: Web breakout [CC-STF-04] (TCP 80/443, UDP 443)&#10;- Explicit Deny: Inter-zone to Soporte, Logística, Guests [CC-STF-03]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="825" width="520" height="325" as="geometry" />
        </mxCell>

        <!-- Servidores Locales (110) & Printers -->
        <mxCell id="zone_servidores" value="SERVIDORES LOCALES (Local Servers) | VLAN 110 | CIDR: 10.4x.10.0/24&#10;- SSID: None (Wired infrastructure only, fixed switch ports)&#10;- Gateway: 10.4x.10.1 (Firewall management interface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="720" width="670" height="460" as="geometry" />
        </mxCell>
        <mxCell id="node_printers" value="Code-Sheet Network Printers (10.4x.10.50 to .59)&#10;- Two network printers wired to PoE switch with MAC port security (ASM-124)&#10;- Local Print Ingress (TCP 631 IPP):&#10;  * From Logística: Un-coded coffee sack tags [CC-LOG-02]&#10;  * From Gerencia &amp; Soporte: Administrative printing [CC-STF-02]&#10;- Offline Operation: Print jobs stay local on LAN; never cross WAN (ASM-124)&#10;- Ingress Only: Printers never initiate outbound traffic [CC-ADM-04]&#10;- Ingress Administration: Accepted strictly from Cloud admin tier [CC-ADM-01]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="680" y="825" width="630" height="325" as="geometry" />
        </mxCell>
        <mxCell id="lbl_stf_print" value="CC-STF-02: Staff print (TCP 631 IPP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontColor=#14532d;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="870" y="792" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="flow_gerencia_print" value="" style="strokeColor=#15803d;strokeWidth=3;fillColor=#15803d;fontColor=#14532d;fontSize=12;endArrow=block;" edge="1" source="node_gerencia_detail" target="node_printers" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="645" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_soporte_print" value="" style="strokeColor=#15803d;strokeWidth=3;fillColor=#15803d;fontColor=#14532d;fontSize=12;endArrow=block;" edge="1" source="node_drone_station" target="node_printers" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1345" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Soporte (102) & Drone Station -->
        <mxCell id="zone_soporte" value="SOPORTE (Support) | VLAN 102 | CIDR: 10.4x.2.0/24&#10;- SSID: cc-support (WPA3-Enterprise 802.1X EAP-TLS)&#10;- Gateway: 10.4x.2.1 (Firewall subinterface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="720" width="630" height="460" as="geometry" />
        </mxCell>
        <mxCell id="node_drone_station" value="Drone Ground Station: 10.4x.2.10/32 (Fixed DHCP Reservation)&#10;- Contracted operator ground station (ADR-002, ASM-082)&#10;- Private client certificate for network and cloud authentication&#10;- Allowed Cloud Ingress:&#10;  * Application tier: Mission preload &amp; upload grant [CC-DRN-01] (TCP 443)&#10;  * Object storage tier: Multipart flight &amp; imagery upload [CC-DRN-03] (TCP 443)&#10;  * AWS IoT Core: Kit grant topic via local breakout [CC-DRN-04] (TCP 8883)&#10;- Explicit Denies:&#10;  * drone_object_ingress tier (RESERVED in pilot, ASM-140) [CC-DRN-02] DENIED&#10;  * Any other destination [CC-DRN-05]; rest of Soporte denied drone paths [CC-DRN-06]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1380" y="825" width="590" height="325" as="geometry" />
        </mxCell>

        <!-- Corridor 3 Flows: Admin Ingress & Logistica Egress (y=1180 to 1260) -->
        <mxCell id="flow_admin_mgmt" value="" style="strokeColor=#15803d;strokeWidth=3;fillColor=#15803d;fontColor=#14532d;fontSize=12;endArrow=block;" edge="1" source="tier_admin" target="zone_servidores" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2675" y="1040" />
              <mxPoint x="2300" y="1040" />
              <mxPoint x="2300" y="1200" />
              <mxPoint x="1000" y="1200" />
              <mxPoint x="1000" y="1180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_admin_mgmt" value="CC-ADM-01 / CL-ADM-03: Session Administration from Cloud (SSH 22, HTTPS 443 via Tunnel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontColor=#14532d;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="1172" width="560" height="24" as="geometry" />
        </mxCell>

        <mxCell id="flow_log_cloud" value="" style="strokeColor=#15803d;strokeWidth=3;fillColor=#15803d;fontColor=#14532d;fontSize=12;endArrow=block;" edge="1" source="node_reception_posts" target="tier_app" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="1400" />
              <mxPoint x="640" y="1400" />
              <mxPoint x="640" y="1238" />
              <mxPoint x="2330" y="1238" />
              <mxPoint x="2330" y="780" />
              <mxPoint x="2675" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_log_corridor" value="CC-LOG-01: Reception Outbox to Cloud App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontColor=#14532d;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1210" width="310" height="24" as="geometry" />
        </mxCell>

        <mxCell id="flow_log_print" value="" style="strokeColor=#15803d;strokeWidth=3;fillColor=#15803d;fontColor=#14532d;fontSize=12;endArrow=block;" edge="1" source="node_reception_posts" target="node_printers" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="1360" />
              <mxPoint x="650" y="1360" />
              <mxPoint x="650" y="1165" />
              <mxPoint x="730" y="1165" />
              <mxPoint x="730" y="1150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_log_print" value="CC-LOG-02: Code sheets (TCP 631 IPP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontColor=#14532d;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="665" y="1140" width="260" height="22" as="geometry" />
        </mxCell>

        <!-- Flow: Guests/Transport Denied to Logistica (routes cleanly in Corridor 3) -->
        <mxCell id="flow_gst_deny_internal" value="" style="strokeColor=#dc2626;strokeWidth=3;dashed=1;dashPattern=6 3;fillColor=#dc2626;fontColor=#b91c1c;fontSize=12;endArrow=block;" edge="1" source="zone_transporte" target="zone_logistica" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="1260" />
              <mxPoint x="680" y="1215" />
              <mxPoint x="350" y="1215" />
              <mxPoint x="350" y="1260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_gst_deny" value="CC-GST-01/02 DENIED: Guests/Transport no route to LAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="1188" width="360" height="24" as="geometry" />
        </mxCell>

        <!-- ROW 3: Operation & Public Zones (y=1260 to 1800) -->
        <!-- Logística (103) -->
        <mxCell id="zone_logistica" value="LOGÍSTICA (Logistics Yard &amp; Reception) | VLAN 103 | CIDR: 10.4x.3.0/24&#10;- SSID: cc-logistics (WPA3-Enterprise 802.1X EAP-TLS)&#10;- Gateway: 10.4x.3.1 (Firewall subinterface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1260" width="560" height="540" as="geometry" />
        </mxCell>
        <mxCell id="node_reception_posts" value="Reception Workstations (10.4x.3.2 &amp; 10.4x.3.3)&#10;- Two receiving posts wired to 802.1X access ports; operator MFA&#10;- Encrypted Local Outbox (ASM-079): stores Part C intake when offline&#10;- S3 / Application Cloud Path: TCP 443 via tunnel [CC-LOG-01]&#10;- Local Printing: Sends print jobs to Code-Sheet Printers (TCP 631) [CC-LOG-02]&#10;- Automatic Drain: Outbox drains to AWS app tier upon link recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontColor=#1e3a8a;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1340" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="node_scanners" value="Logistics Yard Handheld Scanners (10.4x.3.50-.99)&#10;- 20 Wi-Fi mobile scanners on cc-logistics SSID (WPA3-Enterprise)&#10;- Device certificate admission against local RADIUS EAP-TLS&#10;- Barcode and code-sheet verification on incoming coffee sacks&#10;- Reaches AWS application tier via tunnel [CC-LOG-01]&#10;- Traffic Class: Logistics Class (Priority 2, 44/11 Mbps guaranteed)&#10;- Explicit Deny: General internet [CC-LOG-04]; other client zones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1560" width="520" height="215" as="geometry" />
        </mxCell>

        <!-- Transporte (104) -->
        <mxCell id="zone_transporte" value="TRANSPORTE (Transport) | VLAN 104 | CIDR: 10.4x.4.0/24&#10;- SSID: cc-transport (WPA3-Personal SAE, rotated per harvest)&#10;- Gateway: 10.4x.4.1 (Firewall subinterface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="1260" width="670" height="540" as="geometry" />
        </mxCell>
        <mxCell id="node_transporte_detail" value="Transporter Operational &amp; Isolation Context&#10;- Planned Clients: 20 transporter smartphones (DHCP pool: 10.4x.4.50-.89, lease 4 h)&#10;- Wireless Client Isolation: ENABLED (phone-to-phone communication blocked)&#10;- Routing Context: INTERNET-ONLY CONTEXT (no route to internal LAN or tunnel)&#10;- Traffic Classes: Transport App (Priority 4, 2/1M gtd) &amp; Non-op (Priority 5, capped)&#10;- Allowed Cloud Ingress via Local Breakout:&#10;  * Public Application API: Custody transfer events &amp; GPS [CC-TEL-02] (TCP 443)&#10;  * Public Sack Lookup: Front door lookup [CC-PUB-01] (TCP 443)&#10;- Explicit Denies:&#10;  * Internal LAN &amp; Cloud tiers [CC-GST-02, CC-GST-03] DENIED&#10;  * Outbound SMTP port 25 relaying [CC-GST-04] DENIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="680" y="1340" width="630" height="435" as="geometry" />
        </mxCell>

        <!-- Visitantes (105) -->
        <mxCell id="zone_visitantes" value="VISITANTES (Visitors / Guests) | VLAN 105 | CIDR: 10.4x.5.0/24&#10;- SSID: cc-guest (WPA3-Personal SAE, weekly rotated passphrase)&#10;- Gateway: 10.4x.5.1 (Firewall subinterface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1260" width="630" height="540" as="geometry" />
        </mxCell>
        <mxCell id="node_guest_detail" value="Guest Isolation Context (Case Statement Requirement)&#10;- &quot;La VLAN de visitantes no enruta hacia logística ni gerencia&quot; (CC-GST-01)&#10;- Planned Clients: 10 guest smartphones (DHCP pool: 10.4x.5.50-.69, lease 1 h)&#10;- Wireless Client Isolation: ENABLED (guest-to-guest communication blocked)&#10;- Routing Context: INTERNET-ONLY CONTEXT (no route to 10.4x or 10.40.0.0/13)&#10;- Traffic Class: Non-operational (P5 capped at 10/2.5M, 2/0.5M/client, ASM-125)&#10;- Allowed Flows via Local Breakout:&#10;  * External Web: TCP 80/443, UDP 443 [CC-GST-05]&#10;  * Public Sack Lookup: TCP 443 [CC-PUB-01]&#10;- Explicit Denies: Internal LAN [CC-GST-01], Cloud [CC-GST-03], SMTP 25 [CC-GST-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1340" width="590" height="435" as="geometry" />
        </mxCell>

        <!-- Site Bottom Summary Note -->
        <mxCell id="note_site_policy" value="Perimeter Firewall Appliance [D07] statefully enforces inter-zone rules CC-01 to CC-DEF. Full policy intent matrix, QoS specifications, and addressing plan are documented in network/README.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="1840" width="1920" height="35" as="geometry" />
        </mxCell>

        <!-- RIGHT SIDE: AWS Cloud & Internet (x=2650 to 3560) -->
        <!-- AWS NETWORK ACCOUNT HUB [D05] -->
        <mxCell id="box_hub" value="AWS NETWORK ACCOUNT HUB | us-east-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede2fe;strokeColor=#7c3aed;strokeWidth=3;fontColor=#4c1d95;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="2650" y="295" width="910" height="230" as="geometry" />
        </mxCell>
        <mxCell id="badge_d05" value="[D05] Association with Pattern Center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5b21b6;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3250" y="305" width="290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="node_tgw_hub" value="AWS Transit Gateway Hub (tgw-hub)&#10;- Central hub for collection-center connectivity and cross-account routing&#10;- Static routing: 10.4x.0.0/16 only; cannot be widened by center firewall (CL-LNK-06)&#10;- Route Table &#x27;centers&#x27;: static routes to pdn VPC tiers; all other 10.80.0.0/13 blackholed&#10;- Hub carries no center-to-center path (CL-LNK-02, CC-LNK-09)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c4fff;strokeWidth=2;fontColor=#3b0764;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="2675" y="345" width="550" height="165" as="geometry" />
        </mxCell>
        <mxCell id="icon_tgw" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="1">
          <mxGeometry x="3150" y="430" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="node_vpn_hub" value="Site-to-Site VPN Connection&#10;- 2 IPsec Tunnels per center&#10;- Certificate Customer Gateway&#10;- Traceability: PD-120, ASM-078&#10;- Ports: UDP 500 / 4500 (NAT-T), IP 50 ESP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c4fff;strokeWidth=2;fontColor=#3b0764;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="3245" y="345" width="295" height="165" as="geometry" />
        </mxCell>
        <mxCell id="icon_vpn" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="1">
          <mxGeometry x="3470" y="430" width="55" height="55" as="geometry" />
        </mxCell>

        <!-- AWS WORKLOAD ACCOUNT PRODUCTION VPC [D04] -->
        <mxCell id="box_vpc" value="AWS WORKLOAD ACCOUNT | PRODUCTION VPC (pdn) 10.82.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=3;fontColor=#14532d;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="2650" y="540" width="910" height="760" as="geometry" />
        </mxCell>
        <mxCell id="badge_d04" value="[D04] VPC and Tiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=#166534;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3360" y="550" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="icon_vpc" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#ffffff;strokeColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.virtual_private_cloud;" vertex="1" parent="1">
          <mxGeometry x="3305" y="545" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- VPC Tiers -->
        <mxCell id="tier_transit" value="transit tier | 10.82.0.0/20 (/28 attachment subnets)&#10;Transit Gateway VPC Attachment. Network ACL allows only 10.40.0.0/13 and 10.82.0.0/16 [CL-LNK-08]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="590" width="860" height="65" as="geometry" />
        </mxCell>
        <mxCell id="tier_app" value="application tier | 10.82.48.0/20 - AWS Interface Endpoints (execute-api, cognito-idp)&#10;- Reached on TCP 443 by Logística (reception &amp; sack reads [CC-LOG-01])&#10;- Reached on TCP 443 by Gerencia &amp; Soporte (reports web &amp; center app [CC-STF-01])&#10;- Reached on TCP 443 by Drone Ground Station (mission preload &amp; grant [CC-DRN-01])&#10;- Endpoint policy restricts access strictly to platform private API ARNs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="665" width="860" height="135" as="geometry" />
        </mxCell>
        <mxCell id="icon_cognito" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="3470" y="720" width="55" height="55" as="geometry" />
        </mxCell>

        <mxCell id="tier_storage" value="object_storage tier | 10.82.80.0/20 - Amazon S3 Interface Endpoint [CL-DRN-01, CL-DRN-02]&#10;- Reached on TCP 443 strictly by Drone Ground Station (10.4x.2.10/32 only) [CC-DRN-03]&#10;- Multipart upload of flight records and high-resolution imagery&#10;- Endpoint policy restricts access strictly to platform drone object bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="810" width="860" height="125" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="3470" y="860" width="55" height="55" as="geometry" />
        </mxCell>

        <mxCell id="tier_admin" value="administration tier | 10.82.96.0/20 - Session Host, Route 53 Resolver &amp; Observability&#10;- Session Host initiates SSH/HTTPS (TCP 22/443) to center mgmt (10.4x.10.1-.49) [CC-ADM-01 / CL-ADM-03]&#10;- Route 53 Resolver Inbound Endpoint (UDP/TCP 53) resolves private endpoints [CC-LNK-04]&#10;- CloudWatch Logs / Metrics &amp; Roles Anywhere interface endpoints (TCP 443) [CC-ADM-02]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="945" width="860" height="145" as="geometry" />
        </mxCell>
        <mxCell id="icon_resolver" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.route_53_resolver;" vertex="1" parent="1">
          <mxGeometry x="3400" y="1005" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="icon_cw" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="3475" y="1005" width="55" height="55" as="geometry" />
        </mxCell>

        <mxCell id="tier_drone_reserved" value="drone_object_ingress tier | 10.82.32.0/20 (RESERVED TIER - NO ENDPOINTS IN PILOT)&#10;- RESERVED TIER: No interface endpoint created in pilot (ASM-140, CC-DRN-02)&#10;- Ground station routes directly to application and object_storage endpoints&#10;- Traffic from center ground station to this tier is explicitly DENIED and blackholed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#991b1b;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="1100" width="860" height="115" as="geometry" />
        </mxCell>
        <mxCell id="note_vpc_tiers" value="Other VPC tiers (public_query, telemetry_ingress, data) have no route to centers and are blackholed at TGW [CL-LNK-02].&#10;Non-production environments (dev, qa) never reach centers [CL-LNK-04]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="2675" y="1225" width="860" height="55" as="geometry" />
        </mxCell>

        <!-- PUBLIC INTERNET & EDGE SERVICES -->
        <mxCell id="box_internet" value="PUBLIC INTERNET &amp; AWS EDGE SERVICES (Local Breakout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=3;fontColor=#0369a1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="2650" y="1320" width="910" height="560" as="geometry" />
        </mxCell>
        <mxCell id="marker_deny_inbound" value="CC-LNK-08 DENIED: Inbound traffic from Internet to Center LAN or Firewall is dropped and logged. No public management." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2675" y="1365" width="860" height="35" as="geometry" />
        </mxCell>
        <mxCell id="node_iot_core" value="AWS IoT Core Data Endpoint (Public us-east-1) [CL-TEL-01]&#10;- TCP 8883 (MQTT over TLS, mutual X.509 client certificate authentication)&#10;- Used by Drone Ground Station (10.4x.2.10/32) for grant topic [CC-DRN-04]&#10;- Telemetry ingress reservation in VPC is not used for collection centers (ASM-140)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="1410" width="860" height="105" as="geometry" />
        </mxCell>
        <mxCell id="icon_iot" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="3470" y="1440" width="55" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_public_api" value="Public Application API Front Door &amp; Sack Lookup [CL-TEL-03, CC-PUB-01]&#10;- Amazon CloudFront + AWS WAF + Cognito token validation (TCP 443)&#10;- Reached by Transporters (10.4x.4.0/24) for positions &amp; custody events [CC-TEL-02]&#10;- Reached by Transporters &amp; Visitors for public sack lookup [CC-PUB-01]&#10;- Logística reads sacks privately through tunnel application endpoint [CC-LOG-01]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2675" y="1525" width="860" height="120" as="geometry" />
        </mxCell>
        <mxCell id="icon_cf" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="3400" y="1565" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="icon_waf" value="" style="outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1">
          <mxGeometry x="3475" y="1565" width="55" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_ext_web" value="External Internet Web &amp; Vendor Update Services [CC-STF-04, CC-GST-05]&#10;- TCP 80/443, UDP 443 for Gerencia/Soporte staff web access (staff class, 28/7 Mbps gtd)&#10;- TCP 80/443 for Transporte &amp; Visitantes non-operational web (strictly capped, Priority 5)&#10;- Vendor OS/device management update allow-list for Logística [CC-LOG-03]&#10;- Port 25 SMTP relaying from guest/transporter phones [CC-GST-04] DENIED&#10;- Inbound connection initiation from internet to center [CC-LNK-08] DENIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
