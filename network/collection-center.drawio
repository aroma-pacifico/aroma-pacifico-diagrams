  <mxGeometry x="3160" y="395" width="60" height="60" as="geometry" />
</mxCell>
<mxCell id="node_vpn_hub" value="Site-to-Site VPN Connection&#10;- 2 IPsec Tunnels per center&#10;- Certificate Customer Gateway&#10;  (PD-120, ASM-078)&#10;- UDP 500 / 4500, IP 50 ESP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c4fff;strokeWidth=2;fontColor=#3b0764;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
