        </mxCell>
        <mxCell id="lbl_tunnel_pri" value="IPsec Tunnel 1 (Primary 100M Fiber): UDP 500 / 4500 (NAT-T), IP 50 ESP [CC-LNK-01, CC-LNK-02]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1600" y="254" width="620" height="26" as="geometry" />
        </mxCell>

        <!-- SITE CONTAINER (Left Side: x=40, y=295, w=1980, h=1595) -->
        <mxCell id="site_cc" value="COLLECTION CENTER SITE BOUNDARY | Parameterized Network 10.4x.0.0/16 (Summary: 10.40.0.0/13) — Cauca, Huila, Tolima" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=3;fontColor=#102a43;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=30;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="1980" height="1595" as="geometry" />
        </mxCell>

        <!-- ROW 1: Cloud Link, Firewall, Access Switch & APs (y=360 to 650) -->
        <mxCell id="zone_cloudlink" value="ENLACE A LA NUBE (Cloud Link) | VLAN 120 | 10.4x.20.0/24&#10;Wired only on firewall edge ports (never bridged to switch trunk, ASM-088)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="560" height="290" as="geometry" />
        </mxCell>
        <mxCell id="node_fw_edge" value="Firewall Edge Interface&#10;10.4x.20.1&#10;(Source IP toward Hub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="415" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="node_isp_pri" value="Primary WAN Equipment&#10;10.4x.20.2&#10;100 Mbps Symmetric Fiber" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
