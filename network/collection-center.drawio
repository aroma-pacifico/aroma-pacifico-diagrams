  <mxGeometry x="3470" y="740" width="55" height="55" as="geometry" />
</mxCell>
<mxCell id="tier_storage" value="object_storage tier | 10.82.80.0/20 - Amazon S3 Interface Endpoint [CL-DRN-01, CL-DRN-02]&#10;- Reached on TCP 443 strictly by Drone Ground Station (10.4x.2.10/32 only) [CC-DRN-03]&#10;- Multipart upload of flight records and high-resolution imagery&#10;- Endpoint policy restricts access strictly to platform drone object bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
