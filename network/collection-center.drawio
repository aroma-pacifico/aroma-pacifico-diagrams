          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_pri_wan" value="Primary WAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;fontColor=#0369a1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="275" y="440" width="90" height="24" as="geometry" />
        </mxCell>

        <mxCell id="node_isp_bak" value="Cellular Backup Router&#10;10.4x.20.3&#10;LTE+ Backup Link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
