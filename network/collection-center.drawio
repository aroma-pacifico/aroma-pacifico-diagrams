  <mxGeometry x="3470" y="895" width="55" height="55" as="geometry" />
</mxCell>
<mxCell id="tier_admin" value="administration tier | 10.82.96.0/20 - Session Host, Route 53 Resolver &amp; Observability&#10;- Session Host initiates SSH/HTTPS (TCP 22/443) to center mgmt (10.4x.10.1-.49) [CC-ADM-01 / CL-ADM-03]&#10;- Route 53 Resolver Inbound Endpoint (UDP/TCP 53) resolves private endpoints [CC-LNK-04]&#10;- CloudWatch Logs / Metrics &amp; Roles Anywhere interface endpoints (TCP 443) [CC-ADM-02]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
