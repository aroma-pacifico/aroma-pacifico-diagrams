<mxCell id="node_iot_core" value="AWS IoT Core Data Endpoint (Public us-east-1) [CL-TEL-01]&#10;- TCP 8883 (MQTT over TLS, mutual X.509 client certificate authentication)&#10;- Used by Drone Ground Station (10.4x.2.10/32) for grant topic [CC-DRN-04]&#10;- Telemetry ingress reservation in VPC is not used for collection centers (ASM-140)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
