<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="collection-center" name="Collection Center Network Pattern">
    <mxGraphModel dx="3600" dy="1920" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3600" pageHeight="1920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title & Subtitle -->
        <mxCell id="title" value="Collection Center Network Pattern (10.4x.0.0/16)" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="3480" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One repeatable pattern deployed across three centers: Cauca (10.41.0.0/16), Huila (10.42.0.0/16), Tolima (10.43.0.0/16) inside 10.40.0.0/13. Shows zones, VLANs, SSIDs, perimeter firewall [D07], uplinks to hub [D05], production VPC tiers [D04], offline logistics, code-sheet printing, and inter-zone policy intent." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#334e68;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="3480" height="40" as="geometry" />
        </mxCell>

        <!-- Top Overview Cards -->
        <mxCell id="card_params" value="CENTER PARAMETERS&#10;- Pattern CIDR: 10.4x.0.0/16 within 10.40.0.0/13&#10;- Cauca: 10.41.0.0/16 | Huila: 10.42.0.0/16 | Tolima: 10.43.0.0/16&#10;- Summary Route: 10.40.0.0/13 routed via AWS Transit Gateway&#10;- Authority: docs/collection-center-network.md &amp; docs/addressing-plan.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="620" height="95" as="geometry" />
        </mxCell>
        <mxCell id="card_wan" value="WAN &amp; TRAFFIC CLASSES (ASM-084..086)&#10;- Primary WAN: 100 Mbps symmetric (90M planned + 10M IPsec/control)&#10;- Backup: Cellular LTE+ auto-failover; non-operational traffic dropped&#10;- QoS P1: Network control (2/2M gtd) | P2: Logistics (44/11M gtd)&#10;- QoS P3: Drone (5/20M gtd) | P4: Staff (28/7M gtd) | P5: Non-op (capped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="680" y="115" width="680" height="95" as="geometry" />
        </mxCell>
        <mxCell id="card_trace" value="TRACEABILITY &amp; IAC BOXES (architecture.md sec 14, ASM-200)&#10;- [D05] Association of Environment with Pattern Center (B05: TGW hub &amp; VPN)&#10;- [D07] Pattern Firewall Rules (B07: Perimeter firewall rule set CC-01..CC-DEF)&#10;- [D04] VPC Tiers of Pattern Environment (B04: Production VPC pdn 10.82.0.0/16)&#10;- Decisions: ASM-080..089, PD-090..096, ASM-079, ASM-124, ASM-140" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1380" y="115" width="760" height="95" as="geometry" />
        </mxCell>
        <mxCell id="card_legend" value="POLICY INTENT LEGEND&#10;- Solid Green Arrow: Allowed Flow (Stateful rule, port &amp; rule ID labeled)&#10;- Dashed Red Arrow: Denied Flow (Explicit firewall deny / blackhole)&#10;- Blue Line: Physical Uplink / 802.1Q VLAN Trunk&#10;- Client Isolation: Enabled on cc-transport &amp; cc-guest SSIDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="2160" y="115" width="660" height="95" as="geometry" />
        </mxCell>
        <mxCell id="card_resilience" value="OFFLINE OPERATION GUARANTEE (ASM-079, ASM-124)&#10;- WAN Down: Logistics reception app persists to local encrypted outbox&#10;- Local Printing: Code sheets print locally over LAN (never crosses WAN)&#10;- Local Auth: RADIUS runs on firewall with cached CRL chain&#10;- Automatic Drain: Outbox drains to AWS application tier upon link recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="2840" y="115" width="680" height="95" as="geometry" />
        </mxCell>

        <!-- IPsec Tunnels in Dedicated Corridor (y=220..290) Above Containers -->
        <mxCell id="flow_tunnel_bak" value="" style="strokeColor=#7c3aed;strokeWidth=3;fillColor=#7c3aed;fontColor=#5b21b6;fontSize=12;endArrow=block;" edge="1" source="node_isp_bak" target="node_vpn_hub" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="537" />
              <mxPoint x="630" y="537" />
              <mxPoint x="630" y="238" />
              <mxPoint x="3450" y="238" />
              <mxPoint x="3450" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_tunnel_bak" value="IPsec Tunnel 2 (Cellular Backup): UDP 500 / 4500 [CC-LNK-03]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1650" y="224" width="520" height="26" as="geometry" />
        </mxCell>

        <mxCell id="flow_tunnel_pri" value="" style="strokeColor=#7c3aed;strokeWidth=3;fillColor=#7c3aed;fontColor=#5b21b6;fontSize=12;endArrow=block;" edge="1" source="node_isp_pri" target="node_vpn_hub" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="442" />
              <mxPoint x="620" y="442" />
              <mxPoint x="620" y="268" />
