<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="collection-center" name="Collection Center Network Pattern">
    <mxGraphModel dx="3600" dy="2350" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3600" pageHeight="2350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="Collection Center Network Pattern (10.4x.0.0/16)" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="3480" height="45" as="geometry" />
</mxCell>
<mxCell id="subtitle" value="One repeatable pattern deployed across three centers: Cauca (10.41.0.0/16), Huila (10.42.0.0/16), Tolima (10.43.0.0/16) inside 10.40.0.0/13. Shows zones, VLANs, SSIDs, perimeter firewall [D07], uplinks to hub [D05], production VPC tiers [D04], offline logistics, code-sheet printing, and inter-zone policy intent." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#334e68;" vertex="1" parent="1">
  <mxGeometry x="40" y="65" width="3480" height="40" as="geometry" />
</mxCell>
<mxCell id="card_params" value="CENTER PARAMETERS&#10;- Pattern CIDR: 10.4x.0.0/16 within 10.40.0.0/13&#10;- Cauca: 10.41.0.0/16 | Huila: 10.42.0.0/16 | Tolima: 10.43.0.0/16&#10;- Summary Route: 10.40.0.0/13 routed via AWS Transit Gateway&#10;- Authority: docs/collection-center-network.md &amp; docs/addressing-plan.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="40" y="115" width="620" height="100" as="geometry" />
</mxCell>
<mxCell id="card_wan" value="WAN &amp; TRAFFIC CLASSES (ASM-084..086)&#10;- Primary WAN: 100 Mbps symmetric (90M planned + 10M IPsec/control)&#10;- Backup: Cellular LTE+ auto-failover; non-operational traffic dropped&#10;- QoS P1: Network control (2/2M gtd) | P2: Logistics (44/11M gtd)&#10;- QoS P3: Drone (5/20M gtd) | P4: Staff (28/7M gtd) | P5: Non-op (capped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="680" y="115" width="680" height="100" as="geometry" />
</mxCell>
<mxCell id="card_trace" value="TRACEABILITY &amp; IAC BOXES (architecture.md sec 14, ASM-200)&#10;- [D05] Association of Environment with Pattern Center (B05: TGW hub &amp; VPN)&#10;- [D07] Pattern Firewall Rules (B07: Perimeter firewall rule set CC-01..CC-DEF)&#10;- [D04] VPC Tiers of Pattern Environment (B04: Production VPC pdn 10.82.0.0/16)&#10;- Decisions: ASM-080..089, PD-090..096, ASM-079, ASM-124, ASM-140" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="1380" y="115" width="760" height="100" as="geometry" />
</mxCell>
<mxCell id="card_legend" value="POLICY INTENT LEGEND&#10;- Solid Green Arrow: Allowed Flow (Stateful rule, port &amp; rule ID labeled)&#10;- Dashed Red Arrow: Denied Flow (Explicit firewall deny / blackhole)&#10;- Blue Line: Physical Uplink / 802.1Q VLAN Trunk&#10;- Client Isolation: Enabled on cc-transport &amp; cc-guest SSIDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="2160" y="115" width="660" height="100" as="geometry" />
</mxCell>
<mxCell id="card_resilience" value="OFFLINE OPERATION GUARANTEE (ASM-079, ASM-124)&#10;- WAN Down: Logistics reception app persists to local encrypted outbox&#10;- Local Printing: Code sheets print locally over LAN (never crosses WAN)&#10;- Local Auth: RADIUS runs on firewall with cached CRL chain&#10;- Automatic Drain: Outbox drains to AWS application tier upon link recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#627d98;strokeWidth=1;fontColor=#102a43;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="2840" y="115" width="680" height="100" as="geometry" />
</mxCell>
<mxCell id="site_cc" value="COLLECTION CENTER SITE BOUNDARY | Parameterized Network 10.4x.0.0/16 (Summary: 10.40.0.0/13)&#10;[Repeatable Pattern for Cauca 10.41.0.0/16, Huila 10.42.0.0/16, Tolima 10.43.0.0/16]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=3;fontColor=#102a43;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
  <mxGeometry x="40" y="235" width="2100" height="2085" as="geometry" />
</mxCell>
<mxCell id="zone_cloudlink" value="ENLACE A LA NUBE (Cloud Link) | VLAN 120 | 10.4x.20.0/24&#10;Wired only on firewall edge ports (never bridged to switch trunk, ASM-088)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="70" y="300" width="600" height="370" as="geometry" />
</mxCell>
<mxCell id="node_fw_edge" value="Firewall Edge Interface&#10;10.4x.20.1&#10;(Source IP toward Hub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="90" y="365" width="210" height="85" as="geometry" />
</mxCell>
<mxCell id="node_isp_pri" value="Primary WAN Equipment&#10;10.4x.20.2&#10;100 Mbps Symmetric Fiber&#10;(Internet Service LAN side)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="410" y="365" width="240" height="85" as="geometry" />
</mxCell>
<mxCell id="node_isp_bak" value="Cellular Backup Router&#10;10.4x.20.3&#10;LTE+ Backup Link&#10;(Auto-failover on WAN loss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="410" y="485" width="240" height="85" as="geometry" />
</mxCell>
<mxCell id="note_cloudlink" value="Edge rule: 10.4x.20.0/24 never bridged into switch trunk.&#10;Provider public IPs are external; WAN failover activates backup tunnel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="90" y="600" width="560" height="55" as="geometry" />
</mxCell>
<mxCell id="node_firewall" value="PERIMETER FIREWALL APPLIANCE [D07]&#10;Edge: 10.4x.20.1 | Mgmt: 10.4x.10.1 | Gateways: 10.4x.Z.1&#10;- Stateful Zone Inspection: Rules CC-01 to CC-DEF (firewall-policy.md sec 4)&#10;- Dual IPsec VPN Tunnels: UDP 500 / 4500 NAT-T, IP 50 ESP to AWS Hub&#10;- Subinterfaces: .1 default gateway for VLANs 101-105 and 110&#10;- Gateway Services: DHCP server &amp; DNS conditional forwarder (.1)&#10;- Local RADIUS Server: 802.1X EAP-TLS with cached CRL for offline auth&#10;- QoS Traffic Shaper: Priority 1 to 5 bandwidth guarantees and caps&#10;- Dual Contexts: Internal LAN context vs Internet-only routing context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=3;fontColor=#991b1b;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="700" y="300" width="710" height="370" as="geometry" />
</mxCell>
<mxCell id="badge_d07" value="[D07] Pattern Firewall Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=#991b1b;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="1160" y="310" width="230" height="28" as="geometry" />
</mxCell>
<mxCell id="node_switch_box" value="MANAGED PoE ACCESS SWITCH (VLAN 110)&#10;Management: 10.4x.10.2 to .9 | Static assignment&#10;- 802.1Q Trunk from firewall on dedicated access trunk port&#10;- Access ports with 802.1X EAP-TLS port admission for staff&#10;- MAC-based port security for Code-Sheet Printers (ASM-124)&#10;- Layer 2 only: does not route; switches only carry VLAN tags (ASM-080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="1440" y="300" width="680" height="180" as="geometry" />
</mxCell>
<mxCell id="node_aps_box" value="MANAGED Wi-Fi ACCESS POINTS (VLAN 110)&#10;Management: 10.4x.10.20 to .49 | DHCP reservation by MAC&#10;- 5 SSIDs broadcast per radio (cc-management, cc-support, cc-logistics, cc-transport, cc-guest)&#10;- WPA3-Enterprise (802.1X EAP-TLS) for staff zones; WPA3-Personal (SAE) for guests&#10;- Client Isolation enforced on cc-transport &amp; cc-guest SSIDs (ASM-081)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="1440" y="500" width="680" height="170" as="geometry" />
</mxCell>
<mxCell id="zone_gerencia" value="GERENCIA (Management) | VLAN 101 | 10.4x.1.0/24&#10;SSID: cc-management | WPA3-Enterprise (802.1X EAP-TLS)&#10;- Gateway: 10.4x.1.1 on Firewall subinterface&#10;- DHCP Pool: 10.4x.1.50 to .69 (20 hosts, lease 12 h)&#10;- Planned Clients: 2 wired desktops, 5 Wi-Fi phones (7 clients)&#10;- Traffic Class: Staff (Priority 4, 28/7 Mbps guaranteed)&#10;- Allowed Flows: Cloud app (CC-STF-01), Printers (CC-STF-02), Web breakout (CC-STF-04)&#10;- DENIED: Inter-zone to Soporte, Logística, Guests [CC-STF-03]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="70" y="710" width="600" height="470" as="geometry" />
</mxCell>
<mxCell id="zone_servidores" value="SERVIDORES LOCALES (Local Servers) | VLAN 110 | 10.4x.10.0/24&#10;Wired only (no SSID) | Gateway: 10.4x.10.1 (Firewall mgmt)&#10;- Addressing: Switches .2-.9, APs .20-.49 (DHCP reservations)&#10;- Dynamic DHCP: NONE; unreserved ports receive no IP&#10;- Traffic Class: Network Control (Priority 1, 2/2 Mbps guaranteed)&#10;- Ingress Administration: Accepted ONLY from Cloud administration tier [CC-ADM-01]&#10;- DENIED: General internet [CC-ADM-07]; clients cannot reach mgmt [CC-ADM-03]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="700" y="710" width="710" height="470" as="geometry" />
</mxCell>
<mxCell id="node_printers" value="Code-Sheet Network Printers: 10.4x.10.50 to .59 (Static IP)&#10;Two network printers wired to PoE switch with MAC port security (ASM-124)&#10;- Printed from Logística (TCP 631 IPP) for un-coded sacks [CC-LOG-02]&#10;- Printed from Gerencia &amp; Soporte (TCP 631 IPP) [CC-STF-02]&#10;- Local print traffic never crosses WAN; operates offline (ASM-124)&#10;- Printers NEVER initiate connections to user zones, cloud, or internet [CC-ADM-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="720" y="940" width="670" height="220" as="geometry" />
</mxCell>
<mxCell id="zone_soporte" value="SOPORTE (Support) | VLAN 102 | 10.4x.2.0/24&#10;SSID: cc-support | WPA3-Enterprise (802.1X EAP-TLS)&#10;- Gateway: 10.4x.2.1 on Firewall subinterface&#10;- DHCP Pool: 10.4x.2.50 to .69 (20 hosts, lease 12 h)&#10;- Planned Clients: 2 wired desktops, 5 Wi-Fi phones (7 clients)&#10;- Traffic Class: Staff (Priority 4) &amp; Drone Class (Priority 3, 5/20 Mbps gtd)&#10;- Allowed Flows: Cloud app (CC-STF-01), Printers (CC-STF-02), Web breakout (CC-STF-04)&#10;- DENIED: Inter-zone to Gerencia, Logística, Guests [CC-STF-03]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="1440" y="710" width="680" height="470" as="geometry" />
</mxCell>
<mxCell id="node_drone_station" value="Drone Ground Station: 10.4x.2.10/32 (Fixed DHCP Reservation)&#10;Contracted operator device (ADR-002, ASM-082) with private client certificate&#10;- To Cloud application (TCP 443): mission preload &amp; upload grant [CC-DRN-01]&#10;- To Cloud object_storage S3 (TCP 443): multipart flight upload [CC-DRN-03]&#10;- To AWS IoT Core (TCP 8883): MQTT grant topic via breakout [CC-DRN-04]&#10;- DENIED: drone_object_ingress tier (reserved, ASM-140) [CC-DRN-02]&#10;- DENIED: Any other destination [CC-DRN-05]; rest of Soporte denied drone paths [CC-DRN-06]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontSize=12;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="1460" y="940" width="640" height="220" as="geometry" />
</mxCell>
<mxCell id="zone_logistica" value="LOGÍSTICA (Logistics Yard &amp; Reception) | VLAN 103 | 10.4x.3.0/24&#10;SSID: cc-logistics | WPA3-Enterprise (802.1X EAP-TLS)&#10;- Gateway: 10.4x.3.1 on Firewall subinterface&#10;- DHCP Pool: 10.4x.3.50 to .99 (50 hosts, lease 12 h)&#10;- Planned Clients: 2 wired desktops, 20 handheld phones (22 clients)&#10;- Traffic Class: Logistics (Priority 2, 44/11 Mbps guaranteed)&#10;- Allowed Flows: Cloud app (CC-LOG-01), Code-Sheet Printers (CC-LOG-02)&#10;- DENIED: General internet [CC-LOG-04]; inter-zone to other client zones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="70" y="1220" width="600" height="480" as="geometry" />
</mxCell>
<mxCell id="node_reception_posts" value="Reception Workstations: 10.4x.3.2 &amp; 10.4x.3.3 (Wired 802.1X)&#10;Two receiving posts running Part C collection app with operator MFA&#10;- Registers sack arrivals, acceptance/rejection, and trips&#10;- Encrypted Local Outbox (ASM-079): holds records during WAN outages&#10;- Sends print requests locally to Code-Sheet Printers (TCP 631) [CC-LOG-02]&#10;- Drains outbox automatically to AWS application tier upon link recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="85" y="1430" width="570" height="130" as="geometry" />
</mxCell>
<mxCell id="node_scanners" value="Logistics Yard Handheld Scanners: 20 Wi-Fi Phones (10.4x.3.50-.99)&#10;Joined to cc-logistics SSID with 802.1X EAP-TLS device certificates&#10;- Yard operators scan barcode / code-sheet on coffee sacks&#10;- Reaches AWS application tier via tunnel [CC-LOG-01]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;fontStyle=0;" vertex="1" parent="1">
  <mxGeometry x="85" y="1575" width="570" height="105" as="geometry" />
</mxCell>
<mxCell id="zone_transporte" value="TRANSPORTE (Transport) | VLAN 104 | 10.4x.4.0/24&#10;SSID: cc-transport | WPA3-Personal (SAE, rotated per harvest)&#10;- Gateway: 10.4x.4.1 on Firewall subinterface&#10;- DHCP Pool: 10.4x.4.50 to .89 (40 hosts, lease 4 h) | 20 planned phones&#10;- Client Isolation: ENABLED (phone-to-phone communication blocked)&#10;- Routing Context: INTERNET-ONLY CONTEXT (no route to 10.4x, 10.40.0.0/13 or tunnel)&#10;- Traffic Classes: Transport App (2/1M gtd) &amp; Non-operational (20/5M capped)&#10;- Allowed Flows: Public API front door (CC-TEL-02) &amp; Sack lookup (CC-PUB-01)&#10;- DENIED: Internal LAN &amp; Cloud tiers [CC-GST-02, CC-GST-03], SMTP 25 [CC-GST-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="700" y="1220" width="710" height="480" as="geometry" />
</mxCell>
<mxCell id="node_transporte_detail" value="Transporter Operational Context:&#10;- Registered drivers transmit custody transfer events and GPS positions&#10;- Driver phones exit strictly via local internet breakout to Public API front door&#10;- Never permitted to reach internal logistics workstations or servers&#10;- Protected against spoofing and lateral movement via wireless client isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="720" y="1480" width="670" height="200" as="geometry" />
</mxCell>
<mxCell id="zone_visitantes" value="VISITANTES (Visitors / Guests) | VLAN 105 | 10.4x.5.0/24&#10;SSID: cc-guest | WPA3-Personal (SAE, weekly rotated passphrase at reception)&#10;- Gateway: 10.4x.5.1 on Firewall subinterface&#10;- DHCP Pool: 10.4x.5.50 to .69 (20 hosts, lease 1 h) | 10 planned phones&#10;- Client Isolation: ENABLED (guest-to-guest communication blocked)&#10;- Routing Context: INTERNET-ONLY CONTEXT (no route to 10.4x, 10.40.0.0/13 or tunnel)&#10;- Traffic Class: Non-operational (Priority 5, capped at 10/2.5M, 2/0.5M/client, ASM-125)&#10;- Allowed Flows: Local breakout web [CC-GST-05], Public Sack Lookup [CC-PUB-01]&#10;- DENIED: Internal LAN &amp; Cloud tiers [CC-GST-01, CC-GST-03], SMTP 25 [CC-GST-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="1440" y="1220" width="680" height="480" as="geometry" />
</mxCell>
<mxCell id="node_guest_detail" value="Guest Isolation Context (Case Statement Requirement):&#10;- &quot;La VLAN de visitantes no enruta hacia logística ni gerencia&quot; (CC-GST-01)&#10;- Enforced at Layer 3: Internet-only routing context has no routes to 10.4x&#10;- Enforced at Layer 4: Perimeter firewall explicit deny rules CC-GST-01..03&#10;- Enforced at Layer 2: Wi-Fi client isolation prevents guest-to-guest visibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="1460" y="1480" width="640" height="200" as="geometry" />
</mxCell>
<mxCell id="panel_matrix" value="INTER-ZONE POLICY INTENT MATRIX SUMMARY (firewall-policy.md sec 4 &amp; collection-center-network.md sec 6)&#10;Enforced statefully by Perimeter Firewall Appliance [D07]:&#10;- Gerencia (101): Deny other LAN | Allow Printers (631) | Allow Cloud App (443 via Tunnel) | Allow Internet Web Breakout&#10;- Soporte (102): Deny other LAN | Allow Printers (631) | Allow Cloud App (443 via Tunnel) | Allow Internet Web Breakout&#10;- Soporte Drone .10: Allow Cloud App (443) &amp; S3 Object Storage (443) | Allow IoT Core (8883) | DENIED drone_object_ingress&#10;- Logística (103): Deny other LAN | Allow Printers (631) | Allow Cloud App (443 via Tunnel) | DENIED General Internet (no breakout)&#10;- Transporte (104): Client Isolation | Deny Internal LAN &amp; Tunnel | Allow Public API Front Door (443) &amp; Lookup (443)&#10;- Visitantes (105): Client Isolation | Deny Internal LAN &amp; Tunnel | Allow Non-Op Web Breakout (capped) &amp; Lookup (443)&#10;- Servidores (110): Deny Inter-device | Accept Mgmt from Cloud Admin (22/443) | DENIED General Internet | Printers never initiate&#10;- Inbound WAN: DENIED all inbound connection initiations from Internet or Cloud to Center LAN (CC-LNK-07, CC-LNK-08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="70" y="1785" width="1340" height="510" as="geometry" />
</mxCell>
<mxCell id="panel_security" value="SECURITY &amp; ZERO-TRUST CONTROLS (ASM-080..089, PD-090..096)&#10;- 802.1X Network Admission: EAP-TLS certificate auth for staff laptops, workstations, and drone station&#10;- RADIUS Local CRL: Firewall caches certificate revocation list; validates certs locally without WAN&#10;- Printer Hardening: Static IPs, MAC port security, print-only ingress (IPP 631); cannot initiate flows (CC-ADM-04)&#10;- Reception Posts: Dedicated physical cable; local encrypted outbox stores Part C arrivals when offline&#10;- Transporter &amp; Guest Isolation: WPA3-Personal SAE, wireless client isolation, internet-only routing context&#10;- Cloud Management Ingress: Cloud operators enter AWS via IAM Identity Center MFA; session host to center mgmt&#10;- Drone Upload Isolation: Dedicated /32 reservation (10.4x.2.10) restricted to S3 endpoint; no drone ingress endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="1440" y="1785" width="680" height="510" as="geometry" />
</mxCell>
<mxCell id="box_hub" value="AWS NETWORK ACCOUNT HUB | us-east-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede2fe;strokeColor=#7c3aed;strokeWidth=3;fontColor=#4c1d95;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
  <mxGeometry x="2540" y="235" width="1020" height="275" as="geometry" />
</mxCell>
<mxCell id="badge_d05" value="[D05] Association with Pattern Center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5b21b6;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="3250" y="245" width="290" height="30" as="geometry" />
</mxCell>
<mxCell id="node_tgw_hub" value="AWS Transit Gateway Hub (tgw-hub)&#10;- Central hub for collection-center connectivity and cross-account routing&#10;- Static routing: 10.4x.0.0/16 only; cannot be widened by center firewall (CL-LNK-06)&#10;- Route Table &#x27;centers&#x27;: static routes to pdn VPC tiers; all other 10.80.0.0/13 blackholed&#10;- Hub carries no center-to-center path (CL-LNK-02, CC-LNK-09)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c4fff;strokeWidth=2;fontColor=#3b0764;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
