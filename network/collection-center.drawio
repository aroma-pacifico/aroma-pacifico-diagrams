</mxCell>
<mxCell id="note_vpc_tiers" value="Other VPC tiers (public_query, telemetry_ingress, data) have no route to centers and are blackholed at TGW [CL-LNK-02].&#10;Non-production environments (dev, qa) never reach centers [CL-LNK-04]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
