        <mxCell id="cc_cell_det_4" value="10 guest phones | Pool: .50-.69 (20) | Lease: 1h | Client isolation&lt;br/&gt;Local internet breakout only. DOES NOT ROUTE to logistics/management." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1;fontColor=#1a365d;fontSize=12;align=left;verticalAlign=middle;spacing=6;" vertex="1" edge="0" parent="1">
