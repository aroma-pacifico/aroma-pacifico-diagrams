          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="container_scaling_inset" value="INSET: SCALING PATH FROM 200 TO 1,000 FARMS | Technical Constraint &amp;amp; Capacity Headroom Analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#805ad5;strokeWidth=2;fontColor=#44337a;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=16;" vertex="1" edge="0" parent="1">
          <mxGeometry x="40" y="1500" width="2720" height="465" as="geometry" />
        </mxCell>
        <mxCell id="scaling_constraint_quote" value="&lt;b&gt;Case Statement Technical Constraint&lt;/b&gt;: &amp;quot;El patrón de red y de ingesta escala de 200 a 1.000 fincas sin rediseñar el direccionamiento ni el punto de ingesta&amp;quot; (Point 3 &amp;amp; Part A: scales from 200 to 1,000 farms without redesigning addressing or the ingestion point; ASM-032, ASM-036)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b794f4;strokeWidth=1.5;fontColor=#553c9e;fontSize=13.5;align=center;verticalAlign=middle;" vertex="1" edge="0" parent="1">
          <mxGeometry x="70" y="1550" width="2660" height="40" as="geometry" />
        </mxCell>
        <mxCell id="scale_panel_1" value="&lt;b&gt;1. Architectural Scalability: Identity, Not IP&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Zero Cloud Private IP Consumption&lt;/b&gt;: Farms DO NOT receive private cloud IP addresses (ASM-032).&lt;br/&gt;• &lt;b&gt;Public Cellular Bearer&lt;/b&gt;: Nodes publish over cellular data (or satellite IP bearer) to the regional public endpoint (AWS IoT Core).&lt;br/&gt;• &lt;b&gt;Authentication by Identity&lt;/b&gt;: Devices authenticate via mutual TLS with X.509 certificates and FarmId identities, not IP addresses.&lt;br/&gt;• &lt;b&gt;Linear Expansion&lt;/b&gt;: Scaling from 200 to 1,000 farms adds 800 device identities to the existing endpoint.&lt;br/&gt;• &lt;b&gt;Zero Network Topology Changes&lt;/b&gt;: ZERO subnet, route table, interface endpoint, or CIDR block changes required.&lt;br/&gt;• &lt;b&gt;Store-and-Forward&lt;/b&gt;: Local non-volatile encrypted outbox buffers up to 24 hours of readings when signal is absent.&lt;br/&gt;• &lt;b&gt;Transporters &amp;amp; Drones&lt;/b&gt;: Transporter phones and drone uploads over public cellular operate on the same identity principle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6bcfa;strokeWidth=1.5;fontColor=#2d3748;fontSize=13.5;align=left;verticalAlign=top;spacing=12;" vertex="1" edge="0" parent="1">
          <mxGeometry x="70" y="1605" width="860" height="335" as="geometry" />
        </mxCell>
        <mxCell id="icon_aws_iot" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" edge="0" parent="1">
          <mxGeometry x="880" y="1615" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="scale_panel_2" value="&lt;b&gt;2. Ingestion Load Scaling (5x Volume)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Pilot Baseline Load at 200 Farms (Case Statement Part A)&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Cultivation: 200 farms x 6 readings/day = 1,200 readings/day&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Active drying (harvest): 100 farms x 24 readings/day = 2,400 readings/day&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Total pilot daily load: &lt;b&gt;3,600 readings/day (~0.04 readings/sec average)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Expanded Load at 1,000 Farms (ASM-036)&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Cultivation: 1,000 farms x 6 readings/day = 6,000 readings/day&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Active drying (harvest): 500 farms x 24 readings/day = 12,000 readings/day&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Total expanded load: &lt;b&gt;18,000 readings/day (~0.21 readings/sec average)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Capacity Impact&lt;/b&gt;: 0.21 readings/second is trivial for managed AWS IoT Core data plane. Ingestion capacity scales elastically without any network redesign." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6bcfa;strokeWidth=1.5;fontColor=#2d3748;fontSize=13.5;align=left;verticalAlign=top;spacing=12;" vertex="1" edge="0" parent="1">
          <mxGeometry x="960" y="1605" width="860" height="335" as="geometry" />
        </mxCell>
        <mxCell id="scale_panel_3" value="&lt;b&gt;3. Pessimistic Address Headroom Analysis (telemetry_ingress)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Even under a deliberately pessimistic hypothetical bound where every farm consumed one private VPC IP:&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Usable addresses in telemetry_ingress active AZ slots&lt;/b&gt;: 3 x 1,019 = &lt;b&gt;3,057 usable IPs&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;200 farms consumption&lt;/b&gt;: 200 IPs (6.5% of tier capacity) -&amp;gt; &lt;b&gt;2,857 free IPs&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1,000 farms consumption&lt;/b&gt;: 1,000 IPs (32.7% of tier capacity) -&amp;gt; &lt;b&gt;2,057 free IPs&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Worst-case single AZ concentration&lt;/b&gt;: 1,000 farms fits within ONE single /22 slot (1,019 usable IPs)!&lt;br/&gt;• &lt;b&gt;Additional tier headroom without readdressing&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;* az4 slot reserved: 1,019 additional IPs&lt;br/&gt;&amp;nbsp;&amp;nbsp;* 8 reserved tier blocks (10.E.112.0 to 10.E.239.255): 32,768 IPs per environment&lt;br/&gt;• &lt;b&gt;Collection Centers&lt;/b&gt;: 10.40.0.0/13 summary route already encompasses fourth department (10.44.0.0/16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6bcfa;strokeWidth=1.5;fontColor=#2d3748;fontSize=13.5;align=left;verticalAlign=top;spacing=12;" vertex="1" edge="0" parent="1">
          <mxGeometry x="1850" y="1605" width="880" height="335" as="geometry" />
        </mxCell>
        <mxCell id="footer_traceability" value="&lt;b&gt;Traceability &amp;amp; Badges&lt;/b&gt;: D04 = Pattern VPC and Tiers (B04 / #24) | D05 = Collection Center Pattern &amp;amp; Association (B05 / #25) | ADR-001 (cloud choice) | ASM-030 to ASM-036 (addressing assumptions) | ASM-080 to ASM-089 (LAN pattern) | PD-009 (closed non-overlapping CIDRs) | PD-050 (Terraform vars) | PD-052 (firewall policies)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13.5;fontColor=#4a5568;" vertex="1" edge="0" parent="1">
          <mxGeometry x="40" y="1985" width="2720" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>