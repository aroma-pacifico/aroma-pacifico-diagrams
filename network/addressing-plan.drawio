        <mxCell id="container_wan_tgw" value="WAN Interconnection &amp;amp; AWS Transit Gateway Hub (Network Account Hub)
Single Summary Route: 10.40.0.0/13 routed through transit subnets (10.E.240.0/28)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#805ad5;strokeWidth=2;fontColor=#44337a;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" edge="0" parent="1">
          <mxGeometry x="1700" y="1115" width="1060" height="370" as="geometry" />
        </mxCell>
        <mxCell id="wan_hub_card1" value="&lt;b&gt;Primary WAN &amp;amp; Tunnel Link (ASM-085, ASM-088)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;100 Mbps symmetric internet service&lt;/b&gt; (90 Mbps usable payload + 10 Mbps IPsec overhead &amp;amp; keepalives)&lt;br/&gt;• &lt;b&gt;Cellular backup link&lt;/b&gt; with automated failover (ASM-088)&lt;br/&gt;• &lt;b&gt;Dual IPsec VPN tunnels&lt;/b&gt; from Center Firewall (10.4x.20.1) to AWS Transit Gateway Hub&lt;br/&gt;• &lt;b&gt;Staff Wi-Fi admission (RADIUS / EAP-TLS)&lt;/b&gt; validates locally against cached CRL when WAN is down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6bcfa;strokeWidth=1.5;fontColor=#44337a;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" edge="0" parent="1">
          <mxGeometry x="1725" y="1175" width="500" height="175" as="geometry" />
        </mxCell>
        <mxCell id="wan_hub_card2" value="&lt;b&gt;Hub Routing &amp;amp; Policy Enforcement (CL-TEL-04, CC-DRN-02)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;TGW Hub&lt;/b&gt; terminates center VPNs; attaches to VPC transit tier (/28)&lt;br/&gt;• &lt;b&gt;Summary Route 10.40.0.0/13&lt;/b&gt; covers present and future departments (ASM-030)&lt;br/&gt;• &lt;b&gt;Allowed through tunnel&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Logística (10.4x.3.0/24) to application tier (sacks &amp;amp; trips API)&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Ground Station (10.4x.2.10/32) to application &amp;amp; object_storage S3 endpoints&lt;br/&gt;&amp;nbsp;&amp;nbsp;* Cloud administration tier to Servidores locales (10.4x.10.0/24) for management&lt;br/&gt;• &lt;b&gt;Tier restrictions&lt;/b&gt;: telemetry_ingress has no endpoint and is empty/denied (CL-TEL-04); drone_object_ingress is reserved (ASM-140)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6bcfa;strokeWidth=1.5;fontColor=#44337a;fontSize=11.5;align=left;verticalAlign=top;spacing=10;" vertex="1" edge="0" parent="1">
          <mxGeometry x="2245" y="1175" width="495" height="175" as="geometry" />
        </mxCell>
        <mxCell id="flow_center_fw" value="&lt;b&gt;Center Firewall&lt;/b&gt;&lt;br/&gt;10.4x.20.1&lt;br/&gt;(Edge VLAN 120)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontColor=#1a365d;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" edge="0" parent="1">
          <mxGeometry x="1725" y="1365" width="175" height="95" as="geometry" />
        </mxCell>
        <mxCell id="flow_wan_pipe" value="&lt;b&gt;Dual IPsec VPN&lt;/b&gt;&lt;br/&gt;100 Mbps WAN + Cellular&lt;br/&gt;Encrypted Tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#805ad5;strokeWidth=1.5;fontColor=#44337a;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" edge="0" parent="1">
