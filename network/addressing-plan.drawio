  <diagram id="addressing_plan" name="Cloud and Site Addressing Plan">
    <mxGraphModel dx="2800" dy="2050" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2800" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Cloud and Site Addressing Plan" style="text;html=1;align=left;verticalAlign=middle;fontSize=34;fontStyle=1;fontColor=#102a43;" vertex="1" edge="0" parent="1">
          <mxGeometry x="40" y="30" width="2720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Non-overlapping private IPv4 allocations across AWS environments, VPC tiers, on-premises collection centers, and prepared Azure space (ADR-001, ASM-030 to ASM-036, PD-009)" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#334e68;" vertex="1" edge="0" parent="1">
          <mxGeometry x="40" y="80" width="2720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="box_super_cc" value="&lt;b&gt;10.40.0.0/13 | ON-PREMISES &amp;amp; WAN COLLECTION CENTERS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;10.41.0.0/16&lt;/b&gt; : Cauca Collection Center &amp;amp; site LAN growth (active)&lt;br/&gt;• &lt;b&gt;10.42.0.0/16&lt;/b&gt; : Huila Collection Center &amp;amp; site LAN growth (active)&lt;br/&gt;• &lt;b&gt;10.43.0.0/16&lt;/b&gt; : Tolima Collection Center &amp;amp; site LAN growth (active)&lt;br/&gt;• &lt;b&gt;10.44.0.0/16&lt;/b&gt; : Future fourth department space (ASM-030)&lt;br/&gt;• &lt;b&gt;10.45.0.0/16 - 10.47.255.255&lt;/b&gt; : Reserved for future center growth&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Rule: Kept strictly out of the cloud. Reached from cloud transit tier via single summary route 10.40.0.0/13.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=2;fontColor=#1a365d;fontSize=13.5;align=left;verticalAlign=top;spacing=14;" vertex="1" edge="0" parent="1">
          <mxGeometry x="40" y="130" width="660" height="240" as="geometry" />
        </mxCell>
        <mxCell id="box_super_aws" value="&lt;b&gt;10.80.0.0/13 | AWS PRIMARY CLOUD SUPERNET (us-east-1)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;10.80.0.0/16&lt;/b&gt; : Development VPC (dev), Development account&lt;br/&gt;• &lt;b&gt;10.81.0.0/16&lt;/b&gt; : Test / Pattern VPC (qa), Test account&lt;br/&gt;• &lt;b&gt;10.82.0.0/16&lt;/b&gt; : Production VPC (pdn), Production account&lt;br/&gt;• &lt;b&gt;10.83.0.0/16&lt;/b&gt; : AWS Reserve (network / security account VPC, ASM-034)&lt;br/&gt;• &lt;b&gt;10.84.0.0/14&lt;/b&gt; : AWS Reserve for future accounts (10.84.0.0 - 10.87.255.255)&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Rule: Each environment owns one distinct /16 VPC with distinct second octet (80, 81, 82).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#486581;strokeWidth=2;fontColor=#102a43;fontSize=13.5;align=left;verticalAlign=top;spacing=14;" vertex="1" edge="0" parent="1">
          <mxGeometry x="720" y="130" width="720" height="240" as="geometry" />
        </mxCell>
        <mxCell id="box_super_azure" value="&lt;b&gt;10.88.0.0/13 | AZURE SECONDARY CLOUD (PREPARED, NOT DEPLOYED)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;10.88.0.0/16&lt;/b&gt; : Reserved for Azure dev&lt;br/&gt;• &lt;b&gt;10.89.0.0/16&lt;/b&gt; : Reserved for Azure qa&lt;br/&gt;• &lt;b&gt;10.90.0.0/16&lt;/b&gt; : Reserved for Azure pdn&lt;br/&gt;• &lt;b&gt;10.91.0.0/16 to 10.95.0.0/16&lt;/b&gt; : Azure reserve space (ASM-035)&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Rule: Prepared export target only (ADR-001, ASM-035). No live deployments, no cross-cloud VPN or link.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#718096;strokeWidth=2;dashed=1;fontColor=#2d3748;fontSize=13.5;align=left;verticalAlign=top;spacing=14;" vertex="1" edge="0" parent="1">
          <mxGeometry x="1460" y="130" width="620" height="240" as="geometry" />
        </mxCell>
        <mxCell id="icon_azure_cloud" value="" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.cloud;" vertex="1" edge="0" parent="1">
          <mxGeometry x="2010" y="145" width="50" height="33" as="geometry" />
        </mxCell>
        <mxCell id="box_super_verify" value="&lt;b&gt;NON-OVERLAP VERIFICATION (PROVED)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Centers vs AWS Supernet&lt;/b&gt;: 10.47.255.255 &amp;lt; 10.80.0.0 [PASS]&lt;br/&gt;• &lt;b&gt;AWS Supernet vs Azure&lt;/b&gt;: 10.87.255.255 &amp;lt; 10.88.0.0 [PASS]&lt;br/&gt;• &lt;b&gt;AWS Environments&lt;/b&gt;: 10.80.255.255 &amp;lt; 10.81.0.0 &amp;lt; 10.82.0.0 [PASS]&lt;br/&gt;• &lt;b&gt;Prefix Boundary Alignment&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;* /13 on mod-8 octet (40, 80, 88)&lt;br/&gt;&amp;nbsp;&amp;nbsp;* /14 on mod-4 octet (84)&lt;br/&gt;&amp;nbsp;&amp;nbsp;* /22 on mod-4 octet (all tier subnets: 0, 4, 8, 12, ...)&lt;br/&gt;&amp;nbsp;&amp;nbsp;* /28 on mod-16 octet (transit subnets: 0, 16, 32, 48)&lt;br/&gt;&lt;i&gt;Verified with Python ipaddress module and exact prefix boundaries.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#38a169;strokeWidth=2;fontColor=#22543d;fontSize=12.5;align=left;verticalAlign=top;spacing=12;" vertex="1" edge="0" parent="1">
          <mxGeometry x="2100" y="130" width="660" height="240" as="geometry" />
        </mxCell>
