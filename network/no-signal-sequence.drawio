        <mxCell id="box_hop2_desc" value="HOP 2 DESIGN (Largest Field Hop, ASM-075, PD-081):&#10;Target: 60 s. Covers modem cold-wake, multi-network SIM cell attach, IP allocation, and TLS mutual auth handshake.&#10;For satellite bearer, contact pass window timing verified during procurement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065f46;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
