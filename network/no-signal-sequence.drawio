        <mxCell id="p1_phase1" value="1. NORMAL CONNECTED STATE — Direct Ingestion &amp; Acknowledgment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="275" width="1740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="msg_2001" value="1. Periodic reading taken (Crop: 4 h, Drying: 1 h, GNSS: 5 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e3a8a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#0f172a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="320" as="sourcePoint" />
            <mxPoint x="415" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_2002" value="2. MQTT Publish (QoS 1) / HTTPS POST (TLS 1.2+)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e3a8a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#0f172a;" edge="1" parent="1">
