        <mxCell id="subtitle" value="Part 1: Offline buffering, reconnection, ordered replay, and idempotent deduplication. Part 2: 7-hop end-to-end crop alert delivery budget (&lt;5 min). Source: docs/connectivity.md sections 4.3, 7, and 8." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#334e68;" vertex="1" parent="1">
