        <mxCell id="box_hop3_desc" value="HOP 3 DESIGN (ASM-003, ASM-075):&#10;Target: 20 s. Includes WAN latency Colombia -&gt; us-east-1 and absorbs transient MQTT packet retransmission at QoS 1.&#10;PUBACK arrival authorizes buffer release." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065f46;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
