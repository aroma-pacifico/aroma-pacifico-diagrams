        </mxCell>
        <mxCell id="msg_2003" value="3. Deliver payload to regional endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e3a8a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#0f172a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="935" y="375" as="sourcePoint" />
            <mxPoint x="1195" y="375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_2004" value="4. Idempotent write (Key: node_id + reading_timestamp / event_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e3a8a;strokeWidth=1.8;strokeDashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#0f172a;" edge="1" parent="1">
