<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="connectivity" name="End-to-end connectivity architecture">
    <mxGraphModel dx="3700" dy="2300" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3700" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="End-to-End Connectivity Architecture | Aroma Pacífico 2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="3620" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Complete connectivity flows (farm, wet mill, drone, transporter, collection center, and port) through IPsec, network hub, and transit to VPC tiers. Primary cloud AWS us-east-1; Azure 10.88.0.0/13 prepared, not deployed (ADR-001)." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#334e68;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="3620" height="45" as="geometry" />
        </mxCell>
        <mxCell id="grp_farm" value="1A. FIELD TELEMETRY &amp; APP CLIENTS  [D08: Pattern Farm]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="760" height="525" as="geometry" />
        </mxCell>
        <mxCell id="node_crop" value="Crop Node (Autonomous)&#10;Solar panel + battery&#10;Soil probe + temp/humidity&#10;6 readings/day (every 4 h)&#10;X.509 client cert (ASM-070)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="buf_crop" value="Encrypted Non-Volatile Buffer&#10;Store-and-forward, max 24 h (ASM-074)&#10;Drain: Live first, then oldest&#10;Drop counter on gap (PUBACK release)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#92400e;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="305" y="175" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="bearer_crop" value="Cellular LPWA Radio&#10;LTE-M / NB-IoT / Cat-1&#10;Multi-network SIM (ASM-071)&#10;MQTT QoS 1 / TLS 1.2+ (8883/443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="175" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="node_sat" value="Out-of-Coverage Farms (ASM-073):&#10;Dual-mode cellular/satellite module; contact interval &lt;=4 h;&#10;MQTT over TLS to same regional IoT Core endpoint &amp; topic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#166534;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="308" width="720" height="65" as="geometry" />
        </mxCell>
        <mxCell id="node_dry" value="Drying Node (Wet Mill)&#10;Coffee moisture &amp; grain temp&#10;24 readings/day while active&#10;MQTT over TLS (same IoT endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="app_farmer" value="Farmer Smartphone &amp; App&#10;Sack registration (weight, sack ID, farmer ID)&#10;Encrypted outbox until persistence ACK (ASM-079)&#10;HTTPS TLS 1.2+ to Public App API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="395" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="app_trans" value="Transporter Smartphone &amp; App (En Route):&#10;GNSS fix every 5 min (ASM-076); transport_position &amp; sack_custody events;&#10;7-day encrypted outbox (2,016 fixes); custody events never evicted; HTTPS TLS 1.2+." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="grp_internet" value="2A. PUBLIC BEARERS &amp; INTERNET TRANSPORT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="125" width="460" height="525" as="geometry" />
        </mxCell>
        <mxCell id="net_cellular" value="Cellular Operator Core &amp; RAN&#10;LTE-M / NB-IoT / LTE Cat-1&#10;Multi-network SIM attach (ASM-071)&#10;Public IP bearer carrying TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="855" y="175" width="410" height="115" as="geometry" />
        </mxCell>
        <mxCell id="net_satellite" value="Satellite Constellation Bearer&#10;Non-terrestrial NB-IoT / IP satellite&#10;Contact interval &lt;=4 h (ASM-073)&#10;Direct IP uplink to public internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#166534;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="855" y="308" width="410" height="105" as="geometry" />
        </mxCell>
        <mxCell id="net_public_ip" value="Public Internet Backhaul&#10;TLS 1.2+ end-to-end encryption&#10;Zero cleartext exposure (Case pt 2)&#10;Direct route to AWS us-east-1 endpoints&#10;(Farm &amp; transport bypass centers &amp; VPC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="430" width="410" height="170" as="geometry" />
        </mxCell>
        <mxCell id="grp_ingest" value="3A. AWS INGESTION FRONT DOORS (us-east-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1360" y="125" width="590" height="525" as="geometry" />
        </mxCell>
        <mxCell id="icon_iot" value="" style="shape=mxgraph.aws4.resourceIcon;align=center;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#52708a;fontColor=#172b4d;fontSize=13;fontStyle=1;resIcon=mxgraph.aws4.iot_core;verticalLabelPosition=None;verticalAlign=None;" vertex="1" parent="1">
          <mxGeometry x="1390" y="175" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="desc_iot" value="AWS IoT Core Data Endpoint [D09]&#10;Regional public endpoint in us-east-1&#10;MQTT over TLS, port 8883 / 443 ALPN&#10;Mutual X.509 cert authentication&#10;IoT Rules engine routes to DynamoDB &amp; SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="175" width="430" height="95" as="geometry" />
        </mxCell>
        <mxCell id="icon_cf" value="" style="shape=mxgraph.aws4.resourceIcon;align=center;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#52708a;fontColor=#172b4d;fontSize=13;fontStyle=1;resIcon=mxgraph.aws4.cloudfront;verticalLabelPosition=None;verticalAlign=None;" vertex="1" parent="1">
          <mxGeometry x="1390" y="300" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="desc_cf" value="Public Application API Front Door&#10;Amazon CloudFront + API Gateway&#10;HTTPS TLS 1.2+ front door&#10;Cognito auth: Farmer, Transporter, Buyer&#10;Routes to application tier services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="300" width="430" height="95" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3_pub" value="" style="shape=mxgraph.aws4.resourceIcon;align=center;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#52708a;fontColor=#172b4d;fontSize=13;fontStyle=1;resIcon=mxgraph.aws4.s3;verticalLabelPosition=None;verticalAlign=None;" vertex="1" parent="1">
          <mxGeometry x="1390" y="425" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="desc_s3_pub" value="Amazon S3 Regional Public Endpoint&#10;Pre-signed multipart upload with checksums&#10;For Drone ground station from municipal seat&#10;Short-lived URLs for order prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="425" width="430" height="95" as="geometry" />
        </mxCell>
        <mxCell id="note_direct_ingest" value="Direct Ingestion Contract: Farm nodes and phones publish straight to AWS public endpoints. They hold no cloud private IP. Adding farms scales identities, never subnets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1390" y="545" width="490" height="85" as="geometry" />
        </mxCell>
        <mxCell id="grp_drone_port" value="1B. DRONE OPERATOR &amp; PORT OF BUENAVENTURA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="760" height="480" as="geometry" />
        </mxCell>
        <mxCell id="sub_drone_box" value="Contracted Drone Operator (ADR-002, ASM-023)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="715" width="720" height="240" as="geometry" />
        </mxCell>
        <mxCell id="drone_flight" value="Drone Flight Operation&#10;Mission preloaded before takeoff&#10;Polygon &amp; no-fly zones cached&#10;Offline flight proceeds without signal&#10;Fumigation blocked until upload persisted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="755" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="drone_gs_buf" value="Ground Station Storage (No Time Limit)&#10;Flight record + high-res images buffered&#10;Multipart upload with per-part checksums&#10;Deleted only after cloud verification ACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#92400e;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="755" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="drone_routes" value="Dual Ground Station Ingress Paths:&#10;- From Collection Center: Soporte LAN 10.4x.2.10/32 -&gt; Center Firewall -&gt; IPsec VPN -&gt; VPC&#10;- From Municipal Seat: Local public data link -&gt; Public S3 &amp; Application API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1;fontColor=#5b21b6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="880" width="680" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sub_port_box" value="Port of Buenaventura (ASM-077, Case Point 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="970" width="720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="port_desc" value="Port Delivery Handoff (No Federation Equipment Deployed at Port)&#10;Transporter smartphone records sack delivery via mobile data (HTTPS TLS 1.2+)&#10;Event: sack_custody with outcome=accepted/rejected, receiver reference, and recorded_at&#10;Buffered in outbox if mobile signal drops in port terminal; closes trip trace on upload." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="1005" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="grp_center" value="2B. COLLECTION CENTER PATTERN (10.4x.0.0/16 in 10.40.0.0/13)  [D05, D07]&#10;Cauca: 10.41.0.0/16 | Huila: 10.42.0.0/16 | Tolima: 10.43.0.0/16 (Same pattern x3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="670" width="850" height="480" as="geometry" />
        </mxCell>
        <mxCell id="zone_soporte" value="Soporte | VLAN 102 | 10.4x.2.0/24 | cc-support&#10;WPA3-Ent 802.1X | Ground Station 10.4x.2.10/32&#10;Permitted: pdn app (CC-DRN-01) &amp; S3 obj (CC-DRN-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="855" y="745" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="zone_logistica" value="Logística | VLAN 103 | 10.4x.3.0/24 | cc-logistics&#10;WPA3-Ent 802.1X | 20 phones, 2 reception desktops&#10;Local outbox (ASM-079) -&gt; pdn app (CC-LOG-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1270" y="745" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="zone_gerencia" value="Gerencia | VLAN 101 | 10.4x.1.0/24 | cc-management&#10;WPA3-Ent 802.1X | 2 desktops, 5 phones (CC-STF-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="855" y="825" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="zone_servers" value="Servidores Locales | VLAN 110 | 10.4x.10.0/24 | Wired&#10;Printers .50-.59 (Code-sheets, TCP 631, CC-LOG-02)&#10;Switch/AP mgmt .2-.49 (CC-BAS-02/04, CC-ADM-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1270" y="825" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="zone_transporte" value="Transporte (Yard) | VLAN 104 | 10.4x.4.0/24 | cc-transport&#10;WPA3-Personal (SAE) | Client isolation | Breakout (CC-TEL-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="855" y="905" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="zone_visitantes" value="Visitantes | VLAN 105 | 10.4x.5.0/24 | cc-guest&#10;WPA3-Personal | Internet breakout (CC-GST-05, 2/0.5 Mbps cap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1270" y="905" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fw_box" value="Center Perimeter Firewall (10.4x.20.1) [D07]&#10;- RADIUS Server (local 802.1X auth with cached CRL)&#10;- DHCP Server &amp; DNS Forwarder to cloud resolver (CC-LNK-04)&#10;- Traffic shaping: Operational priority; non-op capped 2/0.5 Mbps&#10;- Egress: 2x IPsec VPN tunnels (IKEv2 UDP 500 / NAT-T UDP 4500, CC-LNK-01/03)&#10;- Local Breakout: Direct internet exit for guests &amp; yard; bypasses IPsec tunnel&#10;- Resilience: Primary 100 Mbps WAN (10.4x.20.2) + Cellular backup router (10.4x.20.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#92400e;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="855" y="985" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="grp_net_acct" value="3B. AWS NETWORK HUB  [D05, D07]&#10;us-east-1 | Hub Account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1715" y="670" width="335" height="265" as="geometry" />
        </mxCell>
        <mxCell id="icon_vpn" value="Site-to-Site VPN" style="shape=mxgraph.aws4.resourceIcon;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#52708a;fontColor=#172b4d;fontSize=13;fontStyle=1;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="1">
          <mxGeometry x="1735" y="745" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="desc_vpn" value="AWS Site-to-Site VPN&#10;2 active IPsec tunnels / center&#10;Terminates at Network Hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1815" y="745" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="icon_tgw" value="Transit Gateway" style="shape=mxgraph.aws4.resourceIcon;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#52708a;fontColor=#172b4d;fontSize=13;fontStyle=1;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="1">
          <mxGeometry x="1735" y="825" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="desc_tgw" value="AWS Transit Gateway (TGW) Hub&#10;Routes 10.40.0.0/13 summary&#10;Attaches to VPC transit tier&#10;Denies center-to-center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1815" y="825" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="grp_azure" value="3C. AZURE SECONDARY CLOUD (ADR-001)&#10;10.88.0.0/13 Reserved | Prepared, Not Deployed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;strokeDashed=1;fontColor=#0369a1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1715" y="950" width="335" height="205" as="geometry" />
        </mxCell>
        <mxCell id="azure_box" value="Azure Virtual Network: 10.88.0.0/13&#10;- Prepared secondary cloud export target&#10;- IaC definitions ready in code&#10;- No resources deployed in pilot&#10;- Plan-only / zero standby cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;strokeWidth=1.5;strokeDashed=1;fontColor=#0284c7;fontSize=11;align=center;verticalAlign=top;spacing=6;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1730" y="995" width="305" height="150" as="geometry" />
        </mxCell>
        <mxCell id="grp_workload" value="4. AWS WORKLOAD ACCOUNT (pdn 10.82.0.0/16) | us-east-1  [D04, D07, D10]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="2070" y="125" width="1590" height="1025" as="geometry" />
        </mxCell>
        <mxCell id="vpc_box" value="Production VPC (10.82.0.0/16)  [D04: VPC and Tiers]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2090" y="168" width="1550" height="965" as="geometry" />
        </mxCell>
        <mxCell id="tier_transit" value="transit tier (10.82.0.0/20) [D04]&#10;TGW Subnet Attachments&#10;Routes 10.40.0.0/13 from centers&#10;Propagates to allowed VPC tiers (CL-LNK-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065f46;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2110" y="255" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tier_app" value="application tier (10.82.48.0/20) [D04]&#10;Interface VPC Endpoints (TCP 443):&#10;- Application API (CC-LOG-01, CC-DRN-01)&#10;- Amazon Cognito (CC-LOG-01)&#10;Application Services &amp; Backend Workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065f46;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
