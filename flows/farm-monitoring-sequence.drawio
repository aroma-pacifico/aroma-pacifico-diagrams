        <mxCell id="call_138" value="16b. Dispatch Push: Amazon SNS Mobile Push to platform application (Android FCM / iOS APNs endpoints)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
