          </mxGeometry>
        </mxCell>
        <mxCell id="call_142" value="19. Delivery receipts: Carrier SMS receipt &amp; App push receipt update episode in Alert Store (A21 SLO tracking, PD-134)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;strokeColor=#718096;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
