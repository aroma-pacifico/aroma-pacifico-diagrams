    <mxCell id="m13a" value="13a. Dispatch SMS &amp; Push" style="edgeStyle=none;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1415" y="1038" as="sourcePoint" /><mxPoint x="1600" y="1038" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m13b" value="13b. Deliver SMS / App Push" style="edgeStyle=none;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="1068" as="sourcePoint" /><mxPoint x="1785" y="1068" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
