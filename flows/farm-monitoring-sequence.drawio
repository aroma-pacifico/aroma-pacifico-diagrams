        <mxCell id="icon_p_farmer" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#4a5568;strokeColor=#2d3748;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2820" y="240" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_farmer" value="Farmer Phone &amp; App&#10;SMS Inbox &amp; App Views&#10;Offline Local History" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=68;fillColor=#edf2f7;strokeColor=#2d3748;strokeWidth=2;fontColor=#1a202c;fontSize=12;fontStyle=1;align=center;verticalAlign=top;lifelineDashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="2755" y="298" width="170" height="1632" as="geometry" />
        </mxCell>
        <mxCell id="hdr_hop1" value="HOP 1 (Target: 10 s) | SENSOR READING TAKEN TO MESSAGE READY ON NODE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontColor=#2b6cb0;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="415" width="680" height="26" as="geometry" />
        </mxCell>
        <mxCell id="act_101" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="190" y="450" width="20" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e_self_102" value="1. Reading captured: Crop (moisture, temp, pH/NPK ref) or Drying (coffee moisture, temp)&#10;Package payload with node_id, farm_id, original_timestamp (UTC), seq_no" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a202c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="455" as="sourcePoint" />
            <mxPoint x="200" y="485" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note_103" value="Local write: encrypted ring buffer (max 24 h)&#10;Nodes never evaluate thresholds (A10 sec 4.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a0aec0;fontColor=#4a5568;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="455" width="260" height="42" as="geometry" />
        </mxCell>
        <mxCell id="hdr_hop2" value="HOP 2 (Target: 60 s) | RADIO WAKE, NETWORK ATTACH AND TLS MUTUAL AUTHENTICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontColor=#2b6cb0;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="740" height="26" as="geometry" />
        </mxCell>
        <mxCell id="act_104" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="190" y="565" width="20" height="80" as="geometry" />
        </mxCell>
        <mxCell id="act_105" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="510" y="580" width="20" height="65" as="geometry" />
        </mxCell>
        <mxCell id="call_106" value="2. Radio wake &amp; network attach: LTE-M / NB-IoT / Cat-1 (or satellite IP bearer for out-of-coverage farms, ASM-073)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="575" as="sourcePoint" />
            <mxPoint x="200" y="575" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_107" value="3. Mutual TLS 1.2+ handshake (X.509 client cert, port 8883 / 443 ALPN) to regional IoT endpoint in us-east-1 (ASM-070, A09 sec 6)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="610" as="sourcePoint" />
            <mxPoint x="520" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hdr_hop3" value="HOP 3 (Target: 20 s) | MQTT PUBLISH TO PUBACK AT REGIONAL IOT CORE ENDPOINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#319795;strokeWidth=1.5;fontColor=#234e52;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="740" height="26" as="geometry" />
        </mxCell>
        <mxCell id="act_108" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="190" y="685" width="20" height="85" as="geometry" />
        </mxCell>
        <mxCell id="act_109" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="510" y="685" width="20" height="85" as="geometry" />
        </mxCell>
        <mxCell id="call_110" value="4. MQTT PUBLISH (QoS 1) topic: farms/{farm_id}/nodes/{node_id}/telemetry&#10;Payload: {node_id, farm_id, original_timestamp, seq_no, readings}" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="705" as="sourcePoint" />
            <mxPoint x="520" y="705" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_111" value="5. MQTT PUBACK returned -&gt; Node immediately releases reading from encrypted buffer (ASM-074)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="750" as="sourcePoint" />
            <mxPoint x="200" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt_box_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#dd6b20;strokeWidth=1.5;strokeDashArray=6 4;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="860" height="85" as="geometry" />
        </mxCell>
        <mxCell id="alt_box_lbl" value="ALT: NO SIGNAL / CELLULAR OUTAGE - STORE-AND-FORWARD DRAIN UP TO 24 HOURS (ASM-074, A10 SEC 4.3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#c05621;" vertex="1" parent="1">
          <mxGeometry x="75" y="786" width="830" height="20" as="geometry" />
        </mxCell>
        <mxCell id="alt_box_desc" value="• Signal loss: Reading retained in encrypted non-volatile RAM (max 24 h). Evicted readings counted and reported in telemetry_gap event.&#10;• Reconnection: Live reading published first, then buffered records drain oldest first. Evaluated at original_timestamp.&#10;• Delayed flag: Readings with (arrival_time - original_timestamp) &amp;gt; 300 s marked delayed = true. Deduplication guarantees 1 alert per drain." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7b341e;" vertex="1" parent="1">
          <mxGeometry x="75" y="806" width="830" height="52" as="geometry" />
        </mxCell>
        <mxCell id="hdr_hop4" value="HOP 4 (Target: 10 s) | IOT TOPIC RULE EXECUTION: DUAL PARALLEL ACTIONS (STORAGE &amp; DECOUPLING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#319795;strokeWidth=1.5;fontColor=#234e52;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="895" width="880" height="26" as="geometry" />
        </mxCell>
        <mxCell id="act_112" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="510" y="930" width="20" height="95" as="geometry" />
        </mxCell>
        <mxCell id="act_113" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="800" y="940" width="20" height="45" as="geometry" />
        </mxCell>
        <mxCell id="act_114" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="970" width="20" height="45" as="geometry" />
        </mxCell>
        <mxCell id="call_115" value="6a. Action 1: PutItem to DynamoDB telemetry table: {node_id (PK), reading_timestamp (SK), readings, cert_id, ip, seq_no}&#10;Encrypted under KMS &#x27;telemetry&#x27; | 5-year retention by TTL | Fulfills A08 telemetry audit (ASM-067)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="947" as="sourcePoint" />
            <mxPoint x="810" y="947" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_116" value="6b. Action 2: SendMessage to SQS Threshold Queue: {node_id, farm_id, reading_timestamp}&#10;Decouples ingestion rate from Lambda evaluation (ADR-003, ASM-161) | Dead-letter queue attached" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="990" as="sourcePoint" />
            <mxPoint x="1090" y="990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hdr_hop5" value="HOP 5 (Target: 20 s) | THRESHOLD LAMBDA: RULES EVALUATION, EPISODE DEDUPLICATION &amp; SNS PUBLISH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;fontColor=#744210;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="1030" width="990" height="26" as="geometry" />
        </mxCell>
        <mxCell id="act_117" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1065" width="20" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act_118" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1075" width="20" height="290" as="geometry" />
        </mxCell>
        <mxCell id="act_119" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="800" y="1095" width="20" height="45" as="geometry" />
        </mxCell>
        <mxCell id="act_120" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1145" width="20" height="45" as="geometry" />
        </mxCell>
        <mxCell id="act_121" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1960" y="1245" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="call_122" value="7. SQS invokes Threshold Lambda (batch size 10, concurrency 10, ASM-162)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#d69e2e;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="1078" as="sourcePoint" />
            <mxPoint x="1670" y="1078" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_123" value="8. Strongly consistent GetItem from telemetry table: ensures record is persisted before evaluation (ASM-161)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1670" y="1115" as="sourcePoint" />
            <mxPoint x="810" y="1115" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_124" value="9. Query active Federation threshold version at original_timestamp (sort key effective_from &amp;lt;= ts, KMS &#x27;records&#x27;)&#10;Resolves farm-specific override if present, else pilot rule (ASM-138) | Zero cache (sec 4.4)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;strokeColor=#d69e2e;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1670" y="1160" as="sourcePoint" />
            <mxPoint x="1370" y="1160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_self_125" value="10. Classify reading: in_range, below, above, closure_reached (sec 5)&#10;Compare against active bounds (e.g., Soil Temp 14-30 °C, Coffee Moisture 12%)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;strokeColor=#d69e2e;strokeWidth=2;fontSize=12;fontColor=#1a202c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1670" y="1200" as="sourcePoint" />
            <mxPoint x="1670" y="1230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_126" value="11. Episode Deduplication &amp; Update in Alert Store (TransactWriteItems, KMS &#x27;records&#x27;, 5y TTL):&#10;• First out-of-range: conditional put opens Episode; emits crop_alert_raised (triggers ADR-002 pest case for drone)&#10;• Subsequent out-of-range: attaches to open episode (updates reading count &amp; extremes; suppresses duplicate alert)&#10;• In-range reading: closes episode (alert_resolved) | Drying 12%: emits single drying_closure_notice per lot" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1670" y="1270" as="sourcePoint" />
            <mxPoint x="1970" y="1270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_127" value="12. Publish alert event to SNS Alert Topic (episode_id, farm_alias, node_id, var, val, range, version, delayed_flag)&#10;Note: No PII/names/phones in SNS message (sec 7.3) | Async Bedrock Nova Pro plausibility check (ASM-167)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1670" y="1330" as="sourcePoint" />
            <mxPoint x="1970" y="1330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hdr_hop6" value="HOP 6 (Target: 30 s) | NOTIFICATION DISPATCHER: PII RESOLUTION &amp; SMS COALESCING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=1.5;fontColor=#7b341e;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1365" width="740" height="26" as="geometry" />
