            <mxPoint x="2530" y="2120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_132" value="16b. Dispatch Push: Amazon SNS Mobile Push&#10;to platform app (Android FCM / iOS APNs)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
