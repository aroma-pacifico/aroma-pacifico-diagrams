    <mxCell id="seg_22" value="Target: 210s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1298" y="1186" width="175" height="28" as="geometry" /></mxCell>
