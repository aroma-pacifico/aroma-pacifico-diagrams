        <mxCell id="call_140" value="17b. Mobile Push delivered to farmer app: displays alert banner; syncs history when data returns (sec 8)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#4a5568;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
