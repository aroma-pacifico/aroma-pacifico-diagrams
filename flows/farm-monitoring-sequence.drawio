          <mxGeometry x="2530" y="2110" width="20" height="215" as="geometry" />
        </mxCell>
        <mxCell id="act_130" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#2d3748;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2810" y="2235" width="20" height="260" as="geometry" />
        </mxCell>
        <mxCell id="call_131" value="16a. Dispatch SMS: AWS End User Messaging&#10;(sends SMS to enrollment phone over cellular)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
