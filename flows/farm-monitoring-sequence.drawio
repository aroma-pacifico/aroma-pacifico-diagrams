          <mxGeometry x="2260" y="1410" width="20" height="135" as="geometry" />
        </mxCell>
        <mxCell id="act_130" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2550" y="1505" width="20" height="80" as="geometry" />
        </mxCell>
        <mxCell id="call_131" value="13. Fanout: SNS Alert Topic delivers message to SQS Notification Queue (with DLQ)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1970" y="1417" as="sourcePoint" />
            <mxPoint x="2270" y="1417" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_self_132" value="14. Dispatcher resolves farmer identity &amp; queries DynamoDB personal-data table (KMS &#x27;personal&#x27;)&#10;Retrieves phone number &amp; push endpoint token | Strict PII isolation: Threshold function never sees PII" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
