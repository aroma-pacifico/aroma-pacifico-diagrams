        <mxCell id="sla_bar_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#d97706;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="1835" width="2920" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sla_bar_title" value="END-TO-END 5-MINUTE LATENCY BUDGET ALLOCATION (CONNECTIVITY SEC 8.2 &amp; FARM MONITORING SEC 7.2):" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="1841" width="800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="seg_143" value="Hop 1: 10 s&#10;Node Ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1865" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_144" value="Hop 2: 60 s&#10;Radio Attach &amp; TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="1865" width="250" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_145" value="Hop 3: 20 s&#10;MQTT PUBACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#319795;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="1865" width="190" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_146" value="Hop 4: 10 s&#10;Topic Rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38a169;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="1865" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_147" value="Hop 5: 20 s&#10;Eval &amp; Deduplication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d69e2e;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="1865" width="210" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_148" value="Hop 6: 30 s&#10;PII &amp; SMS Coalesce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dd6b20;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1865" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_149" value="Hop 7: 60 s&#10;SMS &amp; Push Delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#805ad5;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1865" width="250" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_150" value="Total Target: 210 s&#10;(3.5 minutes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38a169;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1590" y="1865" width="280" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_151" value="Margin: 90 s&#10;Retries &amp; Network Jitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e53e3e;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1880" y="1865" width="280" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_152" value="CASE STATEMENT SLA LIMIT: &amp;lt; 300 s (&amp;lt; 5 MINUTES)&#10;Satisfied with 90 s Safety Margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2170" y="1865" width="680" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#3182ce;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1940" width="700" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p1_hdr" value="1. 5-MINUTE LATENCY BUDGET &amp; SLO ARCHITECTURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1940" width="700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1_txt" value="Latency Budget per Hop (Connectivity sec 8.2, ASM-075):&#10;Runs from original reading timestamp to receipt on farmer phone.&#10;• Hop 1 (10 s): Reading taken to message ready. Node publishes every reading immediately; no batching or threshold logic on device.&#10;• Hop 2 (60 s): Radio wake, network attach, TLS session setup. Cellular LTE-M/NB-IoT/Cat-1 or satellite IP contact.&#10;• Hop 3 (20 s): MQTT publish QoS 1 to PUBACK at IoT Core endpoint in us-east-1. Release from local buffer on PUBACK.&#10;• Hop 4 (10 s): Topic rule execution. Telemetry table write + SQS threshold queue enqueue (ASM-161).&#10;• Hop 5 (20 s): Threshold Lambda execution. Strongly consistent read of telemetry record, query active Federation threshold version, episode deduplication, write alert store, publish to SNS alert topic.&#10;• Hop 6 (30 s): Alert topic to channel provider. SNS fanout to SQS, notification dispatcher Lambda reads PII from personal DB (KMS &#x27;personal&#x27;), renders messages, applies SMS coalescing.&#10;• Hop 7 (60 s): Provider to phone. Parallel dispatch via AWS EUM SMS and Amazon SNS Mobile Push (FCM/APNs).&#10;------------------------------------------------------------------------------------------------------------------------&#10;Totals: Target Sum = 210 s | Retry Margin = 90 s | SLA Limit = 300 s (5 min).&#10;&#10;Tie to Point 6 Alert-Delivery SLO (A21, PD-082, PD-134):&#10;• Live Alert SLI: Share of out-of-range readings published live (not from buffer) delivered within 300 seconds of original reading timestamp.&#10;• Trace points: reading_ts, puback_ts, function_start_ts, alert_persisted_ts, sns_ts, send_ts, delivery_receipt_ts.&#10;• Offline Buffer Drain SLI: Drained readings delivered within 24 hours of capture; measured separately from live SLO." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#2d3748;fontFamily=Helvetica;spacing=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="45" y="1980" width="690" height="775" as="geometry" />
        </mxCell>
        <mxCell id="p2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#d69e2e;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="1940" width="720" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p2_hdr" value="2. FEDERATION THRESHOLDS (CONFIGURABLE DATA, NEVER IN CODE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d69e2e;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="1940" width="720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2_txt" value="Initial Ranges Table from Case Statement (Sec 4.1):&#10;• T-01 [Crop]: pH outside 4.5 - 6.0 (Recommended 4.9 - 5.6) | Unit: pH | Source: Soil analysis (ASM-053).&#10;• T-02 [Crop]: Air moisture outside 40 % - 80 % relative humidity | Source: Crop node.&#10;• T-03 [Crop]: Soil moisture outside 40 % - 80 % | Source: Crop node (ASM-131).&#10;• T-04 [Crop]: Air temperature outside 14 °C - 30 °C (Recommended 17 °C - 23 °C) | Source: Crop node.&#10;• T-05 [Crop]: Soil temperature outside 14 °C - 30 °C (Recommended 17 °C - 23 °C) | Source: Crop node.&#10;• T-06..T-08 [Crop]: NPK (Nitrogen, Phosphorus, Potassium) | Pending publication by Federation (ASM-054). Stored without alerts until published.&#10;• T-09 [Drying]: Coffee moisture lot closure near 12 % | Tolerance: 0 (ASM-133) | Notice, not alert (ASM-059).&#10;• T-10 [Drying]: Grain temperature alert above 40 °C | Source: Drying node.&#10;&#10;Configuration &amp; Scope Model (Sec 4.2, ASM-138):&#10;• Threshold store: DynamoDB &#x27;thresholds&#x27; table in workload account, encrypted with customer-managed key &#x27;records&#x27; (ASM-097). PK: rule_key, SK: effective_from.&#10;• Scope resolution: Farm-specific rule (crop#soil_moisture#farm#&lt;farm_id&gt;) overrides Pilot rule (crop#soil_moisture#pilot). NPK is pilot-wide.&#10;• Historical immutability: Version in force at original_timestamp is evaluated, ensuring drained readings evaluate identically to live ones.&#10;• No cache in Lambda: Strongly consistent query on every invocation; updates apply to the immediate next reading.&#10;• Audit trail: CloudTrail data events (write-only) + DynamoDB Streams audit consumer delivering to S3 Object Lock archive (5-year retention, ASM-067)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#2d3748;fontFamily=Helvetica;spacing=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="765" y="1980" width="710" height="775" as="geometry" />
        </mxCell>
        <mxCell id="p3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#dd6b20;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1940" width="720" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p3_hdr" value="3. EPISODE MODEL, DEDUPLICATION &amp; STORE-AND-FORWARD DRAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dd6b20;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1940" width="720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3_txt" value="Why Deduplicate (Sec 6.1, ASM-135):&#10;• Crop variables stay out of range for hours; drying grain stays hot until turned.&#10;• Without deduplication: 1 alert every 4 hours per crop variable (or every hour in drying); 24 messages per drain.&#10;• Prevents drone pest case explosion under ADR-002: unit of alerting is the episode, not the reading.&#10;&#10;Episode State Machine (Sec 6.2, Alert Store, KMS &#x27;records&#x27;):&#10;• Open Episode: First out-of-range reading for a key with no open episode executes conditional put. Winner emits notification and persists crop_alert_raised (ADR-002 mode switch); loser attaches.&#10;• Attach Reading: Subsequent out-of-range readings of same key update count, latest value, and extreme value. Zero notifications sent.&#10;• Close Episode: First in-range reading with timestamp later than latest out-of-range reading closes episode (alert_resolved). Push notification sent.&#10;• 24-Hour Reminder: If episode remains open after 24 hours, push reminder sent once per 24 hours (push only, no SMS, ASM-135).&#10;• Drying Lot Closure: Coffee moisture &lt;= 12% emits single drying_closure_notice per lot; marks lot ready to close (sec 6.5).&#10;&#10;Store-and-Forward Drain Behavior (Sec 6.4, ASM-074):&#10;• Buffer sizing: Encrypted non-volatile ring buffer holds at least 24 hours of readings (6 crop, 24 drying).&#10;• Drainage order: On reconnection, live reading sent first, then buffered records drain oldest first.&#10;• Delayed alert handling: Receive time &gt; 300 s after original timestamp flagged delayed = true. Farmer sees &#x27;measured at&#x27; and &#x27;received at&#x27;.&#10;• Single notification per drain: Oldest drained reading opens episode; following readings attach. 1 notification, not 24." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#2d3748;fontFamily=Helvetica;spacing=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1505" y="1980" width="710" height="775" as="geometry" />
        </mxCell>
        <mxCell id="p4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#4a5568;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2240" y="1940" width="720" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr" value="4. WHAT THE FARMER SEES &amp; ARCHITECTURAL TRACEABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a5568;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="2240" y="1940" width="720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p4_txt" value="Multi-Channel Strategy (Closes PD-085, ASM-136):&#10;• Dual channel: Push + SMS for alert openings and closure notices. Push only for reminders &amp; resolutions.&#10;• SMS: Reaches farmer over cellular connection even without data plan (LTE or later, A10 sec 11).&#10;• Push: Enriches farmer app with full history and charts when phone enters data coverage (town/road).&#10;• SMS Coalescing: First SMS sent immediately; further alerts for same farm within 10 min combined into 1 SMS (ASM-135).&#10;&#10;Farmer Perception &amp; Example Messages (Sec 8, Colombia Time America/Bogota):&#10;• SMS, Live: &#x27;Aroma Pacifico: farm El Mirador, soil moisture 34 % (range 40-80 %), measured 14:02. Check the app.&#x27;&#10;• SMS, Delayed: &#x27;Aroma Pacifico: farm El Mirador, drying grain 43 C (limit 40 C), measured yesterday 23:10, received 06:15.&#x27;&#10;• SMS, Closure: &#x27;Aroma Pacifico: farm El Mirador, drying lot at 12 % moisture. The lot can be closed.&#x27;&#10;• Push, Resolution: &#x27;Soil moisture back in range (52 %) at 18:02.&#x27;&#10;• Messages carry farm alias only; zero farmer names, cedulas, coordinates, or clickable links.&#10;• Farmer App (3 views): Farm Status Card (active alerts, last heard), Alerts List, History Charts (with recommended bands).&#10;&#10;IaC &amp; Box Traceability (Architecture sec 14, Track B):&#10;• Box D08: Reusable Farm Module (field node, sensors, 24h buffer, X.509 cert) -&gt; B08.&#10;• Box D09: Telemetry Ingestion Pattern (IoT Core, topic rules, DynamoDB telemetry table, error SQS) -&gt; B09.&#10;• Box D10: Event-Driven Inference &amp; Function Pattern (Threshold queue, Lambda rules engine, Alert Store, SNS) -&gt; B10.&#10;• Box D06: Identity &amp; KMS Encryption Keys (&#x27;telemetry&#x27;, &#x27;records&#x27;, &#x27;personal&#x27;) -&gt; B06." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#2d3748;fontFamily=Helvetica;spacing=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2245" y="1980" width="710" height="775" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>