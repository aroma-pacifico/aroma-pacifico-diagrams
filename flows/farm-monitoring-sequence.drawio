    <mxCell id="m4" value="4. PUBACK (release buffer)" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="454" as="sourcePoint" /><mxPoint x="120" y="454" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="alt_drain" value="OFFLINE ALT (&lt;= 24 h): Store in encrypted ring buffer; on reconnect send live reading first, then drain oldest-first (marked delayed &gt; 300 s)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11.5;fontStyle=1;fontColor=#92400E;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="476" width="520" height="38" as="geometry" /></mxCell>
    <mxCell id="h4" value="HOP 4 (10 s)  |  IoT Topic Rule Dual Actions" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m5a" value="5a. PutItem reading (5y TTL)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="576" as="sourcePoint" /><mxPoint x="490" y="576" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m5b" value="5b. SendMessage reading key" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="612" as="sourcePoint" /><mxPoint x="675" y="612" as="targetPoint" /><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="h5" value="HOP 5 (20 s)  |  Threshold Evaluation &amp; Episode Deduplication" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9A3412;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m6" value="6. Invoke batch (&lt;=10)" style="edgeStyle=none;html=1;strokeColor=#EA580C;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="684" as="sourcePoint" /><mxPoint x="860" y="684" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Consistent GetItem" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="718" as="sourcePoint" /><mxPoint x="490" y="718" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
