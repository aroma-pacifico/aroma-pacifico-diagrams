            <mxPoint x="2270" y="1477" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_self_133" value="15. SMS coalescing logic (ASM-135): First SMS sent immediately;&#10;further alert openings for same farm within 10 min combined into follow-up SMS" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;strokeColor=#dd6b20;strokeWidth=2;fontSize=12;fontColor=#1a202c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
