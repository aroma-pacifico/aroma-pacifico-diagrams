            <mxPoint x="2810" y="2245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_134" value="17b. Mobile Push delivered to farmer app:&#10;shows alert banner; syncs history on data" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#4a5568;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2550" y="2310" as="sourcePoint" />
            <mxPoint x="2810" y="2310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="card_step18" value="18. What the Farmer sees (sec 8):&#10;• SMS: &#x27;Aroma Pacifico: farm El Mirador, soil moisture 34 % (range 40-80 %), measured 14:02. Check the app.&#x27;&#10;• App Views: Status Card (alert banner), Alerts List (timestamps), History Curves (recommended bands)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3748;strokeWidth=1.5;fontColor=#1a202c;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="2560" y="2345" width="590" height="86" as="geometry" />
        </mxCell>
        <mxCell id="call_135" value="19. Delivery receipts: Carrier SMS receipt &amp; App push receipt update episode in Alert Store (A21 SLO, PD-134)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;strokeColor=#718096;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2810" y="2475" as="sourcePoint" />
            <mxPoint x="1960" y="2475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sla_bar_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#d97706;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="2525" width="3120" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sla_bar_title" value="END-TO-END 5-MINUTE LATENCY BUDGET ALLOCATION (CONNECTIVITY SEC 8.2 &amp; FARM MONITORING SEC 7.2):" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="2531" width="850" height="22" as="geometry" />
        </mxCell>
        <mxCell id="seg_136" value="Hop 1: 10 s&#10;Node Ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="2555" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_137" value="Hop 2: 60 s&#10;Radio Attach &amp; TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="2555" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_138" value="Hop 3: 20 s&#10;MQTT PUBACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#319795;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="2555" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_139" value="Hop 4: 10 s&#10;Topic Rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38a169;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="2555" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_140" value="Hop 5: 20 s&#10;Eval &amp; Deduplication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d69e2e;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="2555" width="230" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_141" value="Hop 6: 30 s&#10;PII &amp; SMS Coalesce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dd6b20;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1160" y="2555" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_142" value="Hop 7: 60 s&#10;SMS &amp; Push Delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#805ad5;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1410" y="2555" width="260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_143" value="Total Target: 210 s&#10;(3.5 minutes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38a169;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1680" y="2555" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_144" value="Margin: 90 s&#10;Retries &amp; Network Jitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e53e3e;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1990" y="2555" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="seg_145" value="CASE STATEMENT SLA LIMIT: &amp;lt; 300 s (&amp;lt; 5 MINUTES)&#10;Satisfied with 90 s Safety Margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2300" y="2555" width="720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#3182ce;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="2625" width="750" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p1_hdr" value="1. 5-MINUTE LATENCY BUDGET &amp; SLO ARCHITECTURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182ce;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2625" width="750" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_txt" value="Latency Budget per Hop (Connectivity sec 8.2, ASM-075):&#10;Runs from original reading timestamp to receipt on farmer phone.&#10;• Hop 1 (10 s): Reading taken to message ready. Zero threshold logic on node.&#10;• Hop 2 (60 s): Radio wake, network attach, TLS setup (cellular or satellite).&#10;• Hop 3 (20 s): MQTT publish QoS 1 to PUBACK at IoT Core in us-east-1.&#10;• Hop 4 (10 s): Topic rule execution: telemetry table write + SQS enqueue.&#10;• Hop 5 (20 s): Threshold Lambda: consistent read, evaluate rules, deduplicate.&#10;• Hop 6 (30 s): Dispatcher Lambda: resolve PII (KMS &#x27;personal&#x27;), SMS coalescing.&#10;• Hop 7 (60 s): Provider to phone: parallel dispatch via SMS &amp; Push (FCM/APNs).&#10;&#10;Totals: Target = 210 s (3.5 min) | Margin = 90 s (1.5 min) | Limit = 300 s (5 min).&#10;&#10;Tie to Point 6 Alert-Delivery SLO (A21, PD-082, PD-134):&#10;• Live Alert SLI: Share of out-of-range live readings delivered within 300 s.&#10;• Trace points: reading_ts, puback_ts, lambda_start, alert_persisted, delivery_ts.&#10;• Offline Buffer Drain SLI: Drained readings delivered within 24 hours of capture." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#2d3748;fontFamily=Helvetica;spacing=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="46" y="2667" width="738" height="342" as="geometry" />
        </mxCell>
        <mxCell id="p2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#d69e2e;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="815" y="2625" width="760" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p2_hdr" value="2. FEDERATION THRESHOLDS (CONFIGURABLE DATA, NEVER IN CODE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d69e2e;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="815" y="2625" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p2_txt" value="Initial Ranges Table from Case Statement (Sec 4.1):&#10;• T-01 [Crop]: pH outside 4.5 - 6.0 (Recommended 4.9 - 5.6) | Soil analysis (ASM-053).&#10;• T-02 [Crop]: Air moisture outside 40 % - 80 % relative humidity | Crop node.&#10;• T-03 [Crop]: Soil moisture outside 40 % - 80 % | Crop node (ASM-131).&#10;• T-04 [Crop]: Air temp outside 14 - 30 °C (Recommended 17 - 23 °C) | Crop node.&#10;• T-05 [Crop]: Soil temp outside 14 - 30 °C (Recommended 17 - 23 °C) | Crop node.&#10;• T-06..T-08 [Crop]: NPK | Pending Federation publication (ASM-054). Stored without alerts.&#10;• T-09 [Drying]: Coffee moisture closure near 12 % | Tolerance: 0 (ASM-133, ASM-059).&#10;• T-10 [Drying]: Grain temperature alert above 40 °C | Drying node.&#10;&#10;Configuration &amp; Scope Model (Sec 4.2, ASM-138):&#10;• Threshold store: DynamoDB &#x27;thresholds&#x27; table (KMS &#x27;records&#x27;). PK: rule_key, SK: effective_from.&#10;• Scope resolution: Farm-specific rule overrides Pilot rule. NPK is pilot-wide.&#10;• Historical immutability: Version in force at original_timestamp is evaluated.&#10;• Zero cache: Strongly consistent query on every invocation; immediate updates.&#10;• Audit trail: CloudTrail write events + DynamoDB Streams to S3 Object Lock archive (5 years)." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#2d3748;fontFamily=Helvetica;spacing=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="821" y="2667" width="748" height="342" as="geometry" />
        </mxCell>
        <mxCell id="p3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#dd6b20;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1600" y="2625" width="760" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p3_hdr" value="3. EPISODE MODEL, DEDUPLICATION &amp; STORE-AND-FORWARD DRAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dd6b20;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1600" y="2625" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p3_txt" value="Why Deduplicate (Sec 6.1, ASM-135):&#10;• Variables stay out of range for hours; prevents 24 messages per drain.&#10;• Prevents drone pest case explosion under ADR-002: episode is the unit of alerting.&#10;&#10;Episode State Machine (Sec 6.2, Alert Store, KMS &#x27;records&#x27;):&#10;• Open Episode: First out-of-range reading opens Episode via conditional put. Emits&#10;  notification and persists crop_alert_raised (triggers ADR-002 drone mode switch).&#10;• Attach Reading: Subsequent out-of-range readings update counts &amp; extremes (0 alerts).&#10;• Close Episode: First in-range reading closes episode (alert_resolved via push).&#10;• 24-Hour Reminder: Sent once per 24 hours if episode remains open (push only).&#10;• Drying Lot Closure: Moisture &amp;lt;= 12% emits single drying_closure_notice per lot.&#10;&#10;Store-and-Forward Drain Behavior (Sec 6.4, ASM-074):&#10;• Buffer sizing: Encrypted ring buffer holds &amp;gt;= 24 h of readings (6 crop, 24 drying).&#10;• Drainage order: Reconnect sends live reading first, then buffered drain oldest first.&#10;• Delayed alert handling: Receive time &amp;gt; 300 s marked delayed = true. 1 alert per drain." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#2d3748;fontFamily=Helvetica;spacing=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1606" y="2667" width="748" height="342" as="geometry" />
        </mxCell>
        <mxCell id="p4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#4a5568;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2385" y="2625" width="775" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr" value="4. WHAT THE FARMER SEES &amp; ARCHITECTURAL TRACEABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a5568;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="2385" y="2625" width="775" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p4_txt" value="Multi-Channel Strategy (Closes PD-085, ASM-136):&#10;• Dual channel: Push + SMS for openings &amp; closure notices. Push only for reminders/resolutions.&#10;• SMS: Delivers over cellular network without requiring data balance (LTE or later, A10 sec 11).&#10;• Push: Enriches farmer app with full history and curves when phone has data coverage.&#10;• SMS Coalescing: First SMS sent immediately; alerts within 10 min combined (ASM-135).&#10;&#10;Farmer Perception &amp; Sample SMS (Sec 8, Colombia Time America/Bogota):&#10;• Live SMS: &#x27;Aroma Pacifico: farm El Mirador, soil moisture 34 % (range 40-80 %), measured 14:02. Check the app.&#x27;&#10;• Delayed SMS: &#x27;Aroma Pacifico: farm El Mirador, drying grain 43 C (limit 40 C), measured 23:10, received 06:15.&#x27;&#10;• Closure SMS: &#x27;Aroma Pacifico: farm El Mirador, drying lot at 12 % moisture. The lot can be closed.&#x27;&#10;• Resolution Push: &#x27;Soil moisture back in range (52 %) at 18:02.&#x27; | Zero PII, cedulas, coordinates, or links.&#10;• Farmer App: Status Card (alert highlighted), Alerts List, History Charts (recommended bands).&#10;&#10;IaC Traceability (Architecture sec 14, Track B):&#10;• Box D08: Reusable Farm Module (field node, sensors, 24h buffer, X.509 cert) -&amp;gt; B08.&#10;• Box D09: Telemetry Ingestion Pattern (IoT Core, topic rules, DynamoDB telemetry, SQS) -&amp;gt; B09.&#10;• Box D10: Event-Driven Inference Pattern (Threshold queue, Lambda rules, Alert Store, SNS) -&amp;gt; B10.&#10;• Box D06: Identity &amp; KMS Encryption Keys (&#x27;telemetry&#x27;, &#x27;records&#x27;, &#x27;personal&#x27;) -&amp;gt; B06." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#2d3748;fontFamily=Helvetica;spacing=8;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2391" y="2667" width="763" height="342" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
