    <mxCell id="legend_bg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1234" width="1840" height="116" as="geometry" /></mxCell>
    <mxCell id="legend_title" value="Legend &amp; Invariants" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1240" width="1812" height="22" as="geometry" /></mxCell>
    <mxCell id="legend_text" value="1. Federation thresholds (T-01..T-10) live as versioned data in DynamoDB (never hardcoded on nodes); crop_alert_raised triggers ADR-002 drone confirmation.&lt;br/&gt;2. Episode deduplication: one SMS + push on opening/closure notice; push-only for 24h reminders and resolutions; offline drain coalesced.&lt;br/&gt;3. PII isolation: Threshold Lambda reads zero personal data; only Dispatcher reads KMS personal table for farmer phone and push endpoint.&lt;br/&gt;4. Dashed lines = acknowledgement, async plausibility, offline drain path, or delivery receipt; solid = live synchronous/ingestion path." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="54" y="1262" width="1812" height="84" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
  </diagram>
