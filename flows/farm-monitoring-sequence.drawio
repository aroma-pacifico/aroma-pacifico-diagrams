        <mxCell id="hdr_hop7" value="HOP 7 (Target: 60 s) | MULTI-CHANNEL DELIVERY: PUSH &amp; SMS DISPATCH TO FARMER PHONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;strokeWidth=1.5;fontColor=#1a202c;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
