        </mxCell>
        <mxCell id="hdr_hop1" value="HOP 1 (Target: 10 s) | SENSOR READING TAKEN TO MESSAGE READY ON NODE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontColor=#2b6cb0;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="act_101" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="210" y="435" width="20" height="72" as="geometry" />
        </mxCell>
        <mxCell id="card_step1" value="1. Reading captured: Crop (moisture, temp, pH/NPK) or Drying (moisture, temp)&#10;Payload: {node_id, farm_id, original_timestamp (UTC), seq_no, readings}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;strokeWidth=1.5;fontColor=#1a202c;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="442" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="note_step1" value="Local write: encrypted ring buffer (max 24 h)&#10;Nodes never evaluate thresholds (A10 sec 4.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#a0aec0;fontColor=#4a5568;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="442" width="320" height="52" as="geometry" />
        </mxCell>
        <mxCell id="hdr_hop2" value="HOP 2 (Target: 60 s) | RADIO WAKE, NETWORK ATTACH AND TLS MUTUAL AUTHENTICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontColor=#2b6cb0;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="760" height="28" as="geometry" />
        </mxCell>
        <mxCell id="act_102" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="210" y="565" width="20" height="145" as="geometry" />
        </mxCell>
        <mxCell id="act_103" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="510" y="682" width="20" height="28" as="geometry" />
        </mxCell>
        <mxCell id="card_step2" value="2. Radio wake &amp; network attach: LTE-M / NB-IoT / Cat-1&#10;(or satellite IP bearer for out-of-coverage farms, ASM-073)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b6cb0;strokeWidth=1.5;fontColor=#1a202c;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="572" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="call_104" value="3. mTLS 1.2+ X.509 handshake (8883/443)&#10;to us-east-1 endpoint (ASM-070, A09 s6)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#2b6cb0;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="230" y="692" as="sourcePoint" />
            <mxPoint x="510" y="692" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hdr_hop3" value="HOP 3 (Target: 20 s) | MQTT PUBLISH TO PUBACK AT REGIONAL IOT CORE ENDPOINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#319795;strokeWidth=1.5;fontColor=#234e52;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="760" height="28" as="geometry" />
        </mxCell>
        <mxCell id="act_105" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="210" y="805" width="20" height="80" as="geometry" />
        </mxCell>
        <mxCell id="act_106" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="510" y="805" width="20" height="80" as="geometry" />
        </mxCell>
        <mxCell id="call_107" value="4. MQTT PUBLISH (QoS 1) telemetry topic:&#10;farms/{farm_id}/nodes/{node_id}/telemetry" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="230" y="815" as="sourcePoint" />
            <mxPoint x="510" y="815" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_108" value="5. MQTT PUBACK -&gt; Node releases reading&#10;from encrypted local buffer (ASM-074)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="875" as="sourcePoint" />
            <mxPoint x="230" y="875" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt_box_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#dd6b20;strokeWidth=1.5;strokeDashArray=6 4;" vertex="1" parent="1">
          <mxGeometry x="60" y="905" width="920" height="95" as="geometry" />
        </mxCell>
        <mxCell id="alt_box_lbl" value="ALT: NO SIGNAL / CELLULAR OUTAGE - STORE-AND-FORWARD DRAIN UP TO 24 HOURS (ASM-074, A10 SEC 4.3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#c05621;" vertex="1" parent="1">
          <mxGeometry x="75" y="911" width="890" height="22" as="geometry" />
        </mxCell>
        <mxCell id="alt_box_desc" value="• Signal loss: Reading retained in encrypted non-volatile RAM (max 24 h). Evicted readings counted and reported in telemetry_gap event.&#10;• Reconnection: Live reading published first, then buffered records drain oldest first. Evaluated at original_timestamp.&#10;• Delayed flag: Readings with (arrival_time - original_timestamp) &amp;gt; 300 s marked delayed = true. Deduplication guarantees 1 alert per drain." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#7b341e;" vertex="1" parent="1">
          <mxGeometry x="75" y="933" width="890" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdr_hop4" value="HOP 4 (Target: 10 s) | IOT TOPIC RULE EXECUTION: DUAL PARALLEL ACTIONS (STORAGE &amp; DECOUPLING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#319795;strokeWidth=1.5;fontColor=#234e52;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="1020" width="880" height="28" as="geometry" />
        </mxCell>
        <mxCell id="act_109" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="510" y="1105" width="20" height="105" as="geometry" />
        </mxCell>
        <mxCell id="act_110" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b2f5ea;strokeColor=#319795;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="790" y="1105" width="20" height="28" as="geometry" />
        </mxCell>
        <mxCell id="act_111" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1182" width="20" height="28" as="geometry" />
        </mxCell>
        <mxCell id="call_112" value="6a. Action 1: PutItem to telemetry table {node_id (PK), reading_timestamp (SK), readings, cert_id, ip, seq_no}&#10;Encrypted under KMS &#x27;telemetry&#x27; | 5-year retention by TTL | Fulfills A08 telemetry audit (ASM-067)" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="1112" as="sourcePoint" />
            <mxPoint x="790" y="1112" as="targetPoint" />
            <mxPoint x="195" y="-4" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="call_113" value="6b. Action 2: SendMessage to SQS Threshold Queue {node_id, farm_id, reading_timestamp}&#10;Decouples ingestion from Lambda evaluation (ADR-003, ASM-161) | DLQ attached" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=0;endArrow=block;endFill=1;endSize=9;strokeColor=#319795;strokeWidth=2;fontSize=12;fontColor=#1a202c;fontStyle=0;labelBackgroundColor=#ffffff;spacingTop=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="1192" as="sourcePoint" />
            <mxPoint x="1070" y="1192" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hdr_hop5" value="HOP 5 (Target: 20 s) | THRESHOLD LAMBDA: RULES EVALUATION, EPISODE DEDUPLICATION &amp; SNS PUBLISH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;fontColor=#744210;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="1235" width="980" height="28" as="geometry" />
        </mxCell>
