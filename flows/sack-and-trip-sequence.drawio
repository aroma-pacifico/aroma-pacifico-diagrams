    <mxCell id="m4_4" value="16. assigned_to_trip" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="916" as="sourcePoint" /><mxPoint x="825" y="916" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph5" value="PHASE 5  |  Port delivery" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#065F46;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="942" width="1840" height="28" as="geometry" /></mxCell>
