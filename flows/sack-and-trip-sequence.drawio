    <mxCell id="ph6" value="PHASE 6  |  Public buyer lookup" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m6_1" value="20. Scan QR (HTTPS)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1765" y="1140" as="sourcePoint" /><mxPoint x="1515" y="1140" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_2" value="21. Rate limit, check digit" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1154" as="sourcePoint" /><mxPoint x="1515" y="1182" as="targetPoint" /><Array as="points"><mxPoint x="1557" y="1154" /><mxPoint x="1557" y="1182" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_3" value="22. Read buyer_view" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1206" as="sourcePoint" /><mxPoint x="1055" y="1206" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_4" value="23. Audit read" style="edgeStyle=none;html=1;strokeColor=#E7157B;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1242" as="sourcePoint" /><mxPoint x="1285" y="1242" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_5" value="24. Buyer view (no-store)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1278" as="sourcePoint" /><mxPoint x="1765" y="1278" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="legend_bg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1372" width="1840" height="118" as="geometry" /></mxCell>
    <mxCell id="legend_title" value="Legend &amp; Invariants" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1378" width="1812" height="22" as="geometry" /></mxCell>
    <mxCell id="legend_text" value="1. Buyer view: origin, processing dates, status and drying variables only; no personal data, no full trace.&lt;br/&gt;2. Transporter outbox keeps at least 7 days of 5-minute fixes (2,016); custody events are never dropped.&lt;br/&gt;3. Codes are 80 random bits with a check symbol; any unknown code returns the same not found.&lt;br/&gt;4. Solid = live call; dashed = physical handover, buffered step, audit or response." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="54" y="1400" width="1812" height="86" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
