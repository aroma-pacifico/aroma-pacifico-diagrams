        <mxCell id="m6_8" value="6.8: Return server-rendered HTML page (Cache-Control: no-store, X-Robots-Tag: noindex, Referrer-Policy: no-referrer)" style="edgeStyle=straight;rounded=0;html=1;strokeColor=#e11d48;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#e11d48;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="l6_buyer" target="l6_buyer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14"/>
            <Array as="points">
              <mxPoint x="2897" y="2995"/>
              <mxPoint x="2897" y="2995"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="card_bv" value="THE FOUR AUTHORIZED DATA GROUPS RETURNED TO BUYER (ASM-096, SEC 8.2):&#10;--------------------------------------------------------------------------------------------------------&#10;1. Origin: sack_code, department, municipality&#10;2. Processing Dates: drying_start_date, drying_end_date, packing_date (calendar dates, no time of day)&#10;3. Status: current Part C state only (in preparation, in transit to center, at center, in transit to port, delivered at port)&#10;4. Drying Variables: final_coffee_moisture_pct, grain_temperature_min_c, grain_temperature_mean_c, grain_temperature_max_c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;fontSize=11;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1950" y="3030" width="1210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="panel_sec" value="SECURITY &amp; PRIVACY BOUNDARY: FIELDS THE BUYER VIEW NEVER RETURNS (DOCS SEC 8.3, CASE STATEMENT POINT 2)&#10;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#10;• NO Personal Data: Farmer name, cédula (national ID), phone number, or subject_id are NEVER returned. Point 2 strictly forbids exposing farmer cédula to the buyer.&#10;• NO Geographic Identifiers: Farm name, farm ID, vereda, polygon coordinates, or plot boundaries are NEVER returned (prevents locating or identifying the producer).&#10;• NO Telemetry Series: Farm IoT node identifiers, device X.509 certificates, and raw sensor readings series are completely withheld.&#10;• NO Custody Trace: Transporter identity, vehicle plate, GPS transit points, event timestamps, receiver references, and receiving operator IDs are withheld.&#10;• NO Commercial Details: Collection center name, rejection reasons, sack scale weights, and internal sack_id are NEVER exposed to the public view.&#10;• Uniform Error Response: Malformed check symbols, void codes, unknown codes, and unregistered codes return identical 'not found' status (zero enumeration oracle)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#991b1b;fontSize=12;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="3130" width="3120" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>