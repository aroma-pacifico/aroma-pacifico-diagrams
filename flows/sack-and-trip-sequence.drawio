    <mxCell id="m1_2" value="2. Issue 80-bit codes (sack_codes)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="294" as="sourcePoint" /><mxPoint x="1055" y="294" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m1_3" value="3. Print via IPP TCP 631 &amp; distribute" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="330" as="sourcePoint" /><mxPoint x="135" y="330" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph2" value="PHASE 2  |  Sack Registration at Wet Mill &amp; Outbox Sync" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#166534;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1840" height="28" as="geometry" /></mxCell>
