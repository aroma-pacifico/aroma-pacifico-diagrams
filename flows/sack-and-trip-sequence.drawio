    <mxCell id="m4_2" value="14. received or bound" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="844" as="sourcePoint" /><mxPoint x="825" y="844" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
