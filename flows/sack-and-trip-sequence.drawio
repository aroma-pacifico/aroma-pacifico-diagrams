    <mxCell id="m3_2" value="10. Buffer &gt;=7d GNSS (2,016 fixes)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1D4ED8;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="644" as="sourcePoint" /><mxPoint x="595" y="672" as="targetPoint" /><Array as="points"><mxPoint x="637" y="644" /><mxPoint x="637" y="672" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m3_3" value="11. Drain custody first, then GNSS fixes" style="edgeStyle=none;html=1;strokeColor=#2563EB;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="696" as="sourcePoint" /><mxPoint x="825" y="696" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m3_4" value="12. Write transport_positions + fold transit" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="732" as="sourcePoint" /><mxPoint x="1055" y="732" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph4" value="PHASE 4  |  Collection Center Reception &amp; Unlabeled Reserve Binding" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#92400E;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="758" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m4_1" value="13. arrived_at_center handover" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="808" as="sourcePoint" /><mxPoint x="365" y="808" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m4_2" value="14. received / bound_at_center (&gt;=400)" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="844" as="sourcePoint" /><mxPoint x="825" y="844" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m4_3" value="15. Fold accepted / rejected" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="880" as="sourcePoint" /><mxPoint x="1055" y="880" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m4_4" value="16. Stage outbound: assigned_to_trip" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="916" as="sourcePoint" /><mxPoint x="825" y="916" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph5" value="PHASE 5  |  Highway Departure &amp; Buenaventura Port Delivery" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#065F46;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="942" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m5_1" value="17. departed_to_port" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="992" as="sourcePoint" /><mxPoint x="825" y="992" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m5_2" value="18. delivered_at_port (acc/rej)" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="1028" as="sourcePoint" /><mxPoint x="825" y="1028" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m5_3" value="19. Fold terminal state &amp; update buyer_view" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="1064" as="sourcePoint" /><mxPoint x="1055" y="1064" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph6" value="PHASE 6  |  Anonymous Public Buyer Lookup (WAF &amp; Isolated Projection)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m6_1" value="20. GET /s/{code} (HTTPS)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1765" y="1140" as="sourcePoint" /><mxPoint x="1515" y="1140" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_2" value="21. WAF 100/5m/IP + mod-37 check" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1154" as="sourcePoint" /><mxPoint x="1515" y="1182" as="targetPoint" /><Array as="points"><mxPoint x="1557" y="1154" /><mxPoint x="1557" y="1182" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_3" value="22. GetItem buyer_view (public_view)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1206" as="sourcePoint" /><mxPoint x="1055" y="1206" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_4" value="23. Audit anonymous read" style="edgeStyle=none;html=1;strokeColor=#E7157B;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1242" as="sourcePoint" /><mxPoint x="1285" y="1242" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6_5" value="24. Return HTML (no-store, buyer view)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515" y="1278" as="sourcePoint" /><mxPoint x="1765" y="1278" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="legend_bg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1372" width="1840" height="145" as="geometry" /></mxCell>
    <mxCell id="legend_title" value="Legend &amp; Invariants" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1378" width="1812" height="22" as="geometry" /></mxCell>
    <mxCell id="legend_text" value="1. Buyer view scope: returns ONLY origin (department, municipality), processing dates, status, and drying variables (moisture, grain temp) -- zero PII or full trace.&lt;br/&gt;2. Transporter outbox: retains at least 7 days of 5-minute GNSS fixes (2,016 positions); custody events are never dropped and drain before positions.&lt;br/&gt;3. Code &amp; privacy: 80-bit Crockford Base32 + mod-37 check symbol; malformed/unknown/void codes return uniform 'not found'; lookup holds zero grants on internal tables.&lt;br/&gt;4. Recovery targets: sack events RPO 15 min (append-only S3 JSONL export every 60s); public lookup RTO 4 hours (CloudFront + WAF + OAC + buyer_view).&lt;br/&gt;5. Dashed lines = local/physical handover, offline/buffered step, audit log, or response." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="54" y="1400" width="1812" height="113" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
