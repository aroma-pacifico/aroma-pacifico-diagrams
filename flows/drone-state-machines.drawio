" entryY="0.5" entryPerimeter="1" /></mxCell><mxCell id="t_c13" value="&lt;b&gt;New fumigation&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Agronomist requests new order (ASM-141)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Agronomist&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="case_not_closable" target="case_confirmed"><mxGeometry relative="1" as="geometry" exitX="1" exitY="0.5" exitPerimeter="1" entryX="1" entryY="0.8" entryPerimeter="1" x="0" y="0"><Array as="points"><mxPoint x="1220" y="1097" /><mxPoint x="1220" y="684" /></Array></mxGeometry></mxCell><mxCell id="t_c14" value="&lt;b&gt;New verification&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Agronomist with MFA requests re-verify&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Agronomist&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="case_not_closable" target="case_verifying"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.8" entryY="1" entryPerimeter="1" x="0" y="12"><Array as="points"><mxPoint x="900" y="1180" /><mxPoint x="512" y="1180" /></Array></mxGeometry></mxCell><mxCell id="case_note_box" value="&lt;b&gt;CASE INVARIANTS (Section 5.1 / ADR-002):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Alert Deduplication:&lt;/b&gt; Alerts on a plot with an open case join its &lt;code&gt;alert_refs&lt;/code&gt;; no duplicate case is opened (ASM-141).&lt;br/&gt;• &lt;b&gt;Mode Boundary:&lt;/b&gt; Plot enters &lt;b&gt;Precision Mode&lt;/b&gt; on case opening. Returns to &lt;b&gt;Area Mode&lt;/b&gt; ONLY on terminal closure (&lt;code&gt;closed&lt;/code&gt; or &lt;code&gt;closed_without_fumigation&lt;/code&gt;).&lt;br/&gt;• &lt;b&gt;Closure Guard:&lt;/b&gt; If verification object or track never arrives, case stays in &lt;code&gt;verifying&lt;/code&gt; (open) and A21 alarms report it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;fontFamily=Helvetica;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1390" width="1260" height="130" as="geometry" /></mxCell><mxCell id="order_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1787" y="195" width="26" height="26" as="geometry" /></mxCell><mxCell id="ord_draft" value="&lt;b&gt;draft&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Draft created from confirmed case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1680" y="260" width="240" height="55" as="geometry" /></mxCell><mxCell id="ord_auth" value="&lt;b&gt;authorized&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;HUMAN AUTHORIZATION (Agronomist MFA)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1680" y="440" width="250" height="55" as="geometry" /></mxCell><mxCell id="ord_disp" value="&lt;b&gt;dispatched&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Pilot downloaded package&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1680" y="620" width="240" height="55" as="geometry" /></mxCell><mxCell id="ord_flown" value="&lt;b&gt;flown&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Flight completed / 1st object arrived&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#c2410c;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1680" y="820" width="240" height="55" as="geometry" /></mxCell><mxCell id="ord_exec" value="&lt;b&gt;executed&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Fumigation record persisted in records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1680" y="1040" width="250" height="60" as="geometry" /></mxCell><mxCell id="ord_closed" value="&lt;b&gt;closed&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;TERMINAL | Verification result persisted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;double=1;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1680" y="1270" width="250" height="60" as="geometry" /></mxCell><mxCell id="ord_exp" value="&lt;b&gt;expired&lt;/b&gt;&lt;br/&gt;&lt;font color='#b91c1c' style='font-size:11px;'&gt;&lt;b&gt;TERMINAL / RECOVERABLE STATE&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Reasons: window_elapsed | rejected | pilot_revoked | kit_revoked&lt;br/&gt;Late recovery if flown in window (late_record flag)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;double=1;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2280" y="530" width="390" height="150" as="geometry" /></mxCell><mxCell id="t_o0" value="&lt;b&gt;Case confirmed&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Active polygon &amp; confirmation record closed (ASM-142)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ca8a04;strokeWidth=2;endArrow=block;endFill=1;fontColor=#ca8a04;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="order_start" target="ord_draft"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_o1" value="&lt;b&gt;Agronomist authorizes&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Agronomist MFA &lt;= 10 min, valid permit, window set, authorizer from token&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Agronomist (HUMAN ONLY!)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ca8a04;strokeWidth=2;endArrow=block;endFill=1;fontColor=#ca8a04;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_draft" target="ord_auth"><mxGeometry relative="1" as