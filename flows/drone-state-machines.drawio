" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3680" y="35" width="140" height="30" as="geometry" /></mxCell><mxCell id="badge_3860" value="D06: Identity &amp; MFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3860" y="35" width="140" height="30" as="geometry" /></mxCell><mxCell id="badge_4010" value="D10: Inference Pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="4010" y="35" width="140" height="30" as="geometry" /></mxCell><mxCell id="c_case" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;opacity=40;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="1300" height="1510" as="geometry" /></mxCell><mxCell id="c_case_lbl" value="5.1 PEST CASE LIFECYCLE (DynamoDB records store | ASM-141)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="1280" height="32" as="geometry" /></mxCell><mxCell id="c_order" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=2;opacity=40;" vertex="1" parent="1"><mxGeometry x="1410" y="140" width="1300" height="1510" as="geometry" /></mxCell><mxCell id="c_order_lbl" value="5.2 FUMIGATION ORDER LIFECYCLE (Transactional base | ADR-002 | ASM-142)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eab308;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="1280" height="32" as="geometry" /></mxCell><mxCell id="c_mission" value="" sty