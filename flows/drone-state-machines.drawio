never arrives, case stays in &lt;code&gt;verifying&lt;/code&gt; (open) and A21 alarms report it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;fontFamily=Helvetica;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1220" width="1260" height="130" as="geometry" /></mxCell><mxCell id="order_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1697" y="195" width="26" height="26" as="geometry" /></mxCell><mxCell id="ord_draft" value="&lt;b&gt;draft&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Draft created from confirmed case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1590" y="290" width="240" height="75" as="geometry" /></mxCell><mxCell id="ord_auth" value="&lt;b&gt;authorized&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;HUMAN AUTHORIZATION (Agronomist MFA)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1590" y="455" width="240" height="75" as="geometry" /></mxCell><mxCell id="ord_disp" value="&lt;b&gt;dispatched&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Pilot downloaded package&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1590" y="620" width="240" height="75" as="geometry" /></mxCell><mxCell id