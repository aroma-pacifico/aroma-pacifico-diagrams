="1860" y="515" /><mxPoint x="1860" y="550" /></Array><mxPoint x="15" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="t_o4" value="&lt;b&gt;flight_completed&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Kit reports status on MQTT or first object arrives (ASM-143)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Drone Kit / Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c2410c;strokeWidth=2;endArrow=block;endFill=1;fontColor=#c2410c;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_disp" target="ord_flown"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_o5" value="&lt;b&gt;Flight record persisted&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Record matches package digest, pilot &amp; kit active (ASM-146)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#16a34a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_flown" target="ord_exec"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_o5b" value="&lt;b&gt;Direct upload&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Persisted without&lt;br/&gt;prior flown status&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#16a34a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_disp" target="ord_exec"><mxGeometry relative="1" as="geometry" exitX="0" exitY="0.5" exitPerimeter="1" entryX="0" entryY="0.5" entryPerimeter="1"><Array as="points"><mxPoint x="1495" y="657" /><mxPoint x="1495" y="992" /></Array></mxGeometry></mxCell><mxCell id="t_o7_disp" value="&lt;b&gt;window_elapsed (dispatched)&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; window_end passes with no record, NOT in flown (ASM-029)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform Scheduler&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#dc2626;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1830" y="635" as="sourcePoint" /><mxPoint x="2390" y="635" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t_o9_kit" value="&lt;b&gt;kit_revoked&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Kit revoked &amp; window_end passes (A09 sec 10)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform Scheduler&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#dc2626;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1830" y="680" as="sourcePoint" /><mxPoint x="2390" y="715" as="targetPoint" /><Array as="points"><mxPoint x="1860" y="680" /><mxPoint x="1860" y="715" /></Array><mxPoint x="15" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="t_o6" value="&lt;b&gt;Verification result&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Verification mission record &amp; objects persisted (ASM-141)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Verification Lambda / Platform&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_exec" target="ord_closed"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_o10" value="&lt;b&gt;Late record arrives&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Flown within window, pilot/kit active at takeoff; flagged late_record (ASM-142)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontColor=#059669;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_exp" target="ord_exec"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="1" entryY="0.5" entryPerimeter="1"><Array as="points"><mxPoint x="2540" y="992" /></Array><mxPoint x="-60" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="order_note_box" value="&lt;b&gt;FUMIGATION ORDER INVARIANTS (Section 5.2 / ADR-002):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Human Authorization Mandatory:&lt;/b&gt; &lt;i&gt;'La autorización de fumigación es una identidad humana. Ningún disparador la ejecuta.'&lt;/i&gt; Function roles strictly denied.&lt;br/&gt;• &lt;b&gt;No-Signal Store-and-Forward:&lt;/b&gt; An order in &lt;code&gt;flown&lt;/code&gt; does &lt;b&gt;NOT&lt;/b&gt; expire at &lt;code&gt;window_end&lt;/code&gt;: the flight occurred in window and sits in local buffer (PD-141).&lt;br/&gt;• &lt;b&gt;Executed State Flags:&lt;/b&gt; Order reaches &lt;code&gt;executed&lt;/code&gt; on ANY persisted fumigation flight record. Flagged (not blocked) if: &lt;code&gt;aborted_closure&lt;/code&gt;, &lt;code&gt;out_of_window&lt;/code&gt;, &lt;code&gt;batch_mismatch&lt;/code&gt;, or &lt;code&gt;late_record&lt;/code&gt; (ASM-146).&lt;br/&gt;• &lt;b&gt;Order Closure:&lt;/b&gt; Moves to &lt;code&gt;closed&lt;/code&gt; on ANY persisted verification result (both &lt;code&gt;can_close&lt;/code&gt; and &lt;code&gt;cannot_close&lt;/code&gt; close the order, ASM-141)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#eab308;strokeWidth=1.5;fontColor=#713f12;fontSize=11;fontFamily=Helvetica;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1430" y="1220" width="1260" height="130" as="geometry" /></mxCell><mxCell id="mission_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3077" y="195" width="26" height="26" as="geometry" /></mxCell><mxCell id="mis_plan" value="&lt;b&gt;planned&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Planned in campaign or case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2970" y="295" width="240" height="65" as="geometry" /></mxCell><mxCell id="mis_assign" value="&lt;b&gt;assigned&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Pilot assigned with valid permit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2970" y="495" width="240" height="65" as="geometry" /></mxCell><mxCell id="mis_disp" value="&lt;b&gt;dispatched&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Mission package downloaded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2970" y="695" width="240" height="65" as="geometry" /></mxCell><mxCell id="mis_flown" value="&lt;b&gt;flown&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;Flight complete / 1st object uploaded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#c2410c;strokeWidth=2;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2970" y="895" width="240" height="65" as="geometry" /></mxCell><mxCell id="mis_persisted" value="&lt;b&gt;record_persisted&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;TERMINAL SUCCESS | Record &amp; manifest persisted in S3 / DDB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;double=1;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2950" y="1110" width="280" height="70" as="geometry" /></mxCell><mxCell id="mis_cancel" value="&lt;b&gt;cancelled&lt;/b&gt;&lt;br/&gt;&lt;font color='#b91c1c' style='font-size:11px;'&gt;&lt;b&gt;TERMINAL STATE&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Triggers: Case closed | order expired | campaign ended | pilot/kit revoked&lt;br/&gt;Evidence preserved if record arrives later (ASM-143)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;double=1;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3680" y="630" width="360" height="160" as="geometry" /></mxCell><mxCell id="mis_service_box" value="&lt;b&gt;MANDATORY MISSION TYPES &amp; S3 PREFIXES (Section 3 &amp; 7):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Plot Delimitation (&lt;code&gt;delimitation&lt;/code&gt;):&lt;/b&gt; Boundary &amp; no-fly zone GeoJSON version.&lt;br/&gt;• &lt;b&gt;2. Pest Confirmation (&lt;code&gt;confirmation&lt;/code&gt;):&lt;/b&gt; Focus pass; triggers Bedrock confirmation.&lt;br/&gt;• &lt;b&gt;3. Focalized Fumigation (&lt;code&gt;fumigation&lt;/code&gt;):&lt;/b&gt; Requires human-authorized order.&lt;br/&gt;• &lt;b&gt;4. Post-Fumigation Verification (&lt;code&gt;verification&lt;/code&gt;):&lt;/b&gt; Closes case on clear signs.&lt;br/&gt;• &lt;b&gt;5. Crop State Estimation (&lt;code&gt;estimation&lt;/code&gt;):&lt;/b&gt; Scheduled campaign vitality assessment.&lt;br/&gt;• &lt;b&gt;Quarantine Isolation:&lt;/b&gt; Invalid grants/checksums routed to &lt;code&gt;quarantine/{yyyy}/{mm}/{dd}/&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#059669;strokeWidth=1.5;fontColor=#064e3b;fontSize=11;fontFamily=Helvetica;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="3480" y="920" width="560" height="175" as="geometry" /></mxCell><mxCell id="t_m0" value="&lt;b&gt;Mission planned&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Farm enrolled; case/campaign in planning state&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform / Agronomist&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontColor=#059669;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="mission_start" target="mis_plan"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_m1" value="&lt;b&gt;Pilot assigned&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Pilot in drone_operator, permit valid &gt; window (ASM-148)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Agronomist (fumigation: at auth)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="mis_plan" target="mis_assign"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_m2" value="&lt;b&gt;Package download&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Operator MFA, permit valid, kit ACTIVE; order authorized&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Drone Operator&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontColor=#ea580c;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="mis_assign" target="mis_disp"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_m3" value="&lt;b&gt;flight_completed&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Kit reports status message with package digest (ASM-143)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Drone Kit / Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c2410c;strokeWidth=2;endArrow=block;endFill=1;fontColor=#c2410c;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="mis_disp" target="mis_flown"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_m4" value="&lt;b&gt;Manifest &amp; record match&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Record and all manifest objects persisted with matching checksums (ASM-146)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="mis_flown" target="mis_persisted"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_m4b" value="&lt;b&gt;Direct persistence&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Persisted without&lt;br/&gt;prior flown status&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Reception Lambda&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="mis_disp" target="mis_persisted"><mxGeometry relative="1" as="geometry" exitX="0" exitY="0.5" exitPerimeter="1" entryX="0" entryY="0.5" entryPerimeter="1"><Array as="points"><mxPoint x="2855" y="727" /><mxPoint x="2855" y="1145" /></Array></mxGeometry></mxCell><mxCell id="t_m6_plan" value="&lt;b&gt;Planned cancelled&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Planned mission superseded or campaign ended without flight&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform or Agronomist&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#dc2626;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3210" y="327" as="sourcePoint" /><mxPoint x="3896" y="630" as="targetPoint" /><Array as="points"><mxPoint x="3896" y="327" /></Array><mxPoint x="-110" y="-34" as="offset" /></mxGeometry></mxCell><mxCell id="t_m7_assign" value="&lt;b&gt;Assigned cancelled&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Assigned pilot revoked before download or order expired&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform or Agronomist&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#dc2626;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3210" y="527" as="sourcePoint" /><mxPoint x="3770" y="630" as="targetPoint" /><Array as="points"><mxPoint x="3770" y="527" /></Array><mxPoint x="-55" y="-34" as="offset" /></mxGeometry></mxCell><mxCell id="t_m5_disp" value="&lt;b&gt;Dispatched cancelled&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Case closed, order expired, or pilot/kit revoked before flight&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform or Agronomist&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#dc2626;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3210" y="725" as="sourcePoint" /><mxPoint x="3680" y="725" as="targetPoint" /><mxPoint x="0" y="-34" as="offset" /></mxGeometry></mxCell><mxCell id="mission_note_box" value="&lt;b&gt;MISSION INVARIANTS (Section 5.3 / A15 / A17):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Five Mandatory Services:&lt;/b&gt; &lt;i&gt;'Los cinco entran. No se sustituye uno por otro.'&lt;/i&gt; Types: &lt;code&gt;delimitation&lt;/code&gt;, &lt;code&gt;confirmation&lt;/code&gt;, &lt;code&gt;fumigation&lt;/code&gt;, &lt;code&gt;verification&lt;/code&gt;, &lt;code&gt;estimation&lt;/code&gt;.&lt;br/&gt;• &lt;b&gt;Upload Quarantine:&lt;/b&gt; Objects failing grant/checksum checks go to &lt;code&gt;quarantine/{yyyy}/{mm}/{dd}/&lt;/code&gt; and do &lt;b&gt;NOT&lt;/b&gt; count toward persistence (PD-104).&lt;br/&gt;• &lt;b&gt;Inference Decoupling:&lt;/b&gt; Drone inference functions trigger on &lt;code&gt;mission_record_persisted&lt;/code&gt; via DynamoDB Streams -&gt; EventBridge, &lt;b&gt;NEVER&lt;/b&gt; on raw S3 object arrival (ASM-149).&lt;br/&gt;• &lt;b&gt;Flight Without Persisted Record:&lt;/b&gt; A mission in &lt;code&gt;dispatched&lt;/code&gt; or &lt;code&gt;flown&lt;/code&gt; without a persisted record is flagged as unpersisted flight (Point 6 / A21)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#10b981;strokeWidth=1.5;fontColor=#064e3b;fontSize=11;fontFamily=Helvetica;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="2790" y="1220" width="1260" height="130" as="geometry" /></mxCell><mxCell id="panel_bottom_roles" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1395" width="4020" height="205" as="geometry" /></mxCell><mxCell id="panel_bottom_hdr" value="CROSS-CUTTING GOVERNANCE, ACTOR ROLES &amp; LIFECYCLE INVARIANTS (docs/drone-service.md, ADR-002, A09, A15, A17)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="60" y="1405" width="4000" height="32" as="geometry" /></mxCell><mxCell id="pnl_col_70" value="&lt;b&gt;1. Agronomist Role (SR2/JR2 | Cognito staff MFA):&lt;/b&gt;&lt;br/&gt;• Exclusive human authority for fumigation order authorization (ADR-002).&lt;br/&gt;• Fresh Cognito MFA session required (auth_time &lt;= 10 min, ASM-092).&lt;br/&gt;• Authorizer ID captured strictly from JWT token; cannot be operator.&lt;br/&gt;• Re-evaluates cases: closes without fumigation or triggers re-flight.&lt;br/&gt;• Defines UTC execution window (window_start/end) &amp; product_batch_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="65" y="1445" width="980" height="140" as="geometry" /></mxCell><mxCell id="pnl_col_1070" value="&lt;b&gt;2. Contracted Pilot &amp; Drone Kit (A09 sec 6):&lt;/b&gt;&lt;br/&gt;• Pilot in Cognito staff with MFA; Aerocivil permit verified (ASM-020).&lt;br/&gt;• Drone Kit registered as AWS IoT Thing with X.509 certificate.&lt;br/&gt;• Upload Grant: IoT MQTT grant restricts S3 PUTs to manifest keys.&lt;br/&gt;• Preload: Mission package preloaded into Drone Kit before takeoff.&lt;br/&gt;• Non-volatile encrypted buffer survives zero-signal flights; evicted on receipt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="1065" y="1445" width="980" height="140" as="geometry" /></mxCell><mxCell id="pnl_col_2070" value="&lt;b&gt;3. Event-Driven Inference (Part E / A17 / D10):&lt;/b&gt;&lt;br/&gt;• Confirmation, Verification, Estimation invoke Amazon Bedrock Runtime.&lt;br/&gt;• Model: Nova Pro in us-east-1 on-demand, zero-shot prompt (ASM-160).&lt;br/&gt;• Trigger: DynamoDB Stream pipe to custom EventBridge bus (ASM-149).&lt;br/&gt;• Bedrock output: Confidence in [0, 1] + structured pest_signs array.&lt;br/&gt;• Persistence: DynamoDB TransactWriteItems; state unchanged on failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="2065" y="1445" width="980" height="140" as="geometry" /></mxCell><mxCell id="pnl_col_3070" value="&lt;b&gt;4. Case, Order &amp; S3 Traceability (ASM-145, ASM-146):&lt;/b&gt;&lt;br/&gt;• Storage: DynamoDB records table encrypted under KMS key 'records'.&lt;br/&gt;• Retention: 5-year compliance lifecycle for all records &amp; S3 objects.&lt;br/&gt;• Flight Record: Mandatory flight closure ('completed' / 'aborted').&lt;br/&gt;• Observability: A21 monitors unclosed fumigations, unflown orders,&lt;br/&gt;  and missions in dispatched/flown without persisted records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="3065" y="1445" width="980" height="140" as="geometry" /></mxCell></root></mxGraphModel>