te flight record flown within window transitions to &lt;code&gt;executed&lt;/code&gt; with &lt;code&gt;late_record&lt;/code&gt; flag (ASM-142)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;double=1;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2390" y="285" width="300" height="455" as="geometry" /></mxCell><mxCell id="t_o0" value="&lt;b&gt;Case confirmed&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Active polygon &amp; confirmation record closed (ASM-142)&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Platform&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ca8a04;strokeWidth=2;endArrow=block;endFill=1;fontColor=#ca8a04;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="order_start" target="ord_draft"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" exitPerimeter="1" entryX="0.5" entryY="0" entryPerimeter="1" /></mxCell><mxCell id="t_o1" value="&lt;b&gt;Agronomist authorizes&lt;/b&gt;&lt;br/&gt;&lt;font color='#1e40af'&gt;&lt;b&gt;[Guard]:&lt;/b&gt; Agronomist MFA &lt;= 10 min, valid permit, window set, authorizer from token&lt;/font&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;&lt;b&gt;[Actor]:&lt;/b&gt; Agronomist (HUMAN ONLY!)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ca8a04;strokeWidth=2;endArrow=block;endFill=1;fontColor=#ca8a04;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1" source="ord_draft" target="ord_auth"><mxGeometry relative="1" as="geometry" exitX="0.5" exitY="1" 