  <diagram id="inference-functions" name="Event-Driven Inference Functions Architecture">
    <mxGraphModel dx="3880" dy="2420" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3880" pageHeight="2420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
