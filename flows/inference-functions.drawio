<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="inference-functions" name="Event-Driven Inference Functions Architecture">
    <mxGraphModel dx="2800" dy="2360" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2800" pageHeight="2360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Event-Driven Inference Functions Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Aroma Pacífico Pilot (us-east-1 | docs/inference-functions.md): Four triggers, SQS buffering, managed Bedrock inference (Amazon Nova Pro), result records, failure handling (retries &amp; DLQs), and error observation point." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="2720" height="30" as="geometry" />
        </mxCell>

        <mxCell id="banner_account" value="AWS Workload Account: production (pdn) | Region: us-east-1 (N. Virginia, USA) | All objects stored &amp; processed in us-east-1 (ASM-002, PD-013) | Bedrock in-Region on-demand, zero cross-Region profiles" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=22;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="102" width="1740" height="44" as="geometry" />
        </mxCell>
        <mxCell id="box_azure" value="Azure: Prepared, not deployed | 10.88.0.0/13 | ADR-001" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1800" y="102" width="440" height="44" as="geometry" />
        </mxCell>
        <mxCell id="box_badges" value="Traceability Badges:   [ D10 Inference ]   [ D09 Ingestion ]   [ D06 Security ]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="2260" y="102" width="500" height="44" as="geometry" />
        </mxCell>

        <mxCell id="col1_container" value="TRIGGERS &amp; INGESTION PIPELINES (Section 3)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="460" height="1430" as="geometry" />
        </mxCell>

        <mxCell id="card_drone_source" value="Contracted Drone Operator Ground Station (ASM-140)&#10;• Ingress: Support VLAN 102 (10.4x.2.10) to private S3 endpoints&#10;• Flights: Confirmation, Verification, Estimation missions&#10;• Pre-Upload Screen: On-device detector screens all frames (ASM-164)&#10;• Uploads: Flight record, manifest, and raw imagery to S3&#10;• Reception Function (A15): Validates checksums and links objects" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingLeft=22;spacingTop=10;spacingRight=45;" vertex="1" parent="1">
          <mxGeometry x="55" y="210" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="icon_drone_source" value="Reception" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="435" y="218" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_dynamo_missions" value="Amazon DynamoDB: missions Table (ASM-149)&#10;• Reception writes record_persisted in atomic transaction&#10;• DynamoDB Stream captures mission status change (single reader)&#10;• Stream Payload: Identifiers only (mission_id, farm_id, case_id)&#10;• Zero raw imagery or personal data in event stream" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingLeft=22;spacingTop=10;spacingRight=45;" vertex="1" parent="1">
          <mxGeometry x="55" y="390" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="icon_dynamo_missions" value="Missions" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#2E27AD;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="435" y="398" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_eb_pipe" value="Amazon EventBridge Pipe (ASM-161)&#10;• Reads DynamoDB Stream from missions table&#10;• Filter pattern: status = record_persisted&#10;• Upstream Pipe DLQ: SQS &lt;prefix&gt;-pdn-sqs-pipedlq&#10;• Target: Custom EventBus drone-service" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=60;" vertex="1" parent="1">
          <mxGeometry x="55" y="560" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="icon_eb_pipe" value="Pipes" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.eventbridge_pipes;" vertex="1" parent="1">
          <mxGeometry x="435" y="568" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_eb_bus" value="Custom EventBridge Bus: drone-service&#10;• Decoupled event distribution for drone mission lifecycle&#10;• Event Detail-Type: mission_record_persisted&#10;• Subscribers: A21 observability and future platform consumers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=60;" vertex="1" parent="1">
          <mxGeometry x="55" y="705" width="430" height="105" as="geometry" />
        </mxCell>
        <mxCell id="icon_eb_bus" value="EventBus" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="435" y="713" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_eb_rules" value="EventBridge Routing Rules (One Per Mission Type | ASM-161)&#10;&#10;1. Rule: rule-inf-confirmation&#10;   • Pattern: mission_type = confirmation&#10;   • Target: SQS Confirmation Queue (retry 2x, target DLQ)&#10;&#10;2. Rule: rule-inf-verification&#10;   • Pattern: mission_type = verification&#10;   • Target: SQS Verification Queue (retry 2x, target DLQ)&#10;&#10;3. Rule: rule-inf-estimation&#10;   • Pattern: mission_type = estimation&#10;   • Target: SQS Estimation Queue (retry 2x, target DLQ)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="845" width="430" height="215" as="geometry" />
        </mxCell>

        <mxCell id="card_telemetry_trigger" value="TRIGGER 4: TELEMETRY BATCH INGESTION (ADR-003, Section 3 | D09)&#10;&#10;Field IoT Nodes (200 Pilot Farms x 2 Nodes | ASM-070)&#10;• Soil &amp; drying sensors; encrypted 24h buffer during outages (ASM-074)&#10;• MQTT over mTLS 1.2+ with per-node X.509 client certificate&#10;&#10;AWS IoT Core Regional Ingestion Endpoint (us-east-1 | D09)&#10;• Topic: aroma/telemetry/v1/farms/{farm_id}/nodes/{node_id}/readings&#10;• Zero private cloud IPs consumed (identity-based ingestion | ASM-032)&#10;• Peak harvest load: 3,600 readings/day (scales to 18,000/day at 1,000 farms)&#10;&#10;Dual Parallel Topic Rule Actions (PD-112)&#10;• Action 1 (DynamoDB PutItem):&#10;   - Direct write of reading to DynamoDB telemetry table&#10;   - Primary key: node_id (PK), reading_timestamp (SK) | KMS: telemetry&#10;• Action 2 (SQS SendMessage):&#10;   - Forwards reading key and payload to SQS Threshold Queue&#10;   - Decoupled ingestion; function reads stored reading with strongly&#10;     consistent GetItem from DynamoDB&#10;• Error Action (SQS SendMessage):&#10;   - If Action 1 or 2 fails, payload routed to &lt;prefix&gt;-pdn-sqs-ioterror&#10;   - Monitored by Alarm: &lt;prefix&gt;-pdn-alarm-infthresholdstore" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=6;spacingLeft=22;spacingTop=10;spacingRight=45;" vertex="1" parent="1">
          <mxGeometry x="55" y="1085" width="430" height="485" as="geometry" />
        </mxCell>
        <mxCell id="icon_iot_core" value="IoT Core" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="435" y="1093" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="col2_container" value="SQS BUFFERING &amp; RETRIES (Section 6.1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="160" width="390" height="1430" as="geometry" />
        </mxCell>

        <mxCell id="card_sqs_conf" value="1. CONFIRMATION SQS QUEUE&#10;Queue: &lt;prefix&gt;-pdn-sqs-infconfirm&#10;• Batch size: 1 message (1 mission)&#10;• Visibility timeout: 1,800 s (6x 300 s Lambda timeout)&#10;• KMS Key: records (ASM-097)&#10;• Backoff: 60 s, 120 s, 240 s, 480 s | maxReceiveCount: 5&#10;&#10;Dead-Letter Queue (DLQ):&#10;Queue: &lt;prefix&gt;-pdn-sqs-infconfirmdlq&#10;• Retention: 14 days (maximum SQS window)&#10;• KMS Key: records&#10;• Alarm: &lt;prefix&gt;-pdn-alarm-infconfirmdlq (depth &gt; 0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="625" y="210" width="360" height="225" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_conf" value="SQS" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="935" y="218" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_sqs_ver" value="2. VERIFICATION SQS QUEUE&#10;Queue: &lt;prefix&gt;-pdn-sqs-infverify&#10;• Batch size: 1 message (1 verification mission)&#10;• Visibility timeout: 1,800 s (6x Lambda timeout)&#10;• KMS Key: records&#10;• Backoff: 60 s, 120 s, 240 s, 480 s | maxReceiveCount: 5&#10;&#10;Dead-Letter Queue (DLQ):&#10;Queue: &lt;prefix&gt;-pdn-sqs-infverifydlq&#10;• Retention: 14 days | KMS Key: records&#10;• Alarm: &lt;prefix&gt;-pdn-alarm-infverifydlq (depth &gt; 0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="625" y="450" width="360" height="225" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_ver" value="SQS" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="935" y="458" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_sqs_est" value="3. ESTIMATION SQS QUEUE&#10;Queue: &lt;prefix&gt;-pdn-sqs-infestimate&#10;• Batch size: 1 message (1 estimation mission)&#10;• Visibility timeout: 1,800 s&#10;• KMS Key: records&#10;• Backoff: 60 s, 120 s, 240 s, 480 s | maxReceiveCount: 5&#10;&#10;Dead-Letter Queue (DLQ):&#10;Queue: &lt;prefix&gt;-pdn-sqs-infestimatedlq&#10;• Retention: 14 days | KMS Key: records&#10;• Alarm: &lt;prefix&gt;-pdn-alarm-infestimatedlq (depth &gt; 0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="625" y="690" width="360" height="225" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_est" value="SQS" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="935" y="698" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_sqs_thresh" value="4. TELEMETRY THRESHOLD QUEUE (D10 / B10)&#10;Queue: &lt;prefix&gt;-pdn-sqs-infthreshold&#10;• Batch size: 10 readings (batch) | Window: 0 s&#10;• Partial batch failures: ReportBatchItemFailures&#10;• Visibility timeout: 360 s (6x 60 s Lambda timeout)&#10;• KMS Key: records&#10;• Backoff: 10 s, 20 s, 40 s, 80 s&#10;  (transient retries stay within 5-min alert budget)&#10;• maxReceiveCount: 5 attempts&#10;&#10;Dead-Letter Queue (DLQ):&#10;Queue: &lt;prefix&gt;-pdn-sqs-infthresholddlq&#10;• Retention: 14 days | KMS Key: records&#10;• Alarm: &lt;prefix&gt;-pdn-alarm-infthresholddlq (depth &gt; 0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="625" y="930" width="360" height="285" as="geometry" />
        </mxCell>
        <mxCell id="icon_sqs_thresh" value="SQS" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="935" y="938" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_sqs_redrive" value="OPERATOR REDRIVE &amp; UPSTREAM DLQS&#10;• Manual SQS DLQ Redrive: Platform operator redrives&#10;  messages to source queue after root cause resolution.&#10;• Safe Replay: Functions are 100% idempotent (Section 6.3);&#10;  duplicate redrive finds existing result and exits cleanly&#10;  without re-invoking Bedrock model.&#10;• Upstream Delivery DLQs:&#10;  - EventBridge Pipe DLQ: captures stream delivery drops&#10;  - EventBridge Rule Target DLQs: captures target drops&#10;  - IoT Rule Error Queue: captures failed telemetry writes&#10;  - Monitored by Alarm: &lt;prefix&gt;-pdn-alarm-infroutedlq&#10;• 14-Day Retention: Alarms fire on FIRST message visible." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="625" y="1230" width="360" height="340" as="geometry" />
        </mxCell>

        <mxCell id="col3_container" value="EVENT-DRIVEN INFERENCE FUNCTIONS (Sections 4 &amp; 11 | Non-VPC | D06, D10)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="160" width="600" height="1430" as="geometry" />
        </mxCell>

        <mxCell id="card_contract" value="COMMON 7-STEP FUNCTION CONTRACT (Section 4.1):&#10;1. Receive: Read SQS event (identifiers only; zero personal data)&#10;2. Idempotency Check: Query result by key; if exists, delete message &amp; stop&#10;3. Guard Check: Verify case/order/mission state; if invalid, record guard_skipped&#10;4. Read Input: S3 GetObject (exact SHA-256) / DynamoDB; verify person_screen = clear&#10;5. Invoke Bedrock: Call Converse API on Nova Pro (us-east-1) with JSON schema&#10;6. Persist: TransactWriteItems: write result record + conditional state transition&#10;7. Finish: Delete SQS message, emit CloudWatch metrics, log structured JSON audit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1105" y="210" width="570" height="140" as="geometry" />
        </mxCell>

        <mxCell id="card_fn_conf" value="FUNCTION 1: OUTBREAK CONFIRMATION (inf-confirmation | Section 4.2)&#10;• Config: Memory 512 MB | Timeout 300 s | Reserved Concurrency 5 (bounds spend)&#10;• Guard: Case in confirming; mission is confirmation with record_persisted&#10;• Reads: S3 photos/ by version &amp; SHA-256 with person_screen = clear (KMS objects)&#10;• Model Input: Up to 8 focus photos (ASM-168) and alert environment context&#10;• Model Output: pest_signs_present (bool), signs, person_detected, confidence [0, 1]&#10;• Decision: focus_confirmed if pest_signs_present = true &amp; confidence &gt;= 0.70 (ASM-163);&#10;  else focus_not_confirmed. If no image usable -&gt; outcome not_evaluable&#10;• Persistence: DynamoDB TransactWriteItems: writes confirmation_result to pest case;&#10;  transitions confirming -&gt; confirmed or confirming -&gt; not_confirmed&#10;• CRITICAL BOUNDARY: NEVER authorizes or creates a fumigation order! Authorizer&#10;  is strictly human agronomist with MFA only (A09 Section 4.3)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1105" y="365" width="570" height="230" as="geometry" />
        </mxCell>
        <mxCell id="icon_fn_conf" value="inf-confirmation" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1625" y="373" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_fn_ver" value="FUNCTION 2: FUMIGATION VERIFICATION (inf-verification | Section 4.3)&#10;• Config: Memory 512 MB | Timeout 300 s | Reserved Concurrency 5&#10;• Guard: Case in verifying; fumigation order in executed; mission is verification&#10;• Reads: S3 photos/ (up to 8 short-pass frames, person_screen = clear) &amp; track/&#10;  geometry (track verified locally in Lambda; track NOT sent to Bedrock)&#10;• Model Input: Up to 8 frames, confirmation result of the case for comparison&#10;• Model Output: active_signs_at_focus (bool), person_detected, confidence [0, 1]&#10;• Decision: can_close if pass covered focus, active_signs = false, confidence &gt;= 0.70;&#10;  else cannot_close. If no usable image -&gt; not_evaluable&#10;• Persistence: DynamoDB TransactWriteItems: writes verification_results;&#10;  transitions verifying -&gt; closed or verifying -&gt; verification_not_closable&#10;• CRITICAL BOUNDARY: NEVER closes case without persisted verification object!" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1105" y="610" width="570" height="230" as="geometry" />
        </mxCell>
        <mxCell id="icon_fn_ver" value="inf-verification" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1625" y="618" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_fn_est" value="FUNCTION 3: HARVEST ESTIMATION (inf-estimation | Section 4.4)&#10;• Config: Memory 512 MB | Timeout 300 s | Reserved Concurrency 5&#10;• Guard: Farm has active polygon version; mission is estimation with record_persisted&#10;• Reads: S3 photos/ (up to 20 plot photos) &amp; maps/ (1 plot map) (person_screen = clear)&#10;• Model Input: Up to 20 photos and 1 plot map (ASM-168) with evaluation prompt&#10;• Model Output: Per plot: productive_cover_fraction [0, 1], crop_load_class&#10;• Decision: Formula: estimated_sacks = area_ha x cover x yield_factor(load_class)&#10;  Farm estimate is sum over plots with low/high bounds (ASM-166)&#10;• Persistence: DynamoDB TransactWriteItems: writes harvest_estimate record in&#10;  estimates table; updates Collection Center expected-sacks view&#10;• CRITICAL BOUNDARY: NEVER creates packing orders, sacks, or code batches!" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1105" y="855" width="570" height="230" as="geometry" />
        </mxCell>
        <mxCell id="icon_fn_est" value="inf-estimation" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1625" y="863" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_fn_thresh" value="FUNCTION 4: TELEMETRY THRESHOLD (inf-threshold | Section 4.5 | D10 / B10)&#10;• Config: Memory 256 MB | Timeout 60 s | Concurrency 10 | Batch size 10&#10;• Reads: Strongly consistent GetItem on DynamoDB telemetry table by key&#10;  (retried 3x if not present: 200, 400, 800 ms; then backoff to queue).&#10;  Queries active threshold version from thresholds table (zero cache). KMS telemetry.&#10;• Rules Engine (Federation Rules): Evaluated first against dynamic ranges&#10;  (T-01..T-10) with confidence 1.0 (confidence_basis = rule). Evaluation item&#10;  written conditional on attribute_not_exists.&#10;• Notification Dispatch (&lt; 5-min SLA Budget): Alert event published to Amazon&#10;  SNS Alert Topic immediately on episode opening, reminder, closure, or resolution.&#10;  Notification dispatch proceeds immediately without waiting for Bedrock.&#10;• Bedrock Plausibility Check (ASM-167): ONLY invoked for a reading opening&#10;  an episode, and ONLY AFTER alert published to SNS! Bedrock Nova Pro checks&#10;  reading against 24h context. Plausibility written onto existing evaluation item.&#10;• CRITICAL BOUNDARY: Bedrock NEVER suppresses, delays, or alters an alert!&#10;  If model fails, plausibility = unavailable (batch succeeds). Zero write on telemetry." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1105" y="1100" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="icon_fn_thresh" value="inf-threshold" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1625" y="1108" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="col4_container" value="MANAGED INFERENCE &amp; DATA STORES (Sections 2, 5, 8, 10)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#059669;strokeWidth=2;fontColor=#064e3b;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1820" y="160" width="460" height="1430" as="geometry" />
        </mxCell>

        <mxCell id="card_bedrock" value="AMAZON BEDROCK RUNTIME (us-east-1 | ASM-160)&#10;&#10;• Model: Amazon Nova Pro (amazon.nova-pro-v1:0)&#10;  In-Region vision-capable foundation model in us-east-1&#10;• Mode: On-demand per request via Converse API&#10;• Zero Persistent Compute: Zero training, zero fine-tuning,&#10;  no provisioned throughput, no SageMaker endpoints (Part E)&#10;• Prompts: Versioned zero-shot system prompts in config;&#10;  structured JSON schema; confidence in [0, 1]&#10;• Guardrails (PD-013): bedrock:InvokeModel permitted ONLY on&#10;  arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0;&#10;  explicit DENY on cross-Region profiles (inference-profile/*)&#10;• Zero Model Training: Terms guarantee data never trains base FMs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1835" y="210" width="430" height="295" as="geometry" />
        </mxCell>
        <mxCell id="icon_bedrock" value="Nova Pro" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="2215" y="218" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_stores" value="DYNAMODB TRANSACTIONAL STORES (Section 5)&#10;&#10;Destination Tables (KMS Key: records | 5-Year Object Lock):&#10;• cases table: confirmation_result, verification_results&#10;• estimates table: harvest_estimate for farm &amp; campaign&#10;• alerts table (Alert Store): evaluation_item, episode&#10;• telemetry table: strongly consistent read for batch readings&#10;&#10;Standardized Result Record Schema:&#10;• result_id: Idempotency key ({function}#{mission_id} or reading key)&#10;• function, outcome, result_at (UTC timestamp)&#10;• confidence [0, 1], confidence_basis (model | rule)&#10;• source: S3 bucket, key, version, SHA-256 or DynamoDB key&#10;• excluded_objects: Key, version, exclusion reason&#10;• model_id, model_region, prompt_version, bedrock_request_id&#10;• input_tokens, output_tokens, event_id (trigger identifier)&#10;&#10;Atomicity: TransactWriteItems writes result conditional on&#10;attribute_not_exists(result_id) AND case/order state guard." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E27AD;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1835" y="520" width="430" height="355" as="geometry" />
        </mxCell>
        <mxCell id="icon_stores" value="Records" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#2E27AD;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="2215" y="528" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_s3_privacy" value="S3 OBJECT STORAGE &amp; PRIVACY (Sections 2, 10)&#10;&#10;S3 Drone Bucket Prefixes (KMS Customer Key: objects):&#10;• photos/, track/, maps/ (5-year Object Lock retention)&#10;• Versioning enabled; SHA-256 verified; NO PutObject/DeleteObject&#10;  for functions: the source object remains permanent!&#10;&#10;Person Privacy Controls (Section 10):&#10;If an object contains a person, it is never sent to inference,&#10;and file handling is documented and audited.&#10;1. Detection Before Upload: Ground station on-device detector&#10;   screens photos before upload (ASM-164); person_screen flag.&#10;2. Platform Fail-Closed: Only clear objects sent to Bedrock.&#10;3. S3 Restricted Storage (ASM-165): Reception function moves&#10;   person_present objects to:&#10;   restricted/person/{yyyy}/{mm}/{dd}/{original_key}&#10;   Encrypted with dedicated KMS customer key: restricted (8th key).&#10;   Explicit DENY on restricted/* for all inference roles.&#10;4. Cloud Backstop: If Bedrock returns person_detected = true,&#10;   result is discarded (outcome = not_evaluable), object moved to&#10;   restricted/, and ModelPersonDetected alarm fires." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=90;" vertex="1" parent="1">
          <mxGeometry x="1835" y="890" width="430" height="460" as="geometry" />
        </mxCell>
        <mxCell id="icon_s3" value="S3" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="2170" y="898" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icon_kms_restricted" value="Restricted" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="2215" y="898" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_sns" value="AMAZON SNS: ALERT TOPIC (A14 / ADR-003)&#10;• Topic: &lt;prefix&gt;-pdn-sns-alerts (KMS records)&#10;• Immediate publication on episode opening, reminder, closure&#10;• Decoupled from Bedrock: Farmer push and SMS dispatched&#10;  immediately, meeting &lt; 5-min SLA budget (Hop 5: 20 s target)&#10;  without waiting for inference." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry x="1835" y="1365" width="430" height="205" as="geometry" />
        </mxCell>
        <mxCell id="icon_sns" value="SNS Alerts" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="2215" y="1373" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="col5_container" value="ERROR OBSERVATION &amp; ALARMS (Section 7)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="2360" y="160" width="400" height="1430" as="geometry" />
        </mxCell>

        <mxCell id="card_obs_signals" value="ERROR OBSERVATION ARCHITECTURE (Section 7)&#10;&#10;State Invariance &amp; Reliability Contract:&#10;If invocation fails, the source object remains permanent and&#10;the case state does not change. The design defines retries,&#10;dead-letter queues, and centralized error observation.&#10;&#10;Observation Principles:&#10;• Dual Observation Locus: The observation point is the&#10;  function DLQ TOGETHER WITH missions reaching&#10;  record_persisted without a result (catches upstream drops).&#10;• Immediate Alarm on First Failure: Alarms trigger on&#10;  ApproximateNumberOfMessagesVisible &gt; 0 (14-day limit).&#10;• Decoupled Operational Surface: Feeds A21 dashboard.&#10;• Structured JSON Logging: CloudWatch Logs under KMS logs;&#10;  records event_id, outcome, result_id, model ID, error class&#10;  (zero personal data, zero image payloads)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;spacingRight=65;" vertex="1" parent="1">
          <mxGeometry x="2375" y="210" width="370" height="480" as="geometry" />
        </mxCell>
        <mxCell id="icon_obs_signals" value="Observation" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="2670" y="218" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="card_alarms" value="PROPOSED CLOUDWATCH ALARMS FOR A21 (PC-IAC-003)&#10;&#10;1. Dead-Letter Queue Depth (MessagesVisible &gt; 0):&#10;   • &lt;prefix&gt;-pdn-alarm-infconfirmdlq (Confirmation DLQ depth &gt; 0)&#10;   • &lt;prefix&gt;-pdn-alarm-infverifydlq (Verification DLQ depth &gt; 0)&#10;   • &lt;prefix&gt;-pdn-alarm-infestimatedlq (Estimation DLQ depth &gt; 0)&#10;   • &lt;prefix&gt;-pdn-alarm-infthresholddlq (Threshold DLQ depth &gt; 0)&#10;&#10;2. Upstream Event Ingestion &amp; Routing Drop:&#10;   • &lt;prefix&gt;-pdn-alarm-infroutedlq&#10;   Monitors EventBridge Pipe DLQ, Rule Target DLQs,&#10;   and FailedInvocations metric.&#10;&#10;3. Oldest Message Age (Queue Processing Lag):&#10;   • &lt;prefix&gt;-pdn-alarm-inf{confirm,verify,estimate,threshold}age&#10;   Monitors ApproximateAgeOfOldestMessage on primary queues.&#10;&#10;4. Invocations Failed Without State Change (State Invariance):&#10;   • &lt;prefix&gt;-pdn-alarm-inffailed&#10;   Custom metric: InferenceFailed in AromaPacifico/Inference.&#10;&#10;5. Missions Awaiting Result (Pipeline Disconnect):&#10;   • &lt;prefix&gt;-pdn-alarm-infawaiting&#10;   Custom metric: MissionsAwaitingResult (&gt; timeout threshold).&#10;&#10;6. Reading Not Persisted Before Evaluation:&#10;   • &lt;prefix&gt;-pdn-alarm-infthresholdstore&#10;   Custom metric: ReadingNotPersisted &amp; IoT error queue depth.&#10;&#10;7. Bedrock Model Throttling &amp; Quotas:&#10;   • &lt;prefix&gt;-pdn-alarm-infthrottle&#10;   Monitors AWS/Bedrock throttles &amp; metric InferenceThrottled.&#10;&#10;8. Person Detected in Crop Object (Privacy Incident):&#10;   • &lt;prefix&gt;-pdn-alarm-infperson&#10;   Custom metric: ModelPersonDetected &gt; 0 (operator incident)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingLeft=22;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="2375" y="710" width="370" height="860" as="geometry" />
        </mxCell>

        <mxCell id="panel_sovereignty" value="DATA SOVEREIGNTY: WHAT LEAVES COLOMBIA (Section 8.2 | PD-013, ASM-002)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=25;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1610" width="880" height="710" as="geometry" />
        </mxCell>
        <mxCell id="sub_sovereignty" value="No AWS Region exists in Colombia (ADR-001). All cloud objects and records are stored in us-east-1 (N. Virginia, USA) under ASM-002." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="60" y="1650" width="840" height="30" as="geometry" />
        </mxCell>

        <mxCell id="t1_h1" value="Object or Record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1690" width="360" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t1_h2" value="Stored in us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1690" width="220" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t1_h3" value="Sent to Bedrock in us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="1690" width="260" height="32" as="geometry" />
        </mxCell>

        <mxCell id="t1_r1_c1" value="Confirmation photos (person_screen = clear)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1722" width="360" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t1_r1_c2" value="YES (S3 objects, 5-year lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1722" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t1_r1_c3" value="YES (up to 8 focus photos)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="1722" width="260" height="28" as="geometry" />
        </mxCell>

        <mxCell id="t1_r2_c1" value="Verification photos &amp; short-pass frames (clear)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1750" width="360" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t1_r2_c2" value="YES (S3 objects, 5-year lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1750" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t1_r2_c3" value="YES (up to 8 frames)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="1750" width="260" height="28" as="geometry" />
