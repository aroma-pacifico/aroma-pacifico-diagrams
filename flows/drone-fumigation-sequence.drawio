nt="1"><mxGeometry x="3435" y="5070" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_10_hdr" value="Inference &amp; Bedrock&#10;(Nova Pro in us-east-1 | D10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3790" y="140" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_10_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3880" y="205" as="sourcePoint" /><mxPoint x="3880" y="5070" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_10_ftr" value="Inference &amp; Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3795" y="5070" width="170" height="40" as="geometry" /></mxCell><mxCell id="phase_p1" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="4180" height="805" as="geometry" /></mxCell><mxCell id="phase_p1_lbl" value="PHASE 1: CROP SENSOR PEST DETECTION, THRESHOLD EVALUATION &amp; ALERT NOTIFICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="235" width="920" height="30" as="geometry" /></mxCell><mxCell id="phase_p2" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#a855f7;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="4180" height="1450" as="geometry" /></mxCell><mxCell id="phase_p2_lbl" value="PHASE 2: CONFIRMATION MISSION, FOCUS FLIGHT, S3 PERSISTENCE &amp; BEDROCK CROP INFERENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="1060" width="920" height="30" as="geometry" /></mxCell><mxCell id="phase_p3" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="2520" width="4180" height="520" as="geometry" /></mxCell><mxCell id="phase_p3_lbl" value="PHASE 3: FUMIGATION ORDER CREATION, AGRONOMIST REVIEW &amp; HUMAN MFA AUTHORIZATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eab308;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="2530" width="920" height="30" as="geometry" /></mxCell><mxCell id="phase_p4" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="3060" width="4180" height="1055" as="geometry" /></mxCell><mxCell id="phase_p4_lbl" value="PHASE 4: MISSION PRELOAD, FUMIGATION FLIGHT, ENCRYPTED BUFFERING &amp; RECORD EXECUTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="3070" width="920" height="30" as="geometry" /></mxCell><mxCell id="phase_p5" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="4135" width="4180" height="915" as="geometry" /></mxCell><mxCell id="phase_p5_lbl" value="PHASE 5: POST-FUMIGATION VERIFICATION FLIGHT, BEDROCK EVALUATION &amp; CASE CLOSURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="4145" width="920" height="30" as="geometry" /></mxCell><mxCell id="msg_1" value="1. MQTT Publish over TLS 1.2 (port 8883,&#10;X.509 cert) reading out of range&#10;Payload: {node_id, farm_id, plot_id, NPK}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="360" as="sourcePoint" /><mxPoint x="640" y="360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="2_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="635" y="381" width="10" height="98" as="geometry" /></mxCell><mxCell id="act_2" value="&lt;b&gt;2. Topic Rule Action 1:&lt;/b&gt; PutItem into&#10;DynamoDB telemetry table&#10;Key: {node_id, original_reading_at}&#10;(KMS key 'telemetry', 5-yr retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#7c3aed;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="385" width="315" height="90" as="geometry" /></mxCell><mxCell id="2_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="405" as="sourcePoint" /><mxPoint x="660" y="405" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_3" value="3. Topic Rule Action 2: Send message&#10;to SQS threshold queue (D09 Ingestion)&#10;Payload: reading key + sensor payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7c3aed;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="570" as="sourcePoint" /><mxPoint x="1000" y="570" as="targetPoint" /></mxGeometry></mxCell><mxCell id="4_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="995" y="591" width="10" height="98" as="geometry" /></mxCell><mxCell id="act_4" value="&lt;b&gt;4. Threshold Lambda&lt;/b&gt; evaluates reading&#10;against threshold version in force (D10).&#10;Opens alert episode; checks deduplication;&#10;evaluates variable range." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#db2777;strokeWidth=1.5;fontColor=#db2777;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="595" width="315" height="90" as="geometry" /></mxCell><mxCell id="4_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#db2777;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="615" as="sourcePoint" /><mxPoint x="1020" y="615" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="995" y="706" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_5" value="&lt;b&gt;5. Emits alert to SNS alert topic&lt;/b&gt; -&gt; SMS &amp;&#10;push to farmer (&lt; 5 min target, ASM-075).&#10;(Post-alert: Bedrock plausibility check&#10;without blocking farmer alert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="710" width="315" height="95" as="geometry" /></mxCell><mxCell id="5_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="730" as="sourcePoint" /><mxPoint x="1020" y="730" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_6" value="6. Persists crop_alert_raised in records&#10;Payload: {case_id, farm_id, plot_id,&#10;focus: node_coords, alert_refs, opened}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#db2777;strokeWidth=2;endArrow=block;endFill=1;fontColor=#db2777;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="900" as="sourcePoint" /><mxPoint x="1360" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="911" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_7" value="&lt;b&gt;7. Case Service:&lt;/b&gt; switches plot from Area&#10;Mode to Precision Mode (ADR-002).&#10;No polygon: awaiting_delimitation (ASM-027)&#10;Polygon exists: confirming + focus (ASM-026)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="915" width="315" height="95" as="geometry" /></mxCell><mxCell id="7_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="935" as="sourcePoint" /><mxPoint x="1380" y="935" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_8" value="8. Agronomist assigns certified pilot&#10;(group drone_operator, permit &gt; window)&#10;(ASM-020, ASM-148)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="1175" as="sourcePoint" /><mxPoint x="1360" y="1175" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_9" value="9. Pilot signs in with Cognito MFA via&#10;Municipal Seat or Support VLAN 102&#10;(10.4x.2.10)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1270" as="sourcePoint" /><mxPoint x="2800" y="1270" as="targetPoint" /><mxPoint x="-180" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="msg_10" value="10. Application API: mission package&#10;download (WGS 84 GeoJSON plot boundary,&#10;no-fly zones, focus, SHA-256 digest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1365" as="sourcePoint" /><mxPoint x="2800" y="1365" as="targetPoint" /><mxPoint x="-180" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="msg_10_resp" value="10b. Returns mission package; Platform&#10;updates mission to dispatched (ASM-144)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="1445" as="sourcePoint" /><mxPoint x="2080" y="1445" as="targetPoint" /><mxPoint x="180" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="msg_11" value="11. Preload mission package into Drone&#10;Kit before takeoff ('La mision se&#10;carga antes del despegue')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1540" as="sourcePoint" /><mxPoint x="2440" y="1540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2435" y="1556" width="10" height="113" as="geometry" /></mxCell><mxCell id="act_12" value="&lt;b&gt;12. Autonomous flight over focus.&lt;/b&gt;&#10;NO SIGNAL at plot: mission preloaded.&#10;Focus photos &amp; GPS track written to&#10;encrypted non-volatile buffer (ASM-095).&#10;Eviction only after confirmed receipt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2460" y="1560" width="315" height="105" as="geometry" /></mxCell><mxCell id="12_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2445" y="1580" as="sourcePoint" /><mxPoint x="2460" y="1580" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_13" value="13. Link restored: kit reports status&#10;flight_completed with package digest;&#10;requests upload grant via MQTT topic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2440" y="1760" as="sourcePoint" /><mxPoint x="2800" y="1760" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_13_resp" value="13b. IoT Core delivers upload grant:&#10;lists S3 presigned URLs, allowed keys&#10;&amp; checksums (A09 sec 6, PD-104)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="1855" as="sourcePoint" /><mxPoint x="2440" y="1855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_14" value="14. HTTPS Multipart Upload (SSE-KMS):&#10;.../confirmation/{mission_id}/photos/*.jpg&#10;(via S3 interface endpoint or public S3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1950" as="sourcePoint" /><mxPoint x="3160" y="1950" as="targetPoint" /></mxGeometry></mxCell><mxCell id="15_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3155" y="1966" width="10" height="113" as="geometry" /></mxCell><mxCell id="act_15" value="&lt;b&gt;15. CloudTrail S3 Data Events audit.&lt;/b&gt;&#10;Reception Lambda (no VPC, ASM-140):&#10;Validates manifest, checksums &amp; grant.&#10;Quarantines ungranted keys. Persists&#10;record_persisted; returns receipt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#15803d;strokeWidth=1.5;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="3180" y="1970" width="315" height="105" as="geometry" /></mxCell><mxCell id="15_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3165" y="1990" as="sourcePoint" /><mxPoint x="3180" y="1990" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_16" value="16. DDB Stream pipe puts event&#10;mission_record_persisted on custom bus&#10;-&gt; SQS confirmation queue (ASM-149)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3160" y="2170" as="sourcePoint" /><mxPoint x="3520" y="2170" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_17" value="17. Confirmation Lambda reads SQS;&#10;reads S3 focus photos (verifies&#10;person_screen = clear, PD-015)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E7157B;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3520" y="2265" as="sourcePoint" /><mxPoint x="3880" y="2265" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17_bedrock_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3875" y="2281" width="10" height="98" as="geometry" /></mxCell><mxCell id="act_17_bedrock" value="&lt;b&gt;17b. Bedrock Converse API:&lt;/b&gt; Nova Pro in&#10;us-east-1, zero-shot (ASM-160, ASM-168)&#10;Output: {pest_signs_present: true,&#10;signs, confidence &gt;= 0.70 threshold}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#01A88D;strokeWidth=1.5;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="3900" y="2285" width="315" height="90" as="geometry" /></mxCell><mxCell id="17_bedrock_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3885" y="2305" as="sourcePoint" /><mxPoint x="3900" y="2305" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_18" value="18. DDB TransactWriteItems: writes result&#10;to case; transitions confirming -&gt; confirmed&#10;(ASM-141). NEVER AUTHORIZES FUMIGATION!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3880" y="2470" as="sourcePoint" /><mxPoint x="1360" y="2470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="2576" width="10" height="113" as="geometry" /></mxCell><mxCell id="act_19" value="&lt;b&gt;19. Case reaching confirmed&lt;/b&gt; triggers&#10;Order Service to create draft Order:&#10;{order_id, farm_id, plot_id, case_id,&#10;polygon_version}. Guard: active polygon&#10;&amp; confirmation closed (ASM-142)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="2580" width="315" height="105" as="geometry" /></mxCell><mxCell id="19_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="2600" as="sourcePoint" /><mxPoint x="1380" y="2600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_20" value="20. Agronomist reviews draft order;&#10;sets UTC window; assigns pilot_id;&#10;sets product_batch_id (ADR-002, ASM-029)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="2780" as="sourcePoint" /><mxPoint x="1360" y="2780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_21" value="21. Agronomist AUTHORIZES order: MFA&#10;auth_time &lt;= 10 min (ASM-092). Identity&#10;from token; roles denied -&gt; authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="2875" as="sourcePoint" /><mxPoint x="1360" y="2875" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_auth_rule" value="&lt;b&gt;HUMAN IDENTITY INVARIANT (ADR-002 / ASM-092):&lt;/b&gt;&lt;br/&gt;'La autorizacion de fumigacion es una identidad&lt;br/&gt;humana. Ningun disparador la ejecuta.'&lt;br/&gt;Order transitions draft -&gt; authorized. Appends MFA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1740" y="2900" width="320" height="115" as="geometry" /></mxCell><mxCell id="msg_23" value="23. Assigned pilot signs in with MFA;&#10;downloads fumigation package (window,&#10;polygon, no-fly, batch, authorizer_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="3185" as="sourcePoint" /><mxPoint x="2800" y="3185" as="targetPoint" /><mxPoint x="-180" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="msg_23_resp" value="23b. Application API transitions Order&#10;&amp; Mission to dispatched (ASM-144)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="3265" as="sourcePoint" /><mxPoint x="1360" y="3265" as="targetPoint" /><mxPoint x="180" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="msg_24" value="24. Preloads fumigation mission&#10;package into Drone Kit before flight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="3345" as="sourcePoint" /><mxPoint x="2440" y="3345" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2435" y="3361" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_25" value="&lt;b&gt;25. Pilot flies fumigation&lt;/b&gt; inside window&#10;(Dose &amp; mixture out of scope).&#10;GPS track, flight closure &amp; record written&#10;to local encrypted buffer (ASM-095)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2460" y="3365" width="315" height="95" as="geometry" /></mxCell><mxCell id="25_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2445" y="3385" as="sourcePoint" /><mxPoint x="2460" y="3385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_26" value="26. Link restored: kit reports status&#10;flight_completed (Order -&gt; flown);&#10;requests upload grant via MQTT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2440" y="3555" as="sourcePoint" /><mxPoint x="2800" y="3555" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_26_resp" value="26b. IoT Core issues upload grant for&#10;track/ and record/ prefixes (A09 sec 6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="3635" as="sourcePoint" /><mxPoint x="2440" y="3635" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_27" value="27. HTTPS Upload of track/ &amp; flight-record:&#10;.../fumigation/{mission_id}/track/{seq}.json&#10;.../fumigation/{mission_id}/record/*.json&#10;Includes: pilot_id, kit, batch, closure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="3745" as="sourcePoint" /><mxPoint x="3160" y="3745" as="targetPoint" /></mxGeometry></mxCell><mxCell id="28_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3155" y="3761" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_28" value="&lt;b&gt;28. Reception Lambda&lt;/b&gt; validates record&#10;against upload grant &amp; order.&#10;Persists flight record in DynamoDB.&#10;Returns receipt; pilot evicts buffer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#15803d;strokeWidth=1.5;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="3180" y="3765" width="315" height="95" as="geometry" /></mxCell><mxCell id="28_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3165" y="3785" as="sourcePoint" /><mxPoint x="3180" y="3785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_28_exec" value="28b. Order transitions flown -&gt; executed&#10;(ASM-146). Flagged if out_of_window,&#10;batch_mismatch, or aborted_closure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3160" y="3955" as="sourcePoint" /><mxPoint x="1360" y="3955" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_no_signal_rule" value="&lt;b&gt;STORE-AND-FORWARD INVARIANT (PD-141):&lt;/b&gt;&lt;br/&gt;Order in flown does NOT expire at window_end&lt;br/&gt;while buffered without signal. Persisted record&lt;br/&gt;moves order to executed (ASM-146)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#78350f;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2460" y="3980" width="320" height="115" as="geometry" /></mxCell><mxCell id="29_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="4191" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_29" value="&lt;b&gt;29. Order reaching executed&lt;/b&gt; plans a&#10;verification mission for same plot &amp; focus&#10;(ASM-141). Pest Case transitions&#10;in_fumigation -&gt; verifying. Pilot assigned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="4195" width="315" height="95" as="geometry" /></mxCell><mxCell id="29_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="4215" as="sourcePoint" /><mxPoint x="1380" y="4215" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_30" value="30. Pilot downloads verification&#10;package; flies short pass over focus;&#10;buffers photos &amp; track offline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="4385" as="sourcePoint" /><mxPoint x="2800" y="4385" as="targetPoint" /><mxPoint x="-180" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="msg_31" value="31. HTTPS Upload of verification objects:&#10;.../verification/{mission_id}/photos/*.jpg&#10;.../verification/{mission_id}/record/*.json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="4480" as="sourcePoint" /><mxPoint x="3160" y="4480" as="targetPoint" /></mxGeometry></mxCell><mxCell id="32_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3155" y="4496" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_32" value="&lt;b&gt;32. Reception Lambda&lt;/b&gt; validates manifest&#10;&amp; grant; persists record_persisted.&#10;DDB Stream pipe puts event on bus -&gt;&#10;routes to SQS verification queue (ASM-149)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#15803d;strokeWidth=1.5;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="3180" y="4500" width="315" height="95" as="geometry" /></mxCell><mxCell id="32_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3165" y="4520" as="sourcePoint" /><mxPoint x="3180" y="4520" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_33" value="33. Verification Lambda reads SQS;&#10;reads S3 verification photos &amp; track;&#10;checks person_screen = clear" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E7157B;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3520" y="4690" as="sourcePoint" /><mxPoint x="3880" y="4690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="33_bedrock_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3875" y="4706" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_33_bedrock" value="&lt;b&gt;33b. Bedrock Converse API:&lt;/b&gt; evaluates&#10;active_signs_at_focus = false,&#10;confidence &gt;= 0.70 (ASM-163).&#10;Decision: can_close = true (cleared)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#01A88D;strokeWidth=1.5;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="3900" y="4710" width="315" height="95" as="geometry" /></mxCell><mxCell id="33_bedrock_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3885" y="4730" as="sourcePoint" /><mxPoint x="3900" y="4730" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_34" value="34. DDB TransactWriteItems: writes result;&#10;transitions Order executed -&gt; closed &amp;&#10;Pest Case verifying -&gt; closed (ASM-141)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3880" y="4900" as="sourcePoint" /><mxPoint x="1360" y="4900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="4916" width="10" height="103" as="geometry" /></mxCell><mxCell id="act_35" value="&lt;b&gt;35. Case closure triggers mode switch:&lt;/b&gt;&#10;Plot returns from Precision Mode back to&#10;Area Mode (ADR-002). Sack harvest &amp;&#10;campaigns continue in Area Mode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="4920" width="315" height="95" as="geometry" /></mxCell><mxCell id="35_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="4940" as="sourcePoint" /><mxPoint x="1380" y="4940" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_unclosed_rule" value="&lt;b&gt;CLOSURE INVARIANT (ASM-141 / PD-141):&lt;/b&gt;&lt;br/&gt;'Si ese archivo no llega, la fumigacion sigue&lt;br/&gt;abierta.' Without verification record, case stays&lt;br/&gt;in verifying and A21 alarms fire." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2460" y="4920" width="320" height="110" as="geometry" /></mxCell><mxCell id="panel_s3_legend" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="5130" width="4180" height="125" as="geometry" /></mxCell><mxCell id="panel_s3_legend_text" value="&lt;b&gt;Amazon S3 Drone Object Bucket Hierarchy (Workload Account pdn | us-east-1 | SSE-KMS Key 'objects' | Block Public Access | 5-Year Lifecycle Retention ASM-145):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Pest Case Missions:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/cases/{case_id}/{mission_type}/{mission_id}/&lt;/code&gt; (types: &lt;code&gt;confirmation&lt;/code&gt;, &lt;code&gt;fumigation&lt;/code&gt;, &lt;code&gt;verification&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Mission Sub-Prefixes:&lt;/b&gt; &lt;code&gt;package/mission-package-v{n}.json&lt;/code&gt; (issued package) | &lt;code&gt;record/flight-record.json&lt;/code&gt; (returned record) | &lt;code&gt;photos/{seq}.jpg&lt;/code&gt; | &lt;code&gt;track/{seq}.json&lt;/code&gt; | &lt;code&gt;maps/&lt;/code&gt; | &lt;code&gt;polygons/&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Review Campaign Missions:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/campaigns/{campaign_id}/{mission_type}/{mission_id}/&lt;/code&gt; (types: &lt;code&gt;delimitation&lt;/code&gt;, &lt;code&gt;estimation&lt;/code&gt;) | &lt;b&gt;Extra Delimitation:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/extra/{mission_id}/delimitation/&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Quarantine Prefix:&lt;/b&gt; &lt;code&gt;quarantine/{yyyy}/{mm}/{dd}/{original_key}&lt;/code&gt; (unmatched grants, revoked pilot/kit, or person screen quarantine; never linked to order or inference, PD-104)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="5140" width="4160" height="105" as="geometry" /></mxCell></root></mxGraphModel>