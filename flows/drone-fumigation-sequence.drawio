    <mxCell id="m5" value="5. Assign pilot" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="442" as="sourcePoint" /><mxPoint x="755" y="442" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6" value="6. MFA sign-in, mission package" style="edgeStyle=none;html=1;strokeColor=#0284C7;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="478" as="sourcePoint" /><mxPoint x="1595" y="478" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Fly offline, buffer" style="edgeStyle=none;html=1;strokeColor=#0F172A;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="514" as="sourcePoint" /><mxPoint x="1385" y="514" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m8" value="8. Upload (15 min grant)" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385" y="550" as="sourcePoint" /><mxPoint x="1595" y="550" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m9" value="9. Confirmation event" style="edgeStyle=none;html=1;strokeColor=#E7157B;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1595" y="586" as="sourcePoint" /><mxPoint x="1800" y="586" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m10" value="10. focus_confirmed" style="edgeStyle=none;html=1;strokeColor=#01A88D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1800" y="622" as="sourcePoint" /><mxPoint x="755" y="622" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph3" value="PHASE 3  |  Human authorization (ADR-002)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#92400E;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="646" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m11" value="11. Draft order" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="684" as="sourcePoint" /><mxPoint x="755" y="712" as="targetPoint" /><Array as="points"><mxPoint x="797" y="684" /><mxPoint x="797" y="712" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m12" value="12. Review draft" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="736" as="sourcePoint" /><mxPoint x="965" y="736" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m13" value="13. Authorize (fresh MFA)" style="edgeStyle=none;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="774" as="sourcePoint" /><mxPoint x="755" y="774" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph4" value="PHASE 4  |  Fumigation flight" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#065F46;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m14" value="14. Order package" style="edgeStyle=none;html=1;strokeColor=#0284C7;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="850" as="sourcePoint" /><mxPoint x="1595" y="850" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m15" value="15. Fumigate offline" style="edgeStyle=none;html=1;strokeColor=#0F172A;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="886" as="sourcePoint" /><mxPoint x="1385" y="886" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m16" value="16. flight_completed" style="edgeStyle=none;html=1;strokeColor=#7AA116;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385" y="922" as="sourcePoint" /><mxPoint x="335" y="922" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m17" value="17. Upload track, record" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385" y="958" as="sourcePoint" /><mxPoint x="1595" y="958" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m18" value="18. Order executed" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1595" y="994" as="sourcePoint" /><mxPoint x="755" y="994" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph5" value="PHASE 5  |  Verification and closure" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9D174D;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m19" value="19. Plan verification" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1058" as="sourcePoint" /><mxPoint x="755" y="1086" as="targetPoint" /><Array as="points"><mxPoint x="797" y="1058" /><mxPoint x="797" y="1086" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m20" value="20. Fly, upload photos" style="edgeStyle=none;html=1;strokeColor=#059669;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="1110" as="sourcePoint" /><mxPoint x="1595" y="1110" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m21" value="21. Verification event" style="edgeStyle=none;html=1;strokeColor=#E7157B;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1595" y="1146" as="sourcePoint" /><mxPoint x="1800" y="1146" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m22" value="22. can_close, close case" style="edgeStyle=none;html=1;strokeColor=#01A88D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1800" y="1184" as="sourcePoint" /><mxPoint x="755" y="1184" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m23" value="23. Back to area mode" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1200" as="sourcePoint" /><mxPoint x="755" y="1228" as="targetPoint" /><Array as="points"><mxPoint x="797" y="1200" /><mxPoint x="797" y="1228" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="legend_bg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1332" width="1840" height="118" as="geometry" /></mxCell>
    <mxCell id="legend_title" value="Legend &amp; Invariants" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1338" width="1812" height="22" as="geometry" /></mxCell>
    <mxCell id="legend_text" value="1. Only a Federation agronomist with MFA under 10 min authorizes; never the pilot, never a trigger (ADR-002).&lt;br/&gt;2. The mission package is preloaded; the drone flies offline and uploads when the link returns.&lt;br/&gt;3. Without verification photos and track the case stays open and alarms fire.&lt;br/&gt;4. Solid = live call or upload; dashed = offline flight or response." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="54" y="1360" width="1812" height="86" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
