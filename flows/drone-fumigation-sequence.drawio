    <mxCell id="ph5" value="PHASE 5  |  Post-Fumigation Verification &amp; Case Closure" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9D174D;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m19" value="19. Plan verification flight" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;align=left;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1058" as="sourcePoint" /><mxPoint x="755" y="1086" as="targetPoint" /><Array as="points"><mxPoint x="797" y="1058" /><mxPoint x="797" y="1086" /></Array><mxPoint x="10" y="0" as="offset" /></mxGeometry></mxCell>
