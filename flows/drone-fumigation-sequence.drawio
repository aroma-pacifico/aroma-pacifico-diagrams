nt="1"><mxGeometry x="3435" y="3910" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_10_hdr" value="Inference &amp; Bedrock&#10;(Nova Pro in us-east-1 | D10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3790" y="140" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_10_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3880" y="205" as="sourcePoint" /><mxPoint x="3880" y="3910" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_10_ftr" value="Inference &amp; Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3795" y="3910" width="170" height="40" as="geometry" /></mxCell><mxCell id="phase_p1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="4180" height="590" as="geometry" /></mxCell><mxCell id="phase_p1_lbl" value="PHASE 1: CROP SENSOR PEST DETECTION, THRESHOLD EVALUATION &amp; ALERT NOTIFICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#a855f7;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="4180" height="1050" as="geometry" /></mxCell><mxCell id="phase_p2_lbl" value="PHASE 2: CONFIRMATION MISSION, FOCUS FLIGHT, S3 PERSISTENCE &amp; BEDROCK CROP INFERENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="840" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="1900" width="4180" height="460" as="geometry" /></mxCell><mxCell id="phase_p3_lbl" value="PHASE 3: FUMIGATION ORDER CREATION, AGRONOMIST REVIEW &amp; HUMAN MFA AUTHORIZATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eab308;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="1910" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="2380" width="4180" height="720" as="geometry" /></mxCell><mxCell id="phase_p4_lbl" value="PHASE 4: MISSION PRELOAD, FUMIGATION FLIGHT, ENCRYPTED BUFFERING &amp; RECORD EXECUTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="2390" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="60" y="3120" width="4180" height="750" as="geometry" /></mxCell><mxCell id="phase_p5_lbl" value="PHASE 5: POST-FUMIGATION VERIFICATION FLIGHT, BEDROCK EVALUATION &amp; CASE CLOSURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="3130" width="920" height="28" as="geometry" /></mxCell><mxCell id="msg_1" value="1. MQTT Publish over TLS 1.2 (port 8883 / 443 ALPN, X.509 cert) reading out of Federation range&#10;Payload: {node_id, farm_id, plot_id, timestamp, seq_no, variables: [NPK, moisture, temp]}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="275" as="sourcePoint" /><mxPoint x="640" y="275" as="targetPoint" /></mxGeometry></mxCell><mxCell id="2_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="635" y="331" width="10" height="56" as="geometry" /></mxCell><mxCell id="act_2" value="2. Topic Rule Action 1: PutItem into telemetry table&#10;Key: {node_id, original_reading_at}&#10;(KMS key 'telemetry', 5-yr retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#7c3aed;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="655" y="335" width="285" height="48" as="geometry" /></mxCell><mxCell id="2_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="347" as="sourcePoint" /><mxPoint x="655" y="347" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_3" value="3. Topic Rule Action 2: Send message to SQS threshold queue (D09 Telemetry Ingestion)&#10;Payload: reading key + sensor payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7c3aed;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="420" as="sourcePoint" /><mxPoint x="1000" y="420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="4_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="995" y="471" width="10" height="56" as="geometry" /></mxCell><mxCell id="act_4" value="4. Threshold Lambda evaluates reading against threshold version in force (D10)&#10;Opens alert episode; checks deduplication; evaluates range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#db2777;strokeWidth=1.5;fontColor=#db2777;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1015" y="475" width="285" height="48" as="geometry" /></mxCell><mxCell id="4_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#db2777;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="487" as="sourcePoint" /><mxPoint x="1015" y="487" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="995" y="551" width="10" height="60" as="geometry" /></mxCell><mxCell id="act_5" value="5. Emits alert to SNS alert topic -&gt; SMS &amp; push to farmer (&lt; 5 min design target, ASM-075)&#10;(Post-alert: Bedrock plausibility check on episode opening without blocking alert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1015" y="555" width="285" height="52" as="geometry" /></mxCell><mxCell id="5_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="567" as="sourcePoint" /><mxPoint x="1015" y="567" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_6" value="6. Persists crop_alert_raised event into DynamoDB records table (ASM-141)&#10;Payload: {case_id, farm_id, plot_id, focus: node_coords, alert_refs, state: opened}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#db2777;strokeWidth=2;endArrow=block;endFill=1;fontColor=#db2777;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="640" as="sourcePoint" /><mxPoint x="1360" y="640" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="701" width="10" height="64" as="geometry" /></mxCell><mxCell id="act_7" value="7. Case Service: switches plot from Area Mode to Precision Mode (ADR-002)&#10;If no polygon: awaiting_delimitation (ASM-027)&#10;If polygon exists: confirming; plans confirmation mission with focus coords (ASM-026)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1375" y="705" width="285" height="56" as="geometry" /></mxCell><mxCell id="7_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="717" as="sourcePoint" /><mxPoint x="1375" y="717" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_8" value="8. Agronomist assigns contracted certified pilot (group drone_operator, permit expiry &gt; window) (ASM-020, ASM-148)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="880" as="sourcePoint" /><mxPoint x="1360" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_9" value="9. Pilot signs in with Cognito MFA via Municipal Seat or Collection Center Support VLAN 102 (10.4x.2.10)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="945" as="sourcePoint" /><mxPoint x="2800" y="945" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_10" value="10. Application API: mission package download&#10;JSON with WGS 84 GeoJSON plot boundary &amp; no-fly zones, focus coords, package_digest SHA-256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1015" as="sourcePoint" /><mxPoint x="2800" y="1015" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_10_resp" value="10b. Returns mission package; Platform updates mission state to dispatched (ASM-144)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="1080" as="sourcePoint" /><mxPoint x="2080" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_11" value="11. Preload mission package into Drone Kit before takeoff ('La misión se carga antes del despegue')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1140" as="sourcePoint" /><mxPoint x="2440" y="1140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2435" y="1191" width="10" height="66" as="geometry" /></mxCell><mxCell id="act_12" value="12. Autonomous flight over focus. NO SIGNAL at plot: mission preloaded.&#10;Focus photos and GPS track written to encrypted non-volatile buffer (ASM-095).&#10;Mission stays dispatched, order stays open. Eviction only after confirmed receipt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0284c7;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="2455" y="1195" width="285" height="58" as="geometry" /></mxCell><mxCell id="12_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2445" y="1207" as="sourcePoint" /><mxPoint x="2455" y="1207" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_13" value="13. Link restored: kit reports flight_completed status with package digest; requests upload grant via MQTT topic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2440" y="1285" as="sourcePoint" /><mxPoint x="2800" y="1285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_13_resp" value="13b. IoT Core delivers upload grant: lists exact S3 presigned URLs, allowed keys &amp; checksums (A09 sec 6, PD-104)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="1350" as="sourcePoint" /><mxPoint x="2440" y="1350" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_14" value="14. HTTPS Multipart Upload of focus photos &amp; record/flight-record.json (SSE-KMS objects key):&#10;farms/{farm_id}/cases/{case_id}/confirmation/{mission_id}/photos/{seq}.jpg&#10;(Ground station uses S3 interface endpoint in object_storage via IPsec tunnel, or public S3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="1430" as="sourcePoint" /><mxPoint x="3160" y="1430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="15_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3155" y="1511" width="10" height="66" as="geometry" /></mxCell><mxCell id="act_15" value="15. CloudTrail S3 Data Events log delivery. Reception Lambda (not VPC-attached, ASM-140):&#10;Validates manifest, checksums, grant validity. Quarantines ungranted keys.&#10;Persists record_persisted to mission table. Returns persistence receipt; buffer safely evicted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#15803d;strokeWidth=1.5;fontColor=#15803d;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="3175" y="1515" width="285" height="58" as="geometry" /></mxCell><mxCell id="15_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3165" y="1527" as="sourcePoint" /><mxPoint x="3175" y="1527" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_16" value="16. DynamoDB Stream pipe puts mission_record_persisted on custom EventBridge bus -&gt; SQS confirmation queue (ASM-149, ASM-161)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3160" y="1610" as="sourcePoint" /><mxPoint x="3520" y="1610" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_17" value="17. Confirmation Lambda reads SQS message; reads S3 focus photos (checks person_screen = clear, PD-015)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E7157B;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3520" y="1675" as="sourcePoint" /><mxPoint x="3880" y="1675" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17_bedrock_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3875" y="1716" width="10" height="58" as="geometry" /></mxCell><mxCell id="act_17_bedrock" value="17b. Bedrock Converse API: Nova Pro in us-east-1, zero-shot prompt (ASM-160, ASM-168)&#10;Output: {pest_signs_present: true, signs, confidence &gt;= 0.70 threshold}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#01A88D;strokeWidth=1.5;fontColor=#01A88D;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="3895" y="1720" width="285" height="50" as="geometry" /></mxCell><mxCell id="17_bedrock_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3885" y="1732" as="sourcePoint" /><mxPoint x="3895" y="1732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_18" value="18. DynamoDB TransactWriteItems: writes confirmation_result to case (timestamp, confidence, source S3 key/version)&#10;and transitions Pest Case confirming -&gt; confirmed (ASM-141). NEVER AUTHORIZES FUMIGATION!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3880" y="1805" as="sourcePoint" /><mxPoint x="1360" y="1805" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="1926" width="10" height="64" as="geometry" /></mxCell><mxCell id="act_19" value="19. Case reaching confirmed triggers Order Service to create draft Fumigation Order:&#10;Fields: {order_id, farm_id, plot_id, reason: case_id + focus_confirmed result, polygon_version}&#10;Guard: Plot has active polygon and confirmation record is closed (ASM-142). State: draft." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1375" y="1930" width="285" height="56" as="geometry" /></mxCell><mxCell id="19_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="1942" as="sourcePoint" /><mxPoint x="1375" y="1942" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_20" value="20. Agronomist reviews draft order; sets UTC window (window_start, window_end); assigns pilot operator_id;&#10;specifies planned product_batch_id (ADR-002, ASM-029)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="2025" as="sourcePoint" /><mxPoint x="1360" y="2025" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_21" value="21. Agronomist AUTHORIZES order: Cognito token auth_time &lt;= 10 min old (ASM-092).&#10;Authorizer identity captured strictly from token; function roles denied. State: authorized." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="2095" as="sourcePoint" /><mxPoint x="1360" y="2095" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_auth_rule" value="HUMAN IDENTITY INVARIANT (Point 5 / ADR-002 / ASM-092):&#10;'La autorización de fumigación es una identidad humana. Ningún disparador la ejecuta.'&#10;Order transitions draft -&gt; authorized. State history appends actor, MFA time, reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1540" y="2180" width="720" height="75" as="geometry" /></mxCell><mxCell id="msg_23" value="23. Assigned pilot signs in with MFA; downloads fumigation mission package via execute-api&#10;Package carries: window, polygon_version, no-fly zones, planned product_batch_id, authorizer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="2420" as="sourcePoint" /><mxPoint x="2800" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_23_resp" value="23b. Application API transitions Fumigation Order &amp; Mission to dispatched; records package digest (ASM-144)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="2485" as="sourcePoint" /><mxPoint x="1360" y="2485" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_24" value="24. Preloads fumigation mission package into Drone Kit before flight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="2545" as="sourcePoint" /><mxPoint x="2440" y="2545" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2435" y="2591" width="10" height="58" as="geometry" /></mxCell><mxCell id="act_25" value="25. Pilot flies fumigation inside authorized window. (Dose &amp; mixture out of scope).&#10;GPS track, flight closure, and flight record written to local encrypted buffer (ASM-095)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0284c7;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="2455" y="2595" width="285" height="50" as="geometry" /></mxCell><mxCell id="25_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2445" y="2607" as="sourcePoint" /><mxPoint x="2455" y="2607" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_26" value="26. Link restored: kit reports flight_completed status (Order moves to flown); requests upload grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2440" y="2680" as="sourcePoint" /><mxPoint x="2800" y="2680" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_26_resp" value="26b. IoT Core issues upload grant for track/ and record/ prefixes (A09 sec 6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="2745" as="sourcePoint" /><mxPoint x="2440" y="2745" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_27" value="27. HTTPS Upload of track/ and record/flight-record.json (ASM-146):&#10;farms/{farm_id}/cases/{case_id}/fumigation/{mission_id}/track/{seq}.json&#10;farms/{farm_id}/cases/{case_id}/fumigation/{mission_id}/record/flight-record.json&#10;Payload includes: pilot_subject_id, kit_thing_name, product_batch_id_used, takeoff/landing, closure (completed/aborted)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="2820" as="sourcePoint" /><mxPoint x="3160" y="2820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="28_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3155" y="2906" width="10" height="58" as="geometry" /></mxCell><mxCell id="act_28" value="28. Reception Lambda validates flight record against upload grant &amp; order.&#10;Persists flight record in DynamoDB records. Returns persistence receipt; pilot evicts buffer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#15803d;strokeWidth=1.5;fontColor=#15803d;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="3175" y="2910" width="285" height="50" as="geometry" /></mxCell><mxCell id="28_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3165" y="2922" as="sourcePoint" /><mxPoint x="3175" y="2922" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_28_exec" value="28b. Order state transitions flown -&gt; executed (ASM-146). (Flagged if out_of_window, batch_mismatch, or aborted_closure)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3160" y="2985" as="sourcePoint" /><mxPoint x="1360" y="2985" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_no_signal_rule" value="STORE-AND-FORWARD INVARIANT (Point 3 / A10 sec 6 / ASM-146 / PD-141):&#10;Order in flown does NOT expire at window_end while buffered without signal.&#10;Persisted fumigation flight record moves order to executed; verification determines if case closes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#78350f;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2180" y="3030" width="780" height="60" as="geometry" /></mxCell><mxCell id="29_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="3146" width="10" height="60" as="geometry" /></mxCell><mxCell id="act_29" value="29. Order reaching executed plans a verification mission for the same plot and focus point (ASM-141).&#10;Pest Case state transitions in_fumigation -&gt; verifying. Pilot assigned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1375" y="3150" width="285" height="52" as="geometry" /></mxCell><mxCell id="29_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="3162" as="sourcePoint" /><mxPoint x="1375" y="3162" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_30" value="30. Pilot downloads verification package; flies short pass over focus point; buffers photos &amp; track" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="3230" as="sourcePoint" /><mxPoint x="2800" y="3230" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_31" value="31. HTTPS Upload of verification photos &amp; flight record:&#10;farms/{farm_id}/cases/{case_id}/verification/{mission_id}/photos/{seq}.jpg&#10;farms/{farm_id}/cases/{case_id}/verification/{mission_id}/record/flight-record.json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2080" y="3305" as="sourcePoint" /><mxPoint x="3160" y="3305" as="targetPoint" /></mxGeometry></mxCell><mxCell id="32_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3155" y="3381" width="10" height="60" as="geometry" /></mxCell><mxCell id="act_32" value="32. Reception Lambda validates manifest &amp; grant; persists record_persisted for verification mission.&#10;DynamoDB Stream pipe puts event on EventBridge -&gt; routes to SQS verification queue (ASM-149)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#15803d;strokeWidth=1.5;fontColor=#15803d;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="3175" y="3385" width="285" height="52" as="geometry" /></mxCell><mxCell id="32_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3165" y="3397" as="sourcePoint" /><mxPoint x="3175" y="3397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_33" value="33. Verification Lambda reads SQS; reads S3 verification photos &amp; track; checks person_screen = clear" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E7157B;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3520" y="3470" as="sourcePoint" /><mxPoint x="3880" y="3470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="33_bedrock_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3875" y="3511" width="10" height="58" as="geometry" /></mxCell><mxCell id="act_33_bedrock" value="33b. Bedrock Converse API: evaluates active_signs_at_focus = false, confidence &gt;= 0.70 (ASM-163)&#10;Decision: can_close = true (focus pest cleared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#01A88D;strokeWidth=1.5;fontColor=#01A88D;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="3895" y="3515" width="285" height="50" as="geometry" /></mxCell><mxCell id="33_bedrock_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3885" y="3527" as="sourcePoint" /><mxPoint x="3895" y="3527" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_34" value="34. DynamoDB TransactWriteItems: writes verification_results; transitions Fumigation Order executed -&gt; closed;&#10;and transitions Pest Case verifying -&gt; closed (case_closed event) (ASM-141, Part E)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3880" y="3600" as="sourcePoint" /><mxPoint x="1360" y="3600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1355" y="3671" width="10" height="60" as="geometry" /></mxCell><mxCell id="act_35" value="35. Case closure triggers plot state switch: Plot returns from Precision Mode back to Area Mode (ADR-002).&#10;Traceability complete: sack harvest &amp; review campaigns continue in Area Mode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontFamily=Helvetica;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1375" y="3675" width="285" height="52" as="geometry" /></mxCell><mxCell id="35_ptr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="3687" as="sourcePoint" /><mxPoint x="1375" y="3687" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_unclosed_rule" value="CLOSURE INVARIANT (Point 2 / A15 sec 5.1 / ASM-141 / PD-141):&#10;'Si ese archivo no llega, la fumigación sigue abierta.' If verification object or track does not arrive,&#10;verification mission stays in flown, case stays in verifying, and CloudWatch alarms report unclosed fumigations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2680" y="3760" width="920" height="65" as="geometry" /></mxCell><mxCell id="panel_s3_legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="3970" width="4180" height="120" as="geometry" /></mxCell><mxCell id="panel_s3_legend_text" value="&lt;b&gt;Amazon S3 Drone Object Bucket Hierarchy (Workload Account pdn | us-east-1 | SSE-KMS Key 'objects' | Block Public Access | 5-Year Lifecycle Retention ASM-145):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Pest Case Missions:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/cases/{case_id}/{mission_type}/{mission_id}/&lt;/code&gt; (types: &lt;code&gt;confirmation&lt;/code&gt;, &lt;code&gt;fumigation&lt;/code&gt;, &lt;code&gt;verification&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Mission Sub-Prefixes:&lt;/b&gt; &lt;code&gt;package/mission-package-v{n}.json&lt;/code&gt; (issued package) | &lt;code&gt;record/flight-record.json&lt;/code&gt; (returned record) | &lt;code&gt;photos/{seq}.jpg&lt;/code&gt; | &lt;code&gt;track/{seq}.json&lt;/code&gt; | &lt;code&gt;maps/&lt;/code&gt; | &lt;code&gt;polygons/&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Review Campaign Missions:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/campaigns/{campaign_id}/{mission_type}/{mission_id}/&lt;/code&gt; (types: &lt;code&gt;delimitation&lt;/code&gt;, &lt;code&gt;estimation&lt;/code&gt;) | &lt;b&gt;Extra Delimitation:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/extra/{mission_id}/delimitation/&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Quarantine Prefix:&lt;/b&gt; &lt;code&gt;quarantine/{yyyy}/{mm}/{dd}/{original_key}&lt;/code&gt; (unmatched grants, revoked pilot/kit, or person screen quarantine; never linked to order or inference, PD-104)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="3980" width="4160" height="100" as="geometry" /></mxCell></root></mxGraphModel>