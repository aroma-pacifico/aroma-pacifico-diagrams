<mxGraphModel dx="4300" dy="5280" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="4300" pageHeight="5280" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Drone Fumigation Service: End-to-End Sequence Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="2400" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="Complete operational chain from crop node pest detection, threshold evaluation, and confirmation flight to fumigation authorization, execution, verification, S3 persistence, and case closure." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="2600" height="30" as="geometry" /></mxCell><mxCell id="meta" value="Normative Sources: docs/drone-service.md (all sections), docs/inference-functions.md (sections 2-5, 8), ADR-002, A19 sec 11. Box badges: D04 (VPC/Endpoints), D06 (Cognito/KMS), D08 (Farm Module), D09 (Ingestion), D10 (Inference Pattern)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748b;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="98" width="2700" height="25" as="geometry" /></mxCell><mxCell id="badge_3440" value="D08: Farm Module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3440" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="badge_3610" value="D09: Ingestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3610" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="badge_3770" value="D10: Inference Pattern" styl