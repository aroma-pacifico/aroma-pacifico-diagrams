y></mxCell><mxCell id="ll_5_ftr" value="Contracted Pilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1575" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_6_hdr" value="Drone Kit &amp; Buffer&#10;(Thing X.509 | Encrypted Buffer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1880" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_6_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="200" as="sourcePoint" /><mxPoint x="1970" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_6_ftr" value="Drone Kit &amp; Buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1885" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_7_hdr" value="Application API &amp; Grants&#10;(execute-api | IoT Grants | D04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2190" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_7_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="200" as="sourcePoint" /><mxPoint x="2280" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_7_ftr" value="Application API &amp; Grants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2195" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_8_hdr" value="Reception &amp; S3 Bucket&#10;(S3 objects | Lambda Reception)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2500" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_8_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="200" as="sourcePoint" /><mxPoint x="2590" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_8_ftr" value="Reception &amp; S3 Bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2505" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_9_hdr" value="EventBridge &amp; SQS&#10;(Pipes -&gt; Custom Bus -&gt; Queues)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="2800" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_9_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2890" y="200" as="sourcePoint" /><mxPoint x="2890" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_9_ftr" value="EventBridge &amp; SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2805" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_10_hdr" value="Inference &amp; Bedrock&#10;(Nova Pro in us-east-1 | D10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="3100" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_10_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3190" y="200" as="sourcePoint" /><mxPoint x="3190" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_10_ftr" value="Inference &amp; Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3105" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="phase_p1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="3520" height="495" as="geometry" /></mxCell><mxCell id="phase_p1_lbl" value="PHASE 1: CROP SENSOR PEST DETECTION, THRESHOLD EVALUATION &amp; ALERT NOTIFICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="50" y="225" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#a855f7;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="3520" height="685" as="geometry" /></mxCell><mxCell id="phase_p2_lbl" value="PHASE 2: CONFIRMATION MISSION, FOCUS FLIGHT, S3 PERSISTENCE &amp; BEDROCK CROP INFERENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="50" y="735" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="1425" width="3520" height="420" as="geometry" /></mxCell><mxCell id="phase_p3_lbl" value="PHASE 3: FUMIGATION ORDER CREATION, AGRONOMIST REVIEW &amp; HUMAN MFA AUTHORIZATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eab308;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="50" y="1435" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="1860" width="3520" height="640" as="geometry" /></mxCell><mxCell id="phase_p4_lbl" value="PHASE 4: MISSION PRELOAD, FUMIGATION FLIGHT, ENCRYPTED BUFFERING &amp; RECORD EXECUTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="50" y="1870" width="920" height="28" as="geometry" /></mxCell><mxCell id="phase_p5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;dashed=1;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="2515" width="3520" height="595" as="geometry" /></mxCell><mxCell id="phase_p5_lbl" value="PHASE 5: POST-FUMIGATION VERIFICATION FLIGHT, BEDROCK EVALUATION &amp; CASE CLOSURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="50" y="2525" width="920" height="28" as="geometry" /></mxCell><mxCell id="msg_1" value="1. MQTT Publish over TLS 1.2 (port 8883 / 443 ALPN, X.509 cert) reading out of Federation range&#10;Payload: {node_id, farm_id, plot_id, timestamp, seq_no, variables: [NPK, moisture, temp]}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="285" as="sourcePoint" /><mxPoint x="450" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_2" value="2. Topic Rule Action 1: PutItem into telemetry table&#10;Key: {node_id, original_reading_at} (KMS key telemetry, 5-yr retention)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7c3aed;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="345" as="sourcePoint" /><mxPoint x="450" y="385" as="targetPoint" /><Array as="points"><mxPoint x="630" y="345" /><mxPoint x="630" y="385" /></Array></mxGeometry></mxCell><mxCell id="msg_3" value="3. Topic Rule Action 2: Send message to SQS threshold queue (D09 Telemetry Ingestion)&#10;Payload: reading key + sensor payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7c3aed;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="415" as="sourcePoint" /><mxPoint x="740" y="415" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_4" value="4. Threshold Lambda evaluates reading against Federation threshold version in force (D10)&#10;Opens alert episode; checks episode deduplication; evaluates range" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#db2777;strokeWidth=2;endArrow=block;endFill=1;fontColor=#db2777;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="465" as="sourcePoint" /><mxPoint x="740" y="510" as="targetPoint" /><Array as="points"><mxPoint x="960" y="465" /><mxPoint x="960" y="510" /></Array></mxGeometry></mxCell><mxCell id="self_5" value="5. Emits alert to SNS alert topic -&gt; SMS &amp; push to farmer (&lt; 5 min design target, ASM-075)&#10;(Post-alert: Bedrock plausibility check on episode opening without blocking alert)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#dc2626;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="535" as="sourcePoint" /><mxPoint x="740" y="580" as="targetPoint" /><Array as="points"><mxPoint x="980" y="535" /><mxPoint x="980" y="580" /></Array></mxGeometry></mxCell><mxCell id="msg_6" value="6. Persists crop_alert_raised event into DynamoDB records table (ASM-141)&#10;Payload: {case_id, farm_id, plot_id, focus: node_coords, alert_refs, state: opened}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#db2777;strokeWidth=2;endArrow=block;endFill=1;fontColor=#db2777;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="605" as="sourcePoint" /><mxPoint x="1040" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_7" value="7. Case Service: switches plot from Area Mode to Precision Mode (ADR-002)&#10;If no polygon: state awaiting_delimitation (ASM-027). If polygon exists: state confirming;&#10;plans confirmation mission with focus coordinates in campaign or extra flight (ASM-026)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f172a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="655" as="sourcePoint" /><mxPoint x="1040" y="705" as="targetPoint" /><Array as="points"><mxPoint x="1300" y="655" /><mxPoint x="1300" y="705" /></Array></mxGeometry></mxCell><mxCell id="msg_8" value="8. Agronomist assigns contracted certified pilot (group drone_operator, permit expiry &gt; window) (ASM-020, ASM-148)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="780" as="sourcePoint" /><mxPoint x="1040" y="780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_9" value="9. Pilot signs in with Cognito MFA via Municipal Seat or Collection Center Support VLAN 102 (10.4x.2.10)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="830" as="sourcePoint" /><mxPoint x="2280" y="830" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_10" value="10. HTTPS GET mission package (/missions/{mission_id}/package)&#10;JSON with WGS 84 GeoJSON plot boundary &amp; no-fly zones, focus coords, package_digest SHA-256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="880" as="sourcePoint" /><mxPoint x="2280" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_10_resp" value="10b. Returns mission package; Platform updates mission state to dispatched (ASM-144)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="930" as="sourcePoint" /><mxPoint x="1660" y="930" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_11" value="11. Preload mission package into Drone Kit before takeoff ('La misión se carga antes del despegue')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="975" as="sourcePoint" /><mxPoint x="1970" y="975" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_12" value="12. Autonomous flight over focus. NO SIGNAL at plot: mission already preloaded.&#10;Focus photos and GPS track written to encrypted non-volatile buffer (ASM-095).&#10;Mission stays dispatched, order stays open. Eviction only after confirmed receipt." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="1020" as="sourcePoint" /><mxPoint x="1970" y="1070" as="targetPoint" /><Array as="points"><mxPoint x="2220" y="1020" /><mxPoint x="2220" y="1070" /></Array></mxGeometry></mxCell><mxCell id="msg_13" value="13. Link restored: kit reports flight_completed status with package digest; requests upload grant via MQTT topic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="1100" as="sourcePoint" /><mxPoint x="2280" y="1100" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_13_resp" value="13b. IoT Core delivers upload grant: lists exact S3 presigned URLs, allowed keys &amp; checksums (A09 sec 6, PD-104)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="1145" as="sourcePoint" /><mxPoint x="1970" y="1145" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_14" value="14. HTTPS Multipart Upload of focus photos &amp; record/flight-record.json (SSE-KMS objects key):&#10;farms/{farm_id}/cases/{case_id}/confirmation/{mission_id}/photos/{seq}.jpg&#10;(Ground station uses S3 interface endpoint in object_storage via IPsec tunnel, or public S3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="1195" as="sourcePoint" /><mxPoint x="2590" y="1195" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_15" value="15. CloudTrail S3 Data Events log delivery. Reception Lambda (not VPC-attached, ASM-140):&#10;Validates manifest, checksums, grant validity. Quarantines ungranted keys to quarantine/{yyyy}/{mm}/{dd}/.&#10;Persists record_persisted to mission table. Returns persistence receipt; buffer safely evicted." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="1255" as="sourcePoint" /><mxPoint x="2590" y="1310" as="targetPoint" /><Array as="points"><mxPoint x="2870" y="1255" /><mxPoint x="2870" y="1310" /></Array></mxGeometry></mxCell><mxCell id="msg_16" value="16. DynamoDB Stream pipe puts mission_record_persisted on custom EventBridge bus -&gt; SQS confirmation queue (ASM-149, ASM-161)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="1335" as="sourcePoint" /><mxPoint x="2890" y="1335" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_17" value="17. Confirmation Lambda reads SQS message; reads S3 focus photos (checks person_screen = clear, PD-015)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E7157B;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2890" y="1375" as="sourcePoint" /><mxPoint x="3190" y="1375" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_17_bedrock" value="17b. Bedrock Converse API: Nova Pro in us-east-1, zero-shot prompt (ASM-160, ASM-168)&#10;Output: {pest_signs_present: true, signs, confidence &gt;= 0.70 threshold}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3190" y="1395" as="sourcePoint" /><mxPoint x="3190" y="1435" as="targetPoint" /><Array as="points"><mxPoint x="3410" y="1395" /><mxPoint x="3410" y="1435" /></Array></mxGeometry></mxCell><mxCell id="msg_18" value="18. DynamoDB TransactWriteItems: writes confirmation_result to case (timestamp, confidence, source S3 key/version)&#10;and transitions Pest Case confirming -&gt; confirmed (ASM-141). NEVER AUTHORIZES FUMIGATION!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3190" y="1450" as="sourcePoint" /><mxPoint x="1040" y="1450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_19" value="19. Case reaching confirmed triggers Order Service to create draft Fumigation Order:&#10;Fields: {order_id, farm_id, plot_id, reason: case_id + focus_confirmed result, polygon_version}&#10;Guard: Plot has active polygon and confirmation record is closed (ASM-142). State: draft." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f172a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="1495" as="sourcePoint" /><mxPoint x="1040" y="1545" as="targetPoint" /><Array as="points"><mxPoint x="1300" y="1495" /><mxPoint x="1300" y="1545" /></Array></mxGeometry></mxCell><mxCell id="msg_20" value="20. Agronomist reviews draft order; sets UTC window (window_start, window_end); assigns pilot operator_id;&#10;specifies planned product_batch_id (ADR-002, ASM-029)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="1575" as="sourcePoint" /><mxPoint x="1040" y="1575" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_21" value="21. Agronomist AUTHORIZES order: Cognito token auth_time &lt;= 10 min old (ASM-092).&#10;Authorizer identity captured strictly from token; function roles denied. State: authorized." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b45309;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b45309;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="1645" as="sourcePoint" /><mxPoint x="1040" y="1645" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_auth_rule" value="HUMAN IDENTITY INVARIANT (Point 5 / ADR-002 / ASM-092):&#10;'La autorización de fumigación es una identidad humana. Ningún disparador la ejecuta.'&#10;Order transitions draft -&gt; authorized. State history appends actor, MFA time, reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="1715" width="520" height="75" as="geometry" /></mxCell><mxCell id="msg_23" value="23. Assigned pilot signs in with MFA; downloads fumigation mission package via execute-api&#10;Package carries: window, polygon_version, no-fly zones, planned product_batch_id, authorizer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="1885" as="sourcePoint" /><mxPoint x="2280" y="1885" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_23_resp" value="23b. Application API transitions Fumigation Order &amp; Mission to dispatched; records package digest (ASM-144)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="1935" as="sourcePoint" /><mxPoint x="1040" y="1935" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_24" value="24. Preloads fumigation mission package into Drone Kit before flight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="1975" as="sourcePoint" /><mxPoint x="1970" y="1975" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_25" value="25. Pilot flies fumigation inside authorized window. (Dose &amp; mixture out of scope).&#10;GPS track, flight closure, and flight record written to local encrypted buffer (ASM-095)." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="2015" as="sourcePoint" /><mxPoint x="1970" y="2060" as="targetPoint" /><Array as="points"><mxPoint x="2220" y="2015" /><mxPoint x="2220" y="2060" /></Array></mxGeometry></mxCell><mxCell id="msg_26" value="26. Link restored: kit reports flight_completed status (Order moves to flown); requests upload grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0284c7;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="2085" as="sourcePoint" /><mxPoint x="2280" y="2085" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_26_resp" value="26b. IoT Core issues upload grant for track/ and record/ prefixes (A09 sec 6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontColor=#059669;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="2125" as="sourcePoint" /><mxPoint x="1970" y="2125" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_27" value="27. HTTPS Upload of track/ and record/flight-record.json (ASM-146):&#10;farms/{farm_id}/cases/{case_id}/fumigation/{mission_id}/track/{seq}.json&#10;farms/{farm_id}/cases/{case_id}/fumigation/{mission_id}/record/flight-record.json&#10;Payload includes: pilot_subject_id, kit_thing_name, product_batch_id_used, takeoff/landing, closure (completed/aborted)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="2175" as="sourcePoint" /><mxPoint x="2590" y="2175" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_28" value="28. Reception Lambda validates flight record against upload grant &amp; order.&#10;Persists flight record in DynamoDB records. Returns persistence receipt; pilot evicts buffer." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="2255" as="sourcePoint" /><mxPoint x="2590" y="2300" as="targetPoint" /><Array as="points"><mxPoint x="2870" y="2255" /><mxPoint x="2870" y="2300" /></Array></mxGeometry></mxCell><mxCell id="msg_28_exec" value="28b. Order state transitions flown -&gt; executed (ASM-146). (Flagged if out_of_window, batch_mismatch, or aborted_closure)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="2325" as="sourcePoint" /><mxPoint x="1040" y="2325" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_no_signal_rule" value="STORE-AND-FORWARD INVARIANT (Point 3 / A10 sec 6 / ASM-146):&#10;Order in flown does NOT expire at window_end while buffered without signal (PD-141).&#10;Any persisted fumigation flight record moves order to executed, even if closure is aborted;&#10;flags are recorded, and verification determines whether the case can close." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#78350f;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1880" y="2375" width="540" height="75" as="geometry" /></mxCell><mxCell id="self_29" value="29. Order reaching executed plans a verification mission for the same plot and focus point (ASM-141).&#10;Pest Case state transitions in_fumigation -&gt; verifying. Pilot assigned." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f172a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="2535" as="sourcePoint" /><mxPoint x="1040" y="2580" as="targetPoint" /><Array as="points"><mxPoint x="1310" y="2535" /><mxPoint x="1310" y="2580" /></Array></mxGeometry></mxCell><mxCell id="msg_30" value="30. Pilot downloads verification package; flies short pass over focus point; buffers photos &amp; track" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="2605" as="sourcePoint" /><mxPoint x="2280" y="2605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_31" value="31. HTTPS Upload of verification photos &amp; flight record:&#10;farms/{farm_id}/cases/{case_id}/verification/{mission_id}/photos/{seq}.jpg&#10;farms/{farm_id}/cases/{case_id}/verification/{mission_id}/record/flight-record.json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0369a1;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="2655" as="sourcePoint" /><mxPoint x="2590" y="2655" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_32" value="32. Reception Lambda validates manifest &amp; grant; persists record_persisted for verification mission.&#10;DynamoDB Stream pipe puts event on EventBridge -&gt; routes to SQS verification queue (ASM-149)." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#15803d;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="2715" as="sourcePoint" /><mxPoint x="2590" y="2760" as="targetPoint" /><Array as="points"><mxPoint x="2870" y="2715" /><mxPoint x="2870" y="2760" /></Array></mxGeometry></mxCell><mxCell id="msg_33" value="33. Verification Lambda reads SQS; reads S3 verification photos &amp; track; checks person_screen = clear" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E7157B;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2890" y="2785" as="sourcePoint" /><mxPoint x="3190" y="2785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_33_bedrock" value="33b. Bedrock Converse API: evaluates active_signs_at_focus = false, confidence &gt;= 0.70 (ASM-163)&#10;Decision: can_close = true (focus pest cleared)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3190" y="2810" as="sourcePoint" /><mxPoint x="3190" y="2850" as="targetPoint" /><Array as="points"><mxPoint x="3410" y="2810" /><mxPoint x="3410" y="2850" /></Array></mxGeometry></mxCell><mxCell id="msg_34" value="34. DynamoDB TransactWriteItems: writes verification_results; transitions Fumigation Order executed -&gt; closed;&#10;and transitions Pest Case verifying -&gt; closed (case_closed event) (ASM-141, Part E)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontColor=#01A88D;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3190" y="2875" as="sourcePoint" /><mxPoint x="1040" y="2875" as="targetPoint" /></mxGeometry></mxCell><mxCell id="self_35" value="35. Case closure triggers plot state switch: Plot returns from Precision Mode back to Area Mode (ADR-002).&#10;Traceability complete: sack harvest &amp; review campaigns continue in Area Mode." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f172a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;spacingLeft=8;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;spacing=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="2945" as="sourcePoint" /><mxPoint x="1040" y="2990" as="targetPoint" /><Array as="points"><mxPoint x="1320" y="2945" /><mxPoint x="1320" y="2990" /></Array></mxGeometry></mxCell><mxCell id="note_unclosed_rule" value="CLOSURE INVARIANT (Point 2 / A15 sec 5.1 / ASM-141 / PD-141):&#10;'Si ese archivo no llega, la fumigación sigue abierta.' If the verification object or track does not arrive,&#10;verification mission stays in flown, case stays in verifying, and CloudWatch alarms report unclosed fumigations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2480" y="3010" width="850" height="75" as="geometry" /></mxCell><mxCell id="panel_s3_legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="3150" width="3520" height="120" as="geometry" /></mxCell><mxCell id="panel_s3_legend_text" value="&lt;b&gt;Amazon S3 Drone Object Bucket Hierarchy (Workload Account pdn | us-east-1 | SSE-KMS Key 'objects' | Block Public Access | 5-Year Lifecycle Retention ASM-145):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Pest Case Missions:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/cases/{case_id}/{mission_type}/{mission_id}/&lt;/code&gt; (types: &lt;code&gt;confirmation&lt;/code&gt;, &lt;code&gt;fumigation&lt;/code&gt;, &lt;code&gt;verification&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Mission Sub-Prefixes:&lt;/b&gt; &lt;code&gt;package/mission-package-v{n}.json&lt;/code&gt; (issued package) | &lt;code&gt;record/flight-record.json&lt;/code&gt; (returned record) | &lt;code&gt;photos/{seq}.jpg&lt;/code&gt; | &lt;code&gt;track/{seq}.json&lt;/code&gt; | &lt;code&gt;maps/&lt;/code&gt; | &lt;code&gt;polygons/&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Review Campaign Missions:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/campaigns/{campaign_id}/{mission_type}/{mission_id}/&lt;/code&gt; (types: &lt;code&gt;delimitation&lt;/code&gt;, &lt;code&gt;estimation&lt;/code&gt;) | &lt;b&gt;Extra Delimitation:&lt;/b&gt; &lt;code&gt;farms/{farm_id}/extra/{mission_id}/delimitation/&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Quarantine Prefix:&lt;/b&gt; &lt;code&gt;quarantine/{yyyy}/{mm}/{dd}/{original_key}&lt;/code&gt; (unmatched grants, revoked pilot/kit, or person screen quarantine; never linked to order or inference, PD-104)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="3160" width="3500" height="100" as="geometry" /></mxCell></root></mxGraphModel>