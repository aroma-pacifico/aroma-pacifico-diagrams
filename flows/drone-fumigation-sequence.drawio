<mxGraphModel dx="3600" dy="3300" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3600" pageHeight="3300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Drone Fumigation Service: End-to-End Sequence Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="2200" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="Complete operational chain from crop node pest detection, threshold evaluation, and confirmation flight to fumigation authorization, execution, verification, S3 persistence, and case closure." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="2400" height="30" as="geometry" /></mxCell><mxCell id="meta" value="Normative Sources: docs/drone-service.md (all sections), docs/inference-functions.md (sections 2-5, 8), ADR-002, A19 sec 11. Box badges: D04 (VPC/Endpoints), D06 (Cognito/KMS), D08 (Farm Module), D09 (Ingestion), D10 (Inference Pattern)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748b;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2500" height="25" as="geometry" /></mxCell><mxCell id="badge_2750" value="D08: Farm Module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="2750" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="badge_2920" value="D09: Ingestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="2920" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="badge_3080" value="D10: Inference Pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3080" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="badge_3270" value="D06: Security &amp; IAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3270" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="badge_3440" value="D04: Network &amp; Endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="3440" y="35" width="145" height="30" as="geometry" /></mxCell><mxCell id="ll_0_hdr" value="Crop Node&#10;(Farm Plot Sensor | D08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_0_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="200" as="sourcePoint" /><mxPoint x="160" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_0_ftr" value="Crop Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_1_hdr" value="AWS IoT Core&#10;(Ingestion Topic Rule | D09)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_1_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="200" as="sourcePoint" /><mxPoint x="450" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_1_ftr" value="AWS IoT Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_2_hdr" value="Threshold Lambda&#10;(Alerts &amp; SNS Topic | D10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="650" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_2_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="200" as="sourcePoint" /><mxPoint x="740" y="3120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_2_ftr" value="Threshold Lambda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="655" y="3120" width="170" height="40" as="geometry" /></mxCell><mxCell id="ll_3_hdr" value="Case &amp; Order Service&#10;(DynamoDB records Store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="950" y="135" width="180" height="65" as="geometry" /></mxCell><mxCell id="ll_3_line" value="" style="strokeColor=#94a3b8;strokeWidth=2;dashed=1;html=1;endArrow=none;" edge="1" parent="1