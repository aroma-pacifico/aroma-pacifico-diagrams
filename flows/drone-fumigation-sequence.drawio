    <mxCell id="m15" value="15. Preload + fly offline (encrypted buffer)" style="edgeStyle=none;html=1;strokeColor=#0F172A;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11.5;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="886" as="sourcePoint" /><mxPoint x="1385" y="886" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
