        <mxCell id="edge_t7" value="T7: delivered_at_port [accepted]&#10;[Transporter | receiver_reference]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#065f46;labelBackgroundColor=#ffffff;labelBorderColor=#a7f3d0;fontStyle=1;" edge="1" parent="1" source="s5_transit_port" target="s6_port_accepted">
