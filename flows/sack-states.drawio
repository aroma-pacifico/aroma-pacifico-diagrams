        <mxCell id="edge_t5_rej" value="T5: bound_at_center [rejected, reason]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#92400e;labelBackgroundColor=#ffffff;labelBorderColor=#fde68a;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="start_unlabeled" target="s4_center_rejected">
