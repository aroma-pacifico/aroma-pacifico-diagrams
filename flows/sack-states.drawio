          <mxGeometry x="40" y="20" width="3300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="hdr_title" value="SACK STATE MACHINE AND TRANSITION LIFECYCLE" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="65" y="28" width="2200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="hdr_sub" value="The seven sack states across farm, trip, collection center, and port: events, responsible roles, guards, and offline reconciliation rules." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#bcccdc;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="65" y="60" width="2200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="hdr_meta" value="Refs aroma-pacifico/aroma-pacifico-roadmap#19 | Closes ALPH-29 | Source: docs/sack-and-trip.md sec 3-4, docs/security-and-identity.md sec 8 | Box badges: D04, D06" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#9fb3c8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="65" y="84" width="2200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="hdr_badge" value="RECOVERY TARGETS (ASM-157, PD-153)&#10;RPO: 15 min for sack events | RTO: 4 h for public lookup&#10;7 States (Part C) -&gt; 4 Design System Badges (PD-154)&#10;Offline Rule: Receiver Authoritative (ASM-152)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2740" y="28" width="580" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="zone_farm" value="ZONE 1: FARM ORIGIN &amp; REGISTRATION&#10;Wet Mill Packaging &amp; App Registration [Box D04, D06]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#166534;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="650" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="zone_trip1" value="ZONE 2: IN TRANSIT TO CENTER&#10;Transporter Feeder Road Trip (ASM-159) [Box D04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="130" width="560" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="zone_center" value="ZONE 3: COLLECTION CENTER (RECEPTION &amp; LOT STAGING)&#10;Cauca, Huila &amp; Tolima Receiving Centers [Box D05, D06]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontColor=#854d0e;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="130" width="760" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="zone_port" value="ZONE 4: IN TRANSIT TO PORT &amp; BUENAVENTURA DELIVERY&#10;Highway Transit &amp; Maritime Port Export Handover [Box D04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=2;fontColor=#9d174d;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2100" y="130" width="1240" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="start_registered" value="Pre-printed&#10;Label Batch&#10;Issued" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=#15803d;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="335" width="95" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s1_in_prep" value="in_preparation&#10;Part C: en preparación | Badge: [en preparación]&#10;--------------------------------------------------&#10;• Sack born at wet mill in 60 kg reference (ASM-150)&#10;• Scale weight measured and recorded with 1 decimal&#10;• Confirms drying lot (links to drying variables, ASM-096)&#10;• Code bound from pre-printed batch (80 bits, ASM-094)&#10;• Encrypted outbox buffers until cellular uplink (ASM-079)&#10;• Responsible: Farmer (Farmer App, field pool, no MFA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="275" width="400" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="s2_transit_center" value="in_transit_to_center&#10;Part C: en viaje al acopio | Badge: [en viaje]&#10;--------------------------------------------------&#10;• Physical custody on vehicle with transporter&#10;• Open trip of type farm_to_center (ASM-159)&#10;• GNSS fix recorded every 5 min en route (PD-110)&#10;• Buffered offline during feeder road dead zones&#10;• Reconnect: custody first, positions oldest first&#10;• Responsible: Transporter (Transporter App, field pool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="850" y="275" width="400" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="s3_center_accepted" value="at_center_accepted&#10;Part C: en acopio (aceptado) | Badge: [aceptado]&#10;--------------------------------------------------&#10;• Physical reception at collection center (ASM-151)&#10;• Non-terminal: staged for outbound port transport&#10;• Ready for assigned_to_trip to Buenaventura&#10;• Receiver-authoritative: applied if pickup delayed (ASM-152)&#10;• Responsible: Center Operator (Logistics App, TOTP MFA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1490" y="220" width="480" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="s4_center_rejected" value="at_center_rejected&#10;Part C: en acopio (rechazado) | Badge: [rechazado]&#10;--------------------------------------------------&#10;• Physical reception rejected; reason is mandatory&#10;• TERMINAL IN PILOT (ASM-151): does NOT travel to port&#10;• Reprocessed coffee presented as NEW sack with NEW code&#10;• Rejected sack preserves complete historical audit trail&#10;• Responsible: Center Operator (Logistics App, TOTP MFA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1490" y="490" width="480" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="start_unlabeled" value="Unlabeled Arrival&#10;Center Reserve&#10;(&gt;= 400 codes)&#10;ASM-153" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=#b45309;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="735" width="115" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s5_transit_port" value="in_transit_to_port&#10;Part C: en viaje al puerto | Badge: [en viaje]&#10;--------------------------------------------------&#10;• Open trip of type center_to_port (ASM-159)&#10;• Origin: collection center; Destination: Buenaventura port&#10;• Center operator assigned accepted sacks (assigned_to_trip)&#10;• GNSS fix recorded every 5 min en route (PD-110)&#10;• Responsible: Transporter (Transporter App, field pool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="2230" y="275" width="410" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="s6_port_accepted" value="delivered_at_port_accepted&#10;Part C: entregado en puerto (aceptado)&#10;Badge: [aceptado]&#10;--------------------------------------------------&#10;• TERMINAL STATE&#10;• Handover accepted by port maritime receiver&#10;• Port receiver reference recorded (ASM-057, ASM-077)&#10;• Custody transfer to maritime export complete&#10;• Responsible: Transporter (Transporter App)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="2870" y="215" width="420" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="s7_port_rejected" value="delivered_at_port_rejected&#10;Part C: entregado en puerto (rechazado)&#10;Badge: [rechazado]&#10;--------------------------------------------------&#10;• TERMINAL STATE&#10;• Handover rejected by port maritime receiver&#10;• Rejection reason &amp; receiver reference recorded&#10;• Commercial dispute audit trace preserved&#10;• Responsible: Transporter (Transporter App)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#1e293b;fontSize=13;align=left;verticalAlign=top;spacing=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="2870" y="490" width="420" height="210" as="geometry"/>
        </mxCell>
