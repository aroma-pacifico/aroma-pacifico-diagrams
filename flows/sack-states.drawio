  <diagram id="sack-states" name="Sack State Machine and Lifecycle">
    <mxGraphModel dx="3380" dy="1620" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3380" pageHeight="1620" math="0" shadow="0">
