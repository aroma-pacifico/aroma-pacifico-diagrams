        </mxCell>
        <mxCell id="edge_t8" value="T8: delivered_at_port [rejected, reason]&#10;[Transporter | receiver_reference]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#991b1b;labelBackgroundColor=#ffffff;labelBorderColor=#fecaca;fontStyle=1;" edge="1" parent="1" source="s5_transit_port" target="s7_port_rejected">
          <mxGeometry relative="1" as="geometry">
