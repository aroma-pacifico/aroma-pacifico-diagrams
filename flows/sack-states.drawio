        <mxCell id="edge_t6" value="T6: departed_to_port (custody)&#10;[Transporter | assigned_to_trip]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#1e40af;labelBackgroundColor=#ffffff;labelBorderColor=#bfdbfe;fontStyle=1;exitX=1;exitY=0.48;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_center_accepted" target="s5_transit_port">
