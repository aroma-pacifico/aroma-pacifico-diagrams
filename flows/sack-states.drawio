        <mxCell id="edge_t3b" value="T3b: Offline Delayed Pickup Rule (ASM-152) — Receiver Authoritative: center reception applied even if pickup still buffered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=2;strokeDashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=13;fontColor=#0f766e;labelBackgroundColor=#ffffff;labelBorderColor=#99f6e4;fontStyle=1;" edge="1" parent="1" source="s1_in_prep" target="s3_center_accepted">
          <mxGeometry relative="1" as="geometry">
