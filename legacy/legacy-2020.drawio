        <mxCell id="text_L08_left" value="&lt;b style=&quot;font-size:15px;color:#1a202c;&quot;&gt;Three applications planned: farmer, transporter, web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1, Contexto: &quot;Hay tres aplicaciones previstas. No hay que construirlas&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;Farmer mobile app, transporter mobile app, and web reporting / public lookup interface.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="200" y="1028" width="1080" height="76" as="geometry" />
