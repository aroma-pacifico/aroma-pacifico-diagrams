        </mxCell>
        <mxCell id="text_L12_left" value="&lt;b style=&quot;font-size:15px;color:#1a202c;&quot;&gt;Port of Buenaventura without LAN or WAN link&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1-2: &quot;En Buenaventura no se despliega infraestructura de la Federación&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;Port reception had no network infrastructure, leaving final export handover and maritime delivery completely unaddressed.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="200" y="1513" width="1080" height="76" as="geometry" />
        </mxCell>
        <mxCell id="right_L12" value="" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="1900" y="1505" width="1240" height="92" as="geometry" />
        </mxCell>
        <mxCell id="text_L12_right" value="&lt;b style=&quot;font-size:15px;color:#7b341e;&quot;&gt;Zero Federation Infrastructure at Port | Commercial Mobile Outbox&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#c05621;font-weight:bold;&quot;&gt;[A10 / A16 (Connectivity §10)]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;Zero Federation hardware deployed at Buenaventura port (case statement mandate). Transporter app records maritime delivery &amp; custody handoff; encrypted outbox syncs via commercial mobile carrier.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1920" y="1513" width="1190" height="76" as="geometry" />
        </mxCell>
