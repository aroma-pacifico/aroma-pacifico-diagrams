        <mxCell id="text_L10_right" value="&lt;b style=&quot;font-size:14.5px;color:#7b341e;&quot;&gt;24-Hour Store-and-Forward Encrypted Non-Volatile Local Buffer&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#c05621;font-weight:bold;&quot;&gt;[A10 (Connectivity §4.3) | B08, B09]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2d3748;&quot;&gt;Nodes buffer readings locally up to 24 hours. Upon reconnect: live reading sent first,&lt;br&gt;then oldest readings drain in background; AWS IoT PUBACK releases buffer entries.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1920" y="1345" width="989" height="74" as="geometry" />
        </mxCell>
