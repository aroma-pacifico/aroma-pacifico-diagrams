        <mxCell id="text_L11_left" value="&lt;b style=&quot;font-size:14.5px;color:#1a202c;&quot;&gt;Collection center without LAN or WAN link&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1, Qué se actualiza: &quot;El centro de acopio y el puerto quedaban sin LAN ni enlace WAN&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2d3748;&quot;&gt;Collection center without LAN or WAN link.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
