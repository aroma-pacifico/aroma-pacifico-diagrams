        <mxCell id="text_L01_right" value="&lt;b style=&quot;font-size:14.5px;color:#1a365d;&quot;&gt;End-to-End Coffee Sack Traceability Chain&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#2b6cb0;font-weight:bold;&quot;&gt;[A16 (Sack &amp; Trip §3)]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2d3748;&quot;&gt;The 60 kg sack is the immutable traced unit from harvest registration to port delivery.&lt;br&gt;Event-driven audit log with 5-year compliance retention (S3 Object Lock, ASM-067).&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1920" y="298" width="1180" height="74" as="geometry" />
