        <mxCell id="text_L01_left" value="&lt;b style=&quot;font-size:15px;color:#1a202c;&quot;&gt;Traceability from farm to buyer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1, Contexto: &quot;piloto de trazabilidad del café, desde la finca hasta el comprador&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;Full chain scope: wet mill, transport, collection center, and maritime export port of Buenaventura.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="200" y="293" width="1080" height="76" as="geometry" />
