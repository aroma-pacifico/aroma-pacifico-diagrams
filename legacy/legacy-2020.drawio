        <mxCell id="reason_L14" value="&lt;b style=&quot;font-size:14px;color:#9b2c2c;&quot;&gt;Reason for Retirement: Invalid Historical Pricing Mandate (PD-017, A23)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Case statement explicitly invalidates all 2020 pricing quotes. 2026 architecture prices all cloud infrastructure, sensor hardware, drone missions, and satellite fees at current 2026 market rates under A23 (roadmap#36).&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
