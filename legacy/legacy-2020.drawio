        <mxCell id="header_mandate" value="Case Statement Core Mandates (p. 1, 7): &quot;Se conserva el requisito que siga vigente y se reemplaza el supuesto de conectividad&quot; | &quot;Precios, dispositivos y servicios de nube de 2020 no son cotización válida&quot; | &quot;No se replica la arquitectura de 2020&quot; | &quot;No se hereda un manual de 2020&quot;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontColor=#2b6cb0;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1">
