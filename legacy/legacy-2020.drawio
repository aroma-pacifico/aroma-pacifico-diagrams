        <mxCell id="text_L01_left" value="&lt;b style=&quot;font-size:14.5px;color:#1a202c;&quot;&gt;Traceability from farm to buyer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1, Contexto: &quot;piloto de trazabilidad del café, desde la finca hasta el comprador&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2d3748;&quot;&gt;Chain through wet mill, transport, collection center and port.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
