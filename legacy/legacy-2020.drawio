        <mxCell id="text_L16" value="&lt;s style=&quot;font-size:14px;color:#742a2a;font-weight:bold;&quot;&gt;2020 cloud services and cloud provider choices&lt;/s&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#9b2c2c;&quot;&gt;Case statement p. 1: &quot;Servicios de nube de 2020 no son cotización válida&quot;&lt;/span&gt;&lt;br&gt;&lt;s style=&quot;font-size:12px;color:#742a2a;&quot;&gt;Legacy cloud provider selections and architecture patterns conceived in 2020.&lt;/s&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
