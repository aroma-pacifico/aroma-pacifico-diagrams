        <mxCell id="fnd_0" value="" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="1900" y="1735" width="1240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fnd_text_0" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;1. Primary Cloud &amp; Multi-Account Architecture (ADR-001)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;AWS Organizations with us-east-1 primary Region. Three workload accounts (dev, qa, pdn) with isolated IAM roles and network boundaries (ASM-060).&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1915" y="1743" width="1140" height="74" as="geometry" />
        </mxCell>
        <mxCell id="fnd_icon_0" value="" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1">
          <mxGeometry x="3075" y="1757" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fnd_1" value="" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="1900" y="1837" width="1240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fnd_text_1" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;2. Prepared Secondary Cloud Target (ADR-001, ASM-035)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Azure RFC 1918 supernet 10.88.0.0/13 reserved as export target, undeployed in pilot. Avoids multi-cloud operational cost while preserving cloud portability.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1915" y="1845" width="1200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="fnd_2" value="" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="1900" y="1939" width="1240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fnd_text_2" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;3. Plan-Only Modular Infrastructure as Code (ADR-003 | D01-D03)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Terraform root stacks consuming public tagged modules. S3 remote state with native locking, automated GitHub Actions CI/CD plan validation.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1915" y="1947" width="1140" height="74" as="geometry" />
        </mxCell>
