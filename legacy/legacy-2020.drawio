        <mxCell id="text_L18" value="&lt;s style=&quot;font-size:14px;color:#742a2a;font-weight:bold;&quot;&gt;2020 design manual&lt;/s&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#9b2c2c;&quot;&gt;Case statement p. 7, Sistema de diseño: &quot;No se hereda un manual de 2020&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#742a2a;&quot;&gt;2020 design manual.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
