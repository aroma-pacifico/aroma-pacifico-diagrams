        <mxCell id="text_L13" value="&lt;s style=&quot;font-size:14px;color:#742a2a;font-weight:bold;&quot;&gt;Dependence on a mobile access network generation&lt;/s&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#9b2c2c;&quot;&gt;Case statement p. 2: &quot;La red de acceso móvil cambió desde 2020&quot;&lt;/span&gt;&lt;br&gt;&lt;s style=&quot;font-size:12px;color:#742a2a;&quot;&gt;2G / 3G circuit-switched cellular connections and legacy SMS-only paths.&lt;/s&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
