        </mxCell>
        <mxCell id="text_L09_right" value="&lt;b style=&quot;font-size:14.5px;color:#7b341e;&quot;&gt;No-Signal Protocol &amp; Satellite Bearer for Out-of-Coverage Farms&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#c05621;font-weight:bold;&quot;&gt;[A10 (Connectivity §4.4)]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2d3748;&quot;&gt;Every data flow states explicit offline behavior. Farms out of cellular coverage utilize&lt;br&gt;satellite IP bearer (dual-mode modules, contact at least every 4h, ASM-073, PD-081).&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1920" y="1243" width="1180" height="74" as="geometry" />
        </mxCell>
