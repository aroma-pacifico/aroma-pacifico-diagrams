        <mxCell id="text_L07_right" value="&lt;b style=&quot;font-size:15px;color:#1a365d;&quot;&gt;Five Drone Missions &amp; Governed Flight Operations&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size:12px;color:#2b6cb0;font-weight:bold;&quot;&gt;[ADR-002 / A15 (Drone Service §5.2)]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;All 5 missions preserved under combined flight mode (contracted operator, ASM-141). Governed by agronomist MFA authorization, pre-flight checks, and S3 flight record audit.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1920" y="923" width="1134" height="76" as="geometry" />
