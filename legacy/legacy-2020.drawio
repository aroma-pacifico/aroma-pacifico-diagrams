        <mxCell id="reason_L18" value="&lt;b style=&quot;font-size:14px;color:#9b2c2c;&quot;&gt;Reason for Retirement: New Design System for Modern User Experience (Epic 7, PD-154)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Case statement bans inheriting any 2020 user interface manual. Replaced by Challenge Point 7 new design system, establishing 4 accessible visual badges for 7 sack lifecycle states and responsive web guidelines.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="700" y="2205" width="1120" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fnd_0" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;1. Primary Cloud &amp; Multi-Account Architecture (ADR-001)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;AWS Organizations with us-east-1 primary Region. Three workload accounts (dev, qa, pdn) with isolated IAM roles and network boundaries (ASM-060).&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1900" y="1680" width="1185" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fnd_icon_0" value="" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1">
          <mxGeometry x="3074" y="1703" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fnd_1" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;2. Prepared Secondary Cloud Target (ADR-001, ASM-035)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Azure RFC 1918 supernet 10.88.0.0/13 reserved as export target, undeployed in pilot. Avoids multi-cloud operational cost while preserving cloud portability.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1900" y="1785" width="1240" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fnd_2" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;3. Plan-Only Modular Infrastructure as Code (ADR-003 | D01-D03)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Terraform root stacks consuming public tagged modules. S3 remote state with native locking, automated GitHub Actions CI/CD plan validation.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1900" y="1890" width="1185" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fnd_icon_2" value="" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1">
          <mxGeometry x="3074" y="1913" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fnd_3" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;4. Standardized Functional Device Classes &amp; 2026 Pricing (A10, A23)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Vendor-neutral device specifications (field telemetry nodes, drone kit, mobile outbox). Current 2026 market pricing for 200 farms under PD-017.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1900" y="1995" width="1240" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fnd_4" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;5. Zero-Trust Identity &amp; 5-Year Compliance Audit Pipeline (D06, ASM-067)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;X.509 device certs (mTLS), Cognito User Pools (staff MFA / field passwordless). Dual-layer audit with S3 Object Lock 5-year compliance archive.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1900" y="2100" width="1185" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fnd_icon_4" value="" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1">
          <mxGeometry x="3074" y="2123" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fnd_5" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;6. Modern Accessible Design System (Epic 7, PD-154)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Modern responsive UI replacing legacy manual. 4 accessible status badges mapping the 7 coffee sack lifecycle states with color + icon redundancy.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1900" y="2205" width="1240" height="92" as="geometry" />
        </mxCell>
        <mxCell id="footer_traceability" value="&lt;b style=&quot;font-size:13px;color:#1a202c;&quot;&gt;Decision-Log &amp; Specification Traceability:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#4a5568;&quot;&gt;• &lt;b&gt;Decisions Closed:&lt;/b&gt; PD-004 (2020 legacy record), PD-007 (ADR-001 cloud selection), PD-008 (Architecture doc §13), PD-051 (Lookup front door CloudFront/Lambda URL).&lt;br&gt;• &lt;b&gt;Core Architectural Assumptions:&lt;/b&gt; ASM-001 (Spanish prevails), ASM-040 (case statement only source), ASM-041 (mobile networks), ASM-061 (DynamoDB on-demand), ASM-073 (satellite bearer), ASM-083 (center addressing), ASM-150 (60 kg reference weight), PD-017 (2026 pricing schedule).&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#cbd5e0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
