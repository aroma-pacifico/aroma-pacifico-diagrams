          <mxGeometry x="1900" y="2041" width="1240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fnd_text_3" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;4. Standardized Functional Device Classes &amp; 2026 Pricing (A10, A23)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Vendor-neutral device specifications (field telemetry nodes, drone kit, mobile outbox). Current 2026 market pricing for 200 farms under open decision PD-017.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1915" y="2049" width="1200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="fnd_4" value="" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="1900" y="2143" width="1240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fnd_text_4" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;5. Zero-Trust Identity &amp; 5-Year Compliance Audit Pipeline (D06, ASM-067)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;X.509 device certs (mTLS), Cognito User Pools (staff MFA / field passwordless). Dual-layer audit with S3 Object Lock 5-year compliance archive.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1915" y="2151" width="1140" height="74" as="geometry" />
        </mxCell>
        <mxCell id="fnd_icon_4" value="" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1">
          <mxGeometry x="3075" y="2165" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fnd_5" value="" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="1900" y="2245" width="1240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fnd_text_5" value="&lt;b style=&quot;font-size:14px;color:#1a365d;&quot;&gt;6. Modern Accessible Design System (Epic 7, PD-154)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;Modern responsive UI replacing legacy manual. 4 accessible status badges mapping the 7 coffee sack lifecycle states with color + icon redundancy.&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="1915" y="2253" width="1200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="footer_box" value="" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#cbd5e0;strokeWidth=1.5;" vertex="1">
          <mxGeometry x="40" y="2390" width="3120" height="130" as="geometry" />
        </mxCell>
        <mxCell id="footer_traceability" value="&lt;b style=&quot;font-size:13px;color:#1a202c;&quot;&gt;Decision-Log &amp; Specification Traceability:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#4a5568;&quot;&gt;• &lt;b&gt;Decisions Referenced:&lt;/b&gt; Closed: PD-004 (2020 legacy record), PD-007 (ADR-001 cloud selection), PD-008 (Architecture doc §13). Open: PD-017 (2026 market pricing), PD-051 (Lookup front door CloudFront/Lambda URL).&lt;br&gt;• &lt;b&gt;Core Architectural Assumptions:&lt;/b&gt; ASM-001 (Spanish prevails), ASM-040 (case statement only source), ASM-041 (mobile networks), ASM-061 (DynamoDB on-demand), ASM-073 (satellite bearer), ASM-083 (center addressing), ASM-150 (60 kg reference weight).&lt;/span&gt;" parent="1" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;html=1;" vertex="1">
          <mxGeometry x="50" y="2400" width="1780" height="110" as="geometry" />
        </mxCell>
        <mxCell id="footer_summary" value="&lt;b style=&quot;font-size:13px;color:#102a43;&quot;&gt;Summary Statistics &amp; IaC Traceability:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;• &lt;b&gt;Total 2020 Elements Traced:&lt;/b&gt; 18 elements (L-01 to L-18)&lt;br&gt;• &lt;b&gt;Kept:&lt;/b&gt; 8 (44.4%) | &lt;b&gt;Replaced:&lt;/b&gt; 4 (22.2%) | &lt;b&gt;Retired:&lt;/b&gt; 6 (33.3%)&lt;br&gt;• &lt;b&gt;Track B IaC Badges Referenced:&lt;/b&gt; D04 (VPC &amp; Endpoints), D05 (Transit Gateway &amp; Centers), D08 (Farm Module), D09 (Telemetry Ingestion), D10 (Inference Functions)&lt;/span&gt;" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#90cdf4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
          <mxGeometry x="1870" y="2400" width="1270" height="110" as="geometry" />
        </mxCell>
