        </mxCell>
        <mxCell id="reason_L13" value="&lt;b style=&quot;font-size:14px;color:#9b2c2c;&quot;&gt;Reason for Retirement: Obsolete Mobile Generation Sunset (ASM-041, ASM-072)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2d3748;&quot;&gt;2G and 3G circuit-switched networks sunset before or during 2026 pilot. 2026 architecture enforces pure packet-switched IP bearers (4G LTE / Satellite IP) with zero circuit-switched or carrier generation dependency.&lt;/span&gt;" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;html=1;" vertex="1">
