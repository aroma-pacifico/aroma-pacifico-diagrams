        <mxCell id="text_L09_left" value="&lt;b style=&quot;font-size:15px;color:#1a202c;&quot;&gt;Assumption of data coverage on most farms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1, Qué se actualiza: &quot;asumía cobertura de datos en la mayoría de las fincas&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;Assumed continuous commercial cellular coverage across remote Andean coffee farms in Cauca, Huila and Tolima.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="200" y="1198" width="1080" height="76" as="geometry" />
        </mxCell>
