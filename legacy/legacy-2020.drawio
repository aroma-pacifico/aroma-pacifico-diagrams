        <mxCell id="text_L10_left" value="&lt;b style=&quot;font-size:15px;color:#1a202c;&quot;&gt;Direct telemetry publishing to ingestion point&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#718096;&quot;&gt;Case statement p. 1, Qué se actualiza: &quot;un dispositivo publicando telemetría directo al punto de ingesta&quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#2d3748;&quot;&gt;Field nodes transmitted readings immediately to cloud; sensor readings were dropped/lost whenever link was unavailable.&lt;/span&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
          <mxGeometry x="200" y="1303" width="1080" height="76" as="geometry" />
