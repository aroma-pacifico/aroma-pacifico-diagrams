        <mxCell id="text_L14" value="&lt;s style=&quot;font-size:14px;color:#742a2a;font-weight:bold;&quot;&gt;2020 prices and historical budget quotes&lt;/s&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#9b2c2c;&quot;&gt;Case statement p. 1: &quot;Precios [...] de 2020 no son cotización válida&quot;&lt;/span&gt;&lt;br&gt;&lt;s style=&quot;font-size:12px;color:#742a2a;&quot;&gt;All 2020 hardware quotes, connectivity fees, and cloud pricing figures.&lt;/s&gt;" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=5;" vertex="1">
