        <mxCell id="s1" value="1. Sensor reading&#10;IoT Core persists telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8da2b5;strokeWidth=1.5;fontColor=#172b4d;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
