        <mxCell id="farmbuf" value="Encrypted, non-volatile buffer&#10;Store-and-forward, maximum 24 h&#10;Live first, then oldest; PUBACK releases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=18;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="365" y="245" width="285" height="150" as="geometry" />
