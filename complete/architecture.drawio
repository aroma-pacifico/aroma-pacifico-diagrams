        <mxCell id="title" value="Complete architecture | Aroma Pacifico 2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=34;fontStyle=1;fontColor=#102a43;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="2890" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Runtime paths, boundaries, trust controls, D01-D13 IaC traceability and the end-to-end crop-alert, drone, sack and trip flows. Primary cloud: AWS us-east-1; Azure is prepared as an undeployed export target (ADR-001)." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#334e68;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="2890" height="50" as="geometry" />
        </mxCell>
        <mxCell id="farm" value="FARMS | 200 farms across Cauca, Huila and Tolima" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8fc;strokeColor=#61788d;strokeWidth=2;fontColor=#172b4d;fontSize=24;fontStyle=1;align=left;verticalAlign=top;spacingLeft=40;spacingTop=25;" parent="1" vertex="1">
          <mxGeometry x="40" y="155" width="690" height="590" as="geometry" />
        </mxCell>
        <mxCell id="farmnodes" value="Crop + drying nodes&#10;Crop: 6 readings/day; drying: 24/day&#10;TLS MQTT, per-node X.509 identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=17;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
