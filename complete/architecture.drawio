        <mxCell id="sub2" value="Track B implements reusable patterns and one plan-only environment; it does not instantiate 200 farms or three center networks." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#334e68;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="2900" height="45" as="geometry" />
