        <mxCell id="mission" value="Ground station preloads mission, polygon and no-fly zones before flight. Operator is contracted and certified; MFA identity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
