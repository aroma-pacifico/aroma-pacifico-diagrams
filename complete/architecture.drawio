          <mxGeometry x="630" y="155" width="82" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c_D02" value="Remote state&#10;&#10;One encrypted, versioned S3 state bucket per environment with native S3 locking (ADR-003)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8da2b5;strokeWidth=1.5;fontColor=#172b4d;fontSize=18;align=left;verticalAlign=middle;spacing=11;" vertex="1" parent="1">
