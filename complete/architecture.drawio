<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="runtime" name="Complete architecture">
    <mxGraphModel dx="3200" dy="2400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3200" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" style="" />
        <mxCell id="1" parent="0" style="" />
        <mxCell id="title" value="Complete architecture | Aroma Pacifico 2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=35;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="3500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Runtime paths, boundaries, trust controls and the end-to-end crop-alert, drone, sack and trip flows. Primary cloud: AWS us-east-1; Azure is prepared as an undeployed export target (ADR-001)." style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontColor=#334e68;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="3500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="farm" value="FARMS | 200 farms across Cauca, Huila and Tolima" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8fc;strokeColor=#61788d;strokeWidth=2;fontColor=#172b4d;fontSize=24;fontStyle=1;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="690" height="590" as="geometry" />
        </mxCell>
        <mxCell id="farmnodes" value="Crop + drying nodes&#10;Crop: 6 readings/day; drying: 24/day while active&#10;TLS MQTT, per-node X.509 identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="255" width="255" height="150" as="geometry" />
        </mxCell>
        <mxCell id="farmbuf" value="Encrypted, non-volatile buffer&#10;Store-and-forward, maximum 24 h&#10;Live first, then oldest; PUBACK releases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="365" y="255" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="farmnet" value="Cellular or satellite bearer&#10;Public internet to regional endpoint&#10;Farm traffic bypasses centers and VPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="210" y="500" width="315" height="140" as="geometry" />
        </mxCell>
        <mxCell id="farmoffline" value="NO SIGNAL: retain readings locally; drain after reconnect. Alert target: &lt;5 min with route; after outage, emit on drain within 24 h." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#b27824;strokeWidth=2;fontColor=#5a3b08;fontSize=19;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="660" width="600" height="75" as="geometry" />
