        <mxCell id="endpoints" value="Private center path: network-account hub -&gt; transit -&gt; interface endpoints in drone_object_ingress and object_storage -&gt; S3. Farm path uses the public IoT endpoint; telemetry_ingress is reserved for private endpoints." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fb;strokeColor=#61788d;strokeWidth=1.5;fontColor=#172b4d;fontSize=18;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="950" y="1535" width="890" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fwpol" value="Cloud firewall: managed security groups, prefix lists, network ACLs, endpoint policies and transit routes; no appliance. Permanent refs: CL-LNK-01/02/03/04/06/07, CC-TEL-01, CL-APP-01, CL-DRN-01/02/03, CL-PUB-01 and CL-DEF-01." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#b27824;strokeWidth=1.5;fontColor=#5a3b08;fontSize=18;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1870" y="1535" width="930" height="120" as="geometry" />
        </mxCell>
        <mxCell id="centerpath" value="Drone inference path: persisted mission record -&gt; EventBridge Pipe + bus -&gt; one SQS queue per function -&gt; Lambda -&gt; Amazon Bedrock in us-east-1. Retries and DLQs are defined in A17 (PD-111 closed)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8da2b5;strokeWidth=1.5;fontColor=#172b4d;fontSize=18;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="950" y="1680" width="890" height="110" as="geometry" />
        </mxCell>
        <mxCell id="encryption" value="TLS 1.2+ in transit; encrypted device buffers; KMS encryption at rest. Five-year retention for telemetry, drone objects, flight records and sack history. Objects containing a person are excluded from inference (PD-015 closed). Inference results record timestamp, confidence and source-object ID; no trigger authorizes fumigation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8da2b5;strokeWidth=1.5;fontColor=#172b4d;fontSize=18;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1870" y="1680" width="930" height="110" as="geometry" />
        </mxCell>
