        </mxCell>
        <mxCell id="cstaff" value="Gerencia 10.41.1.0/24&#10;Support 10.41.2.0/24 (VLAN 102)&#10;Logistics 10.41.3.0/24&#10;Transport 10.41.4.0/24&#10;Visitors 10.41.5.0/24&#10;Servers 10.41.10.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#a7b8c7;fontColor=#172b4d;fontSize=18;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
