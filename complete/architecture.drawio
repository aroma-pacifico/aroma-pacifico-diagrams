        <mxCell id="center_note" value="Farm telemetry and transporter positions do not cross the center VPN. Drone ground station uses Support VLAN 102; center upload stays private." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fb;strokeColor=#61788d;strokeWidth=1.5;fontColor=#172b4d;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
