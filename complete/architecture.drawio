        </mxCell>
        <mxCell id="droneoffline" value="NO SIGNAL at plot: mission already loaded; keep record and objects buffered. Fumigation remains open until persistence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#b27824;strokeWidth=2;fontColor=#5a3b08;fontSize=19;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1605" y="455" width="690" height="90" as="geometry" />
        </mxCell>
        <mxCell id="drone_services" value="Area mode: delimit farm polygon; estimate harvest once per harvest.&#10;Precision mode: confirm sensor focus; fumigate only on human authorization; verify same plot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52708a;strokeWidth=2;fontColor=#172b4d;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
