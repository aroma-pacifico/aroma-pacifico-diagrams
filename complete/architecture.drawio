          <mxGeometry x="40" y="155" width="82" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c_D01" value="Infrastructure repository&#10;&#10;Private `aroma-pacifico-infrastructure`; one root per environment/domain, consuming module tags from the public modules repository." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8da2b5;strokeWidth=1.5;fontColor=#172b4d;fontSize=18;align=left;verticalAlign=middle;spacing=11;" vertex="1" parent="1">
