<mxCell id="e_cf_to_buyerview" value="Queries buyer_view Projection Only (CMK public_view)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c4fff;strokeWidth=2;fontSize=11;fontColor=#5b21b6;align=center; exitX="1" exitY="0.5"; entryX="0" entryY="0.5";" edge="1" parent="1" source="c_entry_points" target="c_buyer_view">
