<mxfile host="Electron" modified="2026-11-10T00:00:00.000Z" agent="Mozilla/5.0 AromaPacifico" version="21.6.8" type="device">
  <diagram id="identity-and-access-arch" name="Identity and Access Architecture">
    <mxGraphModel dx="3200" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c_2" value="Aroma Pacífico — Identity &amp; Access Architecture: Directories, Roles, Entry Points, and KMS CMK Protection" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="60" y="25" width="2600" height="32" as="geometry" /></mxCell><mxCell id="c_3" value="Source: docs/security-and-identity.md (A09), docs/landing-zone.md (A08 §4), docs/decision-log.md (ASM-090..ASM-099). Plan-only academic delivery." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#475569;" parent="1" vertex="1"><mxGeometry x="60" y="60" width="2600" height="20" as="geometry" /></mxCell><mxCell id="c_4" value="1. KINDS OF IDENTITY (ACTORS)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=36;collapsible=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=4;fontSize=14;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="60" y="95" width="380" height="1680" as="geometry" /></mxCell><mxCell id="c_5" value="2. DIRECTORIES &amp; REGISTRIES" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=36;collapsible=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=4;fontSize=14;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="480" y="95" width="440" height="1680" as="geometry" /></mxCell><mxCell id="c_6" value="3. ENTRY POINTS &amp; FRONT DOORS" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=36;collapsible=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=4;fontSize=14;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="960" y="95" width="440" height="1680" as="geometry" /></mxCell><mxCell id="c_7" value="4. PROCESSING &amp; ROLES" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=36;collapsible=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=4;fontSize=14;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1440" y="95" width="440" height="1680" as="geometry" /></mxCell><mxCell id="c_8" value="5. PROTECTED STORES &amp; KMS CMK ENCRYPTION AT REST" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=36;collapsible=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;arcSize=4;fontSize=14;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1920" y="95" width="1200" height="1680" as="geometry" /></mxCell><mxCell id="c_9" value="Workforce Users (Human)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="80" y="150" width="340" height="200" as="geometry" /></mxCell><mxCell id="c_10" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" parent="1" vertex="1"><mxGeometry x="360" y="156" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_11" value="• Platform operators, security admins, auditors
• BreakGlass emergency access (ASM-099)
• Authenticate via federated enterprise IdP
• Mandatory hardware/TOTP MFA for AWS access
• Zero permanent AWS credentials or IAM users" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="84" y="182" width="330" height="160" as="geometry" /></mxCell><mxCell id="c_12" value="Staff App Users (Human)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="80" y="370" width="340" height="220" as="geometry" /></mxCell><mxCell id="c_13" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" parent="1" vertex="1"><mxGeometry x="360" y="376" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_14" value="• Collection-center operators, drone pilots, agronomists
• Separate duties: agronomist authorizes, pilot flies
• Username + password + mandatory TOTP MFA
• Token lifetimes: Access/ID 30 min, Refresh 12 h
• Step-up MFA (auth_time &lt;= 10 min) for sensitive ops
  (fumigation auth, thresholds, revocation - ASM-092)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="84" y="402" width="330" height="180" as="geometry" /></mxCell><mxCell id="c_15" value="Field App Users (Human)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="80" y="610" width="340" height="210" as="geometry" /></mxCell><mxCell id="c_16" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" parent="1" vertex="1"><mxGeometry x="360" y="616" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_17" value="• Coffee farmers and transporters
• Passwordless: one-time SMS code to registered phone
• No MFA: justified by connectivity &amp; simplicity (ASM-091)
• Compensating controls: device keystore, phone lock
• Token lifetimes: Access/ID 60 min, Refresh 30 days
• Dynamic profile scope evaluated on server (0 min)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="84" y="642" width="330" height="170" as="geometry" /></mxCell><mxCell id="c_18" value="Public &amp; Registered Buyers" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="80" y="840" width="340" height="210" as="geometry" /></mxCell><mxCell id="c_19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" parent="1" vertex="1"><mxGeometry x="360" y="846" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_20" value="• Public Buyer: Anonymous web lookup via sack code QR
  (Crockford Base32 80-bit code, no sign-in, ASM-058)
• Registered Buyer: Web report viewer (read-only)
• Passwordless email OTP, no MFA, Refresh: 1 day
• Strict data boundary: buyer view only (origin, dates,
  status, drying vars); no cédula, no trace (ASM-094)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="84" y="872" width="330" height="170" as="geometry" /></mxCell><mxCell id="c_21" value="Edge &amp; Field Devices (Machine)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="80" y="1070" width="340" height="230" as="geometry" /></mxCell><mxCell id="c_22" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" parent="1" vertex="1"><mxGeometry x="360" y="1076" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_23" value="• Farm sensor nodes (temperature, humidity, solar)
• Drone kits: drone + paired ground station (ASM-093)
• X.509 certificate registered from CSR, key in hardware
• Offline buffer encrypted at rest (AES-256)
• TLS 1.2+ mutual authentication (mTLS) to IoT Core
• Immediate revocation by certificate status (0 min)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="84" y="1102" width="330" height="190" as="geometry" /></mxCell><mxCell id="c_24" value="CI/CD Pipelines (Workflows)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="80" y="1320" width="340" height="210" as="geometry" /></mxCell><mxCell id="c_25" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" parent="1" vertex="1"><mxGeometry x="360" y="1326" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_26" value="• GitHub Actions automated workflows (aroma-pacifico)
• Short-lived OIDC federated web identity token
• Zero static AWS access keys or secrets in repo
• Scoped to specific repo, branch, and environment
• Dedicated Plan and Apply roles per account (ADR-003)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="84" y="1352" width="330" height="170" as="geometry" /></mxCell><mxCell id="c_27" value="AWS IAM Identity Center (D08)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="500" y="150" width="400" height="200" as="geometry" /></mxCell><mxCell id="c_28" value="D08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="780" y="154" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_29" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" parent="1" vertex="1"><mxGeometry x="830" y="156" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_30" value="• Centralized directory in Management Account (A08 §4)
• SAML 2.0 / IdP federation for workforce users
• Permission sets: PlatformOperator, Auditor, BreakGlass
• Enforces MFA on all operator sign-ins
• Issues short-lived AWS STS credentials (1 to 8 hours)
• Governed by Service Control Policies (SCPs)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="504" y="182" width="390" height="160" as="geometry" /></mxCell><mxCell id="c_31" value="Cognito User Pool: staff (D06)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="500" y="370" width="400" height="220" as="geometry" /></mxCell><mxCell id="c_32" value="D06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="780" y="374" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_33" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" parent="1" vertex="1"><mxGeometry x="830" y="376" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_34" value="• Workload account, us-east-1, Essentials plan (ASM-090)
• Mandatory MFA (TOTP) enforced for all pool users
• Tokens: Access/ID 30 minutes, Refresh 12 hours
• Step-up auth: auth_time &lt;= 10 min for sensitive actions
• Groups: collection_operators, drone_operators, agronomists
• Separation of duties: one role per identity (ASM-099)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="504" y="402" width="390" height="180" as="geometry" /></mxCell><mxCell id="c_35" value="Cognito User Pool: field (D06)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="500" y="610" width="400" height="210" as="geometry" /></mxCell><mxCell id="c_36" value="D06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="780" y="614" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_37" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" parent="1" vertex="1"><mxGeometry x="830" y="616" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_38" value="• Workload account, us-east-1, Essentials plan (ASM-090)
• Passwordless sign-in: SMS OTP (farmers/transporters)
• Email OTP for registered buyers; MFA disabled (ASM-091)
• Tokens: Access/ID 60 min, Refresh 30 days (Buyer: 1 day)
• Dynamic database scopes: farm_id / vehicle_id (0 min)
• Tokens verified by API Gateway JWT authorizer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="504" y="642" width="390" height="170" as="geometry" /></mxCell><mxCell id="c_39" value="AWS IoT Core Registry (D02)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="500" y="1070" width="400" height="230" as="geometry" /></mxCell><mxCell id="c_40" value="D02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="780" y="1074" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_41" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" parent="1" vertex="1"><mxGeometry x="830" y="1076" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_42" value="• Central device registry for farm nodes &amp; drone kits
• Device X.509 certificates generated from client CSR
• Mutual TLS authentication (TLS 1.2+ security policy)
• Thing policy variables: ${iot:Connection.Thing.ThingName}
• Kit topic grants: kit/{kit_id}/grants for drone uploads
• Instant revocation: UpdateCertificate REVOKED (0 min)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="504" y="1102" width="390" height="190" as="geometry" /></mxCell><mxCell id="c_43" value="GitHub OIDC Identity Provider" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="500" y="1320" width="400" height="210" as="geometry" /></mxCell><mxCell id="c_44" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" parent="1" vertex="1"><mxGeometry x="830" y="1326" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_45" value="• Configured in IAM for token.actions.githubusercontent.com
• Trust policy verifies aud (sts.amazonaws.com) and sub
• Bound to aroma-pacifico/* organization repositories
• Branch &amp; environment claims guard Plan vs Apply roles
• Ephemeral STS credentials (max duration 1 hour)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="504" y="1352" width="390" height="170" as="geometry" /></mxCell><mxCell id="c_46" value="AWS Console &amp; CLI / SSO Portal" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="980" y="150" width="400" height="200" as="geometry" /></mxCell><mxCell id="c_47" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" parent="1" vertex="1"><mxGeometry x="1310" y="156" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_48" value="• Entry portal for workforce administrators &amp; auditors
• Enforces Identity Center sign-in &amp; session policies
• Issues temporary STS credentials for Console and AWS CLI
• Account isolation: Security, Network, Mgmt, Workload
• Governed by root and organizational SCPs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="984" y="182" width="390" height="160" as="geometry" /></mxCell><mxCell id="c_49" value="Amazon API Gateway (D04)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="980" y="450" width="400" height="240" as="geometry" /></mxCell><mxCell id="c_50" value="D04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1260" y="454" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_51" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" parent="1" vertex="1"><mxGeometry x="1310" y="456" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_52" value="• Application REST API front door for staff &amp; field apps
• Custom domain with minimum TLS 1.2 security policy
• Cognito JWT Authorizer: verifies staff &amp; field tokens
• Validates signature, issuer, exp, and token user pool
• Rejects expired or untrusted tokens at API perimeter
• Routes authorized requests to backend Lambda functions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="984" y="482" width="390" height="200" as="geometry" /></mxCell><mxCell id="c_53" value="CloudFront + AWS WAF (D09)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="980" y="840" width="400" height="210" as="geometry" /></mxCell><mxCell id="c_54" value="D09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1260" y="844" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_55" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" parent="1" vertex="1"><mxGeometry x="1310" y="846" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_56" value="• Public lookup front door (TLSv1.2_2021, ASM-155)
• AWS WAF rate limit: &lt;= 100 req/5 min per IP on /s/*
• Default action: Block (CL-PUB-01), managed rule sets
• Strict security headers: Cache-Control: no-store,
  X-Robots-Tag: noindex, Referrer-Policy: no-referrer
• Uniform &#x27;not found&#x27; response prevents code enumeration" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="984" y="872" width="390" height="170" as="geometry" /></mxCell><mxCell id="c_57" value="IoT Core Data Endpoint (D02)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="980" y="1070" width="400" height="230" as="geometry" /></mxCell><mxCell id="c_58" value="D02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1260" y="1074" width="40" height="22" as="geometry" /></mxCell><mxCell id="c_59" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" parent="1" vertex="1"><mxGeometry x="1310" y="1076" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_60" value="• Ingestion endpoint: MQTT over TLS on TCP port 8883
• Mutual TLS (mTLS) with device X.509 certificate
• TLS security policy: IoTSecurityPolicy_TLS13_1_2_2022_10
• Per-thing authorization: publish to telemetry/{id} only
• Collection center ground stations reach via Soporte LAN
• Zero general internet egress for center sensors" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="984" y="1102" width="390" height="190" as="geometry" /></mxCell><mxCell id="c_61" value="AWS STS OIDC Endpoint" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="980" y="1320" width="400" height="210" as="geometry" /></mxCell><mxCell id="c_62" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" parent="1" vertex="1"><mxGeometry x="1310" y="1326" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_63" value="• sts:AssumeRoleWithWebIdentity regional endpoint
• Exchanges GitHub Actions JWT for temporary AWS STS keys
• Role session tags enforce environment boundary
• Short-lived credentials (max duration 1 hour)
• Complete audit trail logged in CloudTrail (A08 §7)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="984" y="1352" width="390" height="170" as="geometry" /></mxCell><mxCell id="c_64" value="Workforce Execution Roles" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1460" y="150" width="400" height="200" as="geometry" /></mxCell><mxCell id="c_65" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" parent="1" vertex="1"><mxGeometry x="1790" y="156" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_66" value="• PlatformOperator: operational administration &amp; thresholds
• Auditor: read-only access to audit trail &amp; evidence (A08)
• BreakGlass: emergency access role, highly monitored
• Permission boundaries prevent privilege escalation
• Denied kms:ScheduleKeyDeletion on all CMKs (ASM-097)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="1464" y="182" width="390" height="160" as="geometry" /></mxCell><mxCell id="c_67" value="Workload API Lambda Functions" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1460" y="450" width="400" height="240" as="geometry" /></mxCell><mxCell id="c_68" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="1" vertex="1"><mxGeometry x="1790" y="456" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_69" value="• Business logic execution roles (least privilege)
• Enforces dynamic profile scopes in database (0 min)
• Enforces separation of duties (ASM-099, ADR-002):
  - Agronomist authorizes fumigation (human only)
  - Drone pilot executes mission; pilot cannot authorize
• Generates 15-minute pre-signed S3 upload URLs for drone
• Accesses DynamoDB records and S3 objects" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="1464" y="482" width="390" height="200" as="geometry" /></mxCell><mxCell id="c_70" value="Public Sack Lookup Lambda" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1460" y="840" width="400" height="210" as="geometry" /></mxCell><mxCell id="c_71" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="1" vertex="1"><mxGeometry x="1790" y="846" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_72" value="• Public lookup execution role (ASM-154, ASM-155)
• Reserved concurrency: 10 (caps load &amp; compute costs)
• Validates Crockford Base32 80-bit code &amp; check symbol
• IAM permissions ONLY on buyer_view projection table
• STRICT ISOLATION: No IAM grants on records, personal,
  or telemetry tables; cannot decrypt internal data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="1464" y="872" width="390" height="170" as="geometry" /></mxCell><mxCell id="c_73" value="IoT Rules Engine &amp; Grant Service" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1460" y="1070" width="400" height="230" as="geometry" /></mxCell><mxCell id="c_74" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" parent="1" vertex="1"><mxGeometry x="1790" y="1076" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_75" value="• Rules engine role for MQTT topic evaluation &amp; routing
• Ingests telemetry into DynamoDB telemetry table
• Routes transporter GPS positions into position store
• Evaluates drone upload grants; issues 15-min pre-signed
  URLs published to kit/{kit_id}/grants topic (ASM-093)
• CloudWatch Logs AWSIotLogsV2 for security audit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="1464" y="1102" width="390" height="190" as="geometry" /></mxCell><mxCell id="c_76" value="CI/CD Deployment Roles" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;startSize=28;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;rounded=1;arcSize=6;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1460" y="1320" width="400" height="210" as="geometry" /></mxCell><mxCell id="c_77" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" parent="1" vertex="1"><mxGeometry x="1790" y="1326" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_78" value="• Terraform Plan and Apply roles per environment (ADR-003)
• Plan role: read-only access to state and infra
• Apply role: scoped permissions to deploy modules (B01-B13)
• Bound to Terraform state bucket with state KMS key
• Workload separation: Dev, QA, and Production isolated" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#334155;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" parent="1" vertex="1"><mxGeometry x="1464" y="1352" width="390" height="170" as="geometry" /></mxCell><mxCell id="c_79" value="Workload Account Stores &amp; KMS CMKs (365-day rotation, ASM-097)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;rounded=1;arcSize=4;fontColor=#0F172A;startSize=30;" parent="1" vertex="1"><mxGeometry x="1940" y="135" width="1160" height="1250" as="geometry" /></mxCell><mxCell id="c_80" value="&lt;b&gt;DynamoDB: Telemetry Table &amp; Position Store&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#166534&#x27; size=&#x27;-1&#x27;&gt;Crop readings (temp, humidity, solar) and transporter GPS positions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=55;verticalAlign=middle;fontSize=12;fontColor=#14532D;" parent="1" vertex="1"><mxGeometry x="1960" y="185" width="540" height="85" as="geometry" /></mxCell><mxCell id="c_81" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" parent="1" vertex="1"><mxGeometry x="1970" y="209" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_82" value="&lt;b&gt;KMS CMK: telemetry&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#881337&#x27; size=&#x27;-1&#x27;&gt;Customer-managed key encrypting sensor &amp; GPS position data&lt;br/&gt;Automatic 365-day rotation enabled (ASM-097)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;align=left;spacingLeft=55;verticalAlign=middle;fontSize=12;fontColor=#881337;" parent="1" vertex="1"><mxGeometry x="2560" y="185" width="510" height="85" as="geometry" /></mxCell><mxCell id="c_83" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" parent="1" vertex="1"><mxGeometry x="2570" y="209" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_84" value="SSE-KMS encrypts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;strokeWidth=1.5;fontSize=11;fontColor=#1E293B;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_82" target="c_80"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_85" value="&lt;b&gt;DynamoDB: Transactional Tables&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#166534&#x27; size=&#x27;-1&#x27;&gt;Sacks, custody events, trips, orders, grants, device registry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=55;verticalAlign=middle;fontSize=12;fontColor=#14532D;" parent="1" vertex="1"><mxGeometry x="1960" y="325" width="540" height="85" as="geometry" /></mxCell><mxCell id="c_86" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" parent="1" vertex="1"><mxGeometry x="1970" y="349" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_87" value="&lt;b&gt;KMS CMK: records&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#881337&#x27; size=&#x27;-1&#x27;&gt;Customer-managed key encrypting core transaction records&lt;br/&gt;Automatic 365-day rotation enabled (ASM-097)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;align=left;spacingLeft=55;verticalAlign=middle;fontSize=12;fontColor=#881337;" parent="1" vertex="1"><mxGeometry x="2560" y="325" width="510" height="85" as="geometry" /></mxCell><mxCell id="c_88" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#BD0816;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" parent="1" vertex="1"><mxGeometry x="2570" y="349" width="36" height="36" as="geometry" /></mxCell><mxCell id="c_89" value="SSE-KMS encrypts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;strokeWidth=1.5;fontSize=11;fontColor=#1E293B;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_87" target="c_85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_90" value="&lt;b&gt;DynamoDB: Personal Data Table&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#166534&#x27; size=&#x27;-1&#x27;&gt;Cédula, phone, plate linked by subject_id; 5-year retention clock (ASM-098)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=55;verticalAlign=middle;fontSize=12;fontColor=#14532D;" parent="1" vertex="1"><mxGeometry x="1960" y="465" width="540" height="85" as="geometry" /></mxCell><mxCell id="c_91" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" parent="1" vertex="1"><mxGeometry x="1970" y="489" width="36" height="36" as="