    <mxCell id="legend_bg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1940" height="150" as="geometry" /></mxCell>
    <mxCell id="legend_title" value="Legend &amp; Invariants" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="1121" width="1912" height="22" as="geometry" /></mxCell>
    <mxCell id="legend_text" value="1. Staff pool requires MFA; authorize, threshold change and revocation need a sign-in under 10 min old.&lt;br/&gt;2. Field pool has no MFA by design: phone-bound app, encrypted outbox, own farms or trips only.&lt;br/&gt;3. Public lookup returns origin, processing dates, status and drying variables only.&lt;br/&gt;4. One KMS key per data class; no function or person holds the restricted key.&lt;br/&gt;5. No IAM users or static keys: people use Identity Center, CI uses OIDC, devices use X.509.&lt;br/&gt;6. Colors group paths by identity kind; every arrow is an allowed path." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="44" y="1143" width="1912" height="118" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
