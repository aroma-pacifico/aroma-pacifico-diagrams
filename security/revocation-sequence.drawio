  </mxGeometry>
</mxCell>
<mxCell id="m302" value="1.2: Operator authenticates with fresh TOTP (auth_time &lt;= 10m); executes Revoke on Operations Screen (Fallback: DeviceRevocation role | §5.3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
