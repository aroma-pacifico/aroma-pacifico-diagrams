  </mxGeometry>
</mxCell>
<mxCell id="m324" value="3.6: IMMEDIATE EFFECT: Any incoming API request carrying revoked device_id is rejected; outbox events on lost phone never enter platform" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991b1b;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
