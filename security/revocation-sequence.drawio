<mxPoint x="680" y="1615" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m303" value="1.3: UpdateCertificate(certificateId, newStatus=REVOKED) -&gt; Immediate mTLS handshake failure (0 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1645" as="sourcePoint" /><mxPoint x="1260" y="1645" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m304" value="1.4: DetachThingPrincipal(thingName, principal) &amp; DetachPolicy -&gt; Device identity disassociated (0 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1675" as="sourcePoint" /><mxPoint x="1260" y="1675" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m305" value="1.5: IoT Core terminates active MQTT connection immediately: device drops off broker (minutes | PD-100)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;strokeWidth=1.5;fontSize=11.5;fontColor=#9F1239;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="1705" as="sourcePoint" /><mxPoint x="1260" y="1705" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m306" value="1.6: UpdateItem in device_registry table: status=REVOKED, revoked_at=now, reason=&#x27;loss_report&#x27; (CMK records)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1735" as="sourcePoint" /><mxPoint x="3060" y="1735" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m307" value="1.7: Expire active upload grants: invalidate all pre-signed S3 URLs (max lifetime 15 min | ASM-093)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11.5;fontColor=#92400E;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1765" as="sourcePoint" /><mxPoint x="3060" y="1765" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m308" value="1.8: CloudTrail logs all 4 IoT management API calls to central audit archive in Security Account (CMK audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1795" as="sourcePoint" /><mxPoint x="3500" y="1795" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hdr_3b" value="PART 3B: DEPARTING OR COMPROMISED STAFF USER (Target: 4 hours SLA | Invalidation: immediate, ASM-098)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1;fontColor=#78350F;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="80" y="1850" width="3640" height="28" as="geometry" /></mxCell><mxCell id="m309" value="2.1: Contract company reports drone pilot left contract (or Federation reports departed agronomist/operator)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11.5;fontColor=#92400E;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="1895" as="sourcePoint" /><mxPoint x="680" y="1895" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m310" value="2.2: AdminDisableUser(staff_pool, username) -&gt; User cannot initiate new sign-in or refresh token flows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1925" as="sourcePoint" /><mxPoint x="1860" y="1925" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m311" value="2.3: AdminUserGlobalSignOut(staff_pool, username) -&gt; Revokes all outstanding refresh tokens immediately" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1955" as="sourcePoint" /><mxPoint x="1860" y="1955" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m312" value="2.4: Write revocation timestamp in database: revoked_after = current_timestamp (CMK records)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1985" as="sourcePoint" /><mxPoint x="3060" y="1985" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m313" value="2.5: Subsequent API calls with existing access token (valid up to 30m): Lambda checks token iat &lt; revoked_after" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11.5;fontColor=#5B21B6;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2460" y="2015" as="sourcePoint" /><mxPoint x="3060" y="2015" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m314" value="2.6: revoked_after check fails -&gt; Returns 401 Unauthorized immediately (Zero waiting for 30m token expiry)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3060" y="2045" as="sourcePoint" /><mxPoint x="2460" y="2045" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m315" value="2.7: Write audit event to CloudWatch Logs (CMK logs) &amp; deliver to Audit Archive (CMK audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2075" as="sourcePoint" /><mxPoint x="3500" y="2075" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hdr_3c" value="PART 3C: LOST PHONE FOR FIELD USER (FARMER / TRANSPORTER, ASM-098)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1;fontColor=#14532D;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="80" y="2130" width="3640" height="28" as="geometry" /></mxCell><mxCell id="m316" value="3.1: Farmer or transporter reports lost phone to Collection Center or Federation liaison" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="2175" as="sourcePoint" /><mxPoint x="680" y="2175" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m317" value="3.2: AdminUserGlobalSignOut(field_pool, username) -&gt; Invalidates all active refresh tokens (30-day token cut)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2205" as="sourcePoint" /><mxPoint x="1860" y="2205" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m318" value="3.3: Invalidate registered device_id: record device_id in revocation denylist (CMK records)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2235" as="sourcePoint" /><mxPoint x="3060" y="2235" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m319" value="3.4: Stolen phone tries to flush outbox: API authorizer verifies device_id against denylist -&gt; Rejection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11.5;fontColor=#5B21B6;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2460" y="2265" as="sourcePoint" /><mxPoint x="3060" y="2265" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m320" value="3.5: Returns 403 Forbidden: device revoked. Compensating control: phone screen lock blocks keystore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3060" y="2295" as="sourcePoint" /><mxPoint x="2460" y="2295" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m321" value="3.6: In-Person Re-Enrollment: User presents in person at Collection Center; identity verified against cédula" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="2330" as="sourcePoint" /><mxPoint x="680" y="2330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m322" value="3.7: Operator updates phone_number in field_pool and registers new device_id in database" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2365" as="sourcePoint" /><mxPoint x="1860" y="2365" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m323" value="3.8: Complete lifecycle audited: loss report, token invalidation, device denylist, and re-enrollment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2400" as="sourcePoint" /><mxPoint x="3500" y="2400" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_3" value="ENFORCED REVOCATION TIME LIMITS SUMMARY (Section 10, ASM-098, PD-100):
• Incident reporting duty: Lost device or user departure reported within 2 hours of awareness
• Cloud revocation SLA: Completed within 4 hours target from report (ASM-098)
• IoT broker disconnection: MQTT connection terminated in minutes via UpdateCertificate REVOKED (PD-100)
• S3 Pre-signed URL expiry: Active drone upload grants expire within 15 minutes max (ASM-093)
• Token invalidation: GlobalSignOut terminates refresh tokens immediately; revoked_after check cuts access tokens
• Outbox key protection: Phone keystore key inaccessible without physical screen lock / biometric PIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=11;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="120" y="2480" width="3560" height="105" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>