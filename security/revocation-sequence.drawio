  </mxGeometry>
</mxCell>
<mxCell id="m323" value="3.5: Step 3: cognito-idp:AdminDisableUser(Username=sub) [Prevents attacker who stole SIM from receiving SMS OTP code]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
