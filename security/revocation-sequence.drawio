yle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="445" as="sourcePoint" /><mxPoint x="800" y="445" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_1a" value="STAFF POOL TOKEN LIFETIMES (ASM-092):
