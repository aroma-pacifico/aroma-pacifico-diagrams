16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1235" as="sourcePoint" /><mxPoint x="1720" y="1235" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m131" value="1C.12: Outbox releases events ONLY after server acknowledges commit (Un despliegue)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1265" as="sourcePoint" /><mxPoint x="800" y="1265" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_1c" value="JUSTIFIED ABSENCE OF MFA FOR FIELD (ASM-091):
