(DynamoDB (CMK records))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1640" y="170" width="160" height="50" as="geometry" /></mxCell><mxCell id="ll1_db_line" value="" style="strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="220" as="sourcePoint" /><mxPoint x="1720" y="1270" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hdr_1a" value="PART 1A: STAFF SIGN-IN WITH MANDATORY TOTP MFA (ASM-090, ASM-092)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#0284C7;strokeWidth=1;fontColor=#1E3A8A;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="80" y="240" width="1780" height="28" as="geometry" /></mxCell><mxCell id="m101" value="1.1: Submit username + password" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="285" as="sourcePoint" /><mxPoint x="800" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m102" value="1.2: InitiateAuth(staff_pool, USER_PASSWORD_AUTH)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="310" as="sourcePoint" /><mxPoint x="1140" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m103" value="1.3: ChallengeName: SOFTWARE_TOKEN_MFA (session token)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#475569;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="335" as="sourcePoint" /><mxPoint x="800" y="335" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m104" value="1.4: Prompt for 6-digit TOTP code from authenticator app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#475569;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="360" as="sourcePoint" /><mxPoint x="480" y="360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m105" value="1.5: User submits 6-digit TOTP code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="385" as="sourcePoint" /><mxPoint x="800" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m106" value="1.6: RespondToAuthChallenge(SOFTWARE_TOKEN_MFA, TotpCode)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="410" as="sourcePoint" /><mxPoint x="1140" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m107" value="1.7: Issues JWT (Access: 30m, ID: 30m, Refresh: 12h | auth_time=now)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="440" as="sourcePoint" /><mxPoint x="800" y="440" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_1a" value="STAFF POOL TOKEN LIFETIMES (ASM-092):
• Access Token: 30 minutes
• ID Token: 30 minutes
• Refresh Token: 12 hours
• Claims: sub, email, cognito:groups, auth_time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1240" y="340" width="310" height="85" as="geometry" /></mxCell><mxCell id="hdr_1b" value="PART 1B: SENSITIVE STAFF OPERATION STEP-UP AUTH (auth_time &lt;= 10 min, ASM-092, ADR-002)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1;fontColor=#78350F;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="80" y="490" width="1780" height="28" as="geometry" /></mxCell><mxCell id="m108" value="2.1: Request sensitive action (e.g. Authorize Fumigation Order ADR-002)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11.5;fontColor=#92400E;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="530" as="sourcePoint" /><mxPoint x="800" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m109" value="2.2: Check JWT auth_time: If (now - auth_time) &gt; 10 min -&gt; Require Step-Up" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11.5;fontColor=#92400E;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="555" as="sourcePoint" /><mxPoint x="800" y="555" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m110" value="2.3: Prompt user for fresh TOTP verification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#475569;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="580" as="sourcePoint" /><mxPoint x="480" y="580" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m111" value="2.4: Enter fresh TOTP code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11.5;fontColor=#92400E;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="605" as="sourcePoint" /><mxPoint x="800" y="605" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m112" value="2.5: Re-authenticate to obtain fresh JWT with auth_time &lt;= 10m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11.5;fontColor=#92400E;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="630" as="sourcePoint" /><mxPoint x="1140" y="630" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m113" value="2.6: Issues new JWT (auth_time = current timestamp)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="655" as="sourcePoint" /><mxPoint x="800" y="655" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m114" value="2.7: POST /orders/{id}/authorize (Bearer JWT with fresh auth_time)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="685" as="sourcePoint" /><mxPoint x="1460" y="685" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m115" value="2.8: API checks: auth_time &lt;= 10m &amp; Separation of Duties (caller != drone pilot)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11.5;fontColor=#5B21B6;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="715" as="sourcePoint" /><mxPoint x="1460" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m116" value="2.9: Conditional PutItem: state=authorized, authorizer=sub (CMK records)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="745" as="sourcePoint" /><mxPoint x="1720" y="745" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m117" value="2.10: Commit confirmed (encrypted at rest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="775" as="sourcePoint" /><mxPoint x="1460" y="775" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m118" value="2.11: 200 OK: Fumigation authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="805" as="sourcePoint" /><mxPoint x="800" y="805" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m119" value="2.12: Displays authorization confirmation and flight readiness" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="830" as="sourcePoint" /><mxPoint x="480" y="830" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_1b" value="SEPARATION OF DUTIES (§4.3, ADR-002):
• Agronomist authorizes fumigation
• Drone pilot executes flight mission
• System denies authorization if caller_id == pilot_id
• No automated trigger authorizes fumigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1540" y="780" width="310" height="85" as="geometry" /></mxCell><mxCell id="hdr_1c" value="PART 1C: FIELD USER PASSWORDLESS SIGN-IN (NO MFA JUSTIFIED, ASM-091, ASM-092)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1;fontColor=#14532D;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="80" y="880" width="1780" height="28" as="geometry" /></mxCell><mxCell id="m120" value="3.1: Open app; unlock via phone screen lock PIN / biometrics (ASM-095)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="925" as="sourcePoint" /><mxPoint x="800" y="925" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m121" value="3.2: Unlock app outbox key in phone hardware keystore (KeyStore / Keychain)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11.5;fontColor=#334155;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="950" as="sourcePoint" /><mxPoint x="800" y="950" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m122" value="3.3: Enter registered phone number" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="980" as="sourcePoint" /><mxPoint x="800" y="980" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m123" value="3.4: InitiateAuth(field_pool, CUSTOM_AUTH: SMS OTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1010" as="sourcePoint" /><mxPoint x="1140" y="1010" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m124" value="3.5: Send 6-digit one-time code via SMS (or email for registered buyers)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#92400E;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1040" as="sourcePoint" /><mxPoint x="200" y="1040" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m125" value="3.6: User inputs SMS one-time code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1070" as="sourcePoint" /><mxPoint x="800" y="1070" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m126" value="3.7: RespondToAuthChallenge(CUSTOM_CHALLENGE, Answer=OTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1100" as="sourcePoint" /><mxPoint x="1140" y="1100" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m127" value="3.8: Validates OTP -&gt; Issues JWT (Access: 60m, ID: 60m, Refresh: 30 days | ASM-092)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1130" as="sourcePoint" /><mxPoint x="800" y="1130" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m128" value="3.9: Offline work: telemetry &amp; event outbox buffered encrypted at rest (ASM-074)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11.5;fontColor=#334155;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1160" as="sourcePoint" /><mxPoint x="800" y="1160" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m129" value="3.10: Reconnection: Flushes queued outbox events to API Gateway with device_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11.5;fontColor=#0369A1;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1190" as="sourcePoint" /><mxPoint x="1460" y="1190" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m130" value="3.11: API checks caller owns farm/trip; conditional put in sack_event_log -&gt; 200 OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1220" as="sourcePoint" /><mxPoint x="1720" y="1220" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m131" value="3.12: Outbox releases events ONLY after server acknowledges commit (Un despliegue)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1250" as="sourcePoint" /><mxPoint x="800" y="1250" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_1c" value="JUSTIFIED ABSENCE OF MFA FOR FIELD (ASM-091):
• Farmers &amp; transporters have intermittent connectivity
• Compensating controls: phone screen lock, device keystore encryption,
  server-side scope enforcement (farm_id, vehicle_id), 30-day session
• Token lifetimes: Access/ID 60 min, Refresh 30 days (Buyer: 1 day)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#14532D;fontSize=11;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="120" y="1285" width="800" height="68" as="geometry" /></mxCell><mxCell id="scen2_boundary" value="2. ANONYMOUS PUBLIC SACK LOOKUP &amp; BUYER VIEW PROJECTION (Section 8, ASM-058, ASM-094, ASM-154)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;startSize=36;rounded=1;arcSize=4;" parent="1" vertex="1"><mxGeometry x="1920" y="110" width="1820" height="1260" as="geometry" /></mxCell><mxCell id="ll2_buyer_box" value="Public Buyer
