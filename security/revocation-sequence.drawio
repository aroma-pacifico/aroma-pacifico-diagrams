  </mxGeometry>
</mxCell>
<mxCell id="m308" value="1.8: Any incoming MQTT publish denied by detached policy; node buffer cannot drain and readings expire locally after 24h (ASM-074)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontSize=11.5;fontColor=#334155;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
