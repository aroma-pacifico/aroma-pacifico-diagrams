  </mxGeometry>
</mxCell>
<mxCell id="m322" value="3.4: Step 2: Application marks installation device_id as REVOKED in database [Blocks any pending outbox uploads]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
