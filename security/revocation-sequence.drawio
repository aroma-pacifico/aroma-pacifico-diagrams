<mxCell id="m303" value="1.3: Step 1: iot:UpdateCertificate(certificateId, newStatus=&#x27;REVOKED&#x27;) [Cert preserved revoked for audit trail]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
