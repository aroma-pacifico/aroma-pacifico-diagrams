    <mxCell id="ph2" value="PHASE 2  |  Farm node decommissioned or drone kit lost" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#7AA116;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#3F6212;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m5" value="5. Certificate REVOKED" style="edgeStyle=none;html=1;strokeColor=#7AA116;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="442" as="sourcePoint" /><mxPoint x="860" y="442" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6" value="6. Detach policy" style="edgeStyle=none;html=1;strokeColor=#7AA116;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="478" as="sourcePoint" /><mxPoint x="860" y="478" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Mark retired / lost" style="edgeStyle=none;html=1;strokeColor=#7AA116;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="514" as="sourcePoint" /><mxPoint x="860" y="514" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m8" value="8. Session dropped" style="edgeStyle=none;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="550" as="sourcePoint" /><mxPoint x="1045" y="550" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m9" value="9. Block kit grants" style="edgeStyle=none;html=1;strokeColor=#C925D1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="586" as="sourcePoint" /><mxPoint x="1230" y="586" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph3" value="PHASE 3  |  Staff member or pilot leaves" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#DD344C;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9F1239;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m10" value="10. Disable + sign out" style="edgeStyle=none;html=1;strokeColor=#DD344C;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="662" as="sourcePoint" /><mxPoint x="490" y="662" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m11" value="11. Remove from group" style="edgeStyle=none;html=1;strokeColor=#DD344C;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="698" as="sourcePoint" /><mxPoint x="490" y="698" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m12" value="12. Set revoked_after" style="edgeStyle=none;html=1;strokeColor=#C925D1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="734" as="sourcePoint" /><mxPoint x="1230" y="734" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m13" value="13. Call, old token" style="edgeStyle=none;html=1;strokeColor=#0284C7;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="770" as="sourcePoint" /><mxPoint x="1415" y="770" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m14" value="14. Check revoked_after" style="edgeStyle=none;html=1;strokeColor=#C925D1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1415" y="806" as="sourcePoint" /><mxPoint x="1230" y="806" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m15" value="15. Refused" style="edgeStyle=none;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1415" y="842" as="sourcePoint" /><mxPoint x="1600" y="842" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph4" value="PHASE 4  |  Farmer or transporter phone lost" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m16" value="16. Sign out + disable" style="edgeStyle=none;html=1;strokeColor=#DD344C;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="918" as="sourcePoint" /><mxPoint x="490" y="918" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m17" value="17. Revoke device_id" style="edgeStyle=none;html=1;strokeColor=#C925D1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="954" as="sourcePoint" /><mxPoint x="1230" y="954" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m18" value="18. Outbox flush" style="edgeStyle=none;html=1;strokeColor=#0284C7;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="990" as="sourcePoint" /><mxPoint x="1415" y="990" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m19" value="19. Refused" style="edgeStyle=none;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1415" y="1026" as="sourcePoint" /><mxPoint x="1600" y="1026" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m20" value="20. Re-enroll in person" style="edgeStyle=none;html=1;strokeColor=#D97706;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="1062" as="sourcePoint" /><mxPoint x="490" y="1062" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="ph5" value="PHASE 5  |  Audit" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#9D174D;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1088" width="1840" height="28" as="geometry" /></mxCell>
    <mxCell id="m21" value="21. Record who, why, incident" style="edgeStyle=none;html=1;strokeColor=#E7157B;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="1138" as="sourcePoint" /><mxPoint x="1785" y="1138" as="targetPoint" /><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="legend_bg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="1840" height="134" as="geometry" /></mxCell>
    <mxCell id="legend_title" value="Legend &amp; Invariants" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1241" width="1812" height="22" as="geometry" /></mxCell>
    <mxCell id="legend_text" value="1. Target: revocation completed within 4 h of the report (a target, not a measurement).&lt;br/&gt;2. IoT Core drops device sessions within minutes; upload URLs already issued expire within 15 min.&lt;br/&gt;3. Fallback path: the same actions through the DeviceRevocation or IdentitySupport permission sets.&lt;br/&gt;4. Users are disabled, never deleted; revoked certificates are kept for the audit trail.&lt;br/&gt;5. Dashed = response or out-of-band step; red dashed = session or request refused." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="54" y="1263" width="1812" height="102" as="geometry" /></mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
