</mxCell>
<mxCell id="m306" value="1.6: Step 4: iot:UpdateThing(thingName, attributes={status: &#x27;decommissioned&#x27;|&#x27;lost&#x27;}) [Silent-node alarm ignores decommissioned node]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
