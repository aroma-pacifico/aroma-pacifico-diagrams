  </mxGeometry>
</mxCell>
<mxCell id="box_c3a_callout" value="TIME LIMITS &amp; RECOVERY (Scenario 3A):&#10;• SLA Target: Revocation completed within 4 hours of report (ASM-098).&#10;• Disconnection: Active TLS sessions killed within minutes of leaving ACTIVE (PD-100).&#10;• Edge Buffer Expiry: Node buffer expires after 24 hours on device (ASM-074).&#10;• S3 URL Expiry: Drone upload pre-signed URLs expire after 15 minutes (ASM-093).&#10;• Replacement: Replacement node receives new CSR-registered X.509 certificate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#7f1d1d;fontSize=11.5;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="2650" y="1470" width="720" height="95" as="geometry" />
</mxCell>
