  </mxGeometry>
</mxCell>
<mxCell id="m325" value="3.7: In-Person Re-Enrollment: User presents in person at Collection Center; identity verified; phone number updated; new device registered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
