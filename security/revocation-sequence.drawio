<mxCell id="m317" value="2.7: IMMEDIATE ENFORCEMENT (0 min): API checks token auth_time &lt; revoked_after; denies ANY request immediately without waiting for 60m expiry!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991b1b;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
