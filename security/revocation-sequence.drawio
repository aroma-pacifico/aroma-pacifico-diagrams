k;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="705" as="sourcePoint" /><mxPoint x="1460" y="705" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m115" value="1B.8: API checks: auth_time &lt;= 10m &amp; Separation of Duties (caller != drone pilot)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11.5;fontColor=#5B21B6;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="735" as="sourcePoint" /><mxPoint x="1460" y="735" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m116" value="1B.9: Conditional PutItem: state=authorized, authorizer=sub (CMK records)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="765" as="sourcePoint" /><mxPoint x="1720" y="765" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m117" value="1B.10: Commit confirmed (encrypted at rest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="795" as="sourcePoint" /><mxPoint x="1460" y="795" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m118" value="1B.11: 200 OK: Fumigation authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalA