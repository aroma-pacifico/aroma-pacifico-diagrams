  </mxGeometry>
</mxCell>
<mxCell id="box_c3c_callout" value="FIELD PHONE LOSS &amp; SIM HIJACK PROTECTION (§10):&#10;• Immediate device_id Revocation: Outbox queue on lost phone is permanently rejected.&#10;• AdminDisableUser: Critical protection against SIM swap or thief intercepting SMS OTP.&#10;• In-Person Re-Enrollment: User MUST verify identity in person at Collection Center&#10;  before account is re-enabled on a replacement smartphone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0c4a6e;fontSize=11.5;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="2650" y="2080" width="720" height="95" as="geometry" />
</mxCell>
      </root>
    </mxGraphModel>
