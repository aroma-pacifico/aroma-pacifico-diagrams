  </mxGeometry>
</mxCell>
<mxCell id="m309" value="1.9: For lost drone: API refuses upload grants; issued pre-signed S3 URLs expire in 15 min (ASM-093); late uploads quarantined" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991b1b;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
