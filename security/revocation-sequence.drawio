<mxCell id="box_step3a_hdr" value="SCENARIO 3A: DECOMMISSIONED FARM NODE OR LOST DRONE KIT (Security §10 | Case Statement Point 2 | Hardware Revocation)" style="rounded=0;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;fontSize=11.5;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1">
  <mxGeometry x="60" y="1430" width="3720" height="26" as="geometry" />
</mxCell>
<mxCell id="m301" value="1.1: Incident reported: Farm node stolen/replaced, or Drone lost during flight (Contracted operator reports | ASM-098)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;fontSize=11.5;fontColor=#1e3a8a;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
