• Agronomist authorizes fumigation
• Drone pilot executes flight mission
• System denies authorization if caller_id == pilot_id
• No automated trigger authorizes fumigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1540" y="800" width="310" height="85" as="geometry" /></mxCell><mxCell id="hdr_1c" value="PART 1C: FIELD USER PASSWORDLESS SIGN-IN (NO MFA JUSTIFIED, ASM-091, ASM-092)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1;fontColor=#14532D;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="80" y="895" width="1780" height="28" as="geometry" /></mxCell><mxCell id="m120" value="1C.1: Open app; unlock via phone screen lock PIN / biometrics (ASM-095)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="940" as="sourcePoint" /><mxPoint x="800" y="940" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m121" value="1C.2: Unlock app outbox key in phone hardware keystore (KeyStore / Keychain)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11.5;fontColor=#334155;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="965" as="sourcePoint" /><mxPoint x="800" y="965" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m122" value="1C.3: Enter registered phone number" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="995" as="sourcePoint" /><mxPoint x="800" y="995" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m123" value="1C.4: InitiateAuth(field_pool, CUSTOM_AUTH: SMS OTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1025" as="sourcePoint" /><mxPoint x="1140" y="1025" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m124" value="1C.5: Send 6-digit one-time code via SMS (or email for registered buyers)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#92400E;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1055" as="sourcePoint" /><mxPoint x="200" y="1055" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m125" value="1C.6: User inputs SMS one-time code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1085" as="sourcePoint" /><mxPoint x="800" y="1085" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m126" value="1C.7: RespondToAuthChallenge(CUSTOM_CHALLENGE, Answer=OTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labe