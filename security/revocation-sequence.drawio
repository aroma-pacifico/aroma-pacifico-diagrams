  </mxGeometry>
</mxCell>
<mxCell id="box_c3b_callout" value="IMMEDIATE REVOCATION ENFORCEMENT (§3.3, §10):&#10;• Zero Token Wait: Token revoked_after comparison terminates access in 0 minutes.&#10;  Does NOT wait for standard 60-minute access token expiration!&#10;• Identity Preserved: User account is disabled, NOT deleted, so historical flight orders&#10;  and fumigation authorizations preserve a valid operator_id for auditability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontSize=11.5;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
  <mxGeometry x="2650" y="1805" width="720" height="90" as="geometry" />
</mxCell>
