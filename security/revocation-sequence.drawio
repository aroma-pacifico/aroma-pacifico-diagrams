  </mxGeometry>
</mxCell>
<mxCell id="m307" value="1.7: Within minutes of leaving ACTIVE: IoT Core forcefully terminates active MQTT sessions and refuses new TLS handshakes (PD-100)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11.5;fontColor=#991b1b;align=center;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1">
