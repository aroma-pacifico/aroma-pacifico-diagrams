roundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2640" y="330" as="sourcePoint" /><mxPoint x="2640" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m204" value="4: Request within rate budget -&gt; Forward to CloudFront origin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2640" y="370" as="sourcePoint" /><mxPoint x="2340" y="370" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m205" value="5: Invokes Public Lookup Lambda (Reserved Concurrency = 10 caps cost &amp; concurrency)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=11.5;fontColor=#9A3412;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2340" y="410" as="sourcePoint" /><mxPoint x="2980" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m206" value="6: Validate Crockford Base32 syntax &amp; checksum symbol (rejects 36/37 bad guesses with zero DB read)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=11.5;fontColor=#9A3412;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2980" y="450" as="sourcePoint" /><mxPoint x="2980" y="450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m207" value="7: GetItem(TableName=&#x27;buyer_view&#x27;, Key={&#x27;sack_code&#x27;: code}) (CMK: public_view)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2980" y="490" as="sourcePoint" /><mxPoint x="3320" y="490" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m208" value="8: Returns public projection: origin (municipality/vereda), dates, status, drying variables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#15803D;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3320" y="530" as="sourcePoint" /><mxPoint x="2980" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m209" value="9: ZERO ACCESS: Lambda role holds NO IAM permissions &amp; NO KMS grants on internal tables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#991B1B;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2980" y="570" as="sourcePoint" /><mxPoint x="3620" y="570" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m210" value="10: Response with SOURCED HEADERS: Cache-Control: no-store, X-Robots-Tag: noindex, Referrer-Policy: no-referrer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#065F46;align=center;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2980" y="620" as="sourcePoint" /><mxPoint x="2340" y="620" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m211" value="11: Displays clean public buyer view (No farmer cédula, no transporter phone, no internal trace)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;dashed=1;fontSize=11.5;fontColor=#92400E;align=left;spacingLeft=10;verticalAlign=bottom;endArrow=block;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2340" y="670" as="sourcePoint" /><mxPoint x="2060" y="670" as="targetPoint" /></mxGeometry></mxCell><mxCell id="callout_2" value="SECURITY &amp; PRIVACY GUARANTEES (Section 8, docs/sack-and-trip.md):
• Code space: 80 random bits (2^80); collision probability &lt; 3.5e-18
• Decoupled projection: buyer_view DynamoDB table encrypted with CMK public_view
• Lookup answer headers: Cache-Control: no-store, X-Robots-Tag: noindex, Referrer-Policy: no-referrer
• Never cached anywhere: guarantees freshness, prevents stale status, enables audit logging (A08 §7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacing=8;" parent="1" vertex="1"><mxGeometry x="1980" y="720" width="1700" height="75" as="geometry" /></mxCell><mxCell id="scen3_boundary" value="3. REVOCATION PROTOCOLS &amp; ENFORCED TIME LIMITS (Section 10, ASM-098, PD-100)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;startSize=36;rounded=1;arcSize=4;" parent="1" vertex="1"><mxGeometry x="60" y="1410" width="3680" height="1220" as="geometry" /></mxCell><mxCell id="ll3_oper_box" value="Reporting Actor / Staff
