        </mxCell>
        <mxCell id="tier_admin" value="administration Tier | 10.82.96.0/20 (Private Subnets)&#10;• Route 53 Resolver Inbound Endpoint (2 IP addresses, CL-ADM-01, UDP/TCP 53) [AUDIT]&#10;• Endpoints: CloudWatch Logs, CloudWatch, IAM Roles Anywhere (CL-ADM-02) [AUDIT]&#10;• Management Session Host: outbound SSH 22 &amp;amp; HTTPS 443 to cc-device-mgmt (CL-ADM-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#1e3a8a;fontSize=11;fontStyle=1;spacingRight=8;" vertex="1" parent="1">
