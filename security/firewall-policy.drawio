        <mxCell id="leg_shaping" value="Traffic Control Guarantees (Section 8): Network 2M, Logistics 44M, Drone 20M, Staff 28M | Caps: Non-op 30M down" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#475569;" vertex="1" parent="1">
