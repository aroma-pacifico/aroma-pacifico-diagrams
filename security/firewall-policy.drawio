      <mxGeometry x="1940" y="32" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="desc_d04" value="VPC &amp; Tiers (Track B04)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
      <mxGeometry x="2005" y="32" width="150" height="35" as="geometry" />
    </mxCell><mxCell id="badge_d05" value="D05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="2170" y="32" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="desc_d05" value="Center Association (B05)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
      <mxGeometry x="2235" y="32" width="155" height="35" as="geometry" />
    </mxCell><mxCell id="badge_d07" value="D07" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="2405" y="32" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="desc_d07" value="Firewall Policy (B07)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
      <mxGeometry x="2470" y="32" width="150" height="35" as="geometry" />
    </mxCell><mxCell id="leg_solid" value="Permanent Rule (Review)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
      <mxGeometry x="2640" y="30" width="170" height="25" as="geometry" />
    </mxCell><mxCell id="leg_solid_line" value="" style="edgeStyle=none;html=1;strokeColor=#2563eb;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="2820" y="42" as="sourcePoint" /><mxPoint x="2890" y="42" as="targetPoint" /></mxGeometry>
    </mxCell><mxCell id="leg_audit" value="Audit before Prod (PD-125)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
      <mxGeometry x="2640" y="60" width="170" height="25" as="geometry" />
    </mxCell><mxCell id="leg_audit_line" value="" style="edgeStyle=none;html=1;strokeColor=#2563eb;strokeWidth=2.5;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="2820" y="72" as="sourcePoint" /><mxPoint x="2890" y="72" as="targetPoint" /></mxGeometry>
    </mxCell><mxCell id="leg_temp" value="Temporary Rule (Audit)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
      <mxGeometry x="2920" y="30" width="160" height="25" as="geometry" />
    </mxCell><mxCell id="leg_temp_line" value="" style="edgeStyle=none;html=1;strokeColor=#d97706;strokeWidth=2.5;dashed=1;dashPattern=3 3;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="3090" y="42" as="sourcePoint" /><mxPoint x="3160" y="42" as="targetPoint" /></mxGeometry>
    </mxCell><mxCell id="leg_deny" value="Explicit Deny / Blackhole" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
      <mxGeometry x="2920" y="60" width="160" height="25" as="geometry" />
    </mxCell><mxCell id="leg_deny_line" value="" style="edgeStyle=none;html=1;strokeColor=#dc2626;strokeWidth=2.5;dashed=1;dashPattern=6 3;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><mxPoint x="3090" y="72" as="sourcePoint" /><mxPoint x="3160" y="72" as="targetPoint" /></mxGeometry>
    </mxCell><mxCell id="leg_shaping" value="Traffic Control: Guarantees (Net 2M, Log 44M, Drn 20M, Stf 28M) | Caps: Non-op 30M down" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#475569;" vertex="1" parent="1">
      <mxGeometry x="3180" y="28" width="350" height="58" as="geometry" />
    </mxCell><mxCell id="cc_boundary" value="COLLECTION CENTER (Pattern: 10.4x.0.0/16) | Cauca .41, Huila .42, Tolima .43" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="50" y="130" width="940" height="2020" as="geometry" />
    </mxCell><mxCell id="cc_badge_d05" value="D05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="910" y="145" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="z_gerencia" value="Gerencia | 10.4x.1.0/24 (VLAN 101, WPA3-Ent)&#10;• 7 planned staff workstations (14M down, 3.5M up)&#10;• Reports web and center management app&#10;• Gateway: 10.4x.1.1 (Perimeter Firewall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="75" y="180" width="415" height="120" as="geometry" />
    </mxCell><mxCell id="z_soporte" value="Soporte | 10.4x.2.0/24 (VLAN 102, WPA3-Ent)&#10;• 7 planned staff workstations | Center support&#10;• Gateway: 10.4x.2.1 (Perimeter Firewall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="75" y="315" width="415" height="235" as="geometry" />
    </mxCell><mxCell id="node_ground_station" value="Drone Ground Station | 10.4x.2.10/32&#10;• Preloads mission packages (order, polygon, no-fly)&#10;• Multipart upload: photos, maps, flight records&#10;• Bandwidth: 5M down / 20M up gtd (burst 61.5M up)&#10;• Uploads reach application &amp; object_storage tiers&#10;• Active path to drone_object_ingress: DENIED (CC-DRN-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="90" y="380" width="385" height="155" as="geometry" />
    </mxCell><mxCell id="z_logistica" value="Logística | 10.4x.3.0/24 (VLAN 103, WPA3-Ent)&#10;• 22 planned clients: 2 wired desks + 20 mobile scanners&#10;• Bandwidth guarantee: 44M down / 11M up (100% active)&#10;• Sack reception (accept/reject), custody, code requests&#10;• Local encrypted outbox; no general internet exit&#10;• Gateway: 10.4x.3.1 (Perimeter Firewall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="75" y="565" width="415" height="160" as="geometry" />
    </mxCell><mxCell id="z_servidores" value="Servidores locales | 10.4x.10.0/24 (VLAN 110, Wired)&#10;Network devices, printing and commissioning zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="75" y="740" width="415" height="375" as="geometry" />
    </mxCell><mxCell id="node_net_devs" value="Network Management Infrastructure (.1 to .49):&#10;• Firewall Mgmt: 10.4x.10.1&#10;• Managed PoE Switches: 10.4x.10.2 to .9&#10;• Wi-Fi APs: 10.4x.10.20 to .49 (5 SSIDs per AP)&#10;• Managed from Cloud Administration host via tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="90" y="790" width="385" height="95" as="geometry" />
    </mxCell><mxCell id="node_printers" value="Network Code-Sheet Printers (.50 to .59):&#10;• Ethernet printers: 10.4x.10.50 to .59&#10;• Prints code sheets for sacks arriving without barcode&#10;• Protocol: IPP on TCP 631 from Logística &amp; Staff&#10;• Print jobs stay local within center; never cross WAN&#10;• Printers NEVER initiate traffic (CC-ADM-04: DENIED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="90" y="895" width="385" height="110" as="geometry" />
    </mxCell><mxCell id="node_laptop" value="Commissioning Laptop (.60) [TEMPORARY AUDIT]:&#10;• 10.4x.10.60/32 on dedicated wired switch port&#10;• TCP 22/443 for initial setup before VPN (CC-ADM-06)&#10;• Disabled immediately upon site acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fillColor=#fffbeb;strokeColor=#f59e0b;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="90" y="1015" width="385" height="85" as="geometry" />
    </mxCell><mxCell id="z_isolated_container" value="INTERNET-ONLY ROUTING CONTEXT (VIRTUAL ROUTER)&#10;NO route to 10.4x networks, 10.40.0.0/13 or Cloud VPN&#10;'La VLAN de visitantes no enruta hacia logística ni gerencia'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontColor=#991b1b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="75" y="1130" width="415" height="320" as="geometry" />
    </mxCell><mxCell id="z_transporte" value="Transporte | 10.4x.4.0/24 (VLAN 104, WPA3-Pers)&#10;• 20 planned transporter phones in yard; client isolation&#10;• Cap: 20M down / 5M up (2M/0.5M per phone)&#10;• Connects to public API front door over breakout&#10;• Gateway: 10.4x.4.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#0f172a;fontSize=13;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="90" y="1195" width="385" height="110" as="geometry" />
    </mxCell><mxCell id="z_visitantes" value="Visitantes | 10.4x.5.0/24 (VLAN 105, WPA3-Pers)&#10;• 10 planned guest phones; client isolation enabled&#10;• Cap: 10M down / 2.5M up (2M/0.5M per phone)&#10;• General web internet breakout only; SMTP 25 blocked&#10;• Gateway: 10.4x.5.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#0f172a;fontSize=13;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="90" y="1315" width="385" height="110" as="geometry" />
    </mxCell><mxCell id="center_barrier_card" value="Center Inter-Zone Defense Matrix (Section 6 &amp; 7):&#10;• CC-GST-01 &amp; 02: Visitantes &amp; Transporte denied to Logística &amp; Gerencia [AUDIT]&#10;• CC-GST-03: Visitantes &amp; Transporte denied to private ranges (10.40/13, Cloud) [AUDIT]&#10;• CC-ADM-03: User zones denied to management addresses (TCP 22/443) [AUDIT]&#10;• CC-STF-03: Staff zones denied to each other, Logística &amp; Guests [REVIEW]&#10;• CC-LNK-07: Inbound tunnel traffic to center denied (except cloud admin) [AUDIT]&#10;• CC-LNK-08: Inbound internet traffic on WAN interfaces denied [AUDIT]&#10;• CC-LNK-09: Inter-center traffic (10.40.0.0/13) denied [REVIEW]&#10;• CC-TEL-01: Any center traffic to telemetry_ingress denied [REVIEW]&#10;• CC-ADM-07: Servidores locales denied general internet access [REVIEW]&#10;• CC-LOG-04 &amp; CC-STF-05: Non-whitelisted internet ports denied [REVIEW]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fillColor=#fef2f2;strokeColor=#f87171;fontSize=10;lineHeight=1.35;" vertex="1" parent="1">
      <mxGeometry x="75" y="1465" width="415" height="230" as="geometry" />
    </mxCell><mxCell id="fw_device" value="CENTER PERIMETER FIREWALL (10.4x.20.1) | Enlace a la Nube" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontColor=#0f172a;fontSize=16;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="510" y="180" width="460" height="1830" as="geometry" />
    </mxCell><mxCell id="fw_services" value="Local Gateway Services &amp; Network Control (Priority 1):&#10;• Gateway IP: 10.4x.Z.1 for all VLAN subinterfaces&#10;• DHCP Server: UDP 67 (Leases: Staff 12h, Yard 4h, Guest 1h)&#10;• DNS Resolver &amp; Cache: UDP/TCP 53 conditional forwarding&#10;• Local NTP Time Source: UDP 123 served locally (ASM-123)&#10;• RADIUS Server: UDP 1812/1813 EAP-TLS with local CRL&#10;• Guaranteed bandwidth: 2 Mbps down / 2 Mbps up (Priority 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="530" y="235" width="420" height="150" as="geometry" />
    </mxCell><mxCell id="fw_shaping" value="Traffic Control &amp; Bandwidth Guarantees (Section 8):&#10;• Priority 1: Network Control (Tunnels, DNS, NTP, RADIUS, Logs) -> 2M / 2M gtd&#10;• Priority 2: Logistics (Receiving, scanning, code sheets) -> 44M / 11M gtd&#10;• Priority 3: Drone (Ground station uploads &amp; grants) -> 5M / 20M gtd (burst 61.5M up)&#10;• Priority 4: Staff (28M / 7M gtd) &amp; Transport App (2M / 1M gtd)&#10;• Priority 5: Non-operational (Visitantes &amp; Transporte) -> Cap 30M down / 7.5M up&#10;  (Per-client cap: 2 Mbps down / 0.5 Mbps up; served last with spare bandwidth)&#10;• Failover: Non-operational traffic suspended on cellular backup (ASM-086)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="530" y="395" width="420" height="175" as="geometry" />
    </mxCell><mxCell id="fw_wan1" value="Primary WAN Interface (10.4x.20.1 on VLAN 120):&#10;• 100 Mbps symmetric fiber link (90 Mbps usable, 10 Mbps IPsec overhead)&#10;• Site-to-Site VPN: 2 IPsec Tunnels to Transit Gateway Hub (CC-LNK-01/02)&#10;  [IKEv2 UDP 500, NAT-T UDP 4500, IP 50 ESP] (Pre-production Audit)&#10;• Local Internet Breakout (NAT) for authorized staff, guest &amp; app traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="530" y="580" width="420" height="120" as="geometry" />
    </mxCell><mxCell id="fw_wan2" value="Cellular Backup WAN Interface (LTE / 4G Router):&#10;• Automatic failover upon primary link failure (ASM-078)&#10;• Re-establishes same 2 IPsec tunnels (UDP 500/4500 NAT-T behind carrier NAT)&#10;• Non-operational traffic suspended; carries operational classes only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;strokeColor=#d97706;strokeWidth=2;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="530" y="710" width="420" height="105" as="geometry" />
    </mxCell><mxCell id="fw_execution_card" value="Top-Down Policy Evaluation Order (Section 4):&#10;1. CC-GST-01..03: Explicit Denies for Guest/Transport to Admin/LAN [AUDIT]&#10;2. CC-ADM-03..04: Deny Clients to Mgmt; Deny Printers Initiating [AUDIT]&#10;3. CC-BAS-01..04: Base Services (DHCP, DNS, NTP, RADIUS, SNMP)&#10;4. CC-LNK-01..03: IPsec Tunnels over Primary &amp; Cellular WAN [AUDIT]&#10;5. CC-LNK-04..05: Route 53 Resolver (53) &amp; Internet DNS/NTP&#10;6. CC-LNK-06: Temporary QA Testing Path (TCP 443) [TEMP, AUDIT]&#10;7. CC-LNK-07..09: Deny Inbound Tunnel / WAN / Other Centers [AUDIT]&#10;8. CC-ADM-01..02: Cloud Admin (22/443) &amp; CloudWatch Logs (443) [AUDIT]&#10;9. CC-ADM-05..06: Vendor Updates &amp; Laptop .60 [TEMP, AUDIT]&#10;10. CC-DRN-01..06: Ground Station Paths to App/S3 &amp; Deny Reserved [AUDIT]&#10;11. CC-LOG-01..04: Logistics App API (443), Printing (631), OS Updates [AUDIT]&#10;12. CC-STF-01..05: Staff App API (443), Printing (631), Web (80/443)&#10;13. CC-TEL-01..02: Deny Telemetry Tier, Allow Transporter Public API&#10;14. CC-PUB-01: Public Lookup Breakout (443)&#10;15. CC-GST-04..05: Deny SMTP (25), Allow Capped Web Breakout&#10;16. CC-DEF-01: Final Explicit Default Deny All (Logged) [AUDIT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=10;lineHeight=1.35;fillColor=#ffffff;" vertex="1" parent="1">
      <mxGeometry x="530" y="825" width="420" height="340" as="geometry" />
    </mxCell><mxCell id="cc_def_block" value="CC-DEF-01: Explicit Default Deny All (Pre-production Audit)&#10;Final rule drops all unmatched packets; stateful replies automatically allowed&#10;Denied attempts logged locally and exported to CloudWatch Logs (CC-ADM-02, A21)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;align=center;verticalAlign=middle;fontColor=#991b1b;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="530" y="1175" width="420" height="85" as="geometry" />
    </mxCell><mxCell id="pub_internet_boundary" value="PUBLIC INTERNET &amp; EXTERNAL CLIENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#1e3a8a;" vertex="1" parent="1">
      <mxGeometry x="1140" y="130" width="640" height="630" as="geometry" />
    </mxCell><mxCell id="ext_farm" value="Farm Field Nodes (200 Farms in Cauca, Huila, Tolima):&#10;• Crop nodes (6 readings/day) &amp; Drying nodes (24 readings/day)&#10;• Transmit via cellular bearer or satellite IP (out-of-coverage farms)&#10;• 24-hour non-volatile buffer; store-and-forward drainage&#10;• Protocol: MQTT over TLS 1.2+ to regional AWS IoT Core (CL-TEL-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="185" width="590" height="95" as="geometry" />
    </mxCell><mxCell id="ext_users" value="Public Mobile Clients (Farmer &amp; Transporter Apps):&#10;• Transporters: 5-minute GNSS fixes, custody events (pickup, yard, port)&#10;• Farmers: Plot registration, alerts notification, reading history&#10;• Protocol: HTTPS TCP 443 with Cognito auth to Public App API (CL-TEL-03)&#10;• Offline outbox: 7-day GNSS buffer with 15-min thinning fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="290" width="590" height="95" as="geometry" />
    </mxCell><mxCell id="ext_lookup" value="Public Sack Lookup Consumers:&#10;• End-buyers and public scanning sack QR codes&#10;• Authenticates via CloudFront CDN front door (CL-PUB-01)&#10;• Strict WAF rate limit: 30 requests/minute per source IP (PD-102)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="395" width="590" height="80" as="geometry" />
    </mxCell><mxCell id="ext_services" value="External Services &amp; Municipal Drone Ingress:&#10;• External NTP Servers (pool.ntp.org) &amp; Provider DNS (CC-LNK-05)&#10;• Vendor Firmware Updates (CC-ADM-05, TEMPORARY MAINTENANCE)&#10;• Municipal Seat Drone Uploads: Public S3 endpoint with TLS 1.2+ (CL-DRN-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="485" width="590" height="90" as="geometry" />
    </mxCell><mxCell id="ext_rules_note" value="Internet Perimeter Controls:&#10;• CC-LNK-08: Inbound internet flows to center WAN strictly blocked&#10;• CC-GST-04: Outbound SMTP (TCP 25) blocked from guest/transporter devices&#10;• CL-ADM-05: Inbound SSH (22) and RDP (3389) from 0.0.0.0/0 blocked via Config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fillColor=#fef2f2;strokeColor=#f87171;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="585" width="590" height="80" as="geometry" />
    </mxCell><mxCell id="hub_tgw_boundary" value="AWS NETWORK ACCOUNT | Central Transit Hub&#10;AWS Transit Gateway (tgw-aroma-hub) &amp; RAM Prefix Lists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#581c87;" vertex="1" parent="1">
      <mxGeometry x="1140" y="780" width="640" height="1370" as="geometry" />
    </mxCell><mxCell id="hub_badge_d05" value="D05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1705" y="795" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="tgw_icon" value="AWS Transit Gateway&#10;(tgw-aroma-hub)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;fillColor=#8C4FFF;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;fontColor=#581c87;" vertex="1" parent="1">
      <mxGeometry x="1425" y="850" width="70" height="70" as="geometry" />
    </mxCell><mxCell id="tgw_vpn" value="AWS Site-to-Site VPN Connections (CL-LNK-06):&#10;• 1 connection per center (Cauca, Huila, Tolima) on Transit Gateway&#10;• 2 tunnels per connection (UDP 500, UDP 4500 NAT-T, IP 50 ESP) [AUDIT]&#10;• IKEv2 only, certificate-based authentication of Customer Gateway (PD-120)&#10;• Static routing: center /16 only (no BGP route poisoning risk, ASM-120)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="935" width="590" height="105" as="geometry" />
    </mxCell><mxCell id="tgw_rt_centers" value="TGW Route Table 'centers' (Inbound from Collection Centers):&#10;• Static Route -> pdn application (10.82.48.0/20) [CL-LNK-01, AUDIT]&#10;• Static Route -> pdn object_storage (10.82.80.0/20) [CL-LNK-01, AUDIT]&#10;• Static Route -> pdn administration (10.82.96.0/20) [CL-LNK-01, AUDIT]&#10;• Static Route -> pdn drone_object_ingress (10.82.32.0/20) [CL-LNK-01]&#10;• Temporary Route -> qa application (10.81.48.0/20) [CL-LNK-05, AUDIT]&#10;• BLACKHOLE: 10.40.0.0/13 (No center-to-center path, CL-LNK-02) [AUDIT]&#10;• BLACKHOLE: dev (10.80.0.0/16), data, telemetry_ingress, public_query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="1050" width="590" height="150" as="geometry" />
    </mxCell><mxCell id="tgw_rt_pdn" value="TGW Route Table 'pdn' (Inbound from pdn VPC):&#10;• Static Route: 10.41.0.0/16 -> Cauca VPN Attachment [CL-LNK-03, AUDIT]&#10;• Static Route: 10.42.0.0/16 -> Huila VPN Attachment [CL-LNK-03, AUDIT]&#10;• Static Route: 10.43.0.0/16 -> Tolima VPN Attachment [CL-LNK-03, AUDIT]&#10;• BLACKHOLE: Remainder of 10.40.0.0/13 summary [AUDIT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="1210" width="590" height="105" as="geometry" />
    </mxCell><mxCell id="tgw_rt_dev_qa" value="TGW Route Tables 'dev' and 'qa':&#10;• Route Table 'dev': 10.40.0.0/13 BLACKHOLE (Dev never reaches centers, CL-LNK-04)&#10;• Route Table 'qa': 10.40.0.0/13 BLACKHOLE except temporary static route&#10;  to Logística 10.4x.3.0/24 during center acceptance testing (CL-LNK-05, AUDIT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="1325" width="590" height="100" as="geometry" />
    </mxCell><mxCell id="tgw_prefix_lists" value="Customer-Managed Prefix Lists (Shared via AWS RAM, Section 5.1):&#10;• cc-firewalls: 10.41.20.1/32, 10.42.20.1/32, 10.43.20.1/32 (3 entries)&#10;• cc-staff: 10.4x.1.0/24 &amp; 10.4x.2.0/24 of the 3 centers (6 entries)&#10;• cc-logistics: 10.41.3.0/24, 10.42.3.0/24, 10.43.3.0/24 (3 entries)&#10;• cc-ground-stations: 10.41.2.10/32, 10.42.2.10/32, 10.43.2.10/32 (3 entries)&#10;• cc-device-mgmt: .0/27, .32/28, .48/31 of 10.4x.10 (9 entries without printers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fillColor=#faf5ff;strokeColor=#c084fc;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1165" y="1435" width="590" height="135" as="geometry" />
    </mxCell><mxCell id="cloud_boundary" value="AWS WORKLOAD ACCOUNT (us-east-1) | Production (pdn) Environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;fillColor=#f8fafc;strokeColor=#475569;" vertex="1" parent="1">
      <mxGeometry x="1940" y="130" width="1610" height="2020" as="geometry" />
    </mxCell><mxCell id="cloud_badge_d04" value="D04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="3400" y="145" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="cloud_badge_d07" value="D07" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="3470" y="145" width="60" height="35" as="geometry" />
    </mxCell><mxCell id="pub_services_box" value="REGIONAL MANAGED PUBLIC ENTRY POINTS (Guarded by WAF &amp; Mutual TLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;fillColor=#f0fdf4;strokeColor=#86efac;fontColor=#14532d;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="1965" y="180" width="1560" height="210" as="geometry" />
    </mxCell><mxCell id="svc_iot_core" value="AWS IoT Core Data Endpoint (CL-TEL-01, CL-TEL-02):&#10;• Port 8883 (MQTT over TLS 1.2+ with mutual X.509 cert auth) [AUDIT]&#10;• Port 443 with ALPN x-amzn-mqtt-ca fallback [REVIEW]&#10;• Per-thing IoT policy; telemetry persistence to DynamoDB&#10;• Ground station grant topic (CC-DRN-04) via public endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1980" y="230" width="370" height="140" as="geometry" />
    </mxCell><mxCell id="svc_pub_api" value="Public Application API Front Door (CL-TEL-03):&#10;• HTTPS TCP 443 | AWS WAF Web ACL (ASM-129) [AUDIT]&#10;• Rate-based filtering, AWSManagedRules Common &amp; Bad Inputs&#10;• Amazon Cognito JWT token validation&#10;• Farmer sack registration, transporter positions &amp; custody events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="2370" y="230" width="375" height="140" as="geometry" />
    </mxCell><mxCell id="svc_pub_lookup" value="Public Sack Lookup Front Door (CL-PUB-01, CL-PUB-02):&#10;• Amazon CloudFront CDN + AWS WAF Web ACL [AUDIT]&#10;• HTTPS TCP 443 (TLS 1.2 min); HTTP 80 redirects to HTTPS&#10;• WAF rate limit: max 30 reads/min per source IP (PD-102)&#10;• Only GET and HEAD allowed on /lookup; default action BLOCK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="2765" y="230" width="375" height="140" as="geometry" />
    </mxCell><mxCell id="svc_s3_cw" value="Amazon S3 &amp; CloudWatch Observability:&#10;• Regional S3 Endpoint: TLS 1.2+ &amp; signed (CL-DRN-03) [AUDIT]&#10;• CloudWatch Logs: VPC Flow Logs of rejected traffic (CL-DEF-02)&#10;• CloudWatch Logs: Center syslog export under 'logs' key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="3160" y="230" width="350" height="140" as="geometry" />
    </mxCell><mxCell id="vpc_pdn" value="PRODUCTION VPC (pdn) | 10.82.0.0/16 (3 AZs: us-east-1a, 1b, 1c)&#10;No NAT Gateway &amp; No Default Internet Route (CL-EGR-01). AWS Network Firewall NOT deployed (ASM-127)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=15;" vertex="1" parent="1">
      <mxGeometry x="1965" y="410" width="1560" height="1180" as="geometry" />
    </mxCell><mxCell id="tier_transit" value="transit Tier | /28 Subnets (TGW VPC Attachment)&#10;• CL-LNK-08: Stateless NACL passes only 10.40.0.0/13 and 10.82.0.0/16; all other sources DENIED [REVIEW]&#10;• Inbound center flows routed to local VPC tiers; outbound flows routed to TGW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1985" y="465" width="750" height="95" as="geometry" />
    </mxCell><mxCell id="tier_app" value="application Tier | 10.82.48.0/20 (Private Subnets)&#10;• VPC Interface Endpoints: execute-api, cognito-idp&#10;• Security Group CL-APP-01: Inbound TCP 443 from cc-staff, cc-logistics, cc-ground-stations [AUDIT]&#10;• Endpoint Policy CL-APP-02: Strict allow for platform API ARNs (aws:SourceVpce) [AUDIT]&#10;• Stateless NACL CL-APP-03: Inbound TCP 443 from 10.40/13 &amp; 10.82/16, outbound ephemeral [REVIEW]&#10;• Reception API, code-sheet requests, staff reports web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1985" y="580" width="750" height="155" as="geometry" />
    </mxCell><mxCell id="tier_storage" value="object_storage Tier | 10.82.80.0/20 (Private Subnets)&#10;• VPC Interface Endpoint: Amazon S3 (com.amazonaws.us-east-1.s3)&#10;• Security Group CL-DRN-01: Inbound TCP 443 from cc-ground-stations only [AUDIT]&#10;• Endpoint Policy CL-DRN-02: s3:PutObject &amp; s3:AbortMultipartUpload on Drone Bucket only [AUDIT]&#10;• Stateless NACL CL-DRN-04: Inbound TCP 443 from ground stations &amp; VPC; ephemeral returns [REVIEW]&#10;• Drone photos, maps, polygons, flight records (5-year retention, SSE-KMS objects key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1985" y="750" width="750" height="160" as="geometry" />
    </mxCell><mxCell id="tier_drone_reserved" value="drone_object_ingress Tier | 10.82.32.0/20 (Private Subnets)&#10;[RESERVED TIER - NO ENDPOINTS DEPLOYED IN PILOT (ASM-140, closes PD-121)]&#10;• Ground station endpoints sit in application and object_storage instead&#10;• CC-DRN-02 &amp; CC-DRN-06: Traffic to this tier explicitly DENIED [AUDIT]&#10;• Preserves CIDR block for future high-scale direct ingestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;fillColor=#fef2f2;strokeColor=#f87171;fontColor=#991b1b;" vertex="1" parent="1">
      <mxGeometry x="1985" y="930" width="750" height="115" as="geometry" />
    </mxCell><mxCell id="tier_admin" value="administration Tier | 10.82.96.0/20 (Private Subnets)&#10;• Route 53 Resolver Inbound Endpoint (2 IP addresses, CL-ADM-01, UDP/TCP 53) [AUDIT]&#10;• Interface Endpoints: CloudWatch Logs, CloudWatch, IAM Roles Anywhere (CL-ADM-02, TCP 443) [AUDIT]&#10;• Management Session Host (CL-ADM-03): Outbound TCP 22 &amp; 443 to cc-device-mgmt; NO inbound [AUDIT]&#10;• Stateless NACL CL-ADM-04: Inbound 53/443 from firewalls, outbound 22/443 to centers [REVIEW]&#10;• Device backups, metrics, certificate revocation list distribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="2755" y="465" width="750" height="160" as="geometry" />
    </mxCell><mxCell id="tier_data" value="data Tier | 10.82.64.0/20 (Private Subnets)&#10;• Amazon DynamoDB &amp; S3 Gateway Endpoints (CL-DAT-03 with aws:ResourceOrgID) [REVIEW]&#10;• Stateless NACL CL-DAT-01: DENY ALL from 10.40.0.0/13 (Lowest rule number) [AUDIT]&#10;• Security Group CL-DAT-02: ALLOW store port from application tier ONLY [REVIEW]&#10;• Centers NEVER reach the data tier directly (strict multi-tier separation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="2755" y="640" width="750" height="145" as="geometry" />
    </mxCell><mxCell id="tier_pub_query" value="public_query Tier | 10.82.0.0/20 (Public Subnets)&#10;• Origin for CloudFront: Serverless Lambda Function URL / S3 origin (PD-051)&#10;• Security Group CL-PUB-03: Inbound TCP 443 restricted to CloudFront origin prefix list [AUDIT]&#10;• Stateless NACL CL-PUB-04: Inbound TCP 443, outbound ephemeral [REVIEW]&#10;• The only internet-facing VPC tier; completely isolated from centers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="2755" y="800" width="750" height="125" as="geometry" />
    </mxCell><mxCell id="tier_tel_reserved" value="telemetry_ingress Tier | 10.82.16.0/20 (Private Subnets)&#10;[RESERVED TIER - NO ENDPOINTS DEPLOYED IN PILOT (A10 sec 4.2)]&#10;• Farm telemetry connects directly to public AWS IoT Core (CL-TEL-01)&#10;• CC-TEL-01 &amp; CL-TEL-04: Inbound traffic to this tier explicitly DENIED [REVIEW]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontColor=#0f172a;fontSize=12;fontStyle=1;fillColor=#fef2f2;strokeColor=#f87171;fontColor=#991b1b;" vertex="1" parent="1">
      <mxGeometry x="2755" y="940" width="750" height="105" as="geometry" />
    </mxCell><mxCell id="cloud_defense_box" value="CLOUD DEFENSE &amp; OBSERVABILITY CONTROLS&#10;• CL-EGR-01: Private tiers have NO NAT Gateway &amp; NO default route to internet [AUDIT]&#10;• CL-DEF-01: Explicit Default Deny across all Security Groups, NACLs &amp; Transit Gateway [AUDIT]&#10;• CL-DEF-02: VPC Flow Logs capture all REJECTED traffic to CloudWatch Logs with 'logs' key [REVIEW]&#10;• CL-ADM-05: AWS Config managed rules block open SSH (22) and RDP (3389) from 0.0.0.0/0 [AUDIT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1985" y="1065" width="1520" height="85" as="geometry" />
    </mxCell><mxCell id="cloud_policy_card" value="Cloud Firewall &amp; Managed Policy Architecture Mapping:&#10;• CL-LNK-01..03: TGW Route Tables route centers to 4 pdn tiers; return routes to center /16s [AUDIT]&#10;• CL-LNK-04..05: TGW dev blackhole; temporary QA test route to Logística 10.4x.3.0/24 [AUDIT]&#10;• CL-LNK-06..08: VPN attachments (IKEv2) [AUDIT]; transit tier stateless NACL passes center &amp; VPC [REVIEW]&#10;• CL-APP-01..03: Security group allows cc-staff/logistics/drone on 443 [AUDIT]; endpoint policy restricts to API ARNs [AUDIT]&#10;• CL-DRN-01..04: SG allows cc-ground-stations to S3 endpoint [AUDIT]; endpoint policy restricts to drone bucket [AUDIT]&#10;• CL-TEL-01..04: IoT Core MQTT 8883/443 with mutual TLS [AUDIT]; WAF Web ACL allows public app API [AUDIT]&#10;• CL-ADM-01..04: Route 53 Resolver SG (53) &amp; CloudWatch SG (443) [AUDIT]; session host outbound to cc-device-mgmt (22/443) [AUDIT]&#10;• CL-PUB-01..04: CloudFront WAF rate limit 30/min [AUDIT]; SG allows CloudFront prefix list [AUDIT]; redirect 80->443 [REVIEW]&#10;• CL-DAT-01..03: NACL denies centers to data tier [AUDIT]; SG allows store port from app tier only; gateway policy OrgID [REVIEW]&#10;• CL-EGR-01, CL-DEF-01..02: No NAT egress [AUDIT]; explicit default deny all [AUDIT]; VPC Flow Logs capture rejected flows [REVIEW]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=10;lineHeight=1.35;fillColor=#ffffff;" vertex="1" parent="1">
      <mxGeometry x="1985" y="1170" width="1520" height="230" as="geometry" />
    </mxCell><mxCell id="nonprod_box" value="NON-PRODUCTION &amp; PREPARED TARGET ENVIRONMENTS (ISOLATION &amp; AUDIT CONTROLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacing=15;fontColor=#0f172a;fontSize=18;fontStyle=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="1965" y="1630" width="1560" height="200" as="geometry" />
    </mxCell><mxCell id="env_qa" value="QA Environment (qa) | 10.81.0.0/16&#10;• QA Application: 10.81.48.0/20&#10;• CC-LNK-06 &amp; CL-LNK-05: Logística acceptance testing [TEMPORARY, AUDIT]&#10;• Static routes on TGW centers &amp; qa, security group rule on TCP 443&#10;• Removed immediately upon center acceptance sign-off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fillColor=#fffbeb;strokeColor=#f59e0b;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1985" y="1680" width="490" height="130" as="geometry" />
    </mxCell><mxCell id="env_dev" value="Dev Environment (dev) | 10.80.0.0/16&#10;• Complete network isolation from operational centers&#10;• CL-LNK-04: 10.40.0.0/13 route explicitly BLACKHOLED in dev route table [REVIEW]&#10;• Development workloads never touch collection center traffic or equipment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="2500" y="1680" width="490" height="130" as="geometry" />
    </mxCell><mxCell id="env_azure" value="Azure Prepared Target | 10.88.0.0/13 [PREPARED, NOT DEPLOYED (ADR-001)]&#10;• Architecture &amp; addressing planned as secondary export target&#10;• Zero cloud resources deployed, zero cross-cloud links or billing&#10;• Satisfies multi-cloud challenge requirement under low-investment constraint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=8;fontColor=#1e293b;fontSize=12;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="3015" y="1680" width="490" height="130" as="geometry" />
