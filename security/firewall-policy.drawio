        </mxCell>
        <mxCell id="cloud_defense_box" value="CLOUD DEFENSE &amp;amp; OBSERVABILITY CONTROLS&#10;• CL-EGR-01: No NAT GW &amp;amp; no default internet route [AUDIT]&#10;• CL-DEF-01: Explicit Default Deny on SGs, NACLs &amp;amp; TGW [AUDIT]&#10;• CL-DEF-02: Flow logs to CloudWatch with 'logs' key [REVIEW]&#10;• CL-ADM-05: Config rules block open mgmt ports [AUDIT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontColor=#991b1b;fontSize=11;fontStyle=1;spacingRight=10;" vertex="1" parent="1">
