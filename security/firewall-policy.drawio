        </mxCell>
        <mxCell id="tier_pub_query" value="public_query Tier | 10.82.0.0/20 (Public Subnets)&#10;• Origin for CloudFront: Serverless Lambda Function URL / S3 origin (PD-051)&#10;• Security Group CL-PUB-03: Inbound TCP 443 from CloudFront origin prefix list [AUDIT]&#10;• Stateless NACL CL-PUB-04: Inbound TCP 443; outbound ephemeral ports [REVIEW]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
