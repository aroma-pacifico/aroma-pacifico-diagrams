        <mxCell id="cc_boundary" value="COLLECTION CENTER (Pattern: 10.4x.0.0/16) | Cauca .41, Huila .42, Tolima .43" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fontColor=#0f172a;fontSize=16;fontStyle=1;" vertex="1" parent="1">
