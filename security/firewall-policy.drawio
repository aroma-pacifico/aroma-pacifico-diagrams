        <mxCell id="pub_services_box" value="REGIONAL MANAGED PUBLIC ENTRY POINTS (Guarded by WAF &amp;amp; Mutual TLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1735" y="185" width="900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="svc_iot_core" value="AWS IoT Core Data Endpoint (CL-TEL-01, CL-TEL-02):&#10;• Port 8883 (MQTT over TLS 1.2+ with mutual X.509 cert auth) [AUDIT]&#10;• Port 443 with ALPN x-amzn-mqtt-ca fallback [REVIEW]&#10;• Per-thing IoT policy; telemetry ingestion to application tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1750" y="220" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="svc_pub_api" value="Public Application API Front Door (CL-TEL-03):&#10;• HTTPS TCP 443 | AWS WAF Web ACL (ASM-129) [AUDIT]&#10;• Rate-based filtering, AWSManagedRules Common &amp;amp; Bad Inputs&#10;• Amazon Cognito JWT token validation | Positions &amp;amp; custody" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1750" y="288" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="svc_pub_lookup" value="Public Sack Lookup Front Door (CL-PUB-01, CL-PUB-02):&#10;• Amazon CloudFront CDN + AWS WAF Web ACL [AUDIT]&#10;• HTTPS TCP 443 (TLS 1.2 min); HTTP 80 redirects to HTTPS&#10;• WAF rate limit: max 30 reads/min per source IP (PD-102)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1750" y="356" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="svc_s3_cw" value="Amazon S3 &amp;amp; CloudWatch Observability:&#10;• Regional S3 Endpoint: TLS 1.2+ &amp;amp; signed by grant role (CL-DRN-03) [AUDIT]&#10;• CloudWatch Logs: VPC Flow Logs of rejected traffic (CL-DEF-02)&#10;• CloudWatch Logs: Center syslog &amp;amp; metric export (CC-ADM-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1750" y="424" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pub_entry_note" value="Edge Security &amp;amp; Ingress Policy Controls:&#10;• CL-TEL-01: Port 8883 MQTT over TLS with mutual X.509 [AUDIT]&#10;• CL-TEL-02: Port 443 with ALPN x-amzn-mqtt-ca fallback [REVIEW]&#10;• CL-TEL-03: HTTPS 443 guarded by AWS WAF Web ACL &amp;amp; Cognito [AUDIT]&#10;• CL-PUB-01: CloudFront CDN + WAF rate-limited 30/min per IP [AUDIT]&#10;• CL-PUB-02: HTTP 80 redirects to HTTPS 443 [REVIEW]&#10;• CL-DRN-03: S3 TLS 1.2+ &amp;amp; signed by upload-grant role [AUDIT]&#10;• CL-DEF-02: Rejected flows logged to CloudWatch Logs [REVIEW]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#334155;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2200" y="220" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="vpc_pdn" value="PRODUCTION VPC (pdn) | 10.82.0.0/16 (3 AZs: us-east-1a, 1b, 1c)&#10;No NAT Gateway &amp;amp; No Default Internet Route (CL-EGR-01). AWS Network Firewall NOT deployed (ASM-127)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1735" y="510" width="900" height="770" as="geometry" />
        </mxCell>
        <mxCell id="tier_transit" value="transit Tier | /28 Subnets (TGW VPC Attachment)&#10;• CL-LNK-08: Stateless NACL passes only 10.40.0.0/13 &amp;amp; 10.82.0.0/16 [REVIEW]&#10;• Inbound center flows routed to local VPC tier endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
