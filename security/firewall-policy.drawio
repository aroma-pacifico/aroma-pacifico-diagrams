        <!-- Collection Center Zones -->
        <mxCell id="z_gerencia" value="Gerencia | 10.4x.1.0/24 (VLAN 101, WPA3-Ent)&#10;• 7 planned staff workstations (14M down / 3.5M up)&#10;• Reports web and center management app&#10;• Gateway: 10.4x.1.1 (Perimeter Firewall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="185" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z_soporte" value="Soporte | 10.4x.2.0/24 (VLAN 102, WPA3-Ent)&#10;• 7 planned staff workstations | Center support &amp;amp; IT&#10;• Gateway: 10.4x.2.1 (Perimeter Firewall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="320" width="360" height="230" as="geometry" />
        </mxCell>
        <mxCell id="node_ground_station" value="Drone Ground Station | 10.4x.2.10/32&#10;• Preloads mission packages (order, polygon, no-fly)&#10;• Multipart upload: photos, maps, flight records&#10;• Bandwidth: 5M down / 20M up gtd (burst 61.5M up)&#10;• Uploads reach application &amp;amp; object_storage tiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="405" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="z_logistica" value="Logística | 10.4x.3.0/24 (VLAN 103, WPA3-Ent)&#10;• 22 planned clients: 2 wired desks + 20 mobile scanners&#10;• Bandwidth guarantee: 44M down / 11M up (100% active)&#10;• Sack reception (accept/reject), custody, code sheets&#10;• Gateway: 10.4x.3.1 (Perimeter Firewall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="565" width="360" height="135" as="geometry" />
        </mxCell>
        <mxCell id="z_servidores" value="Servidores locales | 10.4x.10.0/24 (VLAN 110, Wired)&#10;Network devices, printing and commissioning zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#0f172a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="715" width="360" height="305" as="geometry" />
        </mxCell>
        <mxCell id="node_net_devs" value="Network Management Infrastructure (.1 to .49):&#10;• Firewall Mgmt: .1 | PoE Switches: .2-.9 | APs: .20-.49&#10;• Managed from Cloud Administration (TCP 22/443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="760" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_printers" value="Network Code-Sheet Printers (.50 to .59):&#10;• Dedicated Ethernet printers for sack code sheets&#10;• Inbound IPP TCP 631 from Logística &amp;amp; Staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="845" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="node_laptop" value="Commissioning Laptop (.60) [TEMPORARY AUDIT]:&#10;• 10.4x.10.60/32 on dedicated wired switch port&#10;• TCP 22/443 for initial setup before VPN (CC-ADM-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#92400e;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="930" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="z_isolated_container" value="INTERNET-ONLY ISOLATED CONTEXT (VRF)&#10;Quote: &quot;Visitor VLAN does not route to logistics or management&quot; (Case statement point 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;fontColor=#881337;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="1035" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="z_transporte" value="Transporte | 10.4x.4.0/24 (VLAN 104, WPA3-Pers)&#10;• 20 planned transporter phones | Cap: 20M down / 5M up&#10;• Client isolation; breakout to public API front door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1095" width="330" height="85" as="geometry" />
        </mxCell>
        <mxCell id="z_visitantes" value="Visitantes | 10.4x.5.0/24 (VLAN 105, WPA3-Pers)&#10;• 10 planned guest phones | Cap: 10M down / 2.5M up&#10;• Client isolation; general web breakout (TCP 25 blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1195" width="330" height="85" as="geometry" />
        </mxCell>

        <!-- Perimeter Firewall Box -->
        <mxCell id="fw_device" value="PERIMETER FIREWALL (10.4x.20.1) | Cloud Link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="585" y="185" width="395" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="fw_services" value="Local Gateway Services (Priority 1):&#10;• Gateway IP: 10.4x.Z.1 on all VLAN subinterfaces&#10;• DHCP Server: UDP 67 (Staff 12h, Yard 4h, Guest 1h)&#10;• DNS Cache / Forwarder: UDP 53 (upstream Route 53 Resolver)&#10;• Local NTP Server: UDP 123 (synced to cloud / pool.ntp.org)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="235" width="375" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fw_shaping" value="Traffic Control &amp;amp; Bandwidth Shaping (Section 8):&#10;• Priority 1: Network Control (Tunnels, DNS, NTP, RADIUS, Logs) -&gt; 2M/2M gtd&#10;• Priority 2: Logistics (Receiving, scanning, code sheets) -&gt; 44M/11M gtd&#10;• Priority 3: Drone Ground Station (Missions, multipart uploads) -&gt; 5M down / 20M up gtd (burst 61.5M up)&#10;• Priority 4: Staff Workstations (Center management, reporting) -&gt; 28M/7M gtd&#10;• Priority 5: Non-operational capped pool (Transport, Guests) -&gt; 30M down max (Transport 20M, Guest 10M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#1e3a8a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="385" width="375" height="175" as="geometry" />
        </mxCell>
        <mxCell id="fw_wan1" value="Primary WAN Interface (10.4x.20.1 on VLAN 120):&#10;• 100 Mbps symmetric fiber link (90 Mbps usable)&#10;• Site-to-Site VPN: 2 IPsec Tunnels to TGW Hub (CC-LNK-01..03)&#10;• IKEv2, UDP 500/4500, IP 50 (ESP), AES-256-GCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="575" width="375" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fw_wan2" value="Cellular Backup WAN Interface (LTE / 4G Router):&#10;• Automatic failover upon primary link failure (ASM-078)&#10;• Re-establishes 2 IPsec tunnels behind carrier NAT&#10;• Non-operational traffic suppressed to 0 during failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#92400e;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="710" width="375" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cc_def_block" value="CC-DEF-01: Explicit Default Deny All (Pre-prod Audit)&#10;• Final rule drops unmatched packets; stateful replies allowed&#10;• Rejected flows logged locally and exported to CloudWatch Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#991b1b;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="1020" width="375" height="95" as="geometry" />
        </mxCell>

        <!-- Public Internet Boundary -->
        <mxCell id="pub_internet_boundary" value="PUBLIC INTERNET &amp;amp; EXTERNAL CLIENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fontColor=#0f172a;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="135" width="510" height="360" as="geometry" />
        </mxCell>
        <mxCell id="ext_farm" value="Farm Field Nodes (200 Farms in Cauca, Huila, Tolima):&#10;• Crop &amp;amp; drying telemetry: 6 readings/day (150B MQTT)&#10;• Connects to AWS IoT Core over TCP 8883 / 443 ALPN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="185" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ext_users" value="Public Mobile Clients (Farmer &amp;amp; Transporter Apps):&#10;• Transporter 5-min GPS &amp;amp; custody events (1 KB HTTPS)&#10;• Farmer sack registration; AWS WAF &amp;amp; Cognito JWT auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="260" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ext_lookup" value="Public Sack Lookup Consumers:&#10;• End-buyers scanning QR codes (CloudFront CDN + WAF)&#10;• Rate-limited 30 reads/min per source IP (PD-102)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="335" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ext_services" value="External Services &amp;amp; Municipal Drone Ingress:&#10;• Municipal seat drone operators (signed presigned S3 URLs)&#10;• External NTP pool servers (pool.ntp.org)&#10;• Local breakout exit for center web &amp;amp; update traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="410" width="480" height="65" as="geometry" />
        </mxCell>

        <!-- Transit Hub Boundary -->
        <mxCell id="hub_tgw_boundary" value="AWS NETWORK ACCOUNT | Central Transit Hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#8b5cf6;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=15;fontColor=#0f172a;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="515" width="510" height="1070" as="geometry" />
        </mxCell>
        <mxCell id="hub_badge_d05" value="D05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#52708a;strokeWidth=2;fontColor=#102a43;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1515" y="525" width="55" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tgw_header" value="AWS Transit Gateway (tgw-aroma-hub)&#10;Central hub interconnecting 3 collection centers and workload VPCs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="565" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="tgw_vpn" value="AWS Site-to-Site VPN Connections (CL-LNK-06) [AUDIT]:&#10;• 3 center VPN connections (2 tunnels each, static routes)&#10;• IKEv2 only, certificate-based auth / PSK, IP 50 ESP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="640" width="480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tgw_rt_centers" value="TGW Route Table 'centers' (Inbound from Centers):&#10;• Routes to 4 pdn tiers: application, storage, admin, drone [AUDIT]&#10;• 10.40.0.0/13 inter-center BLACKHOLE (no lateral transit) [AUDIT]&#10;• 10.80.0.0/16 dev BLACKHOLE (dev isolated from centers) [REVIEW]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="745" width="480" height="125" as="geometry" />
        </mxCell>
        <mxCell id="tgw_rt_pdn" value="TGW Route Table 'pdn' (Inbound from pdn VPC):&#10;• Static routes: 10.41/16, 10.42/16, 10.43/16 to VPN attachments [AUDIT]&#10;• Remaining 10.40.0.0/13 BLACKHOLE (unassigned center ranges)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;fontColor=#5b21b6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="880" width="480" height="90" as="geometry" />
        </mxCell>
