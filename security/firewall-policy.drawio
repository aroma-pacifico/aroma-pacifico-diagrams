<mxfile host="app.diagrams.net" version="32.4.1" type="device">
  <diagram id="firewall-policy" name="Perimeter and cloud firewall policy">
    <mxGraphModel dx="3600" dy="2200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="3600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Perimeter and Cloud Firewall Policy" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
      <mxGeometry x="50" y="25" width="800" height="40" as="geometry" />
    </mxCell><mxCell id="subtitle" value="Collection center perimeter firewall (10.4x.0.0/16) and managed cloud controls (AWS us-east-1). Traceability to Track B: D04, D05, D07." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#334155;" vertex="1" parent="1">
      <mxGeometry x="50" y="65" width="1100" height="30" as="geometry" />
    </mxCell><mxCell id="legend_container" value="POLICY &amp; FLOW LEGEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontColor=#1e293b;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1750" y="20" width="1800" height="95" as="geometry" />
